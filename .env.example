# ============================================
# Correo Argentino MDA — Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# --- Storage ---
EXTERNAL_STORAGE_DIR="./data/storage"
# Root directory for all uploaded files (apps, icons, PDFs).
# Files are organized into subdirectories automatically:
#   {dir}/apps/  — application binaries (.zip, .exe, .msi, .rar)
#   {dir}/icons/ — icon files (.png, .jpg, .svg, .ico)
#   {dir}/pdfs/  — instruction PDFs (confidential, auth-protected)

# --- Session & Encryption ---
SESSION_SECRET=""
# A random 64-character hex string for session signing.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

ENCRYPTION_KEY=""
# A 32-character hex string for AES-256-GCM encryption of credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"

# --- InvGate API ---
INVGATE_API_USERNAME="portalmda"
INVGATE_BASE_URL="https://correoargentino.sd.cloud.invgate.net/api/v1/"
INVGATE_API_KEY=""

# --- InvGate Automatizaciones (módulo /automatizaciones) ---
INVGATE_AUTOMATION_GROUP_ID=""
# Override opcional de la/s cola/s (nivel de helpdesk en helpdesksandlevels)
# donde viven los tickets de automatización de sucursales. Acepta uno o varios
# IDs separados por comas (producción 2026-09 usa dos colas: el helpdesk AUTSUC
# y su nivel histórico). La cola se resuelve automáticamente: helpdesk por
# nombre ("Mesa de Coordinación" o "TI_GSM_MDC AUTSUC") + desambiguación empírica
# de niveles contra la categoría resuelta. Usar solo si esa resolución falla o
# como fast-path de performance.

INVGATE_AUTOMATION_CATEGORY_ID=""
# Override opcional del ID de la categoría hoja. La categoría se resuelve
# automáticamente por la ruta vigente (2026-09:
# "Tecnologia informatica » Gestión de Servicios » Mesa de Coordinación »
# Proyectos » Automatizar sucursal"); usar solo si esa ruta cambia o falla.

INVGATE_AUTOMATION_VIEW_ID=""
# Override opcional: ID de una vista guardada de InvGate filtrada SOLO por la
# categoría hoja de automatizaciones (sin filtro de mesa ni de estado). Es la
# fuente autoritativa de padres por categoría: trae los tickets asignados a
# CUALQUIER mesa, incluidos los finalizados (producción 2026-10: view 64).
# Si se deja vacío, se usa el sweep por estado (activos) + tracking persistido.

# --- Caches del módulo /automatizaciones (minutos) ---
AUTOMATION_DETAIL_TTL_MIN="5"
# Snapshot persistido del detalle resuelto: una pipeline por id cada TTL,
# compartida entre usuarios y restarts. Default 5.

AUTOMATION_CHILD_CACHE_TTL_MIN="30"
# Cache de tasks/solutions por ticket hijo (cambian poco). Default 30.

AUTOMATION_USERS_CACHE_TTL_MIN="1440"
# Cache de nombres de usuarios y del mapa de sectores. Default 1440 (24 h).

AUTOMATION_PROGRESS_TTL_MIN="2"
# Cache del progreso liviano de las cards del listado. Default 2.

INVGATE_METRICS="0"
# 1 = loguea el conteo de llamadas a la API de InvGate por flujo (medición).

AUTOMATION_CLOSE_THRESHOLD="80"
# Umbral de progreso (%) a partir del cual un admin puede cerrar un caso
# manualmente desde el portal (cierre local, no toca InvGate). Default 80.
# El flujo que llega al 100% sin etapas bloqueantes faltantes se finaliza
# automáticamente en el portal.

# --- InvGate QA API (test environment) ---
INVGATE_QA_API_USERNAME="portalmda"
INVGATE_QA_BASE_URL="https://correoargentino-qa.sd.cloud.invgate.net/api/v1/"
INVGATE_QA_API_KEY=""
# QA/test environment. Separate server from production. Use for testing requests that edit sensitive data.

# --- Wise CX API ---
WISE_CX_BASE_URL="https://api.wcx.cloud"
WISE_CX_API_KEY=""
WISE_CX_API_USER=""
# Generate API key: Settings → Canales → Api in Wise CX dashboard.
# WISE_CX_API_USER is the username registered when generating the key.