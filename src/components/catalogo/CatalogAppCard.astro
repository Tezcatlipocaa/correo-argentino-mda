---
import { getCleanBase } from "@lib/baseUrl";
import { Icon } from "astro-icon/components";
import CatalogSoftBadge from "./CatalogSoftBadge.astro";
import { decryptData } from "@lib/encryption";
import CopyButton from "@components/ui/CopyButton.astro";
import { resolveUrl } from "@lib/url";
import { iconExists } from "@lib/storage";
import ActionButton from "@components/ui/ActionButton.astro";

interface Props {
  id: number;
  title: string;
  description?: string | null;
  version?: string | null;
  filePath?: string | null;
  categoryTitle?: string | null;
  iconPath?: string | null;
  metadata?: string | null;
  instructionPdfPath?: string | null;
}

const {
  id,
  title,
  description,
  version,
  filePath,
  categoryTitle,
  iconPath,
  metadata,
  instructionPdfPath,
} = Astro.props;

import { canUserAccessCredentials } from "@lib/credentialAccess";

const user = Astro.locals.user;
const isAuthenticated = user && user.id !== 0;

interface AppMetaItem {
  label: string;
  value: string;
  minRole?: string;
  helpdesk?: string | null;
}

let visibleMetaItems: Array<{ label: string; metaIndex: number }> = [];
let hasSensitiveData = false;

if (isAuthenticated && metadata) {
  try {
    const jsonStr = decryptData(metadata);
    const parsed: AppMetaItem[] = JSON.parse(jsonStr);
    if (Array.isArray(parsed)) {
      visibleMetaItems = parsed
        .map((meta, idx) => ({ ...meta, originalIndex: idx }))
        .filter((meta) =>
          canUserAccessCredentials(user, {
            credentialMinRole: meta.minRole,
            credentialHelpdesk: meta.helpdesk,
          }),
        )
        .map((meta) => ({
          label: meta.label,
          metaIndex: meta.originalIndex,
        }));
      hasSensitiveData = visibleMetaItems.length > 0;
    }
  } catch (err) {
    console.error("Error al procesar metadatos en la tarjeta:", err);
  }
}

const cleanBase = getCleanBase();
const isWebUrl = (value: string): boolean => /^https?:\/\//i.test(value);

const rawPath = filePath?.trim() || "";
const isExternal = isWebUrl(rawPath);
const itemUrl = isExternal ? rawPath : rawPath ? resolveUrl(rawPath) : "";
const hasItemUrl = itemUrl.length > 0;

const hasIcon = iconExists(iconPath);
const iconUrl = hasIcon ? `${cleanBase}api/icons/${iconPath}` : null;
const searchText = [
  title,
  description ?? "",
  categoryTitle ?? "",
  version ?? "",
]
  .join(" ")
  .toLowerCase();
---

<article
  data-app-card
  data-search-text={searchText}
  class="card rounded-box border-base-300 bg-base-100 hover:border-secondary/40 h-full border shadow-xs transition-colors"
>
  <div class="card-body flex-row items-start gap-4 p-4 sm:p-5">
    <div
      class="rounded-box border-base-300 bg-base-200 flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden border p-1"
    >
      {
        iconUrl ? (
          <img
            src={iconUrl}
            alt={`Ícono de ${title}`}
            class="h-full w-full object-contain"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Icon name="boxicons:cube" class="text-base-content/40 h-8 w-8" />
        )
      }
    </div>

    <div class="flex min-w-0 flex-1 flex-col gap-4 self-stretch">
      <div class="min-w-0 space-y-2">
        <div class="flex items-start justify-between gap-3">
          <h3
            class="text-base-content text-base font-semibold"
            data-highlight-target
          >
            {title}
          </h3>
          {
            version && (
              <CatalogSoftBadge tone="neutral" class="shrink-0">
                {version}
              </CatalogSoftBadge>
            )
          }
        </div>
        {
          description && (
            <p class="text-base-content/70 text-sm" data-highlight-target>
              {description}
            </p>
          )
        }

        {
          hasSensitiveData && (
            <details class="group/creds mt-1.5 w-full">
              <summary class="btn btn-xs w-full list-none justify-start select-none">
                <Icon name="boxicons:key" size={14} class="shrink-0" />
                <span class="group-open/creds:hidden">
                  Mostrar credenciales
                </span>
                <span class="hidden group-open/creds:inline">
                  Ocultar credenciales
                </span>
              </summary>
              <div class="bg-base-200 mt-2 w-full space-y-1.5 rounded p-2 text-xs">
                {visibleMetaItems.map((meta) => {
                  return (
                    <div
                      class="flex items-center justify-between gap-3"
                      data-credential-row
                      data-entity-type="application"
                      data-entity-id={id}
                      data-meta-index={meta.metaIndex}
                    >
                      <span
                        class="text-base-content/50 flex shrink-0 items-center gap-1 font-semibold"
                        title={meta.label}
                      >
                        <Icon
                          name="boxicons:key"
                          size={14}
                          aria-hidden="true"
                        />
                        <span class="max-w-20 truncate sm:max-w-30">
                          {meta.label}
                        </span>
                      </span>
                      <div class="flex min-w-0 flex-1 items-center justify-end gap-1.5">
                        <input
                          type="password"
                          placeholder="••••••••"
                          readonly
                          aria-label={`Contraseña para ${meta.label}`}
                          class="input input-xs bg-base-300 text-base-content min-w-0 flex-1 border-none pr-1 text-right font-mono font-bold"
                          data-password-input
                        />
                        <button
                          type="button"
                          class="btn btn-xs btn-ghost btn-square min-h-8 min-w-8 text-base-content/60 shrink-0"
                          data-toggle-password
                          title="Mostrar/Ocultar contraseña"
                          aria-label="Mostrar u ocultar contraseña"
                        >
                          <Icon
                            name="boxicons:eye-filled"
                            size={16}
                            data-show-icon
                          />
                          <Icon
                            name="boxicons:eye-slash-filled"
                            size={16}
                            class="hidden"
                            data-hide-icon
                          />
                        </button>
                        <button
                          type="button"
                          class="btn btn-xs btn-ghost btn-square min-h-8 min-w-8 text-base-content/60 shrink-0"
                          data-copy-credential
                          title={`Copiar credencial para ${meta.label}`}
                          aria-label={`Copiar credencial para ${meta.label}`}
                        >
                          <Icon
                            name="boxicons:clipboard-filled"
                            size={16}
                            data-copy-icon-default
                            aria-hidden="true"
                          />
                          <Icon
                            name="boxicons:check-filled"
                            size={16}
                            class="text-success hidden"
                            data-copy-icon-success
                            aria-hidden="true"
                          />
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            </details>
          )
        }
      </div>

      <div class="card-actions mt-auto justify-end pt-1">
        {
          isAuthenticated && instructionPdfPath && (
            <ActionButton
              href={`${cleanBase}api/aplicativos/pdf/${id}`}
              variant="outline"
              color="btn-info"
              size="sm"
              icon="boxicons:file-detail-filled"
              label="Instructivo"
              newTab
            />
          )
        }
        {
          hasItemUrl ? (
            isExternal ? (
              <ActionButton
                href={itemUrl}
                icon="boxicons:arrow-up-right-square-filled"
                ariaLabel={`Acceder a enlace de ${title}`}
                label="Acceder"
                size="sm"
                newTab
                class="rounded-lg transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              />
            ) : (
              <ActionButton
                href={itemUrl}
                color="btn-secondary"
                size="sm"
                icon="boxicons:arrow-to-bottom-stroke"
                label="Descargar"
                download
              />
            )
          ) : (
            <ActionButton
              variant="ghost"
              size="sm"
              icon="boxicons:calendar-filled"
              label="Pendiente"
              disabled
              tabindex="-1"
            />
          )
        }
      </div>
    </div>
  </div>
</article>

<script>
  import { fetchRevealedCredential, copySecretToClipboard } from "@lib/credentialRevealClient";
  import { showToast } from "@lib/toastClient";

  const initAppPasswordHandlers = () => {
    // 1. Toggle visibility con carga bajo demanda
    document.querySelectorAll("[data-toggle-password]").forEach((btn) => {
      if (btn.getAttribute("data-listener-added") === "true") return;
      btn.setAttribute("data-listener-added", "true");

      btn.addEventListener("click", async () => {
        const row = btn.closest<HTMLElement>("[data-credential-row]");
        if (!row) return;

        const input = row.querySelector<HTMLInputElement>("[data-password-input]");
        const showIcon = row.querySelector<HTMLElement>("[data-show-icon]");
        const hideIcon = row.querySelector<HTMLElement>("[data-hide-icon]");
        if (!input) return;

        if (input.type === "text") {
          input.type = "password";
          showIcon?.classList.remove("hidden");
          hideIcon?.classList.add("hidden");
          return;
        }

        if (!input.value) {
          const entityType = row.dataset.entityType as "resource_link" | "application";
          const entityId = Number(row.dataset.entityId);
          const metaIndex = row.dataset.metaIndex !== undefined ? Number(row.dataset.metaIndex) : undefined;
          btn.setAttribute("disabled", "true");
          const secret = await fetchRevealedCredential({ entityType, entityId, metaIndex });
          btn.removeAttribute("disabled");
          if (secret === null) return;
          input.value = secret;
        }

        input.type = "text";
        showIcon?.classList.add("hidden");
        hideIcon?.classList.remove("hidden");
      });
    });

    // 2. Copiar credencial con carga bajo demanda
    document.querySelectorAll("[data-copy-credential]").forEach((btn) => {
      if (btn.getAttribute("data-copy-listener-added") === "true") return;
      btn.setAttribute("data-copy-listener-added", "true");

      btn.addEventListener("click", async () => {
        const row = btn.closest<HTMLElement>("[data-credential-row]");
        if (!row) return;

        const input = row.querySelector<HTMLInputElement>("[data-password-input]");
        const defaultIcon = btn.querySelector<HTMLElement>("[data-copy-icon-default]");
        const successIcon = btn.querySelector<HTMLElement>("[data-copy-icon-success]");
        if (!input) return;

        let secret = input.value;
        if (!secret) {
          const entityType = row.dataset.entityType as "resource_link" | "application";
          const entityId = Number(row.dataset.entityId);
          const metaIndex = row.dataset.metaIndex !== undefined ? Number(row.dataset.metaIndex) : undefined;
          btn.setAttribute("disabled", "true");
          const fetched = await fetchRevealedCredential({ entityType, entityId, metaIndex });
          btn.removeAttribute("disabled");
          if (fetched === null) return;
          secret = fetched;
          input.value = fetched;
        }

        const copied = await copySecretToClipboard(secret);
        if (copied) {
          defaultIcon?.classList.add("hidden");
          successIcon?.classList.remove("hidden");
          showToast("Credencial copiada al portapapeles", "alert-success");
          setTimeout(() => {
            defaultIcon?.classList.remove("hidden");
            successIcon?.classList.add("hidden");
          }, 1800);
        }
      });
    });
  };

  initAppPasswordHandlers();
  document.addEventListener("astro:page-load", initAppPasswordHandlers);
</script>
