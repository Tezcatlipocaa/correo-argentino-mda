---
import { Icon } from "astro-icon/components";
import Modal from "@components/ui/Modal.astro";
import FormField from "@components/ui/forms/FormField.astro";
import FormTextarea from "@components/ui/forms/FormTextarea.astro";
import type { AuditParameter } from "@/types/quality";
import { getCleanBase } from "@lib/baseUrl";
import { getApprovedTitlesList } from "@/lib/qualityTitleMatcher";

interface Props {
  allParameters: AuditParameter[];
  selectedMonth: string;
}

const { allParameters, selectedMonth } = Astro.props;
const cleanBase = getCleanBase();
const approvedTitles = await getApprovedTitlesList();

// Group parameters by channel and section
const wiseCallParams = allParameters.filter(
  (p) => p.channel === "wise_call" || !p.channel,
);
const wiseEmailParams = allParameters.filter((p) => p.channel === "wise_email");
const invgateAgParams = allParameters.filter(
  (p) => p.channel === "invgate_ticket",
);
---

<Modal
  id="audit-modal"
  size="5xl"
  titleClass="font-bold text-base sm:text-lg tracking-tight"
  zIndex="z-200"
  class="w-11/12 max-w-6xl"
>
  <Fragment slot="content">
    <div
      id="audit-modal-container"
      data-approved-titles={JSON.stringify(approvedTitles)}
    >
      <!-- Modal Header: Título y Selector de Canales alineados -->
      <div
        class="border-base-200 mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b pb-3"
      >
        <h3
          id="modal-title"
          class="text-base-content flex items-center gap-2.5 text-base sm:text-lg font-bold tracking-tight m-0 leading-none"
        >
          <Icon name="boxicons:task" class="text-primary shrink-0" size={22} />
          <span>Auditoría de calidad</span>
        </h3>

        <!-- Selector de Canales: Segmented Tabs unificadas -->
        <div class="join bg-base-200/60 p-0.5 rounded-xl border border-base-200 shadow-2xs self-start sm:self-auto" id="channel-selector-join">
          <button
            type="button"
            class="btn btn-xs sm:btn-sm join-item channel-btn btn-active bg-base-100 text-secondary font-bold shadow-2xs transition-all border-transparent px-3"
            data-channel="wise_call"
          >
            <Icon name="boxicons:phone-ring" size={15} />
            <span>Llamada Wise</span>
          </button>
          <button
            type="button"
            class="btn btn-xs sm:btn-sm join-item channel-btn font-medium text-base-content/70 hover:text-secondary hover:bg-base-100/50 transition-all border-transparent px-3"
            data-channel="wise_email"
          >
            <Icon name="boxicons:envelope" size={15} />
            <span>Mail Wise</span>
          </button>
          <button
            type="button"
            class="btn btn-xs sm:btn-sm join-item channel-btn font-medium text-base-content/70 hover:text-secondary hover:bg-base-100/50 transition-all border-transparent px-3"
            data-channel="invgate_ticket"
          >
            <Icon name="boxicons:handshake" size={15} />
            <span>Autogestión</span>
          </button>
        </div>
      </div>

      <form id="audit-form" method="POST">
        <input type="hidden" name="id" id="form-audit-id" />
        <input type="hidden" name="agentId" id="form-agent-id" />
        <input
          type="hidden"
          name="month"
          id="form-month"
          value={selectedMonth}
        />
        <input
          type="hidden"
          name="channelType"
          id="form-channel-type"
          value="wise_call"
        />
        <input type="hidden" name="recordingUrl" id="form-recording-url" />

        <!-- Grid Principal de 2 Columnas: Contexto (Izq) vs Evaluación (Der) -->
        <div id="modal-grid-container" class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          
          <!-- COLUMNA IZQUIERDA: CONTEXTO (Búsqueda, Audio, Datos Atención, Ticket Viewer) -->
          <div id="modal-grid-context" class="lg:col-span-5 space-y-3.5">

            <!-- Buscador Unificado con Selector de Servicio (Tabs) -->
            <div
              id="unified-search-card"
              class="bg-base-100 border border-base-200 rounded-xl p-3 shadow-2xs space-y-2.5"
            >
              <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <!-- Selector de Servicio (Tabs: Wise CX / InvGate) -->
                <div class="flex items-center gap-1.5 shrink-0">
                  <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider hidden sm:inline">Buscar:</span>
                  <div
                    class="join bg-base-200/60 p-0.5 rounded-lg border border-base-200"
                    id="search-service-tabs"
                  >
                    <button
                      type="button"
                      id="tab-search-wise"
                      class="join-item btn btn-xs btn-ghost gap-1 font-bold transition-all text-base-content bg-base-100 shadow-2xs"
                      data-search-target="wise"
                    >
                      <Icon name="boxicons:phone" size={14} class="text-violet-500" />
                      <span>Wise CX</span>
                    </button>
                    <button
                      type="button"
                      id="tab-search-invgate"
                      class="join-item btn btn-xs btn-ghost gap-1 font-medium text-base-content/60 transition-all hover:text-base-content"
                      data-search-target="invgate"
                    >
                      <Icon name="boxicons:receipt" size={14} class="text-secondary" />
                      <span>InvGate</span>
                    </button>
                  </div>
                </div>

                <!-- Barra de Búsqueda Wise CX -->
                <div
                  id="wise-search-container"
                  class="flex-1 flex items-center gap-1.5 transition-all"
                >
                  <div class="relative flex-1">
                    <input
                      type="text"
                      id="wise-search-id"
                      placeholder="Caso Wise (ej: 534787)..."
                      class="input input-xs bg-base-200/30 w-full pl-7 font-mono text-xs font-semibold border-base-200 focus:border-violet-500 focus:outline-hidden"
                    />
                    <div class="text-violet-500 absolute top-1.5 left-2">
                      <Icon name="boxicons:phone" size={13} />
                    </div>
                  </div>
                  <button
                    type="button"
                    id="btn-fetch-wise-api"
                    class="btn btn-xs btn-neutral btn-square shrink-0 transition-all hover:scale-98 active:scale-95 shadow-2xs"
                    title="Buscar"
                    aria-label="Buscar"
                  >
                    <Icon name="boxicons:search" size={14} />
                  </button>
                </div>

                <!-- Barra de Búsqueda InvGate -->
                <div
                  id="invgate-search-container"
                  class="flex-1 flex items-center gap-1.5 hidden transition-all"
                >
                  <div class="relative flex-1">
                    <input
                      type="text"
                      id="invgate-search-id"
                      placeholder="Ticket InvGate (ej: 88442)..."
                      class="input input-xs bg-base-200/30 w-full pl-7 font-mono text-xs font-semibold border-base-200 focus:border-secondary focus:outline-hidden"
                    />
                    <div class="text-secondary absolute top-1.5 left-2">
                      <Icon name="boxicons:receipt" size={13} />
                    </div>
                  </div>
                  <button
                    type="button"
                    id="btn-fetch-invgate-api"
                    class="btn btn-xs btn-neutral btn-square shrink-0 transition-all hover:scale-98 active:scale-95 shadow-2xs"
                    title="Buscar"
                    aria-label="Buscar"
                  >
                    <Icon name="boxicons:search" size={14} />
                    <span id="btn-fetch-invgate-label" class="sr-only">Buscar</span>
                  </button>
                </div>
              </div>

              <!-- Feedback Alerts -->
              <div
                id="wise-feedback-alert"
                class="hidden rounded-lg border p-2 text-xs font-medium transition-all"
              ></div>
              <div
                id="invgate-feedback-alert"
                class="hidden rounded-lg border p-2 text-xs font-medium transition-all"
              ></div>
            </div>

            <!-- Reproductor y Descarga de Grabación Wise CX -->
            <div
              id="tv-audio-container"
              class="bg-base-100 border border-primary/25 hidden rounded-xl p-3 shadow-2xs transition-all duration-200 space-y-2"
            >
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <div class="bg-primary/10 text-primary rounded-lg p-1.5 shrink-0">
                    <Icon name="boxicons:volume-full" size={18} />
                  </div>
                  <span class="text-xs font-bold text-base-content">
                    Grabación de la llamada
                  </span>
                </div>
                <span class="badge badge-xs badge-success font-semibold">Audio disponible</span>
              </div>
              <div class="flex flex-col sm:flex-row items-center gap-2">
                <audio
                  id="tv-audio-player"
                  controls
                  class="h-8 w-full rounded-md"
                  preload="metadata"
                ></audio>
                <a
                  id="tv-audio-download"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  download
                  class="btn btn-xs btn-neutral shrink-0 gap-1 font-semibold text-xs transition-all hover:scale-98 active:scale-95"
                  title="Descargar audio"
                >
                  <Icon name="boxicons:archive-arrow-down" size={14} />
                  <span>MP3</span>
                </a>
              </div>
            </div>

            <!-- Datos Básicos de la Atención -->
            <div
              class="bg-base-100 border border-base-200 p-3 rounded-xl shadow-2xs space-y-2.5"
            >
              <div class="flex items-center justify-between pb-1.5 border-b border-base-200">
                <span class="text-xs font-bold text-base-content flex items-center gap-1.5">
                  <Icon name="boxicons:file-detail" size={15} class="text-primary" />
                  <span>Datos de la atención</span>
                </span>
              </div>

              <div class="grid grid-cols-2 gap-2.5">
                <FormField
                  id="form-call-id"
                  name="callId"
                  label="Nro Caso / Llamada"
                  placeholder="Ej: 534787"
                  size="xs"
                  inputClass="font-mono font-semibold text-xs"
                />
                <FormField
                  id="form-ticket-id"
                  name="ticketId"
                  label="Nro Ticket InvGate"
                  placeholder="Ej: 88442"
                  size="xs"
                  inputClass="font-mono font-semibold text-xs"
                />
                <div class="col-span-2">
                  <FormField
                    id="form-date"
                    name="date"
                    label="Fecha de atención"
                    type="date"
                    required
                    size="xs"
                    inputClass="font-semibold text-xs"
                  />
                </div>

                <!-- Secondary Metadata -->
                <div id="meta-duration-container">
                  <FormField
                    id="form-duration"
                    name="duration"
                    label="Duración"
                    placeholder="02:15"
                    size="xs"
                    inputClass="font-mono font-semibold text-xs"
                  />
                </div>
                <div id="meta-ring-container">
                  <FormField
                    id="form-ring-time"
                    name="ringTime"
                    label="Tiempo ringueo"
                    placeholder="00:30"
                    size="xs"
                    inputClass="font-mono font-semibold text-xs"
                  />
                </div>
                <div id="meta-creation-container" class="hidden">
                  <FormField
                    id="form-creation-time"
                    name="creationTime"
                    label="Creación"
                    placeholder="YYYY-MM-DD HH:MM"
                    size="xs"
                    inputClass="font-mono font-semibold text-xs"
                  />
                </div>
                <div id="meta-take-container" class="hidden">
                  <FormField
                    id="form-take-time"
                    name="takeTime"
                    label="Toma / Lectura"
                    placeholder="YYYY-MM-DD HH:MM"
                    size="xs"
                    inputClass="font-mono font-semibold text-xs"
                  />
                </div>
                <div
                  id="meta-pas-container"
                  class="hidden col-span-2 flex items-center pt-1"
                >
                  <label class="label cursor-pointer gap-2 p-0 hover:opacity-85 transition-opacity">
                    <input
                      type="checkbox"
                      name="isPas"
                      id="form-is-pas"
                      class="checkbox checkbox-xs checkbox-primary"
                    />
                    <span class="label-text text-xs font-bold">Es caso PAS</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Live Ticket Viewer Panel (InvGate) -->
            <div
              id="ticket-viewer-panel"
              class="bg-base-100 border border-base-200 rounded-xl p-3 shadow-2xs"
            >
              <div
                class="flex cursor-pointer items-center justify-between select-none"
                id="ticket-viewer-header"
              >
                <div class="flex items-center gap-2">
                  <Icon name="boxicons:receipt" size={17} class="text-secondary" />
                  <span class="text-base-content text-xs font-bold">
                    Detalle del ticket InvGate
                  </span>
                  <span
                    id="ticket-viewer-badge"
                    class="badge badge-xs badge-ghost font-medium"
                    >Sin ticket cargado</span
                  >
                </div>
                <div
                  class="text-base-content/60 flex items-center gap-1 text-xs font-medium"
                >
                  <span id="ticket-viewer-toggle-text">Mostrar</span>
                  <Icon
                    name="boxicons:chevron-down"
                    size={16}
                    id="ticket-viewer-chevron"
                    class="transition-transform duration-200"
                  />
                </div>
              </div>

              <div id="ticket-viewer-content" class="mt-2.5 hidden space-y-2.5">
                <!-- Título & Validación asistida -->
                <div class="bg-base-200/40 border border-base-200 rounded-lg p-2.5">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div class="min-w-0 flex-1">
                      <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider block">
                        Título en InvGate
                      </span>
                      <p
                        id="tv-title"
                        class="text-base-content text-xs font-semibold leading-relaxed break-words mt-0.5 font-sans"
                      >
                        -
                      </p>
                    </div>
                    <div id="tv-title-match-badge" class="shrink-0 flex items-center"></div>
                  </div>
                </div>

                <!-- Grid de Metadatos: Tipografía Sans-Serif Limpia -->
                <div class="grid grid-cols-2 gap-2">
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:categories" size={13} class="text-primary/70" />
                      Categoría
                    </span>
                    <p id="tv-category" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:flag" size={13} class="text-warning/70" />
                      Prioridad
                    </span>
                    <p id="tv-priority" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:info-circle" size={13} class="text-info/70" />
                      Estado
                    </span>
                    <p id="tv-status" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:user" size={13} class="text-secondary/70" />
                      Solicitante
                    </span>
                    <p id="tv-creator" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:pin" size={13} class="text-primary/70" />
                      Creado por
                    </span>
                    <p id="tv-created-by" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:help-circle" size={13} class="text-info/70" />
                      Mesa de Ayuda
                    </span>
                    <p id="tv-helpdesk" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <div class="flex items-center justify-between gap-1">
                      <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                        <Icon name="boxicons:broadcast" size={13} class="text-primary/70" />
                        Origen
                      </span>
                      <div id="tv-source-match-badge" class="shrink-0 flex items-center"></div>
                    </div>
                    <p id="tv-source" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                </div>


                <!-- Descripción / Evidencia -->
                <div class="bg-base-200/40 border border-base-200 rounded-lg p-2.5">
                  <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider">
                    Descripción / Evidencia
                  </span>
                  <div
                    id="tv-description"
                    class="text-base-content/85 mt-1 max-h-36 overflow-y-auto font-sans text-xs leading-relaxed whitespace-pre-wrap scrollbar-thin"
                  >
                    -
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- COLUMNA DERECHA: EVALUACIÓN (Score en Tiempo Real, Criterios, Notas) -->
          <div id="modal-grid-evaluation" class="lg:col-span-7 space-y-3.5">
            
            <!-- Realtime Score Preview Card -->
            <div
              class="bg-base-100 border border-base-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-xl p-3.5 shadow-2xs"
            >
              <div class="space-y-0.5">
                <span class="text-base-content text-xs font-bold flex items-center gap-1.5">
                  <Icon name="boxicons:bar-chart-big-filled" size={16} class="text-primary" />
                  Score en tiempo real
                </span>
                <p class="text-base-content/50 text-xxs">
                  Cada criterio no cumplido resta porcentaje sobre la base 100%.
                </p>
              </div>

              <div class="flex items-center gap-4 sm:gap-5 self-end sm:self-auto">
                <!-- Sección 1 -->
                <div class="border-base-200 border-r pr-3.5 text-center">
                  <div class="text-base-content/50 text-xxs font-bold uppercase tracking-wider">
                    Sección 1
                  </div>
                  <div id="preview-s1" class="text-base-content/90 text-sm font-bold mt-0.5 font-mono">
                    100%
                  </div>
                </div>

                <!-- Sección 2 -->
                <div
                  id="preview-s2-block"
                  class="border-base-200 border-r pr-3.5 text-center transition-opacity"
                >
                  <div class="text-base-content/50 text-xxs font-bold uppercase tracking-wider">
                    Sección 2
                  </div>
                  <div id="preview-s2" class="text-base-content/90 text-sm font-bold mt-0.5 font-mono">
                    100%
                  </div>
                </div>

                <!-- TOTAL FINAL -->
                <div class="text-center pl-1">
                  <div class="text-base-content/60 text-xxs font-black uppercase tracking-wider">
                    Total final
                  </div>
                  <div id="preview-total" class="text-success text-2xl sm:text-3xl font-black font-mono tracking-tight leading-none mt-0.5">
                    100%
                  </div>
                </div>
              </div>
            </div>

            <!-- Checklist: Canal 1 - Llamadas Wise -->
            <div
              id="channel-checklist-wise_call"
              class="channel-checklist space-y-3"
            >
              <!-- S1: Gestión de la llamada -->
              <div class="bg-base-100 border border-base-200 rounded-xl p-3.5 shadow-2xs">
                <div class="border-base-200 mb-2.5 flex items-center justify-between border-b pb-2 text-xs font-bold text-base-content">
                  <span>1. Gestión de la llamada / atención</span>
                  <span class="text-base-content/40 text-xxs font-semibold">Base: 100%</span>
                </div>
                <div class="space-y-0.5 divide-y divide-base-200/60 max-h-[380px] overflow-y-auto pr-1.5 scrollbar-thin">
                  {
                    wiseCallParams
                      .filter(
                        (p) =>
                          p.section === "items" ||
                          p.category === "Items" ||
                          p.category === "Interacción con Usuario",
                      )
                      .map((p) => (
                        <div class="checklist-item py-2 px-1 transition-colors">
                          <div class="flex items-start justify-between gap-2.5">
                            <label class="label cursor-pointer justify-start gap-2.5 p-0 items-start flex-1 min-w-0">
                              <input
                                type="checkbox"
                                name={p.code}
                                class="checkbox checkbox-primary checkbox-xs sm:checkbox-sm audit-checkbox mt-0.5 shrink-0"
                                data-weight={p.weight ?? 0}
                                data-section="items"
                                checked
                              />
                              <span class="label-text text-xs leading-snug text-base-content font-medium">
                                {p.name}
                                {p.weight ? (
                                  <span class="text-error font-semibold ml-1 text-xs">
                                    (-{p.weight}%)
                                  </span>
                                ) : (
                                  <span class="ml-1 text-xs opacity-50 font-normal">(n/a)</span>
                                )}
                              </span>
                            </label>
                            <div class="flex items-center gap-1 shrink-0">
                              <span
                                class="badge badge-warning badge-xs rule-auto-badge hidden font-semibold text-3xs"
                                data-rule-badge={p.code}
                              >
                                Regla
                              </span>
                              <button
                                type="button"
                                class="btn btn-ghost btn-2xs text-base-content/40 hover:text-secondary transition-colors toggle-obs-btn"
                                data-action="toggle-obs"
                                title="Agregar nota"
                              >
                                <Icon name="boxicons:message" size={13} />
                                <span class="text-3xs hidden sm:inline">Nota</span>
                              </button>
                            </div>
                          </div>
                          <div class="criteria-obs-wrapper hidden mt-2 pl-6">
                            <input
                              type="text"
                              name={`${p.code}_comment`}
                              placeholder="Motivo de penalización u observación..."
                              class="input input-xs bg-base-200/30 border border-base-200 focus:border-primary text-xs w-full placeholder:text-base-content/40 rounded-lg"
                            />
                          </div>
                        </div>
                      ))
                  }
                </div>
              </div>

              <!-- S2: Ticket (Condicional) -->
              <div class="bg-base-100 border border-base-200 rounded-xl p-3.5 shadow-2xs">
                <div class="border-base-200 mb-2.5 flex items-center justify-between border-b pb-2 text-xs font-bold text-base-content">
                  <span>2. Ticket (Gestión y registro)</span>
                  <label class="label cursor-pointer gap-2 p-0 hover:opacity-85 transition-opacity">
                    <span class="label-text text-xxs font-bold uppercase tracking-wider text-base-content/70">
                      ¿Se generó ticket?
                    </span>
                    <input
                      type="checkbox"
                      name="callGeneratedTicket"
                      id="toggle-call-generated-ticket"
                      class="toggle toggle-primary toggle-xs"
                      checked
                    />
                  </label>
                </div>
                <div
                  id="wise-call-ticket-block"
                  class="space-y-0.5 divide-y divide-base-200/60 max-h-[380px] overflow-y-auto pr-1.5 scrollbar-thin"
                >
                  {
                    wiseCallParams
                      .filter(
                        (p) =>
                          p.section === "ticket" ||
                          p.category === "Ticket" ||
                          p.category === "Gestión del Ticket",
                      )
                      .map((p) => (
                        <div class="checklist-item py-2 px-1 transition-colors">
