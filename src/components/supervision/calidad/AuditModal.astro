    // Feedback con auto-dismiss
    let wiseFeedbackTimeout: any = null;
    let invgateFeedbackTimeout: any = null;

    function showFeedbackMessage(
      el: HTMLElement | null,
      content: string,
      type: "success" | "error" | "warning",
      isWise: boolean,
    ) {
      if (!el) return;
      if (isWise && wiseFeedbackTimeout) clearTimeout(wiseFeedbackTimeout);
      if (!isWise && invgateFeedbackTimeout) clearTimeout(invgateFeedbackTimeout);

      el.innerHTML = content;
      const typeClasses =
        type === "success"
          ? "border-success/30 bg-success/10 text-success"
          : type === "warning"
            ? "border-warning/30 bg-warning/10 text-warning"
            : "border-error/30 bg-error/10 text-error";

      el.className = `mt-2 flex items-center gap-2 rounded-lg border px-2.5 py-1.5 text-xs font-semibold shadow-2xs transition-all duration-200 ${typeClasses}`;
      el.classList.remove("hidden");

      const timeout = setTimeout(() => {
        el.classList.add("hidden");
      }, 4500);

      if (isWise) wiseFeedbackTimeout = timeout;
      else invgateFeedbackTimeout = timeout;
    }

    // 1. Buscador Wise CX
    if (btnFetchWise && wiseSearchInput) {
      wiseSearchInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          btnFetchWise.click();
        }
      });

      btnFetchWise.addEventListener("click", async () => {
        const id = wiseSearchInput.value.trim();
        if (!id) {
          showFeedbackMessage(
            wiseFeedbackAlert,
            "Ingrese un número o ID de caso Wise.",
            "warning",
            true,
          );
          return;
        }

        const channel = formChannelType?.value || "wise_call";
        const originalHtml = btnFetchWise.innerHTML;
        btnFetchWise.disabled = true;
        btnFetchWise.innerHTML =
          '<span class="loading loading-spinner loading-xs"></span>';
        if (wiseFeedbackAlert) wiseFeedbackAlert.classList.add("hidden");

        try {
          const res = await fetch(
            `${cleanBase}api/calidad/fetch-metadata?channel=${channel}&id=${encodeURIComponent(id)}&source=wise`,
          );
          const json = await res.json();

          if (!res.ok || !json.data) {
            showFeedbackMessage(
              wiseFeedbackAlert,
              json.error || "No se encontró el caso en Wise CX.",
              "error",
              true,
            );
            return;
          }

          const d = json.data;

          // Auto-conmutación de canal si se detectó un tipo distinto al seleccionado
          let channelSwitched = false;
          if (
            d.detectedChannel &&
            formChannelType &&
            formChannelType.value !== d.detectedChannel
          ) {
            const targetBtn = document.querySelector(
              `.channel-btn[data-channel="${d.detectedChannel}"]`,
            ) as HTMLButtonElement | null;
            if (targetBtn) {
              targetBtn.click();
              channelSwitched = true;
            }
          }

          const formCallId = document.getElementById(
            "form-call-id",
          ) as HTMLInputElement;
          const formTicketId = document.getElementById(
            "form-ticket-id",
          ) as HTMLInputElement;
          const formDuration = document.getElementById(
            "form-duration",
          ) as HTMLInputElement;
          const formDate = document.getElementById(
            "form-date",
          ) as HTMLInputElement;
          const formRing = document.getElementById(
            "form-ring-time",
          ) as HTMLInputElement;
          const formCreation = document.getElementById(
            "form-creation-time",
          ) as HTMLInputElement;
          const formTake = document.getElementById(
            "form-take-time",
          ) as HTMLInputElement;

          if (formCallId && d.caseNumber) formCallId.value = d.caseNumber;
          if (formDuration && d.duration) formDuration.value = d.duration;
          if (formDate && d.date) formDate.value = d.date;
          if (formRing && d.ringTime) formRing.value = d.ringTime;
          if (formCreation && d.creationTime)
            formCreation.value = d.creationTime;
          if (formTake && d.takeTime) formTake.value = d.takeTime;
          if (formRecordingUrl && d.recordingUrl)
            formRecordingUrl.value = d.recordingUrl;

          if (formTicketId && !formTicketId.value && d.rawDetails?.incidentId) {
            formTicketId.value = d.rawDetails.incidentId.toString();
          }

          // Reproductor de audio independiente
          if (d.recordingUrl && tvAudioContainer && tvAudioPlayer && tvAudioDownload) {
            const caseId = d.caseNumber || "llamada";
            const downloadUrl = `${cleanBase}api/calidad/download-audio?url=${encodeURIComponent(d.recordingUrl)}&filename=grabacion-caso-${encodeURIComponent(caseId)}.mp3&download=1`;
            tvAudioPlayer.src = d.recordingUrl;
            tvAudioPlayer.load();
            tvAudioDownload.href = downloadUrl;
            tvAudioContainer.classList.remove("hidden");
          } else if (tvAudioContainer) {
            tvAudioContainer.classList.add("hidden");
            if (tvAudioPlayer) {
              tvAudioPlayer.pause();
              tvAudioPlayer.src = "";
            }
          }

          const channelTag =
            d.detectedChannel === "wise_email"
              ? "Mail Wise"
              : d.detectedChannel === "wise_call"
                ? "Llamada Wise"
                : "";

          const successMsg = channelSwitched
            ? `✓ Caso detectado como ${channelTag} (canal cambiado): ${d.operator || ""} ${d.duration ? `(${d.duration})` : ""}`
            : `✓ Caso obtenido [${channelTag}]: ${d.operator || ""} ${d.duration ? `(${d.duration})` : ""}`;

          showFeedbackMessage(
            wiseFeedbackAlert,
            successMsg,
            channelSwitched ? "info" : "success",
            true,
          );
        } catch (err) {
          showFeedbackMessage(
            wiseFeedbackAlert,
            "Error de red al consultar Wise CX.",
            "error",
            true,
