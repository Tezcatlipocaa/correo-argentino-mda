---
import { Icon } from "astro-icon/components";
import Modal from "@components/ui/Modal.astro";
import FormField from "@components/ui/forms/FormField.astro";
import FormTextarea from "@components/ui/forms/FormTextarea.astro";
import type { AuditParameter } from "@/types/quality";
import { getCleanBase } from "@lib/baseUrl";
import { getApprovedTitlesList } from "@/lib/qualityTitleMatcher";

interface Props {
  allParameters: AuditParameter[];
  selectedMonth: string;
}

const { allParameters, selectedMonth } = Astro.props;
const cleanBase = getCleanBase();
const approvedTitles = await getApprovedTitlesList();

// Group parameters by channel and section
const wiseCallParams = allParameters.filter(
  (p) => p.channel === "wise_call" || !p.channel,
);
const wiseEmailParams = allParameters.filter((p) => p.channel === "wise_email");
const invgateAgParams = allParameters.filter(
  (p) => p.channel === "invgate_ticket",
);
---

<Modal
  id="audit-modal"
  size="3xl"
  titleClass="font-black text-lg uppercase tracking-tight"
  zIndex="z-200"
  class="w-11/12 max-w-5xl"
>
  <Fragment slot="content">
    <div
      id="audit-modal-container"
      data-approved-titles={JSON.stringify(approvedTitles)}
    >
      <!-- Modal Header: Título y Selector de Canales alineados -->
      <div
        class="border-base-300 mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b pb-3.5"
      >
        <h3
          id="modal-title"
          class="text-base-content flex items-center gap-2.5 text-base sm:text-lg font-black tracking-tight uppercase m-0 leading-none"
        >
          <Icon name="boxicons:task" class="text-primary shrink-0" size={22} />
          <span>Auditoría de Calidad</span>
        </h3>

        <!-- Selector de Canales: Segmented Tabs unificadas -->
        <div class="join bg-base-200/80 p-0.5 rounded-xl border border-base-300/70 shadow-2xs self-start sm:self-auto" id="channel-selector-join">
          <button
            type="button"
            class="btn btn-xs sm:btn-sm join-item channel-btn btn-active bg-base-100 text-primary font-bold shadow-2xs transition-all border-transparent px-3"
            data-channel="wise_call"
          >
            <Icon name="boxicons:phone-ring" size={15} />
            <span>Llamada Wise</span>
          </button>
          <button
            type="button"
            class="btn btn-xs sm:btn-sm join-item channel-btn font-semibold text-base-content/70 hover:text-base-content hover:bg-base-100/50 transition-all border-transparent px-3"
            data-channel="wise_email"
          >
            <Icon name="boxicons:envelope" size={15} />
            <span>Mail Wise</span>
          </button>
          <button
            type="button"
            class="btn btn-xs sm:btn-sm join-item channel-btn font-semibold text-base-content/70 hover:text-base-content hover:bg-base-100/50 transition-all border-transparent px-3"
            data-channel="invgate_ticket"
          >
            <Icon name="boxicons:handshake" size={15} />
            <span>Autogestión</span>
          </button>
        </div>
      </div>

      <!-- Buscador Unificado con Selector de Servicio (Tabs) -->
      <div
        id="unified-search-card"
        class="bg-base-200/40 border border-base-300/80 rounded-2xl p-3 mb-4 shadow-2xs space-y-2.5"
      >
        <div class="flex flex-col sm:flex-row sm:items-center gap-2.5">
          <!-- Selector de Servicio (Tabs: Wise CX / InvGate) -->
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-xxs text-base-content/50 font-extrabold uppercase tracking-wider hidden sm:inline">Buscar:</span>
            <div
              class="join bg-base-100 p-0.5 rounded-xl border border-base-300/70"
              id="search-service-tabs"
            >
              <button
                type="button"
                id="tab-search-wise"
                class="join-item btn btn-xs sm:btn-sm btn-ghost gap-1.5 font-bold transition-all text-primary bg-base-200/90 shadow-2xs"
                data-search-target="wise"
              >
                <Icon name="boxicons:phone" size={15} class="text-primary" />
                <span>Wise CX</span>
              </button>
              <button
                type="button"
                id="tab-search-invgate"
                class="join-item btn btn-xs sm:btn-sm btn-ghost gap-1.5 font-semibold text-base-content/70 transition-all hover:text-base-content"
                data-search-target="invgate"
              >
                <Icon name="boxicons:receipt" size={15} class="text-secondary" />
                <span>InvGate</span>
              </button>
            </div>
          </div>

          <!-- Barra de Búsqueda Wise CX (Activa por defecto en llamadas/mails) -->
          <div
            id="wise-search-container"
            class="flex-1 flex flex-col sm:flex-row sm:items-center gap-2 transition-all"
          >
            <div class="relative flex-1">
              <input
                type="text"
                id="wise-search-id"
                placeholder="Buscar Caso Wise CX (ej: 534787)..."
                class="input input-sm bg-base-100 w-full pl-8 font-mono text-xs font-semibold border-base-300/80 focus:border-primary focus:outline-hidden"
              />
              <div class="text-base-content/40 absolute top-2 left-2.5">
                <Icon name="boxicons:phone" size={15} />
              </div>
            </div>
            <button
              type="button"
              id="btn-fetch-wise-api"
              class="btn btn-sm btn-primary text-xs font-bold uppercase gap-1.5 shrink-0 px-3 transition-all hover:scale-98 active:scale-95 shadow-2xs"
            >
              <Icon name="boxicons:server" size={15} />
              <span>Buscar en Wise</span>
            </button>
          </div>

          <!-- Barra de Búsqueda InvGate (Alternativa o exclusiva en Autogestión) -->
          <div
            id="invgate-search-container"
            class="flex-1 flex flex-col sm:flex-row sm:items-center gap-2 hidden transition-all"
          >
            <div class="relative flex-1">
              <input
                type="text"
                id="invgate-search-id"
                placeholder="Buscar Ticket en InvGate (ej: 88442)..."
                class="input input-sm bg-base-100 w-full pl-8 font-mono text-xs font-semibold border-base-300/80 focus:border-secondary focus:outline-hidden"
              />
              <div class="text-base-content/40 absolute top-2 left-2.5">
                <Icon name="boxicons:receipt" size={15} />
              </div>
            </div>
            <button
              type="button"
              id="btn-fetch-invgate-api"
              class="btn btn-sm btn-secondary text-xs font-bold uppercase gap-1.5 shrink-0 px-3 transition-all hover:scale-98 active:scale-95 shadow-2xs"
            >
              <Icon name="boxicons:search-alt" size={15} />
              <span id="btn-fetch-invgate-label">Buscar Ticket InvGate</span>
            </button>
          </div>
        </div>

        <!-- Feedback Alerts -->
        <div
          id="wise-feedback-alert"
          class="mt-2 hidden rounded-xl border p-2 text-xs font-medium transition-all"
        ></div>
        <div
          id="invgate-feedback-alert"
          class="mt-2 hidden rounded-xl border p-2 text-xs font-medium transition-all"
        ></div>
      </div>

      <!-- Reproductor y Descarga de Grabación Wise CX (Independiente) -->
      <div
        id="tv-audio-container"
        class="bg-base-200/40 border border-primary/25 hidden rounded-2xl p-3.5 mb-4 shadow-2xs transition-all duration-200"
      >
        <div
          class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center"
        >
          <div class="flex items-center gap-2.5">
            <div class="bg-primary/10 text-primary rounded-xl p-2 shrink-0">
              <Icon name="boxicons:volume-full" size={22} />
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span
                  class="text-xs font-black tracking-wider uppercase text-base-content/90"
                >
                  Grabación de la Llamada Wise CX
                </span>
                <span class="badge badge-xs badge-success font-bold"
                  >Audio Disponible</span
                >
              </div>
              <p
                id="tv-audio-label"
                class="text-base-content/60 font-mono text-xxs font-medium mt-0.5"
              >
                Audio disponible
              </p>
            </div>
          </div>
          <div class="flex w-full flex-wrap items-center gap-2 sm:w-auto">
            <audio
              id="tv-audio-player"
              controls
              class="h-9 w-full max-w-full rounded-lg sm:w-64"
              preload="metadata"></audio>
            <a
              id="tv-audio-download"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              download
              class="btn btn-sm btn-outline btn-primary shrink-0 gap-1.5 text-xs font-bold transition-all hover:scale-98 active:scale-95"
            >
              <Icon name="boxicons:save" size={16} />
              <span>Descargar MP3</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Live Ticket Viewer Panel (InvGate) -->
      <div
        id="ticket-viewer-panel"
        class="bg-base-200/30 border-base-300 mb-4 rounded-2xl border p-3"
      >
        <div
          class="flex cursor-pointer items-center justify-between select-none"
          id="ticket-viewer-header"
        >
          <div class="flex items-center gap-2">
            <Icon name="boxicons:receipt" size={18} class="text-secondary" />
            <span
              class="text-base-content/80 text-xs font-black tracking-wider uppercase"
            >
              Detalle del Ticket InvGate
            </span>
            <span
              id="ticket-viewer-badge"
              class="badge badge-xs badge-ghost font-bold"
              >Sin ticket cargado</span
            >
          </div>
          <div
            class="text-base-content/60 flex items-center gap-1 text-xs font-semibold"
          >
            <span id="ticket-viewer-toggle-text">Mostrar</span>
            <Icon
              name="boxicons:chevron-down"
              size={16}
              id="ticket-viewer-chevron"
              class="transition-transform duration-200"
            />
          </div>
        </div>

        <div id="ticket-viewer-content" class="mt-3 hidden space-y-2.5">
          <!-- Título & Validación asistida -->
          <div
            class="bg-base-100/90 border border-base-300/70 rounded-xl p-3 shadow-2xs"
          >
            <div
              class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5"
            >
              <div class="min-w-0 flex-1">
                <span
                  class="text-xxs text-base-content/50 font-extrabold tracking-wider uppercase block"
                  >Título en InvGate</span
                >
                <p
                  id="tv-title"
                  class="text-base-content text-xs font-semibold leading-relaxed break-words mt-0.5"
                >
                  -
                </p>
              </div>
              <div id="tv-title-match-badge" class="shrink-0 flex items-center">
                <!-- Badge de validación automática -->
              </div>
            </div>
          </div>

          <!-- Grid de Metadatos: Categoría, Prioridad, Estado, Solicitante -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <div
              class="bg-base-100/90 border border-base-300/60 rounded-xl p-2.5 shadow-2xs flex flex-col justify-between"
            >
              <span
                class="text-xxs text-base-content/50 font-extrabold tracking-wider uppercase flex items-center gap-1"
              >
                <Icon name="boxicons:categories" size={13} class="text-primary/70" />
                Categoría
              </span>
              <p
                id="tv-category"
                class="text-base-content truncate font-mono text-xs font-bold mt-1"
              >
                -
              </p>
            </div>
            <div
              class="bg-base-100/90 border border-base-300/60 rounded-xl p-2.5 shadow-2xs flex flex-col justify-between"
            >
              <span
                class="text-xxs text-base-content/50 font-extrabold tracking-wider uppercase flex items-center gap-1"
              >
                <Icon name="boxicons:flag" size={13} class="text-warning/70" />
                Prioridad
              </span>
              <p
                id="tv-priority"
                class="text-base-content truncate font-mono text-xs font-bold mt-1"
              >
                -
              </p>
            </div>
            <div
              class="bg-base-100/90 border border-base-300/60 rounded-xl p-2.5 shadow-2xs flex flex-col justify-between"
            >
              <span
                class="text-xxs text-base-content/50 font-extrabold tracking-wider uppercase flex items-center gap-1"
              >
                <Icon name="boxicons:info-circle" size={13} class="text-info/70" />
                Estado
              </span>
              <p
                id="tv-status"
                class="text-base-content truncate font-mono text-xs font-bold mt-1"
              >
                -
              </p>
            </div>
            <div
              class="bg-base-100/90 border border-base-300/60 rounded-xl p-2.5 shadow-2xs flex flex-col justify-between"
            >
              <span
                class="text-xxs text-base-content/50 font-extrabold tracking-wider uppercase flex items-center gap-1"
              >
                <Icon name="boxicons:user" size={13} class="text-secondary/70" />
                Solicitante
              </span>
              <p
                id="tv-creator"
                class="text-base-content truncate font-mono text-xs font-bold mt-1"
              >
                -
              </p>
            </div>
          </div>

          <!-- Descripción / Evidencia -->
          <div
            class="bg-base-100 border-base-300/50 rounded-xl border p-3 shadow-xs"
          >
            <span
              class="text-xxs text-base-content/50 font-bold tracking-wider uppercase"
              >Descripción / Evidencia del Ticket</span
            >
            <div
              id="tv-description"
              class="text-base-content/80 mt-1 max-h-36 overflow-y-auto font-sans text-xs leading-relaxed whitespace-pre-wrap"
            >
              -
            </div>
          </div>
        </div>
      </div>

      <form id="audit-form" method="POST" class="space-y-4">
        <input type="hidden" name="id" id="form-audit-id" />
        <input type="hidden" name="agentId" id="form-agent-id" />
        <input
          type="hidden"
          name="month"
          id="form-month"
          value={selectedMonth}
        />
        <input
          type="hidden"
          name="channelType"
          id="form-channel-type"
          value="wise_call"
        />
        <input type="hidden" name="recordingUrl" id="form-recording-url" />

        <!-- Case Metadata Fields: Grid responsivo de 3 columnas -->
        <div
          class="bg-base-200/30 border border-base-300/70 p-3.5 rounded-2xl shadow-2xs space-y-3"
        >
          <div class="flex items-center justify-between pb-1 border-b border-base-300/40">
            <span class="text-xxs font-black uppercase tracking-wider text-base-content/60 flex items-center gap-1.5">
              <Icon name="boxicons:file-detail" size={14} class="text-primary" />
              <span>Datos Básicos de la Auditoría</span>
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            <FormField
              id="form-call-id"
              name="callId"
              label="Nro Caso / ID Llamada"
              placeholder="Ej: 534787"
              size="sm"
              inputClass="font-mono font-semibold"
            />
            <FormField
              id="form-ticket-id"
              name="ticketId"
              label="Nro Ticket / AG"
              placeholder="Ej: 88442"
              size="sm"
              inputClass="font-mono font-semibold"
            />
            <FormField
              id="form-date"
              name="date"
              label="Fecha de Atención"
              type="date"
              required
              size="sm"
              inputClass="font-semibold"
            />

            <!-- Secondary Metadata (Dynamic per channel) -->
            <div id="meta-duration-container">
              <FormField
                id="form-duration"
                name="duration"
                label="Duración"
                placeholder="02:15"
                size="sm"
                inputClass="font-mono font-semibold"
              />
            </div>
            <div id="meta-ring-container">
              <FormField
                id="form-ring-time"
                name="ringTime"
                label="Tiempo Ringueo"
                placeholder="00:30"
                size="sm"
                inputClass="font-mono font-semibold"
              />
            </div>
            <div id="meta-creation-container" class="hidden">
              <FormField
                id="form-creation-time"
                name="creationTime"
                label="Creación"
                placeholder="YYYY-MM-DD HH:MM"
                size="sm"
                inputClass="font-mono font-semibold text-xs"
              />
            </div>
            <div id="meta-take-container" class="hidden">
              <FormField
                id="form-take-time"
                name="takeTime"
                label="Toma / Lectura"
                placeholder="YYYY-MM-DD HH:MM"
                size="sm"
                inputClass="font-mono font-semibold text-xs"
              />
            </div>
            <div
              id="meta-pas-container"
              class="hidden flex items-center pt-6"
            >
              <label class="label cursor-pointer gap-2 p-0 hover:opacity-85 transition-opacity">
                <input
                  type="checkbox"
                  name="isPas"
                  id="form-is-pas"
                  class="checkbox checkbox-sm checkbox-primary"
                />
                <span class="label-text text-xs font-bold uppercase tracking-wider">Es PAS</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Realtime Score Preview Card -->
        <div
          class="bg-base-200/40 border border-base-300/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl p-4 shadow-2xs transition-all"
        >
          <div class="space-y-0.5">
            <span class="text-base-content/90 text-sm font-extrabold flex items-center gap-1.5 uppercase tracking-wider">
              <Icon name="boxicons:bar-chart-big-filled" size={16} class="text-primary" />
              Score Calculado en Tiempo Real
            </span>
            <p class="text-base-content/50 text-xs">
              Cada criterio no cumplido resta su porcentaje de ponderación sobre la base 100%.
            </p>
          </div>

          <div class="flex items-center gap-4 sm:gap-6 self-end sm:self-auto">
            <!-- Sección 1 (Secundaria) -->
            <div class="border-base-300/60 border-r pr-4 text-center">
              <div class="text-base-content/40 text-xxs font-extrabold uppercase tracking-wider">
                Sección 1
              </div>
              <div id="preview-s1" class="text-base-content/80 text-base font-bold mt-0.5 font-mono">
                100%
              </div>
            </div>

            <!-- Sección 2 (Secundaria) -->
            <div
              id="preview-s2-block"
              class="border-base-300/60 border-r pr-4 text-center transition-opacity"
            >
              <div class="text-base-content/40 text-xxs font-extrabold uppercase tracking-wider">
                Sección 2
              </div>
              <div id="preview-s2" class="text-base-content/80 text-base font-bold mt-0.5 font-mono">
                100%
              </div>
            </div>

            <!-- TOTAL FINAL (Hero Metric - Destacado y prominente) -->
            <div class="text-center pl-1">
              <div class="text-base-content/50 text-xxs font-black uppercase tracking-wider">
                Total Final
              </div>
              <div id="preview-total" class="text-success text-3xl sm:text-4xl font-black font-mono tracking-tight leading-none mt-0.5">
                100%
              </div>
            </div>
          </div>
        </div>

        <!-- Checklist: Channel 1 - Llamadas Wise -->
        <div
          id="channel-checklist-wise_call"
          class="channel-checklist space-y-4"
        >
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <!-- S1: Items (Gestión Llamada) -->
            <div
              class="bg-base-200/25 border border-base-300/60 rounded-2xl p-4 shadow-2xs"
            >
              <div
                class="border-base-300/60 mb-3 flex items-center justify-between border-b pb-2 text-xs font-black uppercase tracking-wider text-base-content/85"
              >
                <span>1. Gestión de la Llamada / Atención</span>
                <span class="text-base-content/40 text-xxs font-bold"
                  >Base: 100%</span
                >
              </div>
              <div class="max-h-96 space-y-2.5 overflow-y-auto pr-1.5 scrollbar-thin">
                {
                  wiseCallParams
                    .filter(
                      (p) =>
                        p.section === "items" ||
                        p.category === "Items" ||
                        p.category === "Interacción con Usuario",
                    )
                    .map((p) => (
                      <div class="p-2.5 rounded-xl border border-base-300/40 bg-base-100/50 hover:bg-base-100 hover:border-base-300 hover:shadow-2xs transition-all duration-150">
                        <label class="label cursor-pointer justify-start gap-2.5 p-0 items-start">
                          <input
                            type="checkbox"
                            name={p.code}
                            class="checkbox checkbox-primary checkbox-sm audit-checkbox mt-0.5 shrink-0"
                            data-weight={p.weight ?? 0}
                            data-section="items"
                            checked
                          />
                          <span class="label-text flex-1 text-xs font-semibold leading-snug text-base-content/90">
                            {p.name}
                            {p.weight ? (
                              <span class="text-error font-bold ml-1 text-xs">
                                (-{p.weight}%)
                              </span>
                            ) : (
                              <span class="ml-1 text-xs opacity-50">(n/a)</span>
                            )}
                          </span>
                          <span
                            class="badge badge-warning badge-xs rule-auto-badge ml-auto hidden shrink-0 font-bold"
                            data-rule-badge={p.code}
                          >
                            Desactivado por regla
                          </span>
                        </label>
                        <input
                          type="text"
                          name={`${p.code}_comment`}
                          placeholder="Observación o comentario opcional..."
                          class="input input-xs bg-base-200/40 hover:bg-base-100 focus:bg-base-100 border border-base-300/70 focus:border-primary text-xxs mt-2 w-full font-normal placeholder:text-base-content/40 rounded-lg transition-all"
                        />
                      </div>
                    ))
                }
              </div>
            </div>

            <!-- S2: Ticket (Condicional) -->
            <div
              class="bg-base-200/25 border border-base-300/60 rounded-2xl p-4 shadow-2xs"
            >
              <div
                class="border-base-300/60 mb-3 flex items-center justify-between border-b pb-2 text-xs font-black uppercase tracking-wider text-base-content/85"
              >
                <span>2. TICKET (Gestión y Registro)</span>
                <label class="label cursor-pointer gap-2 p-0 hover:opacity-85 transition-opacity">
                  <span class="label-text text-xxs font-bold uppercase tracking-wider text-base-content/70"
                    >¿Se generó ticket?</span
                  >
                  <input
                    type="checkbox"
                    name="callGeneratedTicket"
                    id="toggle-call-generated-ticket"
                    class="toggle toggle-primary toggle-xs"
                    checked
                  />
                </label>
              </div>
              <div
                id="wise-call-ticket-block"
                class="max-h-96 space-y-2.5 overflow-y-auto pr-1.5 scrollbar-thin"
              >
                {
                  wiseCallParams
                    .filter(
                      (p) =>
                        p.section === "ticket" ||
                        p.category === "Ticket" ||
                        p.category === "Gestión del Ticket",
                    )
                    .map((p) => (
                      <div class="p-2.5 rounded-xl border border-base-300/40 bg-base-100/50 hover:bg-base-100 hover:border-base-300 hover:shadow-2xs transition-all duration-150">
                        <label class="label cursor-pointer justify-start gap-2.5 p-0 items-start">
                          <input
                            type="checkbox"
                            name={p.code}
                            class="checkbox checkbox-primary checkbox-sm audit-checkbox mt-0.5 shrink-0"
                            data-weight={p.weight ?? 0}
                            data-section="ticket"
                            checked
                          />
                          <span class="label-text flex-1 text-xs font-semibold leading-snug text-base-content/90">
                            {p.name}
                            {p.weight ? (
                              <span class="text-error font-bold ml-1 text-xs">
                                (-{p.weight}%)
                              </span>
                            ) : (
                              <span class="ml-1 text-xs opacity-50">(n/a)</span>
                            )}
                          </span>
                          <span
