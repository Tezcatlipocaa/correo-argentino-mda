---
import { Icon } from "astro-icon/components";

interface Props {
  isAgent?: boolean;
}

const { isAgent = false } = Astro.props;
---

<div class:list={[isAgent ? "col-span-full" : "w-full"]}>
  <!-- Encabezado Compacto y Banda de Métricas -->
  <div class="bg-base-100 border-base-200/80 rounded-2xl border p-4 shadow-xs sm:p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <!-- Izquierda: Avatar + Nombre + Legajo/User + Período -->
      <div class="flex items-center gap-3.5 min-w-0">
        <div
          class="bg-secondary/10 text-secondary border-secondary/20 flex size-12 shrink-0 items-center justify-center rounded-xl border text-lg font-black tracking-wider shadow-2xs"
          id="detail-avatar"
        >
          --
        </div>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h3
              class="text-base-content text-xl sm:text-2xl font-black tracking-tight truncate"
              id="detail-name"
            >
              --
            </h3>
            <span
              id="detail-id"
              class="badge badge-sm badge-ghost font-mono text-3xs font-semibold text-base-content/70"
            >
              --
            </span>
          </div>
          <div class="text-base-content/60 mt-0.5 flex items-center gap-2 text-xs font-medium">
            <span class="flex items-center gap-1">
              <Icon name="boxicons:calendar" size={14} class="text-primary shrink-0" />
              <span id="detail-month" class="font-semibold text-base-content/80">--</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Derecha: Score Mensual Integrado + Menú Acciones + Botón Cerrar -->
      <div class="flex items-center justify-between sm:justify-end gap-3 shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-base-200/60">
        <!-- Score Mensual Principal Compacto -->
        <div class="flex items-baseline gap-2 bg-base-200/50 border border-base-200/80 rounded-xl px-3.5 py-1.5 shadow-2xs">
          <span class="text-3xs font-black uppercase tracking-wider text-base-content/50">Score Mes</span>
          <span
            class="text-secondary text-2xl sm:text-3xl font-black font-mono tracking-tight leading-none"
            id="detail-score"
          >
            --%
          </span>
        </div>

        <!-- Acciones Secundarias: Dropdown Exportar -->
        <div class="dropdown dropdown-end">
          <button
            tabindex="0"
            type="button"
            class="btn btn-sm btn-ghost border border-base-200/80 text-xs font-bold gap-1 text-base-content/70 hover:text-base-content rounded-xl"
            title="Opciones de exportación"
            aria-label="Opciones de exportación"
          >
            <Icon name="boxicons:download" size={16} />
            <span class="hidden md:inline">Exportar</span>
            <Icon name="boxicons:chevron-down" size={14} class="opacity-60" />
          </button>
          <ul
            tabindex="0"
            class="dropdown-content menu bg-base-100 rounded-box border-base-200 z-50 w-52 border p-1.5 shadow-lg text-xs font-medium mt-1"
          >
            <li>
              <button
                id="btn-export-csv"
                type="button"
                class="flex items-center gap-2 py-2 text-base-content/80 hover:text-secondary"
                title="Exportar Reporte de Operador a CSV"
              >
                <Icon name="boxicons:file" size={16} class="text-secondary" />
                <span>Exportar CSV</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="flex items-center gap-2 py-2 text-base-content/80 hover:text-secondary"
                onclick="window.print()"
                title="Imprimir o guardar reporte en PDF"
              >
                <Icon name="boxicons:printer" size={16} class="text-secondary" />
                <span>Imprimir Reporte</span>
              </button>
            </li>
          </ul>
        </div>

        <!-- Botón Cerrar Estándar -->
        <button
          id="btn-back-to-summary"
          type="button"
          class="btn btn-sm btn-ghost btn-circle text-base-content/60 hover:text-base-content hover:bg-base-200"
          title={isAgent ? "Volver" : "Cerrar ficha"}
          aria-label={isAgent ? "Volver" : "Cerrar ficha"}
        >
          <Icon name={isAgent ? "boxicons:arrow-to-left" : "boxicons:x"} size={20} />
        </button>
      </div>
    </div>

    <!-- Banda de 4 Métricas Compactas -->
    <div class="mt-4 pt-3.5 border-t border-base-200/70 grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
      <!-- Métrica 1: Score Anterior -->
      <div class="bg-base-200/40 border border-base-200/60 rounded-xl p-2.5 flex flex-col justify-between">
        <span class="text-3xs text-base-content/50 font-bold uppercase tracking-wider">vs Mes Anterior</span>
        <span id="detail-stat-diff" class="text-base sm:text-lg font-black font-mono mt-0.5 text-base-content">
          Sin datos
        </span>
      </div>

      <!-- Métrica 2: Duración Media (AHT) -->
      <div class="bg-base-200/40 border border-base-200/60 rounded-xl p-2.5 flex flex-col justify-between">
        <span class="text-3xs text-base-content/50 font-bold uppercase tracking-wider">Duración Media (AHT)</span>
        <span id="detail-stat-aht" class="text-base sm:text-lg font-black font-mono mt-0.5 text-base-content">
          Sin datos
        </span>
      </div>

      <!-- Métrica 3: Interacción (S1) -->
      <div class="bg-base-200/40 border border-base-200/60 rounded-xl p-2.5 flex flex-col justify-between">
        <span class="text-3xs text-base-content/50 font-bold uppercase tracking-wider">Interacción (S1)</span>
        <span id="detail-stat-interaction" class="text-base sm:text-lg font-black font-mono mt-0.5 text-base-content">
          Sin datos
        </span>
      </div>

      <!-- Métrica 4: Gestión (S2) -->
      <div class="bg-base-200/40 border border-base-200/60 rounded-xl p-2.5 flex flex-col justify-between">
        <span class="text-3xs text-base-content/50 font-bold uppercase tracking-wider">Gestión (S2)</span>
        <span id="detail-stat-management" class="text-base sm:text-lg font-black font-mono mt-0.5 text-base-content">
          Sin datos
        </span>
      </div>
    </div>
  </div>
</div>

{/* Insights y Tendencia */}
<div class="mt-6 grid gap-6 sm:grid-cols-2">
  {/* Tendencia */}
  <div class="bg-base-100 border-base-200 rounded-2xl border p-6 shadow-md">
    <h4 class="text-base-content/70 mb-4 flex items-center gap-2 text-xs font-bold tracking-wider uppercase">
      <Icon name="boxicons:chart-line" size={18} />
      Tendencia (Últimos 6 meses)
    </h4>
    <div
      class="flex h-20 items-end justify-between gap-2"
      id="detail-history-chart"
    >
      {/* dynamic bars */}
    </div>
  </div>

  {/* Áreas de Mejora */}
  <div class="bg-base-100 border-warning/30 rounded-2xl border p-6 shadow-md">
    <h4 class="text-warning-content/70 mb-4 flex items-center gap-2 text-xs font-bold tracking-wider uppercase">
      <Icon
        name="boxicons:alert-octagon"
        size={24}
        class="text-warning"
      />
      Áreas de Mejora Detectadas
    </h4>
    <ul
      class="text-base-content/80 space-y-2 text-sm font-medium"
      id="detail-insights"
    >
      {/* dynamic insights */}
    </ul>
  </div>
</div>

{/* Observaciones del Mes */}
<div class="bg-base-100 border-base-200 rounded-2xl border p-6 shadow-md mt-6">
  <div class="mb-4 flex items-center justify-between">
    <h4 class="text-base-content/70 flex items-center gap-2 text-xs font-bold tracking-wider uppercase">
      <Icon name="boxicons:note" size={18} />
      Observaciones del Mes
    </h4>
    {!isAgent && (
      <button
        id="btn-edit-month-summary"
        class="btn btn-sm btn-ghost btn-square"
        title="Editar observaciones"
      >
        <Icon name="boxicons:edit-alt" size={18} />
      </button>
    )}
  </div>
  <p
    id="detail-month-summary"
    class="text-base-content/80 text-sm font-medium whitespace-pre-line empty:hidden"
  >
    {/* dynamic summary */}
  </p>
  <p
    id="detail-month-summary-empty"
    class="text-base-content/40 text-sm font-medium italic"
  >
    No hay observaciones para este mes.
  </p>
</div>

{/* Section Titulo y Tabs de Canales */}
<div class="border-base-300 flex flex-col gap-4 border-b pb-3 mt-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h4 class="text-base-content/80 flex items-center gap-2 font-bold tracking-wider uppercase">
        <Icon name="boxicons:chart-bar-columns" size={24} />
        Evaluaciones de Calidad del Operador
      </h4>
      <p class="text-base-content/50 text-xs">Cuota mensual requerida: 4 Llamadas Wise + 4 Mails Wise + 4 Autogestiones (12 en total)</p>
    </div>
    <div class="flex items-center gap-2">
      <span
        id="total-samples-avg-badge"
        class="badge badge-neutral text-xs font-bold gap-1"
        title="Promedio General del Total de Muestras del Mes"
      >
        <Icon name="boxicons:calculator" size={14} />
        <span class="opacity-70 font-normal">Promedio Total:</span>
        <strong id="total-samples-avg-val">--</strong>
      </span>
      <span
        id="quota-progress-badge"
        class="badge badge-neutral text-xs font-bold"
      >
        0/12 Completadas
      </span>
      {!isAgent && (
        <button
          id="btn-new-audit"
          type="button"
          class="btn btn-sm btn-primary rounded-lg text-xs font-bold uppercase gap-1"
        >
          <Icon name="boxicons:plus" size={16} />
          Nueva Auditoría
        </button>
      )}
    </div>
  </div>

  <!-- Tabs de separación por Canal -->
  <div class="tabs tabs-boxed bg-base-200/60 p-1 w-fit" id="operator-channel-tabs">
    <button
      type="button"
      class="tab tab-active operator-channel-tab text-xs font-bold gap-1.5"
      data-channel="wise_call"
    >
      <Icon name="boxicons:phone-ring" size={16} />
      <span>Llamadas Wise</span>
      <span class="badge badge-xs badge-ghost ml-1 font-mono" id="tab-count-wise_call">0/4</span>
      <span class="badge badge-xs badge-ghost ml-0.5 font-bold" id="tab-avg-wise_call" title="Promedio de Llamadas Wise">--</span>
    </button>
    <button
      type="button"
      class="tab operator-channel-tab text-xs font-bold gap-1.5"
      data-channel="wise_email"
    >
      <Icon name="boxicons:envelope" size={16} />
      <span>Mails Wise</span>
      <span class="badge badge-xs badge-ghost ml-1 font-mono" id="tab-count-wise_email">0/4</span>
      <span class="badge badge-xs badge-ghost ml-0.5 font-bold" id="tab-avg-wise_email" title="Promedio de Mails Wise">--</span>
    </button>
    <button
      type="button"
      class="tab operator-channel-tab text-xs font-bold gap-1.5"
      data-channel="invgate_ticket"
    >
      <Icon name="boxicons:handshake" size={16} />
      <span>Autogestiones</span>
      <span class="badge badge-xs badge-ghost ml-1 font-mono" id="tab-count-invgate_ticket">0/4</span>
      <span class="badge badge-xs badge-ghost ml-0.5 font-bold" id="tab-avg-invgate_ticket" title="Promedio de Autogestiones">--</span>
    </button>
  </div>
</div>

{/* Grid de Auditorías del Canal Activo */}
<div class="grid gap-6 mt-4" id="detail-calls-container">
  {/* Renderizado dinámico vía JS */}
</div>
