---
import { Icon } from "astro-icon/components";
import FormField from "@components/ui/forms/FormField.astro";
import FormTextarea from "@components/ui/forms/FormTextarea.astro";
import type { AuditParameter } from "@/types/quality";
import { getCleanBase } from "@lib/baseUrl";

interface Props {
  allAgents: Array<{ id: number; name: string; username: string | null }>;
  allParameters: AuditParameter[];
  selectedMonth: string;
  preselectedAgentId?: number;
  approvedTitles: string[];
}

const {
  allAgents,
  allParameters,
  selectedMonth,
  preselectedAgentId,
  approvedTitles,
} = Astro.props;

const cleanBase = getCleanBase();

// Group parameters by channel
const wiseCallParams = allParameters.filter(
  (p) => p.channel === "wise_call" || !p.channel,
);
const wiseEmailParams = allParameters.filter((p) => p.channel === "wise_email");
const invgateAgParams = allParameters.filter(
  (p) => p.channel === "invgate_ticket",
);
---

<div
  id="new-audit-form-container"
  class="space-y-6"
  data-approved-titles={JSON.stringify(approvedTitles)}
  data-clean-base={cleanBase}
>
  <input type="hidden" name="id" id="form-audit-id" value="" />
  <input type="hidden" name="month" id="form-month" value={selectedMonth} />
  <input
    type="hidden"
    name="channelType"
    id="form-channel-type"
    value="wise_call"
  />
  <input type="hidden" name="recordingUrl" id="form-recording-url" value="" />

  <!-- BARRA DE CONFIGURACIÓN SUPERIOR: Operador, Mes y Canal -->
  <div class="card bg-base-100 border border-base-200 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
      <!-- Selector de Operador -->
      <div class="md:col-span-5">
        <label for="form-agent-id" class="label pb-1.5 pt-0">
          <span class="label-text font-bold text-xs uppercase tracking-wider text-base-content/80 flex items-center gap-1.5">
            <Icon name="boxicons:user-filled" size={16} class="text-primary" />
            Operador a evaluar
            <span class="text-error font-bold">*</span>
          </span>
        </label>
        <select
          name="agentId"
          id="form-agent-id"
          class="select select-bordered select-sm sm:select-md w-full font-bold focus:border-primary"
          required
        >
          <option value="" disabled selected={!preselectedAgentId}>
            Seleccionar operador...
          </option>
          {
            allAgents.map((agent) => (
              <option
                value={agent.id}
                selected={agent.id === preselectedAgentId}
              >
                {agent.name} {agent.username ? `(@${agent.username})` : ""}
              </option>
            ))
          }
        </select>
      </div>

      <!-- Período Evaluado -->
      <div class="md:col-span-3">
        <label class="label pb-1.5 pt-0">
          <span class="label-text font-bold text-xs uppercase tracking-wider text-base-content/80 flex items-center gap-1.5">
            <Icon name="boxicons:calendar-filled" size={16} class="text-primary" />
            Período
          </span>
        </label>
        <div class="flex items-center px-3 py-2 bg-base-200/50 border border-base-300 rounded-lg text-sm font-mono font-bold text-base-content h-[2.5rem]">
          {selectedMonth}
        </div>
      </div>

      <!-- Segmented Tabs Canales -->
      <div class="md:col-span-4 flex flex-col items-start md:items-end">
        <span class="label-text font-bold text-xs uppercase tracking-wider text-base-content/80 mb-1.5 flex items-center gap-1.5">
          <Icon name="boxicons:broadcast" size={16} class="text-primary" />
          Canal de atención
        </span>
        <div
          class="join bg-base-200/70 p-1 rounded-xl border border-base-300 shadow-2xs w-full sm:w-auto"
          id="channel-selector-join"
        >
          <button
            type="button"
            class="btn btn-sm join-item channel-btn btn-active bg-base-100 text-secondary font-bold shadow-2xs transition-all border-transparent flex-1 sm:flex-initial gap-1.5"
            data-channel="wise_call"
          >
            <Icon name="boxicons:phone-ring" size={16} />
            <span>Llamada Wise</span>
          </button>
          <button
            type="button"
            class="btn btn-sm join-item channel-btn font-medium text-base-content/70 hover:text-secondary hover:bg-base-100/50 transition-all border-transparent flex-1 sm:flex-initial gap-1.5"
            data-channel="wise_email"
          >
            <Icon name="boxicons:envelope" size={16} />
            <span>Mail Wise</span>
          </button>
          <button
            type="button"
            class="btn btn-sm join-item channel-btn font-medium text-base-content/70 hover:text-secondary hover:bg-base-100/50 transition-all border-transparent flex-1 sm:flex-initial gap-1.5"
            data-channel="invgate_ticket"
          >
            <Icon name="boxicons:handshake" size={16} />
            <span>Autogestión</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- GRID PRINCIPAL DE 2 COLUMNAS AMPLIAS: CONTEXTO (IZQ) vs EVALUACIÓN (DER) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- COLUMNA IZQUIERDA: Contexto, Búsqueda, Metadatos y Visor -->
    <div class="lg:col-span-5 space-y-4">
      
      <!-- Buscador Unificado con Selector de Servicio (Tabs) -->
      <div
        id="unified-search-card"
        class="bg-base-100 border border-base-200 rounded-2xl p-4 shadow-sm space-y-3"
      >
        <div class="flex items-center justify-between border-b border-base-200 pb-2.5">
          <span class="text-xs font-bold text-base-content flex items-center gap-2 uppercase tracking-wide">
            <Icon name="boxicons:search" size={16} class="text-primary" />
            Buscador Asistido de Metadatos
          </span>
          <div
            class="join bg-base-200/60 p-0.5 rounded-lg border border-base-200"
            id="search-service-tabs"
          >
            <button
              type="button"
              id="tab-search-wise"
              class="join-item btn btn-xs btn-ghost gap-1.5 font-bold transition-all text-base-content bg-base-100 shadow-2xs"
              data-search-target="wise"
            >
              <Icon name="boxicons:phone" size={14} class="text-violet-500" />
              <span>Wise CX</span>
            </button>
            <button
              type="button"
              id="tab-search-invgate"
              class="join-item btn btn-xs btn-ghost gap-1.5 font-medium text-base-content/60 transition-all hover:text-base-content"
              data-search-target="invgate"
            >
              <Icon name="boxicons:receipt" size={14} class="text-secondary" />
              <span>InvGate</span>
            </button>
          </div>
        </div>

        <!-- Barra de Búsqueda Wise CX -->
        <div
          id="wise-search-container"
          class="flex items-center gap-2 transition-all"
        >
          <div class="relative flex-1">
            <input
              type="text"
              id="wise-search-id"
              placeholder="Nro Caso o ID Wise (ej: 534787)..."
              class="input input-sm bg-base-200/40 w-full pl-8 font-mono text-xs font-semibold border-base-200 focus:border-violet-500 focus:outline-hidden rounded-xl"
            />
            <div class="text-violet-500 absolute top-2 left-2.5">
              <Icon name="boxicons:phone" size={15} />
            </div>
          </div>
          <button
            type="button"
            id="btn-fetch-wise-api"
            class="btn btn-sm bg-violet-600 hover:bg-violet-700 text-white border-violet-600 shrink-0 gap-1.5 rounded-xl shadow-xs transition-all hover:scale-98 active:scale-95"
            title="Buscar caso en Wise CX"
          >
            <Icon name="boxicons:search" size={15} class="text-white" is:inline />
            <span class="text-xs font-bold">Buscar</span>
          </button>
        </div>

        <!-- Barra de Búsqueda InvGate -->
        <div
          id="invgate-search-container"
          class="flex items-center gap-2 hidden transition-all"
        >
          <div class="relative flex-1">
            <input
              type="text"
              id="invgate-search-id"
              placeholder="Nro Ticket InvGate (ej: 88442)..."
              class="input input-sm bg-base-200/40 w-full pl-8 font-mono text-xs font-semibold border-base-200 focus:border-secondary focus:outline-hidden rounded-xl"
            />
            <div class="text-secondary absolute top-2 left-2.5">
              <Icon name="boxicons:receipt" size={15} is:inline />
            </div>
          </div>
          <button
            type="button"
            id="btn-fetch-invgate-api"
            class="btn btn-sm btn-secondary shrink-0 gap-1.5 rounded-xl shadow-xs transition-all hover:scale-98 active:scale-95"
            title="Buscar ticket en InvGate"
          >
            <Icon name="boxicons:search" size={15} is:inline />
            <span class="text-xs font-bold">Buscar</span>
          </button>
        </div>

        <!-- Feedback Alerts -->
        <div
          id="wise-feedback-alert"
          class="hidden rounded-xl border p-2.5 text-xs font-medium transition-all"
        ></div>
        <div
          id="invgate-feedback-alert"
          class="hidden rounded-xl border p-2.5 text-xs font-medium transition-all"
        ></div>
      </div>

      <!-- Reproductor y Descarga de Grabación Wise CX -->
      <div
        id="tv-audio-container"
        class="bg-base-100 border border-primary/25 hidden rounded-2xl p-4 shadow-sm transition-all duration-200 space-y-2.5"
      >
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <div class="bg-primary/10 text-primary rounded-xl p-2 shrink-0">
              <Icon name="boxicons:volume-full" size={20} />
            </div>
            <div>
              <span class="text-xs font-bold text-base-content block leading-tight">
                Grabación de la llamada
              </span>
              <span class="text-xxs text-base-content/60">Audio provisto por Wise CX</span>
            </div>
          </div>
          <span class="badge badge-sm badge-success font-semibold">Audio disponible</span>
        </div>
        <div class="flex flex-col sm:flex-row items-center gap-2 pt-1">
          <audio
            id="tv-audio-player"
            controls
            class="h-9 w-full rounded-lg"
            preload="metadata"
          ></audio>
          <a
            id="tv-audio-download"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            download
            class="btn btn-sm btn-neutral shrink-0 gap-1.5 font-bold text-xs rounded-xl"
            title="Descargar audio"
          >
            <Icon name="boxicons:archive-arrow-down" size={16} />
            <span>MP3</span>
          </a>
        </div>
      </div>

      <!-- Datos Básicos de la Atención -->
      <div class="bg-base-100 border border-base-200 p-4 rounded-2xl shadow-sm space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-base-200">
          <span class="text-xs font-bold text-base-content flex items-center gap-2 uppercase tracking-wide">
            <Icon name="boxicons:file-detail" size={16} class="text-primary" />
            <span>Datos de la atención</span>
          </span>
          <span class="text-xxs text-base-content/50 font-medium">Requeridos para auditoría</span>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <FormField
            id="form-call-id"
            name="callId"
            label="Nro Caso / ID Llamada"
            placeholder="Ej: 534787"
            size="sm"
            inputClass="font-mono font-semibold text-xs"
          />
          <FormField
            id="form-ticket-id"
            name="ticketId"
            label="Nro Ticket InvGate"
            placeholder="Ej: 88442"
            size="sm"
            inputClass="font-mono font-semibold text-xs"
          />
          <div class="col-span-2">
            <FormField
              id="form-date"
              name="date"
              label="Fecha de atención"
              type="date"
              required
              size="sm"
              inputClass="font-semibold text-xs"
            />
          </div>

          <!-- Secondary Metadata -->
          <div id="meta-duration-container">
            <FormField
              id="form-duration"
              name="duration"
              label="Duración"
              placeholder="02:15"
              size="sm"
              inputClass="font-mono font-semibold text-xs"
            />
          </div>
          <div id="meta-ring-container">
            <FormField
              id="form-ring-time"
              name="ringTime"
              label="Tiempo ringueo"
              placeholder="00:30"
              size="sm"
              inputClass="font-mono font-semibold text-xs"
            />
          </div>
          <div id="meta-creation-container" class="hidden">
            <FormField
              id="form-creation-time"
              name="creationTime"
              label="Creación"
              placeholder="YYYY-MM-DD HH:MM"
              size="sm"
              inputClass="font-mono font-semibold text-xs"
            />
          </div>
          <div id="meta-take-container" class="hidden">
            <FormField
              id="form-take-time"
              name="takeTime"
              label="Toma / Lectura"
              placeholder="YYYY-MM-DD HH:MM"
              size="sm"
              inputClass="font-mono font-semibold text-xs"
            />
          </div>
          <div
            id="meta-pas-container"
            class="hidden col-span-2 flex items-center pt-1"
          >
            <label class="label cursor-pointer gap-2 p-0 hover:opacity-85 transition-opacity">
              <input
                type="checkbox"
                name="isPas"
                id="form-is-pas"
                class="checkbox checkbox-xs checkbox-primary"
              />
              <span class="label-text text-xs font-bold">Es caso PAS</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Live Ticket Viewer Panel (InvGate) -->
      <div
        id="ticket-viewer-panel"
        class="bg-base-100 border border-base-200 rounded-2xl p-4 shadow-sm"
      >
        <div
          class="flex cursor-pointer items-center justify-between select-none"
          id="ticket-viewer-header"
        >
          <div class="flex items-center gap-2">
            <Icon name="boxicons:receipt" size={18} class="text-secondary" />
            <span class="text-base-content text-xs font-bold uppercase tracking-wide">
              Detalle del ticket InvGate
            </span>
            <span
              id="ticket-viewer-badge"
              class="badge badge-xs badge-ghost font-medium"
            >Sin ticket cargado</span>
          </div>
          <div
            class="text-base-content/60 flex items-center gap-1 text-xs font-medium"
          >
            <span id="ticket-viewer-toggle-text">Mostrar</span>
            <Icon
              name="boxicons:chevron-down"
              size={16}
              id="ticket-viewer-chevron"
              class="transition-transform duration-200"
            />
          </div>
        </div>

        <div id="ticket-viewer-content" class="mt-3 hidden space-y-3">
          <!-- Título & Validación asistida -->
          <div class="bg-base-200/40 border border-base-200 rounded-xl p-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="min-w-0 flex-1">
                <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider block">
                  Título en InvGate
                </span>
                <p
                  id="tv-title"
                  class="text-base-content text-xs font-semibold leading-relaxed break-words mt-0.5 font-sans"
                >
                  -
                </p>
              </div>
              <div id="tv-title-match-badge" class="shrink-0 flex items-center"></div>
            </div>
          </div>

          <!-- Grid de Metadatos -->
          <div class="grid grid-cols-2 gap-2.5">
            <div class="bg-base-200/40 border border-base-200 rounded-xl p-2.5">
              <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                <Icon name="boxicons:categories" size={13} class="text-primary/70" />
                Categoría
              </span>
              <p id="tv-category" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                -
              </p>
            </div>
            <div class="bg-base-200/40 border border-base-200 rounded-xl p-2.5">
              <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                <Icon name="boxicons:flag" size={13} class="text-warning/70" />
                Prioridad
              </span>
              <p id="tv-priority" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                -
              </p>
            </div>
            <div class="bg-base-200/40 border border-base-200 rounded-xl p-2.5">
              <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                <Icon name="boxicons:info-circle" size={13} class="text-info/70" />
                Estado
              </span>
              <p id="tv-status" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                -
              </p>
            </div>
            <div class="bg-base-200/40 border border-base-200 rounded-xl p-2.5">
              <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                <Icon name="boxicons:user" size={13} class="text-secondary/70" />
                Solicitante
              </span>
              <p id="tv-creator" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                -
              </p>
            </div>
            <div class="bg-base-200/40 border border-base-200 rounded-xl p-2.5">
              <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                <Icon name="boxicons:pin" size={13} class="text-primary/70" />
                Creado por
              </span>
              <p id="tv-created-by" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                -
              </p>
            </div>
            <div class="bg-base-200/40 border border-base-200 rounded-xl p-2.5">
              <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                <Icon name="boxicons:help-circle" size={13} class="text-info/70" />
                Mesa de Ayuda
              </span>
              <p id="tv-helpdesk" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                -
              </p>
            </div>
            <div class="bg-base-200/40 border border-base-200 rounded-xl p-2.5 col-span-2">
              <div class="flex items-center justify-between gap-1">
                <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                  <Icon name="boxicons:broadcast" size={13} class="text-primary/70" />
                  Origen
                </span>
                <div id="tv-source-match-badge" class="shrink-0 flex items-center"></div>
              </div>
              <p id="tv-source" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                -
              </p>
            </div>
          </div>

          <!-- Descripción / Evidencia -->
          <div class="bg-base-200/40 border border-base-200 rounded-xl p-3">
            <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider block">
              Descripción / Evidencia
            </span>
            <div
              id="tv-description"
              class="text-base-content/85 mt-1 max-h-48 overflow-y-auto font-sans text-xs leading-relaxed whitespace-pre-wrap"
            >
              -
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- COLUMNA DERECHA: Puntuación en Tiempo Real, Criterios y Observaciones -->
    <div class="lg:col-span-7 space-y-4">
      
      <!-- Card Puntuación en Tiempo Real -->
      <div
        class="bg-base-100 border border-base-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl p-4 sm:p-5 shadow-sm"
      >
        <div class="space-y-1">
          <span class="text-base-content text-sm font-bold flex items-center gap-2">
            <Icon name="boxicons:bar-chart-big-filled" size={20} class="text-primary" />
            Puntuación en tiempo real
          </span>
          <p class="text-base-content/60 text-xs">
            Cada criterio desmarcado deduce porcentaje sobre la base de 100%.
          </p>
        </div>

        <div class="flex items-center gap-5 sm:gap-6 self-end sm:self-auto">
          <!-- Sección 1 -->
          <div class="border-base-200 border-r pr-4 text-center">
            <div class="text-base-content/50 text-xxs font-bold uppercase tracking-wider">
              Sección 1
            </div>
            <div id="preview-s1" class="text-base-content/90 text-base font-bold mt-0.5 font-mono">
              100%
            </div>
          </div>

          <!-- Sección 2 -->
          <div
            id="preview-s2-block"
            class="border-base-200 border-r pr-4 text-center transition-opacity"
          >
            <div class="text-base-content/50 text-xxs font-bold uppercase tracking-wider">
              Sección 2
            </div>
            <div id="preview-s2" class="text-base-content/90 text-base font-bold mt-0.5 font-mono">
              100%
            </div>
          </div>

          <!-- TOTAL FINAL -->
          <div class="text-center pl-1">
            <div class="text-base-content/60 text-xxs font-black uppercase tracking-wider">
              Total Final
            </div>
            <div id="preview-total" class="text-success text-3xl sm:text-4xl font-black font-mono tracking-tight leading-none mt-1">
              100%
            </div>
          </div>
        </div>
      </div>

      <!-- Checklist: Canal 1 - Llamadas Wise -->
      <div
        id="channel-checklist-wise_call"
        class="channel-checklist space-y-4"
      >
        <!-- S1: Gestión de la llamada -->
        <div class="bg-base-100 border border-base-200 rounded-2xl p-4 shadow-sm">
          <div class="border-base-200 mb-3 flex items-center justify-between border-b pb-2 text-xs font-bold text-base-content uppercase tracking-wider">
            <span>1. Gestión de la llamada / atención</span>
            <span class="text-base-content/50 text-xxs font-semibold">Base: 100%</span>
          </div>
          <div class="space-y-1 divide-y divide-base-200/60">
            {
              wiseCallParams
                .filter(
                  (p) =>
                    p.section === "items" ||
                    p.category === "Items" ||
                    p.category === "Interacción con Usuario",
                )
                .map((p) => (
                  <div class="checklist-item py-2.5 px-1 transition-colors">
                    <div class="flex items-start justify-between gap-3">
                      <label class="label cursor-pointer justify-start gap-3 p-0 items-start flex-1 min-w-0">
                        <input
                          type="checkbox"
                          name={p.code}
                          class="checkbox checkbox-primary checkbox-sm audit-checkbox mt-0.5 shrink-0"
                          data-weight={p.weight ?? 0}
                          data-section="items"
                          checked
                        />
                        <span class="label-text text-xs leading-snug text-base-content font-medium">
                          {p.name}
                          {p.weight ? (
                            <span class="text-error font-semibold ml-1.5 text-xs">
                              (-{p.weight}%)
                            </span>
                          ) : (
                            <span class="ml-1 text-xs opacity-50 font-normal">(n/a)</span>
                          )}
                        </span>
                      </label>
                      <div class="flex items-center gap-1.5 shrink-0">
                        <span
                          class="badge badge-warning badge-xs rule-auto-badge hidden font-semibold text-3xs"
                          data-rule-badge={p.code}
                        >
                          Regla
                        </span>
                        <button
                          type="button"
                          class="btn btn-ghost btn-xs text-base-content/40 hover:text-secondary transition-colors toggle-obs-btn"
                          data-action="toggle-obs"
                          title="Agregar nota"
                        >
                          <Icon name="boxicons:message" size={14} />
                          <span class="text-xxs hidden sm:inline">Nota</span>
                        </button>
                      </div>
                    </div>
                    <div class="criteria-obs-wrapper hidden mt-2.5 pl-7">
                      <input
                        type="text"
