---
import { Icon } from "astro-icon/components";
import FormField from "@components/ui/forms/FormField.astro";
import FormLegend from "@components/ui/forms/FormLegend.astro";
import FormTextarea from "@components/ui/forms/FormTextarea.astro";
import type { AuditParameter } from "@/types/quality";
import { getCleanBase } from "@lib/baseUrl";

interface Props {
  allAgents: Array<{ id: number; name: string; username: string | null }>;
  allParameters: AuditParameter[];
  selectedMonth: string;
  preselectedAgentId?: number;
  approvedTitles: string[];
}

const {
  allAgents,
  allParameters,
  selectedMonth,
  preselectedAgentId,
  approvedTitles,
} = Astro.props;

const cleanBase = getCleanBase();
const invgateWebBase = (import.meta.env.INVGATE_BASE_URL || "")
  .replace(/\/api\/v1\/?$/, "")
  .replace(/\/$/, "");

// Group parameters by channel and section
const wiseCallParams = allParameters.filter(
  (p) =>
    (p.channel === "wise_call" || !p.channel) &&
    p.code !== "call_ticket_reclamo_novedad",
);
const wiseCallTicketParams = wiseCallParams.filter(
  (p) =>
    (p.section === "ticket" ||
      p.category === "Ticket" ||
      p.category === "Gestión del Ticket") &&
    p.code !== "call_ticket_reclamo_novedad",
);
const wiseEmailParams = allParameters.filter(
  (p) =>
    p.channel === "wise_email" &&
    p.code !== "email_mda_reclamo_novedad",
);
const wiseEmailMdaParams = wiseEmailParams.filter(
  (p) =>
    (p.section === "mda" || p.category === "MDA") &&
    p.code !== "email_mda_reclamo_novedad",
);
const invgateAgParams = allParameters.filter(
  (p) => p.channel === "invgate_ticket",
);
---
<div
  id="new-audit-form-container"
  class="space-y-6"
  data-approved-titles={JSON.stringify(approvedTitles)}
  data-clean-base={cleanBase}
  data-invgate-web-base={invgateWebBase}
>
  <input type="hidden" name="id" id="form-audit-id" value="" />
  <input type="hidden" name="month" id="form-month" value={selectedMonth} />
  <input
    type="hidden"
    name="channelType"
    id="form-channel-type"
    value="wise_call"
  />
  <input type="hidden" name="recordingUrl" id="form-recording-url" value="" />

  <!-- BARRA DE CONFIGURACIÓN SUPERIOR: Operador, Mes y Canal -->
  <div class="card bg-base-100 border border-base-200 shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
      <!-- Selector de Operador -->
      <div class="md:col-span-5">
        <label for="form-agent-id" class="label pb-1.5 pt-0">
          <span class="label-text font-bold text-xs uppercase tracking-wider text-base-content/80 flex items-center gap-1.5">
            <Icon name="boxicons:user-filled" size={16} class="text-primary" />
            Operador a evaluar
            <span class="text-error font-bold">*</span>
          </span>
        </label>
        <select
          name="agentId"
          id="form-agent-id"
          class="select select-bordered select-sm sm:select-md w-full font-bold focus:border-primary"
          required
        >
          <option value="" disabled selected={!preselectedAgentId}>
            Seleccionar operador...
          </option>
          {
            allAgents.map((agent) => (
              <option
                value={agent.id}
                selected={agent.id === preselectedAgentId}
              >
                {agent.name} {agent.username ? `(@${agent.username})` : ""}
              </option>
            ))
          }
        </select>
      </div>

      <!-- Período Evaluado -->
      <div class="md:col-span-3">
        <label class="label pb-1.5 pt-0">
          <span class="label-text font-bold text-xs uppercase tracking-wider text-base-content/80 flex items-center gap-1.5">
            <Icon name="boxicons:calendar-filled" size={16} class="text-primary" />
            Período
          </span>
        </label>
        <div class="flex items-center px-3 py-2 bg-base-200/50 border border-base-300 rounded-lg text-sm font-mono font-bold text-base-content h-[2.5rem]">
          {selectedMonth}
        </div>
      </div>

      <!-- Segmented Tabs Canales -->
      <div class="md:col-span-4 flex flex-col items-start md:items-end">
        <span class="label-text font-bold text-xs uppercase tracking-wider text-base-content/80 mb-1.5 flex items-center gap-1.5">
          <Icon name="boxicons:broadcast" size={16} class="text-primary" />
          Canal de atención
        </span>
        <div
          class="join bg-base-200/70 p-1 rounded-xl border border-base-300 shadow-2xs w-full sm:w-auto"
          id="channel-selector-join"
        >
          <button
            type="button"
            class="btn btn-sm join-item channel-btn btn-active bg-base-100 text-secondary font-bold shadow-2xs transition-all border-transparent flex-1 sm:flex-initial gap-1.5"
            data-channel="wise_call"
          >
            <Icon name="boxicons:phone-ring" size={16} />
            <span>Llamada Wise</span>
          </button>
          <button
            type="button"
            class="btn btn-sm join-item channel-btn font-medium text-base-content/70 hover:text-secondary hover:bg-base-100/50 transition-all border-transparent flex-1 sm:flex-initial gap-1.5"
            data-channel="wise_email"
          >
            <Icon name="boxicons:envelope" size={16} />
            <span>Mail Wise</span>
          </button>
          <button
            type="button"
            class="btn btn-sm join-item channel-btn font-medium text-base-content/70 hover:text-secondary hover:bg-base-100/50 transition-all border-transparent flex-1 sm:flex-initial gap-1.5"
            data-channel="invgate_ticket"
          >
            <Icon name="boxicons:handshake" size={16} />
            <span>Autogestión</span>
          </button>
        </div>
      </div>
    </div>
  </div>

<div id="modal-grid-container" class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          
          <!-- COLUMNA IZQUIERDA: CONTEXTO (Búsqueda, Audio, Datos Atención, Ticket Viewer) -->
          <div id="modal-grid-context" class="lg:col-span-5 space-y-3.5">

            <!-- Feedback Alerts (compartidos por ambas búsquedas) -->
            <div
              id="wise-feedback-alert"
              class="hidden rounded-xl border p-2.5 text-xs font-medium shadow-2xs transition-all"
            ></div>
            <div
              id="invgate-feedback-alert"
              class="hidden rounded-xl border p-2.5 text-xs font-medium shadow-2xs transition-all"
            ></div>

            <!-- Reproductor y Descarga de Grabación Wise CX -->
            <div
              id="tv-audio-container"
              class="bg-base-100 border border-primary/25 hidden rounded-xl p-3 shadow-2xs transition-all duration-200 space-y-2"
            >
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <div class="bg-primary/10 text-primary rounded-lg p-1.5 shrink-0">
                    <Icon name="boxicons:volume-full" size={18} />
                  </div>
                  <span class="text-xs font-bold text-base-content">
                    Grabación de la llamada
                  </span>
                </div>
                <span class="badge badge-xs badge-success font-semibold">Audio disponible</span>
              </div>
              <div class="flex flex-col sm:flex-row items-center gap-2">
                <audio
                  id="tv-audio-player"
                  controls
                  class="h-8 w-full rounded-md"
                  preload="metadata"
                ></audio>
                <a
                  id="tv-audio-download"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  download
                  class="btn btn-xs btn-neutral shrink-0 gap-1 font-semibold text-xs transition-all hover:scale-98 active:scale-95"
                  title="Descargar audio"
                >
                  <Icon name="boxicons:archive-arrow-down" size={14} />
                  <span>MP3</span>
                </a>
              </div>
            </div>

            <!-- Datos Básicos de la Atención -->
            <div
              class="bg-base-100 border border-base-200 p-3 rounded-xl shadow-2xs space-y-2.5"
            >
              <div class="flex items-center justify-between pb-1.5 border-b border-base-200">
                <span class="text-xs font-bold text-base-content flex items-center gap-1.5">
                  <Icon name="boxicons:file-detail" size={15} class="text-primary" />
                  <span>Datos de la atención</span>
                </span>
              </div>

              <div class="grid grid-cols-2 gap-2.5">
                <!-- Campo Case ID: búsqueda API Wise CX integrada -->
                <fieldset class="fieldset min-w-0">
                  <FormLegend class="font-bold tracking-wider">
                    Nro Caso / Llamada
                  </FormLegend>
                  <div class="join w-full">
                    <input
                      type="text"
                      id="form-call-id"
                      name="callId"
                      placeholder="Ej: 534787"
                      class="input input-xs join-item w-full min-w-0 bg-base-200/30 font-mono font-semibold text-xs border-base-200 focus:border-violet-500 focus:outline-hidden"
                    />
                    <button
                      type="button"
                      id="btn-fetch-wise-api"
                      class="btn btn-xs bg-violet-600 hover:bg-violet-700 text-white border-violet-600 join-item btn-square shrink-0 transition-all hover:scale-98 active:scale-95 shadow-2xs"
                      title="Buscar el caso en Wise CX y completar los datos"
                      aria-label="Buscar el caso en Wise CX"
                    >
                      <Icon name="boxicons:search" size={14} is:inline />
                    </button>
                  </div>
                </fieldset>

                <!-- Campo Ticket ID: búsqueda API InvGate integrada -->
                <fieldset class="fieldset min-w-0">
                  <FormLegend class="font-bold tracking-wider">
                    Nro Ticket InvGate
                  </FormLegend>
                  <div class="join w-full">
                    <input
                      type="text"
                      id="form-ticket-id"
                      name="ticketId"
                      placeholder="Ej: 88442"
                      class="input input-xs join-item w-full min-w-0 bg-base-200/30 font-mono font-semibold text-xs border-base-200 focus:border-secondary focus:outline-hidden"
                    />
                    <button
                      type="button"
                      id="btn-fetch-invgate-api"
                      class="btn btn-xs btn-secondary join-item btn-square shrink-0 transition-all hover:scale-98 active:scale-95"
                      title="Buscar el ticket en InvGate y completar los datos"
                      aria-label="Buscar el ticket en InvGate"
                    >
                      <Icon name="boxicons:search" size={14} is:inline />
                      <span id="btn-fetch-invgate-label" class="sr-only">Buscar</span>
                    </button>
                  </div>
                </fieldset>

                <div class="col-span-2">
                  <FormField
                    id="form-date"
                    name="date"
                    label="Fecha de atención"
                    type="date"
                    required
                    size="xs"
                    inputClass="font-semibold text-xs"
                  />
                </div>

                <!-- Secondary Metadata -->
                <div id="meta-duration-container">
                  <FormField
                    id="form-duration"
                    name="duration"
                    label="Duración"
                    placeholder="02:15"
                    size="xs"
                    inputClass="font-mono font-semibold text-xs"
                  />
                </div>
                <div id="meta-ring-container">
                  <FormField
                    id="form-ring-time"
                    name="ringTime"
                    label="Tiempo ringueo"
                    placeholder="00:30"
                    size="xs"
                    inputClass="font-mono font-semibold text-xs"
                  />
                </div>
                <div id="meta-creation-container" class="hidden">
                  <FormField
                    id="form-creation-time"
                    name="creationTime"
                    label="Creación"
                    placeholder="YYYY-MM-DD HH:MM"
                    size="xs"
                    inputClass="font-mono font-semibold text-xs"
                  />
                </div>
                <div id="meta-take-container" class="hidden">
                  <FormField
                    id="form-take-time"
                    name="takeTime"
                    label="Toma / Lectura"
                    placeholder="00:00:00"
                    size="xs"
                    inputClass="font-mono font-semibold text-xs"
                  />
                  <p
                    id="take-time-hint"
                    class="text-xxs text-secondary font-semibold pl-1 hidden font-sans mt-0.5"
                  ></p>
                </div>
                <div
                  id="meta-pas-container"
                  class="hidden col-span-2 flex items-center pt-1"
                >
                  <label class="label cursor-pointer gap-2 p-0 hover:opacity-85 transition-opacity">
                    <input
                      type="checkbox"
                      name="isPas"
                      id="form-is-pas"
                      class="checkbox checkbox-xs checkbox-primary"
                    />
                    <span class="label-text text-xs font-bold">Es caso PAS</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Live Ticket Viewer Panel (InvGate) -->
            <div
              id="ticket-viewer-panel"
              class="bg-base-100 border border-base-200 rounded-xl p-3 shadow-2xs"
            >
              <div
                class="flex cursor-pointer items-center justify-between select-none"
                id="ticket-viewer-header"
              >
                <div class="flex min-w-0 items-center gap-2">
                  <Icon name="boxicons:receipt" size={17} class="text-secondary shrink-0" />
                  <span class="text-base-content text-xs font-bold truncate">
                    Detalle del ticket InvGate
                  </span>
                  <span
                    id="ticket-viewer-badge"
                    class="badge badge-xs badge-ghost font-medium shrink-0 max-w-36 truncate"
                    title="Sin ticket cargado"
                    >Sin ticket cargado</span
                  >
                </div>
                <div
                  class="text-base-content/60 flex shrink-0 items-center gap-1.5 text-xs font-medium"
                >
                  <!-- Deep-link al ticket dentro de InvGate -->
                  <a
                    id="btn-open-invgate-ticket"
                    href={invgateWebBase ? `${invgateWebBase}/requests/show/index/id/0` : "#"}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-ghost btn-xs gap-1 font-semibold text-secondary hover:bg-secondary/10 transition-colors pointer-events-none opacity-40"
                    title="Abrir el ticket en InvGate"
                    aria-label="Abrir el ticket en InvGate"
                  >
                    <Icon name="boxicons:window-arrow-out" size={13} />
                    <span class="hidden sm:inline">Abrir en InvGate</span>
                  </a>
                  <span id="ticket-viewer-toggle-text">Mostrar</span>
                  <Icon
                    name="boxicons:chevron-down"
                    size={16}
                    id="ticket-viewer-chevron"
                    class="transition-transform duration-200"
                  />
                </div>
              </div>

              <div id="ticket-viewer-content" class="mt-2.5 hidden space-y-2.5">
                <!-- Título & Validación asistida -->
                <div class="bg-base-200/40 border border-base-200 rounded-lg p-2.5">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div class="min-w-0 flex-1">
                      <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider block">
                        Título en InvGate
                      </span>
                      <p
                        id="tv-title"
                        class="text-base-content text-xs font-semibold leading-relaxed break-words mt-0.5 font-sans"
                      >
                        -
                      </p>
                    </div>
                    <div id="tv-title-match-badge" class="shrink-0 flex items-center"></div>
                  </div>
                </div>

                <!-- Grid de Metadatos: Tipografía Sans-Serif Limpia -->
                <div class="grid grid-cols-2 gap-2">
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:categories" size={13} class="text-primary/70" />
                      Categoría
                    </span>
                    <p id="tv-category" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:flag" size={13} class="text-warning/70" />
                      Prioridad
                    </span>
                    <p id="tv-priority" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:info-circle" size={13} class="text-info/70" />
                      Estado
                    </span>
                    <p id="tv-status" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:user" size={13} class="text-secondary/70" />
                      Solicitante
                    </span>
                    <p id="tv-creator" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:pin" size={13} class="text-primary/70" />
                      Creado por
                    </span>
                    <p id="tv-created-by" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:help-circle" size={13} class="text-info/70" />
                      Mesa de Ayuda
                    </span>
                    <p id="tv-helpdesk" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <div class="flex items-center justify-between gap-1">
                      <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                        <Icon name="boxicons:broadcast" size={13} class="text-primary/70" />
                        Origen
                      </span>
                      <div id="tv-source-match-badge" class="shrink-0 flex items-center"></div>
                    </div>
                    <p id="tv-source" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                  <div class="bg-base-200/40 border border-base-200 rounded-lg p-2">
                    <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider flex items-center gap-1">
                      <Icon name="boxicons:timer" size={13} class="text-secondary/70" />
                      1ra Respuesta
                    </span>
                    <p id="tv-response-time" class="text-base-content truncate font-sans text-xs font-semibold mt-0.5">
                      -
                    </p>
                  </div>
                </div>


                <!-- Descripción / Evidencia -->
                <div class="bg-base-200/40 border border-base-200 rounded-lg p-2.5">
                  <span class="text-xxs text-base-content/50 font-bold uppercase tracking-wider">
                    Descripción / Evidencia
                  </span>
                  <div
                    id="tv-description"
                    class="text-base-content/85 mt-1 max-h-36 overflow-y-auto font-sans text-xs leading-relaxed whitespace-pre-wrap scrollbar-thin"
                  >
                    -
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- COLUMNA DERECHA: EVALUACIÓN (Score en Tiempo Real, Criterios, Notas) -->
          <div id="modal-grid-evaluation" class="lg:col-span-7 space-y-3.5">
            
            <!-- Realtime Score Preview Card -->
            <div
              class="bg-base-100 border border-base-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-xl p-3.5 shadow-2xs"
            >
              <div class="space-y-0.5">
                <span class="text-base-content text-xs font-bold flex items-center gap-1.5">
                  <Icon name="boxicons:bar-chart-big-filled" size={16} class="text-primary" />
                  Score en tiempo real
                </span>
                <p class="text-base-content/50 text-xxs">
                  Cada criterio no cumplido resta porcentaje sobre la base 100%.
                </p>
              </div>

              <div class="flex items-center gap-4 sm:gap-5 self-end sm:self-auto">
                <!-- Sección 1 -->
                <div class="border-base-200 border-r pr-3.5 text-center">
                  <div class="text-base-content/50 text-xxs font-bold uppercase tracking-wider">
                    Sección 1
                  </div>
                  <div id="preview-s1" class="text-base-content/90 text-sm font-bold mt-0.5 font-mono">
                    100%
                  </div>
                </div>

                <!-- Sección 2 -->
                <div
                  id="preview-s2-block"
                  class="border-base-200 border-r pr-3.5 text-center transition-opacity"
                >
                  <div class="text-base-content/50 text-xxs font-bold uppercase tracking-wider">
                    Sección 2
                  </div>
                  <div id="preview-s2" class="text-base-content/90 text-sm font-bold mt-0.5 font-mono">
                    100%
                  </div>
                </div>

                <!-- TOTAL FINAL -->
                <div class="text-center pl-1">
                  <div class="text-base-content/60 text-xxs font-black uppercase tracking-wider">
                    Total final
                  </div>
                  <div id="preview-total" class="text-success text-2xl sm:text-3xl font-black font-mono tracking-tight leading-none mt-0.5">
                    100%
                  </div>
                </div>
              </div>
            </div>

            <!-- Checklist: Canal 1 - Llamadas Wise -->
            <div
              id="channel-checklist-wise_call"
              class="channel-checklist space-y-3"
            >
              <!-- S1: Gestión de la llamada -->
              <div class="bg-base-100 border border-base-200 rounded-xl p-3.5 shadow-2xs">
                <div class="border-base-200 mb-2.5 flex items-center justify-between border-b pb-2 text-xs font-bold text-base-content">
                  <div class="flex items-center gap-2">
                    <span>1. Gestión de la llamada / atención</span>
                    <span class="text-base-content/40 text-xxs font-semibold">Base: 45 pts</span>
                  </div>
                  <div class="inline-flex items-center rounded-md bg-base-200/60 border border-base-300/60 p-0.5 shadow-2xs">
                    <button
                      type="button"
                      class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-3xs font-medium text-base-content/70 hover:text-secondary hover:bg-base-100 active:scale-95 transition-all duration-150 cursor-pointer toggle-all-section-btn focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-secondary/50"
                      data-target-group="wise-call-s1"
                      data-action="check-all"
                      title="Marcar todos los ítems de llamada"
                    >
                      <Icon name="boxicons:checkbox-checked" size={13} class="text-secondary shrink-0" />
                      <span>Todos</span>
                    </button>
                    <span class="w-px h-2.5 bg-base-300/80 mx-0.5 select-none" aria-hidden="true"></span>
                    <button
                      type="button"
                      class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-3xs font-medium text-base-content/70 hover:text-base-content hover:bg-base-100 active:scale-95 transition-all duration-150 cursor-pointer toggle-all-section-btn focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-base-content/30"
                      data-target-group="wise-call-s1"
                      data-action="uncheck-all"
                      title="Desmarcar todos los ítems de llamada"
                    >
                      <Icon name="boxicons:checkbox" size={13} class="text-base-content/40 shrink-0" />
                      <span>Ninguno</span>
                    </button>
                  </div>
                </div>
                <div
                  data-checklist-group="wise-call-s1"
                  class="space-y-0.5 divide-y divide-base-200/60 max-h-[380px] overflow-y-auto pr-1.5 scrollbar-thin transition-opacity duration-150"
                >
                  {
                    wiseCallParams
