                      <Icon name="boxicons:checkbox" size={13} class="text-base-content/40 shrink-0" />
                      <span>Ninguno</span>
                    </button>
                  </div>
                </div>
                <div
                  data-checklist-group="invgate-ag-s1"
                  class="space-y-0.5 divide-y divide-base-200/60 max-h-[380px] overflow-y-auto pr-1.5 scrollbar-thin transition-opacity duration-150"
                >
                  {
                    invgateAgParams
                      .filter((p) => p.section === "items")
                      .map((p) => (
                        <div class="checklist-item py-2 px-1 transition-colors">
                          <div class="flex items-start justify-between gap-2.5">
                            <label class="label cursor-pointer justify-start gap-2.5 p-0 items-start flex-1 min-w-0">
                              <input
                                type="checkbox"
                                name={p.code}
                                class="checkbox checkbox-primary checkbox-xs sm:checkbox-sm audit-checkbox mt-0.5 shrink-0"
                                data-weight={p.weight ?? 0}
                                data-section="items"
                                checked
                              />
                              <span class="label-text text-xs leading-snug text-base-content font-medium">
                                {p.name}
                                {p.weight ? (
                                  <span class="text-error font-semibold ml-1 text-xs">
                                    (-{p.weight}%)
                                  </span>
                                ) : (
                                  <span class="ml-1 text-xs opacity-50 font-normal">(n/a)</span>
                                )}
                              </span>
                            </label>
                            <div class="flex items-center gap-1 shrink-0">
                              <span
                                class="badge badge-warning badge-xs rule-auto-badge hidden font-semibold text-3xs"
                                data-rule-badge={p.code}
                              >
                                Regla
                              </span>
                              <button
                                type="button"
                                class="btn btn-ghost btn-2xs text-base-content/40 hover:text-secondary transition-colors toggle-obs-btn"
                                data-action="toggle-obs"
                                title="Agregar nota"
                              >
                                <Icon name="boxicons:message" size={13} />
                                <span class="text-3xs hidden sm:inline">Nota</span>
                              </button>
                            </div>
                          </div>
                          <div class="criteria-obs-wrapper hidden mt-2 pl-6">
                            <input
                              type="text"
                              name={`${p.code}_comment`}
                              placeholder="Motivo de penalización u observación..."
                              class="input input-xs bg-base-200/30 border border-base-200 focus:border-primary text-xs w-full placeholder:text-base-content/40 rounded-lg"
                            />
                          </div>
                        </div>
                      ))
                  }
                </div>
              </div>

              <!-- S2: Items MDA -->
              <div class="bg-base-100 border border-base-200 rounded-xl p-3.5 shadow-2xs">
                <div class="border-base-200 mb-2.5 flex items-center justify-between border-b pb-2 text-xs font-bold text-base-content">
                  <div class="flex items-center gap-2">
                    <span>2. Items categoría MDA</span>
                    <span class="text-base-content/40 text-xxs font-semibold">Base: 100%</span>
                  </div>
                  <div class="flex items-center gap-2.5">
                    <div class="inline-flex items-center rounded-md bg-base-200/60 border border-base-300/60 p-0.5 shadow-2xs">
                      <button
                        type="button"
                        class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-3xs font-medium text-base-content/70 hover:text-secondary hover:bg-base-100 active:scale-95 transition-all duration-150 cursor-pointer toggle-all-section-btn focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-secondary/50"
                        data-target-group="invgate-ag-s2"
                        data-action="check-all"
                        title="Marcar todos los ítems de MDA"
                      >
                        <Icon name="boxicons:checkbox-checked" size={13} class="text-secondary shrink-0" />
                        <span>Todos</span>
                      </button>
                      <span class="w-px h-2.5 bg-base-300/80 mx-0.5 select-none" aria-hidden="true"></span>
                      <button
                        type="button"
                        class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-3xs font-medium text-base-content/70 hover:text-base-content hover:bg-base-100 active:scale-95 transition-all duration-150 cursor-pointer toggle-all-section-btn focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-base-content/30"
                        data-target-group="invgate-ag-s2"
                        data-action="uncheck-all"
                        title="Desmarcar todos los ítems de MDA"
                      >
                        <Icon name="boxicons:checkbox" size={13} class="text-base-content/40 shrink-0" />
                        <span>Ninguno</span>
                      </button>
                    </div>
                    <label class="label cursor-pointer gap-2 p-0 hover:opacity-85 transition-opacity">
                      <span class="label-text text-xxs font-bold uppercase tracking-wider text-base-content/70">
                        ¿Queda en MDA?
                      </span>
                      <input
                        type="checkbox"
                        name="staysInMda"
                        id="toggle-stays-mda"
                        class="toggle toggle-secondary toggle-xs"
                        checked
                      />
                    </label>
                  </div>
                </div>
                <div
                  id="invgate-ag-mda-block"
                  data-checklist-group="invgate-ag-s2"
                  class="space-y-0.5 divide-y divide-base-200/60 max-h-[380px] overflow-y-auto pr-1.5 scrollbar-thin transition-opacity duration-150"
                >
                  {
                    invgateAgParams
                      .filter((p) => p.section === "mda")
                      .map((p) => (
                        <div class="checklist-item py-2 px-1 transition-colors">
                          <div class="flex items-start justify-between gap-2.5">
                            <label class="label cursor-pointer justify-start gap-2.5 p-0 items-start flex-1 min-w-0">
                              <input
                                type="checkbox"
                                name={p.code}
                                class="checkbox checkbox-primary checkbox-xs sm:checkbox-sm audit-checkbox mt-0.5 shrink-0"
                                data-weight={p.weight ?? 0}
                                data-section="mda"
                                checked
                              />
                              <span class="label-text text-xs leading-snug text-base-content font-medium">
                                {p.name}
                                {p.weight ? (
                                  <span class="text-error font-semibold ml-1 text-xs">
                                    (-{p.weight}%)
                                  </span>
                                ) : (
                                  <span class="ml-1 text-xs opacity-50 font-normal">(n/a)</span>
                                )}
                              </span>
                            </label>
                            <div class="flex items-center gap-1 shrink-0">
                              <span
                                class="badge badge-warning badge-xs rule-auto-badge hidden font-semibold text-3xs"
                                data-rule-badge={p.code}
                              >
                                Regla
                              </span>
                              <button
                                type="button"
                                class="btn btn-ghost btn-2xs text-base-content/40 hover:text-secondary transition-colors toggle-obs-btn"
                                data-action="toggle-obs"
                                title="Agregar nota"
                              >
                                <Icon name="boxicons:message" size={13} />
                                <span class="text-3xs hidden sm:inline">Nota</span>
                              </button>
                            </div>
                          </div>
                          <div class="criteria-obs-wrapper hidden mt-2 pl-6">
                            <input
                              type="text"
                              name={`${p.code}_comment`}
                              placeholder="Motivo de penalización u observación..."
                              class="input input-xs bg-base-200/30 border border-base-200 focus:border-primary text-xs w-full placeholder:text-base-content/40 rounded-lg"
                            />
                          </div>
                        </div>
                      ))
                  }
                </div>
                <!-- Estado Vacío Elegante (Derivado fuera de MDA) -->
                <div
                  id="invgate-ag-mda-placeholder"
                  class="hidden flex-col items-center justify-center p-6 text-center rounded-xl bg-base-200/30 border border-dashed border-base-300 my-1"
                >
                  <div class="p-2.5 bg-base-200 text-base-content/40 rounded-xl mb-2">
                    <Icon name="boxicons:share" size={24} />
                  </div>
                  <h5 class="text-xs font-bold text-base-content mb-0.5">Caso derivado fuera de MDA</h5>
                  <p class="text-xxs text-base-content/50 max-w-xs leading-relaxed">
                    El caso no permanece en la mesa MDA. La evaluación computará únicamente la Sección 1.
                  </p>
                  <span class="badge badge-xs badge-ghost mt-2 font-semibold text-xxs">
                    Sección 2 excluida
                  </span>
                </div>
              </div>
            </div>

            <!-- Notas / Observaciones Generales -->
            <div class="bg-base-100 border border-base-200 rounded-xl p-3 shadow-2xs">
              <FormTextarea
                id="form-notes"
                name="notes"
                label="Notas y observaciones generales"
                placeholder="Observaciones de esta auditoría..."
                rows={2}
                textareaClass="textarea-xs font-medium"
              />
            </div>

          </div>
        </div>
      
</div>

<script>

  import { actions } from "astro:actions";
  import { getCleanBase } from "@lib/baseUrl";
  import { matchApprovedTitle, cleanHtmlText } from "@/lib/titleNormalizer";

  function initNewAuditForm() {
    const container = document.getElementById("new-audit-form-container");
    if (!container) return false;
    if (container.dataset.formBound === "true") return true;
    container.dataset.formBound = "true";
    const form = document.getElementById("audit-form") as HTMLFormElement;

    const cleanBase = getCleanBase();
    // container already declared above
    let approvedTitles: string[] = [];
    try {
      approvedTitles = container?.dataset.approvedTitles
        ? JSON.parse(container.dataset.approvedTitles)
        : [];
    } catch {
      approvedTitles = [];
    }

    const formChannelType = document.getElementById(
      "form-channel-type",
    ) as HTMLInputElement | null;
    const channelButtons = document.querySelectorAll(".channel-btn");

    // Search Inputs (integrados en "Datos de la atención")
    const wiseSearchInput = document.getElementById(
      "form-call-id",
    ) as HTMLInputElement | null;
    const btnFetchWise = document.getElementById(
      "btn-fetch-wise-api",
    ) as HTMLButtonElement | null;
    const wiseFeedbackAlert = document.getElementById("wise-feedback-alert");

    const invgateSearchInput = document.getElementById(
      "form-ticket-id",
    ) as HTMLInputElement | null;
    const btnFetchInvgate = document.getElementById(
      "btn-fetch-invgate-api",
    ) as HTMLButtonElement | null;
    const btnFetchInvgateLabel = document.getElementById(
      "btn-fetch-invgate-label",
    );
    const invgateFeedbackAlert = document.getElementById(
      "invgate-feedback-alert",
    );

    // Deep-link al ticket en InvGate
    const invgateWebBase = container?.dataset.invgateWebBase || "";
    const btnOpenInvgateTicket = document.getElementById(
      "btn-open-invgate-ticket",
    ) as HTMLAnchorElement | null;

    function syncInvgateDeepLink() {
      if (!btnOpenInvgateTicket) return;
      const ticketId = invgateSearchInput?.value.trim();
      if (!invgateWebBase || !ticketId) {
        btnOpenInvgateTicket.setAttribute("aria-disabled", "true");
        btnOpenInvgateTicket.classList.add("opacity-40", "pointer-events-none");
        btnOpenInvgateTicket.removeAttribute("href");
      } else {
        btnOpenInvgateTicket.removeAttribute("aria-disabled");
        btnOpenInvgateTicket.classList.remove("opacity-40", "pointer-events-none");
        btnOpenInvgateTicket.href = `${invgateWebBase}/requests/show/index/id/${encodeURIComponent(ticketId)}`;
      }
    }

    invgateSearchInput?.addEventListener("input", syncInvgateDeepLink);
    syncInvgateDeepLink();

    // Live Ticket Viewer Elements
    const ticketViewerHeader = document.getElementById("ticket-viewer-header");
    const ticketViewerContent = document.getElementById(
      "ticket-viewer-content",
    );
    const ticketViewerBadge = document.getElementById("ticket-viewer-badge");
    const ticketViewerToggleText = document.getElementById(
      "ticket-viewer-toggle-text",
    );
    const ticketViewerChevron = document.getElementById(
      "ticket-viewer-chevron",
    );
    const tvTitle = document.getElementById("tv-title");
    const tvTitleMatchBadge = document.getElementById("tv-title-match-badge");
    const tvCategory = document.getElementById("tv-category");
    const tvPriority = document.getElementById("tv-priority");
    const tvStatus = document.getElementById("tv-status");
    const tvCreator = document.getElementById("tv-creator");
    const tvCreatedBy = document.getElementById("tv-created-by");
    const tvHelpdesk = document.getElementById("tv-helpdesk");
    const tvSource = document.getElementById("tv-source");
    const tvResponseTime = document.getElementById("tv-response-time");
    const formTakeHint = document.getElementById("take-time-hint");

    const tvSourceMatchBadge = document.getElementById("tv-source-match-badge");
    const tvDescription = document.getElementById("tv-description");
    const tvAudioContainer = document.getElementById("tv-audio-container");
    const tvAudioPlayer = document.getElementById(
      "tv-audio-player",
    ) as HTMLAudioElement | null;
    const tvAudioDownload = document.getElementById(
      "tv-audio-download",
    ) as HTMLAnchorElement | null;
    const formRecordingUrl = document.getElementById(
      "form-recording-url",
    ) as HTMLInputElement | null;

    // Ticket Viewer Accordion Toggle
    ticketViewerHeader?.addEventListener("click", (ev) => {
      // El deep-link a InvGate no debe togglear el acordeón
      if ((ev.target as HTMLElement)?.closest("#btn-open-invgate-ticket")) return;
      if (!ticketViewerContent) return;
      const isHidden = ticketViewerContent.classList.contains("hidden");
      if (isHidden) {
        ticketViewerContent.classList.remove("hidden");
        if (ticketViewerToggleText)
          ticketViewerToggleText.textContent = "Ocultar";
        if (ticketViewerChevron)
          ticketViewerChevron.classList.add("rotate-180");
      } else {
        ticketViewerContent.classList.add("hidden");
        if (ticketViewerToggleText)
          ticketViewerToggleText.textContent = "Mostrar";
        if (ticketViewerChevron)
          ticketViewerChevron.classList.remove("rotate-180");
      }
    });

    // Helper para badges de reglas en parámetros
    function setParamRuleBadge(
      code: string,
      active: boolean,
      text = "Desactivado por regla",
    ) {
      const badge = document.querySelector(
        `.rule-auto-badge[data-rule-badge="${code}"]`,
      ) as HTMLElement | null;
      if (!badge) return;
      if (active) {
        badge.textContent = text;
        badge.classList.remove("hidden");
      } else {
        badge.classList.add("hidden");
      }
    }

    function clearAllRuleBadges() {
      document.querySelectorAll(".rule-auto-badge").forEach((el) => {
        el.classList.add("hidden");
      });
    }

    // Auto-evaluación del parámetro Título
    function evaluateTicketTitle(titleStr: string) {
      if (!titleStr) return;
      const channel = formChannelType?.value || "wise_call";
      let checkboxName = "call_ticket_titulo";
      if (channel === "wise_email") checkboxName = "email_mda_titulo";
      else if (channel === "invgate_ticket") checkboxName = "ag_titulo";

      const checkbox = document.querySelector(
        `input[name="${checkboxName}"]`,
      ) as HTMLInputElement | null;
      const match = matchApprovedTitle(titleStr, approvedTitles);

      if (tvTitleMatchBadge) {
        if (match.matched) {
          tvTitleMatchBadge.innerHTML = `
            <span class="badge badge-xs badge-success font-semibold gap-1 text-[11px]" title="Coincide con: ${match.matchedTitle}">
              <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Título Homologado
            </span>
          `;
          if (checkbox) checkbox.checked = true;
          setParamRuleBadge(checkboxName, false);
        } else {
          tvTitleMatchBadge.innerHTML = `
            <span class="badge badge-xs badge-warning font-semibold text-[11px]" title="No coincide con catálogo de títulos">
              No Homologado
            </span>
          `;
          if (checkbox) checkbox.checked = false;
          setParamRuleBadge(checkboxName, true, "Desactivado por regla");
        }
      }
      recalculateScores();
    }

    // Auto-evaluación del parámetro Origen de la solicitud
    function evaluateTicketSource(sourceStr: string) {
      const channel = formChannelType?.value || "wise_call";
      if (channel === "invgate_ticket") {
        if (tvSourceMatchBadge) tvSourceMatchBadge.innerHTML = "";
        return;
      }

      let checkboxName = "";
      let isValid = false;

      const norm = (sourceStr || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();

      if (channel === "wise_call") {
        checkboxName = "call_ticket_origen";
        isValid = norm.includes("tel") || norm.includes("llamada");
      } else if (channel === "wise_email") {
        checkboxName = "email_mda_origen";
        isValid = norm.includes("corr") || norm.includes("mail");
      }

      if (!checkboxName) return;

      const checkbox = document.querySelector(
        `input[name="${checkboxName}"]`,
      ) as HTMLInputElement | null;

      if (tvSourceMatchBadge) {
        if (isValid) {
          tvSourceMatchBadge.innerHTML = `
            <span class="badge badge-xs badge-success font-semibold gap-1 text-[11px]" title="Origen coincide con el canal">
              <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Válido
            </span>
          `;
        } else {
          tvSourceMatchBadge.innerHTML = `
            <span class="badge badge-xs badge-warning font-semibold text-[11px]" title="El origen del ticket no coincide con el canal auditado">
              No coincide
            </span>
          `;
        }
      }

      if (isValid) {
        if (checkbox) checkbox.checked = true;
        setParamRuleBadge(checkboxName, false);
      } else {
        if (checkbox) checkbox.checked = false;
        setParamRuleBadge(checkboxName, true, "Origen incorrecto");
      }

      recalculateScores();
    }

    // Actualizar datos en el Visor de Ticket
    function populateTicketViewer(data: any) {
      const title = data.title || data.rawDetails?.title || "Sin título";
      const category =
        data.category || data.rawDetails?.category || "Sin categoría";
      const priority = data.priority || data.rawDetails?.priority || "Media";
      const status = data.status || data.rawDetails?.status || "Abierto";
      const creator = data.customer || data.creator || data.rawDetails?.customer || data.rawDetails?.creator || "Desconocido";
      const createdBy = data.createdBy || data.rawDetails?.createdBy || creator;
      const helpdesk =
        data.helpdesk || data.rawDetails?.helpdesk || "Sin mesa asignada";
      const source = data.source || data.rawDetails?.source || "Sin origen";
      const description =
        data.description ||
        data.rawDetails?.description ||
        "Sin descripción disponible";

      if (tvTitle) tvTitle.textContent = title;
      if (tvCategory) tvCategory.textContent = category;
      if (tvPriority) tvPriority.textContent = priority;
      if (tvStatus) tvStatus.textContent = status;
      if (tvCreator) tvCreator.textContent = creator;
      if (tvCreatedBy) tvCreatedBy.textContent = createdBy;
      if (tvHelpdesk) tvHelpdesk.textContent = helpdesk;
      if (tvSource) tvSource.textContent = source;

      if (tvResponseTime) {
        const human = data.rawDetails?.responseHuman;
        tvResponseTime.textContent = data.takeTime ? `${data.takeTime}${human ? ` (${human})` : ""}` : "-";
      }

      if (formTakeHint) {
        if (data.rawDetails?.reassignedWithoutComment) {
          formTakeHint.textContent = `Sin comentarios. Verificar en InvGate.`;
          formTakeHint.classList.remove("hidden");
        } else {
          const human = data.rawDetails?.responseHuman;
          if (human) {
            formTakeHint.textContent = `~${human}`;
            formTakeHint.classList.remove("hidden");
          } else if (data.takeTime) {
            formTakeHint.textContent = data.takeTime;
            formTakeHint.classList.remove("hidden");
          } else {
            formTakeHint.classList.add("hidden");
          }
        }
      }

      if (tvDescription)
        tvDescription.textContent =
          cleanHtmlText(description) || "Sin descripción disponible";

      if (ticketViewerBadge) {
        const ticketLabel = `Ticket #${data.caseNumber || data.rawDetails?.incidentId || ""}`;
        ticketViewerBadge.textContent = ticketLabel;
        ticketViewerBadge.setAttribute("title", ticketLabel);
        ticketViewerBadge.classList.remove("badge-ghost", "font-medium");
        ticketViewerBadge.classList.add("badge-neutral", "font-semibold");
      }

      // Expandir visor para visualización inmediata
      if (ticketViewerContent) {
        ticketViewerContent.classList.remove("hidden");
        if (ticketViewerToggleText)
          ticketViewerToggleText.textContent = "Ocultar";
        if (ticketViewerChevron)
          ticketViewerChevron.classList.add("rotate-180");
      }

      evaluateTicketTitle(title);
      evaluateTicketSource(source);
    }

    // Resetear visor de ticket
    function resetTicketViewer() {
      if (tvTitle) tvTitle.textContent = "-";
      if (tvCategory) tvCategory.textContent = "-";
      if (tvPriority) tvPriority.textContent = "-";
      if (tvStatus) tvStatus.textContent = "-";
      if (tvCreator) tvCreator.textContent = "-";
      if (tvHelpdesk) tvHelpdesk.textContent = "-";
      if (tvSource) tvSource.textContent = "-";
      if (tvResponseTime) tvResponseTime.textContent = "-";
      if (formTakeHint) {
        formTakeHint.textContent = "";
        formTakeHint.classList.add("hidden");
      }
      if (tvDescription) tvDescription.textContent = "-";
      if (tvTitleMatchBadge) tvTitleMatchBadge.innerHTML = "";
      if (tvSourceMatchBadge) tvSourceMatchBadge.innerHTML = "";
      if (ticketViewerBadge) {
        ticketViewerBadge.textContent = "Sin ticket cargado";
        ticketViewerBadge.setAttribute("title", "Sin ticket cargado");
        ticketViewerBadge.classList.remove("badge-neutral", "font-semibold");
        ticketViewerBadge.classList.add("badge-ghost", "font-medium");
      }
      if (ticketViewerContent) ticketViewerContent.classList.add("hidden");
      if (ticketViewerToggleText) ticketViewerToggleText.textContent = "Mostrar";
      if (ticketViewerChevron) ticketViewerChevron.classList.remove("rotate-180");
      syncInvgateDeepLink();
      clearAllRuleBadges();
    }

    // Resetear reproductor de audio
    function resetAudioPlayer() {
      if (tvAudioContainer) tvAudioContainer.classList.add("hidden");
      if (tvAudioPlayer) {
        tvAudioPlayer.pause();
        tvAudioPlayer.src = "";
      }
      if (tvAudioDownload) tvAudioDownload.href = "#";
      if (formRecordingUrl) formRecordingUrl.value = "";
    }

    // Cambio de Pestañas / Canales
    channelButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const channel = btn.getAttribute("data-channel");
        if (!channel) return;

        channelButtons.forEach((b) => {
          b.classList.remove("btn-active", "bg-base-100", "text-secondary", "font-bold", "shadow-2xs");
          b.classList.add("font-medium", "text-base-content/70", "hover:text-secondary");
        });
        btn.classList.add("btn-active", "bg-base-100", "text-secondary", "font-bold", "shadow-2xs");
        btn.classList.remove("font-medium", "text-base-content/70", "hover:text-secondary");
        if (formChannelType) formChannelType.value = channel;

        // Toggle checklists
        document
          .querySelectorAll(".channel-checklist")
          .forEach((el) => el.classList.add("hidden"));
        const targetChecklist = document.getElementById(
          `channel-checklist-${channel}`,
        );
        if (targetChecklist) targetChecklist.classList.remove("hidden");

        // Toggle channel specific meta fields
        const metaDuration = document.getElementById("meta-duration-container");
        const metaRing = document.getElementById("meta-ring-container");
        const metaCreation = document.getElementById("meta-creation-container");
        const metaTake = document.getElementById("meta-take-container");
        const metaPas = document.getElementById("meta-pas-container");

        if (metaDuration) {
          metaDuration.classList.toggle("hidden", channel === "invgate_ticket");
          const legend = metaDuration.querySelector("legend");
          if (legend) {
            legend.textContent = channel === "wise_email" ? "Respuesta" : "Duración";
          }
          const formDurationInput = document.getElementById(
            "form-duration",
          ) as HTMLInputElement | null;
          if (formDurationInput) {
            formDurationInput.placeholder = channel === "wise_email" ? "19:14" : "02:15";
          }
        }
        if (metaRing)
          metaRing.classList.toggle("hidden", channel !== "wise_call");
        if (metaCreation)
          metaCreation.classList.toggle("hidden", channel !== "invgate_ticket");
        if (metaTake)
          metaTake.classList.toggle("hidden", channel !== "invgate_ticket");
        if (metaPas)
          metaPas.classList.toggle("hidden", channel !== "invgate_ticket");

        const formDuration = document.getElementById(
          "form-duration",
        ) as HTMLInputElement | null;
        if (channel === "invgate_ticket" && formDuration && !formDuration.value) {
          formDuration.value = "00:00";
        }

        if (channel === "wise_call") {
          const formAuditId = document.getElementById(
            "form-audit-id",
          ) as HTMLInputElement | null;
          if (!formAuditId || !formAuditId.value) {
            if (toggleCallGeneratedTicket) {
              toggleCallGeneratedTicket.checked = true;
              wiseCallTicketBlock?.classList.remove("hidden");
              wiseCallTicketPlaceholder?.classList.add("hidden");
            }
          }
        }

        // Reset search feedback on tab switch
        if (wiseFeedbackAlert) wiseFeedbackAlert.classList.add("hidden");
        if (invgateFeedbackAlert) invgateFeedbackAlert.classList.add("hidden");

        // Re-evaluar reglas automáticas con el nuevo canal si hay ticket cargado
        if (tvTitle && tvTitle.textContent && tvTitle.textContent !== "-") {
          evaluateTicketTitle(tvTitle.textContent);
        }
        if (tvSource && tvSource.textContent && tvSource.textContent !== "-") {
          evaluateTicketSource(tvSource.textContent);
        }

        if (channel === "wise_call") {
          const mode = (callTicketModeInput?.value as "nuevo" | "reclamo") || "nuevo";
          if (formIsReclamoInput) formIsReclamoInput.value = mode === "reclamo" ? "true" : "false";
        } else if (channel === "wise_email") {
          const mode = (emailTicketModeInput?.value as "nuevo" | "reclamo") || "nuevo";
          if (formIsReclamoInput) formIsReclamoInput.value = (toggleAppliesMda?.checked && mode === "reclamo") ? "true" : "false";
        } else {
          if (formIsReclamoInput) formIsReclamoInput.value = "false";
        }

        recalculateScores();
      });
    });

    // Feedback con auto-dismiss
    let wiseFeedbackTimeout: any = null;
    let invgateFeedbackTimeout: any = null;

    function showFeedbackMessage(
      el: HTMLElement | null,
      content: string,
      type: "success" | "error" | "warning" | "info",
      isWise: boolean,
    ) {
      if (!el) return;
      if (isWise && wiseFeedbackTimeout) clearTimeout(wiseFeedbackTimeout);
      if (!isWise && invgateFeedbackTimeout) clearTimeout(invgateFeedbackTimeout);

      el.innerHTML = content;
      const typeClasses =
        type === "success"
          ? "border-success/30 bg-success/10 text-success"
          : type === "warning"
            ? "border-warning/30 bg-warning/10 text-warning"
            : type === "info"
              ? "border-info/30 bg-info/10 text-info"
              : "border-error/30 bg-error/10 text-error";

      el.className = `flex items-center gap-2 rounded-xl border px-2.5 py-1.5 text-xs font-semibold shadow-2xs transition-all duration-200 ${typeClasses}`;
      el.classList.remove("hidden");

      const timeout = setTimeout(() => {
        el.classList.add("hidden");
      }, 4500);

      if (isWise) wiseFeedbackTimeout = timeout;
      else invgateFeedbackTimeout = timeout;
    }

    // 1. Buscador Wise CX
    if (btnFetchWise && wiseSearchInput) {
      wiseSearchInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          btnFetchWise.click();
        }
      });

      btnFetchWise.addEventListener("click", async () => {
        const id = wiseSearchInput.value.trim();
        if (!id) {
          showFeedbackMessage(
            wiseFeedbackAlert,
            "Ingrese un número o ID de caso Wise.",
            "warning",
            true,
          );
          return;
        }

        const channel = formChannelType?.value || "wise_call";
        const originalHtml = btnFetchWise.innerHTML;
        btnFetchWise.disabled = true;
        btnFetchWise.innerHTML =
          '<span class="loading loading-spinner loading-xs"></span>';
        if (wiseFeedbackAlert) wiseFeedbackAlert.classList.add("hidden");

        try {
          const res = await fetch(
            `${cleanBase}api/calidad/fetch-metadata?channel=${channel}&id=${encodeURIComponent(id)}&source=wise`,
          );
          const json = await res.json();

          if (!res.ok || !json.data) {
            showFeedbackMessage(
              wiseFeedbackAlert,
              json.error || "No se encontró el caso en Wise CX.",
              "error",
              true,
            );
            return;
          }

          const d = json.data;

          // Auto-conmutación de canal si se detectó un tipo distinto al seleccionado
          let channelSwitched = false;
          if (
            d.detectedChannel &&
            formChannelType &&
            formChannelType.value !== d.detectedChannel
          ) {
            const targetBtn = document.querySelector(
              `.channel-btn[data-channel="${d.detectedChannel}"]`,
            ) as HTMLButtonElement | null;
            if (targetBtn) {
              targetBtn.click();
              channelSwitched = true;
            }
          }

          const formCallId = document.getElementById(
            "form-call-id",
          ) as HTMLInputElement;
          const formTicketId = document.getElementById(
            "form-ticket-id",
          ) as HTMLInputElement;
          const formDuration = document.getElementById(
            "form-duration",
          ) as HTMLInputElement;
          const formDate = document.getElementById(
            "form-date",
          ) as HTMLInputElement;
          const formRing = document.getElementById(
            "form-ring-time",
          ) as HTMLInputElement;
          const formCreation = document.getElementById(
            "form-creation-time",
          ) as HTMLInputElement;
          const formTake = document.getElementById(
            "form-take-time",
          ) as HTMLInputElement;

          if (formCallId && d.caseNumber) formCallId.value = d.caseNumber;
          if (formDuration && d.duration) formDuration.value = d.duration;
          if (formDate && d.date) formDate.value = d.date;
          if (formRing && d.ringTime) formRing.value = d.ringTime;
          if (formCreation && d.creationTime)
            formCreation.value = d.creationTime;
          if (formTake && d.takeTime) formTake.value = d.takeTime;
          if (formRecordingUrl && d.recordingUrl)
            formRecordingUrl.value = d.recordingUrl;

          if (formTicketId && !formTicketId.value && d.rawDetails?.incidentId) {
            formTicketId.value = d.rawDetails.incidentId.toString();
          }
          syncInvgateDeepLink();

          // Reproductor de audio independiente
          if (d.recordingUrl && tvAudioContainer && tvAudioPlayer && tvAudioDownload) {
            const caseId = d.caseNumber || "llamada";
            const downloadUrl = `${cleanBase}api/calidad/download-audio?url=${encodeURIComponent(d.recordingUrl)}&filename=grabacion-caso-${encodeURIComponent(caseId)}.mp3&download=1`;
            tvAudioPlayer.src = d.recordingUrl;
            tvAudioPlayer.load();
            tvAudioDownload.href = downloadUrl;
            tvAudioContainer.classList.remove("hidden");
          } else if (tvAudioContainer) {
            tvAudioContainer.classList.add("hidden");
            if (tvAudioPlayer) {
              tvAudioPlayer.pause();
              tvAudioPlayer.src = "";
            }
          }

          const channelTag =
            d.detectedChannel === "wise_email"
              ? "Mail Wise"
              : d.detectedChannel === "wise_call"
                ? "Llamada Wise"
                : "";

          const successMsg = channelSwitched
            ? `✓ Caso detectado como ${channelTag} (canal cambiado): ${d.operator || ""} ${d.duration ? `(${d.duration})` : ""}`
            : `✓ Caso obtenido [${channelTag}]: ${d.operator || ""} ${d.duration ? `(${d.duration})` : ""}`;

          showFeedbackMessage(
            wiseFeedbackAlert,
            successMsg,
            channelSwitched ? "info" : "success",
            true,
          );
        } catch (err) {
          showFeedbackMessage(
            wiseFeedbackAlert,
            "Error de red al consultar Wise CX.",
            "error",
            true,
          );
        } finally {
          btnFetchWise.disabled = false;
          btnFetchWise.innerHTML = originalHtml;
        }
      });
    }

    // 2. Buscador InvGate
    if (btnFetchInvgate && invgateSearchInput) {
      invgateSearchInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          btnFetchInvgate.click();
        }
      });

      btnFetchInvgate.addEventListener("click", async () => {
        const id = invgateSearchInput.value.trim();
        if (!id) {
          showFeedbackMessage(
            invgateFeedbackAlert,
            "Ingrese un número o ID de incidente InvGate.",
            "warning",
            false,
          );
          return;
        }

        const channel = formChannelType?.value || "wise_call";
        const originalHtml = btnFetchInvgate.innerHTML;
        btnFetchInvgate.disabled = true;
        btnFetchInvgate.innerHTML =
          '<span class="loading loading-spinner loading-xs"></span>';
        if (invgateFeedbackAlert) invgateFeedbackAlert.classList.add("hidden");

        const formAgentId = document.getElementById(
          "form-agent-id",
        ) as HTMLInputElement;
        const agentIdParam = formAgentId?.value
          ? `&agentId=${encodeURIComponent(formAgentId.value)}`
          : "";

        try {
          const res = await fetch(
            `${cleanBase}api/calidad/fetch-metadata?channel=invgate_ticket&id=${encodeURIComponent(id)}&source=invgate${agentIdParam}`,
          );
          const json = await res.json();

          if (!res.ok || !json.data) {
            showFeedbackMessage(
              invgateFeedbackAlert,
              json.error || "No se encontró el ticket en InvGate.",
              "error",
              false,
            );
            return;
          }

          const d = json.data;
          const formCallId = document.getElementById(
            "form-call-id",
          ) as HTMLInputElement;
          const formTicketId = document.getElementById(
            "form-ticket-id",
          ) as HTMLInputElement;
          const formDate = document.getElementById(
            "form-date",
          ) as HTMLInputElement;
          const formCreation = document.getElementById(
            "form-creation-time",
          ) as HTMLInputElement;
          const formTake = document.getElementById(
            "form-take-time",
          ) as HTMLInputElement;
          const formIsPas = document.getElementById(
            "form-is-pas",
          ) as HTMLInputElement;

          if (formTicketId && d.caseNumber) formTicketId.value = d.caseNumber;
          syncInvgateDeepLink();
          if (channel === "invgate_ticket") {
            if (formCallId && !formCallId.value && d.caseNumber)
              formCallId.value = d.caseNumber;
            if (formDate && d.date) formDate.value = d.date;
            if (formCreation && d.creationTime)
              formCreation.value = d.creationTime;
            if (d.takeTime && formTake) formTake.value = d.takeTime;
            if (formIsPas && typeof d.isPas === "boolean")
              formIsPas.checked = d.isPas;
          }

          // Cargar datos en el Visor de Ticket y auto-evaluar título
          populateTicketViewer(d);

          if (d.rawDetails?.reassignedWithoutComment) {
            showFeedbackMessage(
              invgateFeedbackAlert,
              `✓ Ticket #${d.caseNumber} cargado. Sin comentarios del operador evaluado. Verificar en InvGate.`,
              "warning",
              false,
            );
          } else {
            showFeedbackMessage(
              invgateFeedbackAlert,
              `✓ Ticket #${d.caseNumber} cargado ${d.isPas ? "[PAS]" : ""}`,
              "success",
              false,
            );
          }
        } catch (err) {
          showFeedbackMessage(
            invgateFeedbackAlert,
            "Error de red al consultar InvGate.",
            "error",
            false,
          );
        } finally {
          btnFetchInvgate.disabled = false;
          btnFetchInvgate.innerHTML = originalHtml;
        }
      });
    }

    const toggleCallGeneratedTicket = document.getElementById(
      "toggle-call-generated-ticket",
    ) as HTMLInputElement;
    const callTicketModeInput = document.getElementById(
      "call-ticket-mode",
    ) as HTMLInputElement;
    const formIsReclamoInput = document.getElementById(
      "form-is-reclamo-novedad",
    ) as HTMLInputElement;
    const ticketModeButtons = document.querySelectorAll<HTMLButtonElement>(
      ".ticket-mode-btn",
    );
    const wiseCallTicketBlock = document.getElementById(
      "wise-call-ticket-block",
    );
    const wiseCallTicketActions = document.getElementById(
      "wise-call-ticket-actions",
    );
    const wiseCallReclamoCard = document.getElementById(
      "wise-call-reclamo-card",
    );
    const wiseCallTicketPlaceholder = document.getElementById(
      "wise-call-ticket-placeholder",
    );

    function setTicketMode(mode: "nuevo" | "reclamo") {
      if (callTicketModeInput) callTicketModeInput.value = mode;
      if (formIsReclamoInput) formIsReclamoInput.value = mode === "reclamo" ? "true" : "false";
      if (toggleCallGeneratedTicket) toggleCallGeneratedTicket.checked = true;

      ticketModeButtons.forEach((btn) => {
        const btnMode = btn.getAttribute("data-mode");
        const isActive = btnMode === mode;
        btn.classList.toggle("btn-active", isActive);
        btn.classList.toggle("bg-secondary", isActive);
        btn.classList.toggle("text-secondary-content", isActive);
        btn.classList.toggle("font-bold", isActive);
        btn.classList.toggle("shadow-xs", isActive);
        btn.classList.toggle("text-base-content/75", !isActive);
        btn.classList.toggle("font-medium", !isActive);
      });

      if (mode === "reclamo") {
        wiseCallTicketBlock?.classList.add("hidden");
        wiseCallTicketActions?.classList.add("hidden");
        wiseCallReclamoCard?.classList.remove("hidden");
        wiseCallReclamoCard?.classList.add("flex");
        wiseCallTicketPlaceholder?.classList.add("hidden");
      } else {
        wiseCallTicketBlock?.classList.remove("hidden");
        wiseCallTicketActions?.classList.remove("hidden");
        wiseCallReclamoCard?.classList.add("hidden");
        wiseCallReclamoCard?.classList.remove("flex");
        wiseCallTicketPlaceholder?.classList.add("hidden");
      }

      recalculateScores();
    }

    ticketModeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.getAttribute("data-mode") as "nuevo" | "reclamo";
        setTicketMode(mode || "nuevo");
      });
    });

    (window as any).setAuditTicketMode = setTicketMode;

    // Botones de marcado / desmarcado masivo de sección ("Todos" / "Ninguno")
    document.querySelectorAll<HTMLButtonElement>(".toggle-all-section-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetGroup = btn.getAttribute("data-target-group");
        const action = btn.getAttribute("data-action");
        if (!targetGroup) return;

        const container = document.querySelector(`[data-checklist-group="${targetGroup}"]`);
        if (!container) return;

        // Feedback táctil visual instantáneo en el botón
        btn.classList.add("bg-base-200/90", "ring-1", action === "check-all" ? "ring-secondary/40" : "ring-base-content/20");
        setTimeout(() => {
          btn.classList.remove("bg-base-200/90", "ring-1", "ring-secondary/40", "ring-base-content/20");
        }, 180);

        // Feedback visual sutil en el contenedor de ítems
        container.classList.add("opacity-60");
        setTimeout(() => {
          container.classList.remove("opacity-60");
        }, 120);

        const shouldCheck = action === "check-all";
        container.querySelectorAll<HTMLInputElement>(".audit-checkbox").forEach((cb) => {
          cb.checked = shouldCheck;
          // Si desmarca, revela observaciones si corresponde
          const item = cb.closest(".checklist-item");
          const wrapper = item?.querySelector(".criteria-obs-wrapper");
          const inp = wrapper?.querySelector<HTMLInputElement>("input");
          if (!shouldCheck) {
            wrapper?.classList.remove("hidden");
          } else {
            if (inp && !inp.value.trim()) {
              wrapper?.classList.add("hidden");
            }
          }
        });

        recalculateScores();
      });
    });

    toggleCallGeneratedTicket?.addEventListener("change", () => {
      const active = toggleCallGeneratedTicket.checked;
      if (!active) {
        wiseCallTicketBlock?.classList.add("hidden");
        wiseCallTicketActions?.classList.add("hidden");
        wiseCallReclamoCard?.classList.add("hidden");
        wiseCallTicketPlaceholder?.classList.remove("hidden");
      } else {
        const mode = (callTicketModeInput?.value as "nuevo" | "reclamo") || "nuevo";
        setTicketMode(mode);
      }
      recalculateScores();
    });

    const toggleAppliesMda = document.getElementById(
      "toggle-applies-mda",
    ) as HTMLInputElement | null;
    const emailTicketModeInput = document.getElementById(
      "email-ticket-mode",
    ) as HTMLInputElement | null;
    const emailTicketModeJoin = document.getElementById(
      "email-ticket-mode-join",
    );
    const emailTicketModeButtons = document.querySelectorAll<HTMLButtonElement>(
      ".email-ticket-mode-btn",
    );
    const wiseEmailMdaActions = document.getElementById(
      "wise-email-mda-actions",
    );
    const wiseEmailReclamoCard = document.getElementById(
      "wise-email-reclamo-card",
    );
    const wiseEmailMdaBlock = document.getElementById("wise-email-mda-block");

    function setEmailTicketMode(mode: "nuevo" | "reclamo") {
      if (emailTicketModeInput) emailTicketModeInput.value = mode;
      if (formIsReclamoInput && (formChannelType?.value || "wise_call") === "wise_email") {
        formIsReclamoInput.value = mode === "reclamo" ? "true" : "false";
      }

      emailTicketModeButtons.forEach((btn) => {
        const btnMode = btn.getAttribute("data-mode");
        const isActive = btnMode === mode;
        btn.classList.toggle("btn-active", isActive);
        btn.classList.toggle("bg-secondary", isActive);
        btn.classList.toggle("text-secondary-content", isActive);
        btn.classList.toggle("font-bold", isActive);
        btn.classList.toggle("shadow-xs", isActive);
        btn.classList.toggle("text-base-content/75", !isActive);
        btn.classList.toggle("font-medium", !isActive);
      });

      if (mode === "reclamo") {
        wiseEmailMdaBlock?.classList.add("hidden");
        wiseEmailMdaActions?.classList.add("hidden");
        wiseEmailReclamoCard?.classList.remove("hidden");
        wiseEmailReclamoCard?.classList.add("flex");
      } else {
        wiseEmailMdaBlock?.classList.remove("hidden");
        wiseEmailMdaActions?.classList.remove("hidden");
        wiseEmailReclamoCard?.classList.add("hidden");
        wiseEmailReclamoCard?.classList.remove("flex");
      }

      recalculateScores();
    }

    emailTicketModeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.getAttribute("data-mode") as "nuevo" | "reclamo";
        setEmailTicketMode(mode || "nuevo");
      });
    });

    (window as any).setAuditEmailTicketMode = setEmailTicketMode;

    const toggleStaysMda = document.getElementById(
      "toggle-stays-mda",
    ) as HTMLInputElement;
    const invgateAgMdaBlock = document.getElementById("invgate-ag-mda-block");
    const invgateAgMdaPlaceholder = document.getElementById(
      "invgate-ag-mda-placeholder",
    );

    toggleStaysMda?.addEventListener("change", () => {
      const active = toggleStaysMda.checked;
      invgateAgMdaBlock?.classList.toggle("hidden", !active);
      invgateAgMdaPlaceholder?.classList.toggle("hidden", active);
      recalculateScores();
    });

    // Revelado Progresivo de Observaciones / Notas
    function toggleCriterionObservation(btn: HTMLElement) {
      const item = btn.closest(".checklist-item");
      if (!item) return;
      const wrapper = item.querySelector(".criteria-obs-wrapper");
      if (!wrapper) return;
      const isHidden = wrapper.classList.contains("hidden");
      if (isHidden) {
        wrapper.classList.remove("hidden");
        const inp = wrapper.querySelector("input");
        inp?.focus();
      } else {
        wrapper.classList.add("hidden");
      }
    }

    document.querySelectorAll('[data-action="toggle-obs"]').forEach((el) => {
      el.addEventListener("click", () => {
        toggleCriterionObservation(el as HTMLElement);
      });
    });

    // Checkbox change handler: muestra u oculta observaciones según necesidad
    document.querySelectorAll(".audit-checkbox").forEach((el) => {
      const cb = el as HTMLInputElement;
      cb.addEventListener("change", () => {
        if (cb.checked) {
          setParamRuleBadge(cb.name, false);
        }

        const item = cb.closest(".checklist-item");
        const wrapper = item?.querySelector(".criteria-obs-wrapper");
        const inp = wrapper?.querySelector<HTMLInputElement>("input");

        if (!cb.checked) {
          // Desmarcado (penalización): revelar automáticamente para documentar
          wrapper?.classList.remove("hidden");
          inp?.focus();
        } else {
          // Si vuelve a marcarse y no hay comentario, ocultar
          if (inp && !inp.value.trim()) {
            wrapper?.classList.add("hidden");
          }
        }

        recalculateScores();
      });
    });

    // Función para refrescar visibilidad de notas en modo edición
    function refreshAuditCommentsVisibility() {
      document.querySelectorAll(".checklist-item").forEach((item) => {
        const cb = item.querySelector<HTMLInputElement>(".audit-checkbox");
        const inp = item.querySelector<HTMLInputElement>("input[name$='_comment']");
        const wrapper = item.querySelector(".criteria-obs-wrapper");
        if (!wrapper) return;

        if ((cb && !cb.checked) || (inp && inp.value.trim() !== "")) {
          wrapper.classList.remove("hidden");
        } else {
          wrapper.classList.add("hidden");
        }
      });
    }

    function recalculateScores() {
      const channel = formChannelType?.value || "wise_call";
      const checklist = document.getElementById(`channel-checklist-${channel}`);
      if (!checklist) return;

      let s1Deductions = 0;
      let s2Deductions = 0;

      checklist
        .querySelectorAll<HTMLInputElement>(".audit-checkbox")
        .forEach((cb) => {
          const weight = parseFloat(cb.getAttribute("data-weight") || "0");
          const section = cb.getAttribute("data-section");
          if (!cb.checked && weight > 0) {
            if (section === "items") {
              s1Deductions += weight;
            } else {
              s2Deductions += weight;
            }
          }
        });

      let s1Score = 0;
      let s2Score = 0;
      let total = 0;
      let hasSection2 = true;

      if (channel === "wise_call") {
        const mode = (callTicketModeInput?.value as "nuevo" | "reclamo") || "nuevo";
        const isReclamo = mode === "reclamo";
        hasSection2 = toggleCallGeneratedTicket?.checked ?? true;
        const s1Raw = Math.max(0, 45 - s1Deductions);
        s1Score = Math.round((s1Raw / 45) * 100);
        if (hasSection2) {
          if (isReclamo) {
            s2Score = 100;
            total = s1Raw + 55;
          } else {
            const s2Raw = Math.max(0, 55 - s2Deductions);
            s2Score = Math.round((s2Raw / 55) * 100);
            total = s1Raw + s2Raw;
          }
        } else {
          s2Score = 0;
          total = s1Score;
        }
      } else {
        if (channel === "wise_email") {
          hasSection2 = true;
          const emailMode = (emailTicketModeInput?.value as "nuevo" | "reclamo") || "nuevo";
          const isReclamo = emailMode === "reclamo";
          s1Score = Math.max(0, Math.round(100 - s1Deductions));
          if (isReclamo) {
            s2Score = 100;
            total = Math.round((s1Score + 100) / 2);
          } else {
            s2Score = Math.max(0, Math.round(100 - s2Deductions));
            total = Math.round((s1Score + s2Score) / 2);
          }
        } else if (channel === "invgate_ticket") {
          hasSection2 = toggleStaysMda?.checked ?? true;
          s1Score = Math.max(0, Math.round(100 - s1Deductions));
          s2Score = hasSection2 ? Math.max(0, Math.round(100 - s2Deductions)) : 0;
          total = hasSection2 ? Math.round((s1Score + s2Score) / 2) : s1Score;
        }
      }

      const pS1 = document.getElementById("preview-s1");
      const pS2 = document.getElementById("preview-s2");
      const pS2Block = document.getElementById("preview-s2-block");
      const pTotal = document.getElementById("preview-total");

      if (pS1) pS1.textContent = `${s1Score}%`;
      
      if (pS2) {
        if (!hasSection2) {
          pS2.textContent = "N/A";
        } else {
          pS2.textContent = `${s2Score}%`;
        }
      }
      if (pS2Block) pS2Block.style.opacity = hasSection2 ? "1" : "0.3";

      if (pTotal) {
        pTotal.textContent = `${total}%`;
        pTotal.className = `text-2xl sm:text-3xl font-black font-mono tracking-tight leading-none mt-0.5 ${total >= 90 ? "text-success" : total >= 80 ? "text-warning" : "text-error"}`;
      }
    }

    (window as any).recalculateAuditScores = recalculateScores;
    (window as any).refreshAuditCommentsVisibility = refreshAuditCommentsVisibility;
    (window as any).resetTicketViewer = () => {
      resetTicketViewer();
      resetAudioPlayer();
      syncInvgateDeepLink();
    };
    (window as any).syncInvgateDeepLink = syncInvgateDeepLink;
    // SUBMIT HANDLER
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const btnSubmit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const originalText = btnSubmit ? btnSubmit.innerHTML : "";
        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.innerHTML = '<span class="loading loading-spinner loading-xs"></span> Guardando…';
        }

        const formData = new FormData(form as HTMLFormElement);
        const agentIdVal = (formData.get("agentId") as string)?.trim();
        if (!agentIdVal) {
          alert("Debe seleccionar un operador a auditar.");
          const selectAgent = document.getElementById("form-agent-id");
          selectAgent?.focus();
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = originalText;
          }
          return;
        }

        if (callTicketModeInput) {
          formData.set("callTicketMode", callTicketModeInput.value);
        }
        if (emailTicketModeInput) {
          formData.set("emailTicketMode", emailTicketModeInput.value);
        }
        if (formIsReclamoInput) {
          formData.set("isReclamoNovedad", formIsReclamoInput.value);
        }
        if (toggleCallGeneratedTicket) {
          formData.set("callGeneratedTicket", toggleCallGeneratedTicket.checked ? "true" : "false");
        }
        if (toggleAppliesMda) {
          formData.set("appliesMda", toggleAppliesMda.checked ? "true" : "false");
        }
        if (toggleStaysMda) {
          formData.set("staysInMda", toggleStaysMda.checked ? "true" : "false");
        }

        const activeChannel = (formData.get("channelType") as string) || "wise_call";
        const callIdVal = (formData.get("callId") as string)?.trim() || "";
        const ticketIdVal = (formData.get("ticketId") as string)?.trim() || "";

        if (activeChannel === "wise_call" && !callIdVal) {
          alert("El Nro de Caso / ID de Llamada es requerido.");
          document.getElementById("form-call-id")?.focus();
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = originalText;
          }
          return;
        }

        if (activeChannel === "wise_email" && !callIdVal) {
          alert("El Nro de Caso / Mail Wise es requerido.");
          document.getElementById("form-call-id")?.focus();
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = originalText;
          }
          return;
        }

        if (activeChannel === "invgate_ticket") {
          if (!ticketIdVal && !callIdVal) {
            alert("El Nro de Caso / Ticket AG es requerido.");
            document.getElementById("form-ticket-id")?.focus();
            if (btnSubmit) {
              btnSubmit.disabled = false;
              btnSubmit.innerHTML = originalText;
            }
            return;
          }
          if (!callIdVal) {
            formData.set("callId", ticketIdVal);
          }
        }

        if (!formData.get("duration")) {
          formData.set("duration", "00:00");
        }
        if (!formData.has("notes")) {
          formData.set("notes", "");
        }

        try {
          const result = await actions.saveAudit(formData);
          if (result.error) {
            console.error("Validation error:", result.error);
            alert(`Error al validar el formulario: ${result.error.message || "Verifique los campos requeridos."}`);
            if (btnSubmit) {
              btnSubmit.disabled = false;
              btnSubmit.innerHTML = originalText;
            }
          } else if (result.data?.success) {
            const redirectUrl = new URL(`${window.location.origin}${cleanBase}supervision/calidad-operadores`);
            if (formData.get("month")) {
              redirectUrl.searchParams.set("month", formData.get("month") as string);
            }
            if (agentIdVal) {
              redirectUrl.searchParams.set("agentId", agentIdVal);
            }
            redirectUrl.searchParams.set("toast_msg", "Auditoría guardada con éxito.");
            redirectUrl.searchParams.set("toast_type", "success");
            window.location.href = redirectUrl.toString();
          } else {
            alert("Error al guardar la auditoría.");
            if (btnSubmit) {
              btnSubmit.disabled = false;
              btnSubmit.innerHTML = originalText;
            }
          }
        } catch (err) {
          console.error("Save audit error:", err);
          alert("Ocurrió un error inesperado al guardar la auditoría.");
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = originalText;
          }
        }
      });
    }

    return true;
  }

  function setupNewAuditObserver() {
    if (initNewAuditForm()) return;
    const observer = new MutationObserver((_, obs) => {
      if (initNewAuditForm()) {
        obs.disconnect();
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }

  setupNewAuditObserver();
  document.addEventListener("astro:page-load", setupNewAuditObserver);

</script>
