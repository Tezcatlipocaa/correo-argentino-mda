---
import { Icon } from "astro-icon/components";
import Modal from "@components/ui/Modal.astro";

interface Props {
  id?: string;
}

const { id = "modal-ai-inspection" } = Astro.props;
---

<Modal
  id={id}
  size="3xl"
  fixedFooter
  class="border-secondary/30 border shadow-2xl backdrop-blur-xs"
>
  <div slot="content" class="space-y-5">
    <!-- Header visual espectacular con gradiente sutil -->
    <div
      class="border-secondary/20 from-secondary/15 via-primary/10 relative overflow-hidden rounded-2xl border bg-gradient-to-r to-transparent p-5"
    >
      <div
        class="relative z-10 flex flex-wrap items-center justify-between gap-3"
      >
        <div class="flex items-center gap-3">
          <div
            class="bg-secondary text-secondary-content shadow-secondary/30 ring-secondary/20 flex size-11 animate-pulse items-center justify-center rounded-xl shadow-md ring-4"
          >
            <Icon name="boxicons:magic-wand" size={24} aria-hidden="true" />
          </div>
          <div>
            <h2
              class="text-base-content flex items-center gap-2 text-base font-bold sm:text-lg"
            >
              Asistente de Auditoría con IA
              <span
                class="badge badge-xs badge-secondary font-mono tracking-wider uppercase"
                >Modo Pro</span
              >
            </h2>
            <p class="text-base-content/70 text-xs">
              Evaluación asistida de tickets InvGate mediante modelos de
              lenguaje.
            </p>
          </div>
        </div>

        <!-- Selector de Modelo activo -->
        <div class="flex items-center gap-2">
          <label
            for="ai-modal-model-select"
            class="text-base-content/70 flex items-center gap-1 text-xs font-semibold"
          >
            <Icon
              name="boxicons:chip"
              size={14}
              class="text-secondary"
              aria-hidden="true"
            />
            Modelo:
          </label>
          <select
            id="ai-modal-model-select"
            class="select select-xs border-secondary/30 bg-base-100 focus:ring-secondary/40 rounded-lg font-mono text-xs focus:ring-2 focus:outline-none"
          >
            <option value="opencode/nemotron-3.5-lightning-free" selected
              >Nemotron 3.5 Lightning (Free)</option
            >
            <option value="opencode/deepseek-v4.1-flash-free"
              >DeepSeek v4.1 Flash (Free)</option
            >
            <option value="opencode/mimo-v2.6-flash-free"
              >MiMo v2.6 Flash (Free)</option
            >
          </select>
        </div>
      </div>
    </div>

    <!-- Estado: En Progreso (Etapas animadas) -->
    <div
      id="ai-modal-loading-state"
      class="border-base-200 bg-base-200/40 hidden space-y-4 rounded-2xl border p-6 text-center"
    >
      <div
        class="bg-secondary/15 text-secondary mx-auto flex size-14 items-center justify-center rounded-full"
      >
        <span class="loading loading-spinner loading-md"></span>
      </div>
      <div>
        <h3
          id="ai-modal-stage-title"
          class="text-base-content text-sm font-bold"
        >
          Iniciando análisis con IA...
        </h3>
        <p id="ai-modal-stage-desc" class="text-base-content/60 mt-1 text-xs">
          Por favor aguardá mientras se procesan los metadatos del caso.
        </p>
      </div>

      <!-- Barra de etapas visual -->
      <ul class="steps steps-horizontal w-full text-xs font-medium">
        <li id="ai-step-1" class="step step-secondary" data-content="1">
          Extracción
        </li>
        <li id="ai-step-2" class="step" data-content="2">Inferencia</li>
        <li id="ai-step-3" class="step" data-content="3">Síntesis</li>
      </ul>
    </div>

    <!-- Estado: Error -->
    <div
      id="ai-modal-error-state"
      class="border-error/30 bg-error/10 text-error hidden rounded-xl border p-4 text-xs"
    >
      <div class="flex items-start gap-2.5">
        <Icon
          name="boxicons:alert-circle"
          size={18}
          class="shrink-0"
          aria-hidden="true"
        />
        <div>
          <strong class="font-bold">No se pudo completar el análisis:</strong>
          <p id="ai-modal-error-msg" class="text-error/90 mt-0.5"></p>
        </div>
      </div>
    </div>

    <!-- Estado: Veredictos disponibles -->
    <div id="ai-modal-results-state" class="hidden space-y-5">
      <!-- Resumen Ejecutivo -->
      <div class="border-secondary/20 bg-secondary/5 rounded-xl border p-4">
        <div class="text-secondary flex items-center gap-2 text-xs font-bold">
          <Icon name="boxicons:file" size={16} aria-hidden="true" />
          <span>Resumen Ejecutivo de la Atención</span>
        </div>
        <p
          id="ai-modal-summary-text"
          class="text-base-content/80 mt-1.5 text-xs leading-relaxed font-medium"
        >
          --
        </p>
      </div>

      <!-- Header de lista de criterios con acción de selección masiva -->
      <div
        class="border-base-200 flex flex-wrap items-center justify-between gap-2 border-b pb-2"
      >
        <div class="flex items-center gap-2">
          <span class="text-base-content text-xs font-bold">
            Criterios Analizados
          </span>
          <span
            id="ai-modal-count-badge"
            class="badge badge-sm badge-neutral font-mono"
          >
            0 sugerencias
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="ai-modal-toggle-all-btn"
            class="btn btn-xs btn-ghost text-base-content/70 hover:text-base-content text-xs"
          >
            Deseleccionar todas
          </button>
        </div>
      </div>

      <!-- Grilla de Veredictos sugeridos -->
      <div
        id="ai-modal-verdicts-list"
        class="divide-base-200/70 space-y-3 divide-y"
      >
        <!-- Generado dinámicamente -->
      </div>
    </div>
  </div>

  <div slot="actions" class="flex flex-wrap items-center justify-between gap-3">
    <div class="text-base-content/60 flex items-center gap-1.5 text-xs">
      <Icon
        name="boxicons:info-circle"
        size={14}
        class="text-secondary shrink-0"
        aria-hidden="true"
      />
      <span
        >El supervisor puede desmarcar sugerencias o corregirlas a mano.</span
      >
    </div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="ai-modal-btn-cancel"
        class="btn btn-sm btn-ghost text-xs font-medium"
      >
        Cerrar
      </button>
      <button
        type="button"
        id="ai-modal-btn-start"
        class="btn btn-sm btn-secondary gap-1.5 text-xs font-bold shadow-sm"
      >
        <Icon name="boxicons:play" size={16} aria-hidden="true" />
        <span>Iniciar Análisis</span>
      </button>
      <button
        type="button"
        id="ai-modal-btn-apply"
        class="btn btn-sm btn-success text-success-content hidden gap-1.5 text-xs font-bold shadow-sm"
      >
        <Icon name="boxicons:checks" size={16} aria-hidden="true" />
        <span>Aplicar al Formulario</span>
      </button>
    </div>
  </div>
</Modal>
