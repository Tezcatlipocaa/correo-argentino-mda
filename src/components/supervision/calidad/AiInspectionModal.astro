---
import { Icon } from "astro-icon/components";
import Modal from "@components/ui/Modal.astro";

interface Props {
  id?: string;
}

const { id = "modal-ai-inspection" } = Astro.props;
---

<Modal
  id={id}
  size="2xl"
  fixedFooter
  class="border-base-200 border shadow-xl"
>
  <div slot="content" class="space-y-4">
    <!-- Encabezado con gradiente sutil azul institucional y blanco -->
    <header
      class="border-secondary/20 from-secondary/12 via-secondary/5 to-base-100 rounded-xl border bg-gradient-to-r p-4"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-3">
          <div
            class="bg-secondary text-secondary-content flex size-9 shrink-0 items-center justify-center rounded-lg shadow-xs"
          >
            <Icon name="boxicons:magic-wand" size={18} aria-hidden="true" />
          </div>
          <div class="min-w-0">
            <h2
              class="text-base-content text-sm font-bold text-balance sm:text-base"
            >
              Asistente de Auditoría IA
            </h2>
            <p class="text-base-content/60 truncate text-xs">
              Evaluación asistida del ticket e historial de cambios en InvGate
            </p>
          </div>
        </div>

        <!-- Selector de Modelo alineado -->
        <div class="flex shrink-0 items-center gap-2">
          <label
            for="ai-modal-model-select"
            class="text-base-content/70 flex items-center gap-1 text-xs font-medium"
          >
            <Icon
              name="boxicons:chip"
              size={14}
              class="text-secondary shrink-0"
              aria-hidden="true"
            />
            <span>Modelo:</span>
          </label>
          <select
            id="ai-modal-model-select"
            name="aiModel"
            autocomplete="off"
            class="select select-xs border-base-300 bg-base-100 text-base-content focus-visible:border-secondary focus-visible:ring-secondary/40 h-7 rounded-lg font-mono text-xs focus:outline-none focus-visible:ring-2"
          >
            <option value="council" selected>
              Council MDA (3 Modelos + Árbitro)
            </option>
            <option value="opencode/deepseek-v4.1-flash-free">
              DeepSeek v4.1 Flash (~20s)
            </option>
            <option value="opencode/mimo-v2.6-flash-free">
              MiMo v2.6 Flash (~20s)
            </option>
            <option value="opencode/nemotron-3.5-lightning-free">
              Nemotron 3.5 Lightning (Detallado)
            </option>
          </select>
        </div>
      </div>
    </header>

    <!-- Estado inicial / guía rápida antes de ejecutar -->
    <div
      id="ai-modal-idle-state"
      class="border-base-200 bg-base-200/30 rounded-xl border p-4"
    >
      <div class="flex items-start gap-3">
        <Icon
          name="boxicons:info-circle"
          size={18}
          class="text-secondary mt-0.5 shrink-0"
          aria-hidden="true"
        />
        <div class="min-w-0 space-y-1 text-xs">
          <p class="text-base-content font-semibold">
            ¿Qué analiza este asistente?
          </p>
          <p class="text-base-content/70 leading-relaxed">
            Extrae metadatos, campos personalizados, notas internas, solución e
            historial de cambios del ticket en InvGate, y contrasta cada ítem
            contra las rúbricas oficiales de calidad.
          </p>
        </div>
      </div>
    </div>

    <!-- Estado: En Progreso (Compacto, limpio y accesible) -->
    <div
      id="ai-modal-loading-state"
      role="status"
      aria-live="polite"
      class="border-base-200 bg-base-200/30 hidden rounded-xl border p-5"
    >
      <div class="flex items-center gap-3.5">
        <span
          class="loading loading-spinner loading-md text-secondary shrink-0"
          aria-hidden="true"></span>
        <div class="min-w-0 flex-1">
          <h3
            id="ai-modal-stage-title"
            class="text-base-content text-sm font-semibold"
          >
            Iniciando análisis con IA…
          </h3>
          <p id="ai-modal-stage-desc" class="text-base-content/60 mt-0.5 text-xs">
            Aguardá mientras se procesan los metadatos y el historial del caso.
          </p>
        </div>
      </div>

      <!-- Indicador lineal de etapas -->
      <div
        id="ai-modal-steps-container"
        class="mt-4 grid grid-cols-4 gap-2 border-t border-base-200 pt-3"
      >
        <div
          id="ai-step-1"
          data-active="true"
          class="data-[active=true]:border-secondary data-[active=true]:bg-secondary/10 data-[active=true]:text-secondary border-base-300 bg-base-100 text-base-content/50 flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium transition-colors motion-reduce:transition-none"
        >
          <span class="font-mono font-bold tabular-nums">1.</span>
          <span class="truncate">Extracción</span>
        </div>
        <div
          id="ai-step-2"
          data-active="false"
          class="data-[active=true]:border-secondary data-[active=true]:bg-secondary/10 data-[active=true]:text-secondary border-base-300 bg-base-100 text-base-content/50 flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium transition-colors motion-reduce:transition-none"
        >
          <span class="font-mono font-bold tabular-nums">2.</span>
          <span class="truncate">Evaluación</span>
        </div>
        <div
          id="ai-step-3"
          data-active="false"
          class="data-[active=true]:border-secondary data-[active=true]:bg-secondary/10 data-[active=true]:text-secondary border-base-300 bg-base-100 text-base-content/50 flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium transition-colors motion-reduce:transition-none"
        >
          <span class="font-mono font-bold tabular-nums">3.</span>
          <span class="truncate">Consenso</span>
        </div>
        <div
          id="ai-step-4"
          data-active="false"
          class="data-[active=true]:border-secondary data-[active=true]:bg-secondary/10 data-[active=true]:text-secondary border-base-300 bg-base-100 text-base-content/50 flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium transition-colors motion-reduce:transition-none"
        >
          <span class="font-mono font-bold tabular-nums">4.</span>
          <span class="truncate">Arbitraje</span>
        </div>
      </div>
    </div>

    <!-- Estado: Error -->
    <div
      id="ai-modal-error-state"
      role="alert"
      aria-live="polite"
      class="border-error/30 bg-error/10 text-error hidden rounded-xl border p-3.5 text-xs"
    >
      <div class="flex items-start gap-2.5">
        <Icon
          name="boxicons:alert-circle"
          size={16}
          class="mt-0.5 shrink-0"
          aria-hidden="true"
        />
        <div class="min-w-0">
          <strong class="font-bold">No se pudo completar el análisis</strong>
          <p id="ai-modal-error-msg" class="text-error/90 mt-0.5 break-words"></p>
        </div>
      </div>
    </div>

    <!-- Estado: Veredictos disponibles -->
    <div id="ai-modal-results-state" class="hidden space-y-4">
      <!-- Resumen Ejecutivo -->
      <div
        class="border-secondary/20 from-secondary/10 to-base-100 rounded-xl border bg-gradient-to-r p-3.5"
      >
        <div class="text-secondary flex items-center gap-1.5 text-xs font-bold">
          <Icon name="boxicons:file" size={15} aria-hidden="true" />
          <span>Resumen de la Atención</span>
        </div>
        <p
          id="ai-modal-summary-text"
          class="text-base-content/85 mt-1 text-xs leading-relaxed break-words"
        >
          —
        </p>
      </div>

      <!-- Barra de control de lista de criterios -->
      <div
        class="border-base-200 flex flex-wrap items-center justify-between gap-2 border-b pb-2"
      >
        <div class="flex items-center gap-2">
          <span class="text-base-content text-xs font-bold">
            Sugerencias por criterio
          </span>
          <span
            id="ai-modal-count-badge"
            class="badge badge-xs bg-base-200 text-base-content/70 border-base-300 font-mono tabular-nums"
          >
            0 seleccionadas
          </span>
        </div>
        <button
          type="button"
          id="ai-modal-toggle-all-btn"
          class="btn btn-xs btn-ghost text-secondary hover:bg-secondary/10 focus-visible:ring-secondary/50 rounded-md px-2 text-xs font-semibold focus-visible:ring-2 focus-visible:outline-none"
        >
          Deseleccionar todas
        </button>
      </div>

      <!-- Lista de Veredictos sugeridos -->
      <div
        id="ai-modal-verdicts-list"
        class="divide-base-200 divide-y rounded-xl border border-base-200 bg-base-100"
      >
        <!-- Generado dinámicamente -->
      </div>
    </div>
  </div>

  <!-- Barra de acciones fija al pie -->
  <div
    slot="actions"
    class="flex flex-wrap items-center justify-between gap-3"
  >
    <p class="text-base-content/60 flex items-center gap-1.5 text-xs">
      <Icon
        name="boxicons:check-shield"
        size={14}
        class="text-secondary shrink-0"
        aria-hidden="true"
      />
      <span>Solo se aplican los ítems marcados.</span>
    </p>
    <div class="ml-auto flex items-center gap-2">
      <button
        type="button"
        id="ai-modal-btn-cancel"
        class="btn btn-sm btn-ghost text-base-content/70 hover:text-base-content focus-visible:ring-secondary/50 rounded-xl px-3.5 text-xs font-medium focus-visible:ring-2 focus-visible:outline-none"
      >
        Cerrar
      </button>
      <button
        type="button"
        id="ai-modal-btn-start"
        class="btn btn-sm btn-secondary focus-visible:ring-secondary/60 gap-1.5 rounded-xl px-4 text-xs font-semibold shadow-none focus-visible:ring-2 focus-visible:outline-none"
      >
        <Icon name="boxicons:play" size={16} aria-hidden="true" />
        <span>Analizar Ticket</span>
      </button>
      <button
        type="button"
        id="ai-modal-btn-apply"
        class="btn btn-sm btn-secondary focus-visible:ring-secondary/60 hidden gap-1.5 rounded-xl px-4 text-xs font-semibold shadow-none focus-visible:ring-2 focus-visible:outline-none"
      >
        <Icon name="boxicons:check" size={16} aria-hidden="true" />
        <span>Aplicar seleccionadas</span>
      </button>
    </div>
  </div>
</Modal>
