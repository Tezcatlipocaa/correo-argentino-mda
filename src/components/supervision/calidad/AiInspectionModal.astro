---
import { Icon } from "astro-icon/components";
import Modal from "@components/ui/Modal.astro";

interface Props {
  id?: string;
}

const { id = "modal-ai-inspection" } = Astro.props;
---

<Modal id={id} size="3xl" fixedFooter class="border border-secondary/30 shadow-2xl backdrop-blur-xs">
  <div slot="content" class="space-y-5">
    <!-- Header visual espectacular con gradiente sutil -->
    <div class="relative overflow-hidden rounded-2xl border border-secondary/20 bg-gradient-to-r from-secondary/15 via-primary/10 to-transparent p-5">
      <div class="relative z-10 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="flex size-11 items-center justify-center rounded-xl bg-secondary text-secondary-content shadow-md shadow-secondary/30 ring-4 ring-secondary/20 animate-pulse">
            <Icon name="boxicons:bot" size={24} aria-hidden="true" />
          </div>
          <div>
            <h2 class="text-base font-bold text-base-content sm:text-lg flex items-center gap-2">
              Asistente de Auditoría con IA
              <span class="badge badge-xs badge-secondary font-mono uppercase tracking-wider">Modo Pro</span>
            </h2>
            <p class="text-xs text-base-content/70">
              Evaluación asistida de tickets InvGate mediante modelos de lenguaje.
            </p>
          </div>
        </div>

        <!-- Selector de Modelo activo -->
        <div class="flex items-center gap-2">
          <label for="ai-modal-model-select" class="text-xs font-semibold text-base-content/70 flex items-center gap-1">
            <Icon name="boxicons:chip" size={14} class="text-secondary" aria-hidden="true" />
            Modelo:
          </label>
          <select
            id="ai-modal-model-select"
            class="select select-xs rounded-lg border-secondary/30 bg-base-100 font-mono text-xs focus:outline-none focus:ring-2 focus:ring-secondary/40"
          >
            <option value="opencode/nemotron-3.5-lightning-free" selected>Nemotron 3.5 Lightning (Free)</option>
            <option value="opencode/deepseek-v4.1-flash-free">DeepSeek v4.1 Flash (Free)</option>
            <option value="opencode/mimo-v2.6-flash-free">MiMo v2.6 Flash (Free)</option>
            <option value="gemini-2.5-flash-lite">Google Gemini Flash-Lite (API)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Estado: En Progreso (Etapas animadas) -->
    <div id="ai-modal-loading-state" class="hidden space-y-4 rounded-2xl border border-base-200 bg-base-200/40 p-6 text-center">
      <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-secondary/15 text-secondary">
        <span class="loading loading-spinner loading-md"></span>
      </div>
      <div>
        <h3 id="ai-modal-stage-title" class="text-sm font-bold text-base-content">
          Iniciando análisis con IA...
        </h3>
        <p id="ai-modal-stage-desc" class="mt-1 text-xs text-base-content/60">
          Por favor aguardá mientras se procesan los metadatos del caso.
        </p>
      </div>

      <!-- Barra de etapas visual -->
      <ul class="steps steps-horizontal w-full text-xs font-medium">
        <li id="ai-step-1" class="step step-secondary" data-content="1">Extracción</li>
        <li id="ai-step-2" class="step" data-content="2">Inferencia</li>
        <li id="ai-step-3" class="step" data-content="3">Síntesis</li>
      </ul>
    </div>

    <!-- Estado: Error -->
    <div id="ai-modal-error-state" class="hidden rounded-xl border border-error/30 bg-error/10 p-4 text-xs text-error">
      <div class="flex items-start gap-2.5">
        <Icon name="boxicons:error-circle" size={18} class="shrink-0" aria-hidden="true" />
        <div>
          <strong class="font-bold">No se pudo completar el análisis:</strong>
          <p id="ai-modal-error-msg" class="mt-0.5 text-error/90"></p>
        </div>
      </div>
    </div>

    <!-- Estado: Veredictos disponibles -->
    <div id="ai-modal-results-state" class="hidden space-y-5">
      <!-- Resumen Ejecutivo -->
      <div class="rounded-xl border border-secondary/20 bg-secondary/5 p-4">
        <div class="flex items-center gap-2 text-xs font-bold text-secondary">
          <Icon name="boxicons:file" size={16} aria-hidden="true" />
          <span>Resumen Ejecutivo de la Atención</span>
        </div>
        <p id="ai-modal-summary-text" class="mt-1.5 text-xs leading-relaxed text-base-content/80 font-medium">
          --
        </p>
      </div>

      <!-- Header de lista de criterios con acción de selección masiva -->
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-200 pb-2">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-base-content">
            Criterios Analizados
          </span>
          <span id="ai-modal-count-badge" class="badge badge-sm badge-neutral font-mono">
            0 sugerencias
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="ai-modal-toggle-all-btn"
            class="btn btn-xs btn-ghost text-xs text-base-content/70 hover:text-base-content"
          >
            Deseleccionar todas
          </button>
        </div>
      </div>

      <!-- Grilla de Veredictos sugeridos -->
      <div id="ai-modal-verdicts-list" class="space-y-3 divide-y divide-base-200/70">
        <!-- Generado dinámicamente -->
      </div>
    </div>
  </div>

  <div slot="actions" class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-1.5 text-xs text-base-content/60">
      <Icon name="boxicons:info-circle" size={14} class="text-secondary shrink-0" aria-hidden="true" />
      <span>El supervisor puede desmarcar sugerencias o corregirlas a mano.</span>
    </div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="ai-modal-btn-cancel"
        class="btn btn-sm btn-ghost text-xs font-medium"
      >
        Cerrar
      </button>
      <button
        type="button"
        id="ai-modal-btn-start"
        class="btn btn-sm btn-secondary gap-1.5 text-xs font-bold shadow-sm"
      >
        <Icon name="boxicons:play" size={16} aria-hidden="true" />
        <span>Iniciar Análisis</span>
      </button>
      <button
        type="button"
        id="ai-modal-btn-apply"
        class="btn btn-sm btn-success hidden gap-1.5 text-xs font-bold text-success-content shadow-sm"
      >
        <Icon name="boxicons:check-double" size={16} aria-hidden="true" />
        <span>Aplicar al Formulario</span>
      </button>
    </div>
  </div>
</Modal>
