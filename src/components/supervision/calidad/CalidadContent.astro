---
import { Icon } from "astro-icon/components";
import StatsCard from "@components/ui/StatsCard.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import SearchEmptyState from "@components/ui/SearchEmptyState.astro";
import FormField from "@components/ui/forms/FormField.astro";
import FormTextarea from "@components/ui/forms/FormTextarea.astro";
import Modal from "@components/ui/Modal.astro";
import { db } from "@db/index";
import {
  agents,
  users,
  qualityAudits,
  auditParameters,
  auditScores,
  monthlySummaries,
} from "@db/schema";
import { and, eq, inArray } from "drizzle-orm";
import { activeAgentCondition } from "@lib/activeUsers";
import { getResolvedSearchParams } from "@lib/navigation";
import { formatMonthLabel } from "@lib/monthUtils";
import { getCleanBase } from "@lib/baseUrl";
import AuditModal from "./AuditModal.astro";
import OperatorDetailsPanel from "./OperatorDetailsPanel.astro";
import {
  calculateOperatorChannelStats,
  calculateChannelAverages,
  formatChannelAverageScore,
  getChannelAverageBadgeClass,
} from "@lib/qualityCalculator";
import type { ChannelType } from "@/types/quality";


const searchParams = getResolvedSearchParams(Astro.request, Astro.url);

const currentActualMonth = (() => {
  const now = new Date();
  const mm = (now.getMonth() + 1).toString().padStart(2, "0");
  const yyyy = now.getFullYear();
  return `${mm}-${yyyy}`;
})();

const selectedMonth = searchParams.get("month") || currentActualMonth;

// Generate the last 6 months based on the selected month
const getDynamicMonths = (baseMonthStr: string) => {
  const [mm, yyyy] = baseMonthStr.split("-");
  let m = parseInt(mm, 10);
  let y = parseInt(yyyy, 10);
  const res = [];
  for (let i = 0; i < 6; i++) {
    res.push(`${m.toString().padStart(2, "0")}-${y}`);
    m--;
    if (m === 0) {
      m = 12;
      y--;
    }
  }
  return res;
};

const dynamicMonthsList = getDynamicMonths(selectedMonth);

const selectorMonthsList = getDynamicMonths(currentActualMonth);
if (!selectorMonthsList.includes(selectedMonth)) {
  selectorMonthsList.push(selectedMonth);
  selectorMonthsList.sort((a, b) => {
    const [mA, yA] = a.split("-").map(Number);
    const [mB, yB] = b.split("-").map(Number);
    if (yA !== yB) return yB - yA;
    return mB - mA;
  });
}

// Fetch all agents (small table, ~30 rows)
const allAgents = await db
  .select({ id: agents.id, name: agents.name, username: agents.username })
  .from(agents)
  .leftJoin(users, eq(users.id, agents.userId))
  .where(and(eq(agents.incluidoCalidad, true), activeAgentCondition()))
  .orderBy(agents.name);

// Fetch all parameters (for resolving historical scores) and active parameters
const allParameters = await db
  .select()
  .from(auditParameters)
  .orderBy(auditParameters.order);

const activeParameters = allParameters.filter((p) => p.active !== false);

// Fetch audits filtered by dynamic months
const allAudits = await db
  .select()
  .from(qualityAudits)
  .where(inArray(qualityAudits.month, dynamicMonthsList));

// Fetch scores only for loaded audits
const auditIds = allAudits.map((a) => a.id);
const allScores =
  auditIds.length > 0
    ? await db
        .select()
        .from(auditScores)
        .where(inArray(auditScores.auditId, auditIds))
    : [];

// Fetch monthly summaries only for selected month
const allMonthlySummaries = await db
  .select()
  .from(monthlySummaries)
  .where(eq(monthlySummaries.month, selectedMonth));

// Pre-indexar auditorías por agentId
const auditsByAgent = new Map<number, typeof allAudits>();
for (const audit of allAudits) {
  if (!auditsByAgent.has(audit.agentId)) {
    auditsByAgent.set(audit.agentId, []);
  }
  auditsByAgent.get(audit.agentId)!.push(audit);
}

// Pre-indexar scores por auditId
const scoresByAudit = new Map<number, typeof allScores>();
for (const score of allScores) {
  if (!scoresByAudit.has(score.auditId)) {
    scoresByAudit.set(score.auditId, []);
  }
  scoresByAudit.get(score.auditId)!.push(score);
}

// Pre-indexar summaries por agentId
const summariesByAgent = new Map<number, (typeof allMonthlySummaries)[0]>();
for (const s of allMonthlySummaries) {
  summariesByAgent.set(s.agentId, s);
}

import { normalizeRole } from "@lib/rbac";

const user = Astro.locals.user;
const role = normalizeRole(user.role);
const isAgent = role === "agent";

let finalAgents = allAgents;
let agentNotFound = false;

if (isAgent) {
  const matched = allAgents.find(
    (a) =>
      a.username?.toLowerCase().trim() === user.username.toLowerCase().trim(),
  );
  if (matched) {
    finalAgents = [matched];
  } else {
    finalAgents = [];
    agentNotFound = true;
  }
}

const operatorsQuality = finalAgents.map((agent) => {
  const agentAudits = auditsByAgent.get(agent.id) || [];
  const currentMonthAudits = agentAudits.filter(
    (a) => a.month === selectedMonth,
  );

  const monthSummaryRec = summariesByAgent.get(agent.id);
  const monthSummary = monthSummaryRec ? monthSummaryRec.summary : "";

  const averageScore =
    currentMonthAudits.length > 0
      ? Math.round(
          currentMonthAudits.reduce((sum, audit) => sum + audit.totalScore, 0) /
            currentMonthAudits.length,
        )
      : 0;

  const history = dynamicMonthsList
    .slice()
    .reverse()
    .map((m) => {
      const monthAudits = agentAudits.filter((a) => a.month === m);
      return monthAudits.length > 0
        ? Math.round(
            monthAudits.reduce((sum, audit) => sum + audit.totalScore, 0) /
              monthAudits.length,
          )
        : 0;
    });

  const channelStats = calculateOperatorChannelStats(currentMonthAudits);

  const calls = currentMonthAudits.map((audit) => {
    const auditScoresList = scoresByAudit.get(audit.id) || [];
    const section1Details: Record<string, boolean> = {};
    const section2Details: Record<string, boolean> = {};
    const parameterComments: Record<string, string> = {};

    auditScoresList.forEach((scoreObj) => {
      const param = allParameters.find((p) => p.id === scoreObj.parameterId);
      if (param) {
        if (param.category === "Interacción con Usuario" || param.section === "items") {
          section1Details[param.code] = scoreObj.score;
        } else {
          section2Details[param.code] = scoreObj.score;
        }
        if (scoreObj.comment && scoreObj.comment.trim()) {
          parameterComments[param.code] = scoreObj.comment.trim();
        }
      }
    });

    return {
      id: audit.id,
      channelType: (audit.channelType || "wise_call") as ChannelType,
      callId: audit.callId,
      ticketId: audit.ticketId,
      duration: audit.duration,
      date: audit.date,
      month: audit.month,
      notes: audit.notes || "",
      isCriticalFailure: audit.isCriticalFailure || false,
      ringTime: audit.ringTime,
      creationTime: audit.creationTime,
      takeTime: audit.takeTime,
      isPas: audit.isPas,
      appliesMda: (audit.channelType || "wise_call") === "wise_call"
        ? (audit.appliesMda ?? true)
        : audit.appliesMda,
      staysInMda: audit.staysInMda,
      recordingUrl: audit.recordingUrl,
      comments: parameterComments,
      section1: {
        score: audit.section1Score,
        maxScore: 100,
        details: section1Details,
      },
      section2: {
        score: audit.section2Score,
        maxScore: 100,
        details: section2Details,
      },
      totalScore: audit.totalScore,
    };
  });

  const prevMonth = dynamicMonthsList[1];
  const prevMonthAudits = prevMonth
    ? agentAudits.filter((a) => a.month === prevMonth)
    : [];
  const prevAverageScore =
    prevMonthAudits.length > 0
      ? Math.round(
          prevMonthAudits.reduce((sum, audit) => sum + audit.totalScore, 0) /
            prevMonthAudits.length,
        )
      : 0;
  const prevCallsCount = prevMonthAudits.length;
  const prevCriticalCount = prevMonthAudits.filter(
    (a) => a.isCriticalFailure,
  ).length;

  return {
    id: agent.id.toString(),
    name: agent.name,
    username: agent.username || "",
    month: selectedMonth,
    monthSummary,
    calls,
    history,
    averageScore: channelStats.globalAverage > 0 ? channelStats.globalAverage : averageScore,
    wiseCallsAvg: channelStats.wiseCallsAvg,
    wiseCallsCount: channelStats.wiseCallsCount,
    wiseEmailsAvg: channelStats.wiseEmailsAvg,
    wiseEmailsCount: channelStats.wiseEmailsCount,
    invgateAgAvg: channelStats.invgateAgAvg,
    invgateAgCount: channelStats.invgateAgCount,
    totalAuditsCount: channelStats.totalAuditsCount,
    quotaFulfilled: channelStats.quotaFulfilled,
    prevAverageScore,
    prevCallsCount,
    prevCriticalCount,
  };
});

const operatorsDataMap = Object.fromEntries(
  operatorsQuality.map((op) => [op.id, op]),
);

const auditedOperators = operatorsQuality.filter((op) => op.calls.length > 0);
const totalOperators = operatorsQuality.length;

const avgScore =
  auditedOperators.length > 0
    ? Math.round(
        auditedOperators.reduce((acc, op) => acc + op.averageScore, 0) /
          auditedOperators.length,
      )
    : 0;

const excellentOperators = auditedOperators.filter(
  (op) => op.averageScore >= 90,
).length;

const needsImprovement = auditedOperators.filter(
  (op) => op.averageScore > 0 && op.averageScore < 80,
).length;

const allCalls = operatorsQuality.flatMap((op) => op.calls);
const totalCalls = allCalls.length;

const avgSection1 =
  totalCalls > 0
    ? Math.round(
        allCalls.reduce((acc, c) => acc + c.section1.score, 0) / totalCalls,
      )
    : 0;

const avgSection2 =
  totalCalls > 0
    ? Math.round(
        allCalls.reduce((acc, c) => acc + c.section2.score, 0) / totalCalls,
      )
    : 0;

const cleanBase = getCleanBase();
---

<div
  id="audit-parameters-data"
  data-parameters={JSON.stringify(allParameters)}
  class="hidden"
>
</div>
<div
  id="operators-data"
  data-operators={JSON.stringify(operatorsDataMap)}
  class="hidden"
>
</div>
<PageContainer
  class="mx-auto max-w-7xl"
  data-is-agent={isAgent}
  data-agent-not-found={agentNotFound}
>
  <PageHeader
    description="Evaluación de llamadas, métricas y validaciones de la calidad de atención del equipo de operaciones de Mesa de Ayuda."
  />

  <!-- Barra Superior Unificada -->
  <div
    class="bg-base-200/50 border-base-300 mt-4 mb-6 flex flex-col gap-4 rounded-2xl border p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between"
  >
    {/* Extremo Izquierdo: Buscador */}
    <div class="w-full sm:max-w-md">
      {
        !isAgent ? (
          <SearchBar
            id="operator-search"
            placeholder="Buscar por nombre o legajo..."
          />
        ) : (
          <div class="text-base-content/80 flex items-center gap-2">
            <Icon name="boxicons:calendar" size={24} class="text-primary" />
            <span class="font-semibold text-sm">Período de evaluación:</span>
          </div>
        )
      }
    </div>

    {/* Extremo Derecho: Selector de mes + Botones */}
    <div class="flex flex-wrap items-center justify-end gap-2">
      <div class="flex items-center gap-1">
        <button
          id="btn-prev-month"
          class="btn btn-sm btn-square btn-ghost"
          title="Mes anterior"
        >
          <Icon name="boxicons:chevron-left" size={20} />
        </button>
        <select
          id="month-selector"
          class="select select-sm bg-base-100 text-center font-bold sm:w-44"
        >
          {
            selectorMonthsList.map((m) => (
              <option value={m} selected={selectedMonth === m}>
                {formatMonthLabel(m)}
              </option>
            ))
          }
        </select>
        <button
          id="btn-next-month"
          class="btn btn-sm btn-square btn-ghost"
          title="Mes siguiente"
        >
          <Icon name="boxicons:chevron-right" size={20} />
        </button>
      </div>

      {
        !isAgent && (
          <>
            <div class="divider divider-horizontal mx-0.5 hidden sm:flex"></div>
            <button
              id="btn-configure-parameters"
              class="btn btn-sm btn-outline btn-ghost gap-1.5 text-xs font-bold uppercase"
              title="Configurar Parámetros de Calidad"
            >
              <Icon name="boxicons:cog" size={18} />
              <span class="hidden md:inline">Parámetros</span>
            </button>
            <a
              id="btn-top-new-audit"
              href={`${cleanBase}supervision/calidad-operadores/nueva?month=${selectedMonth}`}
              class="btn btn-sm btn-primary gap-1.5 text-xs font-bold uppercase shadow-sm"
            >
              <Icon name="boxicons:plus" size={18} />
              <span>Nueva Auditoría</span>
            </a>
          </>
        )
      }
    </div>
  </div>

  {
    agentNotFound ? (
      <div class="alert alert-warning mb-6 flex gap-4 rounded-2xl p-6 shadow-md">
        <Icon
          name="boxicons:alert-circle-filled"
          size={24}
          class="shrink-0 text-amber-600"
        />
        <div>
          <h3 class="text-sm font-bold tracking-wide uppercase">
            Ficha de Operador no encontrada
          </h3>
          <p class="mt-1 text-xs">
            No se encontró tu ficha de operador vinculada a tu nombre de usuario
            (@{user.username}). Por favor, solicita a tu supervisor que cree tu
            ficha en el sistema.
          </p>
        </div>
      </div>
    ) : (
      <div class="mt-4">
        {
          isAgent ? (
            <div id="operator-details-panel" class="w-full space-y-6">
              <OperatorDetailsPanel isAgent={true} />
            </div>
          ) : (
            <>
              {/* Grilla de Operadores */}
              <div
                id="operators-grid"
                class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4"
              >
                {operatorsQuality.map((op) => {
                  const initials = op.name
                    .split(" ")
                    .filter(Boolean)
                    .map((n) => n[0])
                    .join("")
                    .substring(0, 2)
                    .toUpperCase();
                  const scoreBadgeClass =
                    op.averageScore >= 90
                      ? "badge-success text-success-content"
                      : op.averageScore >= 80
                        ? "badge-warning text-warning-content"
                        : "badge-error text-error-content";

                  return (
                    <button
                      type="button"
                      class="operator-card card bg-base-100 border-base-300 hover:border-secondary hover:shadow-lg transition-all duration-200 border p-5 text-left cursor-pointer group flex flex-col justify-between"
                      data-name={op.name.toLowerCase()}
                      data-id={op.id.toLowerCase()}
                      data-username={(op.username || "").toLowerCase()}
                      data-operator-id={op.id}
                      data-operator={JSON.stringify({
                        id: op.id,
                        name: op.name,
                        username: op.username,
                        averageScore: op.averageScore,
                        callsCount: op.calls.length,
                      })}
                    >
                      <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3">
                          <div class="avatar placeholder">
                            <div class="bg-base-200 text-base-content/80 group-hover:bg-secondary group-hover:text-secondary-content size-12 rounded-xl font-black text-sm transition-colors shadow-sm">
                              <span>{initials}</span>
                            </div>
                          </div>
                          <div>
                            <div class="flex items-center gap-1.5">
                              <span class="text-base-content font-bold text-sm tracking-tight line-clamp-1 group-hover:text-secondary transition-colors">
                                {op.name}
                              </span>
                              {op.averageScore >= 90 && (
                                <Icon
                                  name="boxicons:badge-check"
                                  class="text-secondary shrink-0"
                                  size={20}
                                  title="Insignia de Excelencia"
                                />
                              )}
                            </div>
                            <div class="text-base-content/50 font-mono text-xs lowercase">
                              @{op.username || op.id}
                            </div>
                          </div>
                        </div>
                        <span class={`badge ${scoreBadgeClass} badge-sm font-black shrink-0`}>
                          {op.averageScore}%
                        </span>
                      </div>

                      <div class="mt-4 pt-3 border-t border-base-200/60">
                        <div class="flex items-center justify-between text-xs text-base-content/70">
                          <span class="font-medium">Auditorías</span>
                          <span class="font-mono font-bold">{op.calls.length} / 12</span>
                        </div>
                        <progress
                          class="progress progress-secondary w-full h-1.5 mt-1.5 bg-base-200"
                          value={Math.min(op.calls.length, 12)}
                          max="12"
                        ></progress>
                      </div>
                    </button>
                  );
                })}
                <div id="calidad-empty-state" class="col-span-full hidden py-12">
                  <SearchEmptyState
                    title="Sin resultados"
                    description="No hay operadores que coincidan con la búsqueda. Probá con otro nombre o legajo."
                  />
                </div>
              </div>

              {/* Modal de Detalle de Operador para Supervisores */}
              <dialog id="operator-details-modal" class="modal z-150">
                <div class="modal-box w-11/12 max-w-6xl max-h-[90vh] overflow-y-auto p-6 bg-base-100">
                  <form method="dialog">
                    <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 z-20">✕</button>
                  </form>
                  <div id="operator-details-panel" class="space-y-6">
                    <OperatorDetailsPanel isAgent={false} />
                  </div>
                </div>
                <form method="dialog" class="modal-backdrop">
                  <button>close</button>
                </form>
              </dialog>
            </>
          )
        }
      </div>
    )
  }
</PageContainer>

<AuditModal allParameters={activeParameters} selectedMonth={selectedMonth} />

<Modal
  id="month-summary-modal"
  title="Observaciones del Mes"
  icon="boxicons:note"
  titleClass="font-black text-lg uppercase tracking-tight"
  zIndex="z-200"
  class="max-w-lg"
>
  <Fragment slot="content">
    <form id="month-summary-form" method="POST" class="space-y-4">
      <input type="hidden" name="agentId" id="summary-agent-id" />
      <input
        type="hidden"
        name="month"
        id="summary-month"
        value={selectedMonth}
      />

      <FormTextarea
        id="summary-content"
        name="summary"
        label="Resumen general"
        placeholder="Escriba aquí las observaciones del mes..."
        rows={5}
        textareaClass="textarea-sm font-bold"
      />
    </form>
  </Fragment>
  <Fragment slot="actions">
    <div class="modal-action mt-6 flex justify-end gap-2">
      <button
        type="button"
        id="btn-close-summary-modal"
        class="btn btn-sm btn-ghost hover:bg-base-200 text-xs font-black uppercase"
      >
        Cancelar
      </button>
      <button
        type="submit"
        form="month-summary-form"
        class="btn btn-sm btn-secondary text-xs font-black uppercase"
      >
        Guardar
      </button>
    </div>
  </Fragment>
</Modal>

<Modal
  id="parameters-modal"
  title="Configuración de Parámetros de Calidad"
  icon="boxicons:cog"
  titleClass="font-black text-lg uppercase tracking-tight"
  size="2xl"
  zIndex="z-200"
  class="flex h-[80vh] w-11/12 flex-col sm:h-150"
>
  <Fragment slot="content">
    <!-- Channel Selector in Parameters Modal -->
    <div class="flex items-center justify-between gap-2 mb-3 bg-base-200/40 p-2 rounded-xl border border-base-300">
      <span class="text-xs font-bold uppercase tracking-wider text-base-content/60 pl-1">Canal:</span>
      <div class="join">
        <button
          type="button"
          class="btn btn-xs join-item param-channel-btn btn-active btn-primary font-bold uppercase"
          data-channel="wise_call"
        >
          Llamada Wise
        </button>
        <button
          type="button"
          class="btn btn-xs join-item param-channel-btn font-bold uppercase"
          data-channel="wise_email"
        >
          Mail Wise
        </button>
        <button
          type="button"
          class="btn btn-xs join-item param-channel-btn font-bold uppercase"
          data-channel="invgate_ticket"
        >
          Autogestión
        </button>
      </div>
    </div>

    <!-- Tabs Header -->
    <div class="tabs bg-base-200/50 mb-4 shrink-0 rounded-xl p-1">
      <button
        type="button"
        id="param-tab-s1-btn"
        class="tab tab-active parameter-tab flex-1 text-xs font-bold uppercase"
        data-tab="s1"
      >
        Interacción con Usuario
      </button>
      <button
        type="button"
        id="param-tab-s2-btn"
        class="tab parameter-tab flex-1 text-xs font-bold uppercase"
        data-tab="s2"
      >
        Gestión del Ticket
      </button>
    </div>

    <!-- Lists Container -->
    <div class="min-h-0 flex-1 space-y-4 overflow-y-auto pr-1">
      <!-- Section 1 List -->
      <div id="param-list-s1" class="parameter-list-pane space-y-3">
        <!-- populated dynamically -->
      </div>

      <!-- Section 2 List -->
      <div id="param-list-s2" class="parameter-list-pane hidden space-y-3">
        <!-- populated dynamically -->
      </div>
    </div>
  </Fragment>
  <Fragment slot="actions">
    <!-- Action Buttons -->
    <div
      class="modal-action border-base-200 mt-6 flex shrink-0 justify-between border-t pt-4"
    >
      <div class="flex gap-2">
        <button
          type="button"
          id="btn-add-param-s1"
          class="btn btn-sm btn-primary add-param-btn gap-1 text-xs font-black uppercase"
        >
          <Icon name="boxicons:plus" size={16} />
          <span id="btn-add-param-s1-label">Agregar Criterio</span>
        </button>
        <button
          type="button"
          id="btn-add-param-s2"
          class="btn btn-sm btn-primary add-param-btn hidden gap-1 text-xs font-black uppercase"
        >
          <Icon name="boxicons:plus" size={16} />
          <span id="btn-add-param-s2-label">Agregar Criterio</span>
        </button>
      </div>
      <div class="flex gap-2">
        <button
          type="button"
          id="btn-close-parameters-modal"
          class="btn btn-sm btn-ghost hover:bg-base-200 text-xs font-black uppercase"
        >
          Cancelar
        </button>
        <button
          type="button"
          id="btn-save-parameters"
          class="btn btn-sm btn-secondary text-xs font-black uppercase"
        >
          Guardar Cambios
        </button>
      </div>
    </div>
  </Fragment>
</Modal>

<style is:global>
  /* RBAC - Vista de calidad para Operador (Solo Lectura) */
  [data-is-agent="true"] #btn-back-to-summary {
    display: none !important;
  }
  [data-is-agent="true"] #btn-new-audit {
    display: none !important;
  }
  [data-is-agent="true"] #btn-edit-month-summary {
    display: none !important;
  }
  [data-is-agent="true"] .edit-audit-btn,
  [data-is-agent="true"] .delete-audit-btn,
  [data-is-agent="true"] #btn-delete-audit {
    display: none !important;
  }
</style>

<style>
  /* Animaciones útiles para las transiciones de estado */
  @media print {
    body * {
      visibility: hidden;
    }
    #operator-details-panel,
    #operator-details-panel * {
      visibility: visible;
    }
    #operator-details-panel {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      margin: 0;
      padding: 0;
    }
    .no-print,
    .btn,
    button,
    select {
      display: none !important;
    }
    .call-card-details {
      display: grid !important;
    } /* Force expand all calls for print */
  }
</style>

<script>
  import { actions } from "astro:actions";
  import {
    calculateAuditScores,
    calculateChannelAverages,
    formatChannelAverageScore,
    getChannelAverageBadgeClass,
  } from "@lib/qualityCalculator";
  import { escapeHtml } from "@lib/sanitize";

  import { formatMonthLabel } from "@lib/monthUtils";
  import { getCleanBase } from "@lib/baseUrl";
  import type {
    QualityCall,
    OperatorQuality,
    AuditParameter,
  } from "@/types/quality";

  const cleanBase = getCleanBase();

  const ICON_CHECK = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;"><path d="m10 15.586-3.293-3.293-1.414 1.414L10 18.414l9.707-9.707-1.414-1.414z"></path></svg>`;
  const ICON_X = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;"><path d="m16.192 6.344-4.243 4.242-4.242-4.242-1.414 1.414L10.535 12l-4.242 4.242 1.414 1.414 4.242-4.242 4.243 4.242 1.414-1.414L13.364 12l4.242-4.242z"></path></svg>`;
  const ICON_ARROW = `<svg class="size-4 text-warning" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;"><path d="M10.707 17.707 16.414 12l-5.707-5.707-1.414 1.414L13.586 12l-4.293 4.293z"></path></svg>`;
  const ICON_STAR = `<svg class="size-4 text-success" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;"><path d="M21.947 9.179a1.001 1.001 0 0 0-.868-.676l-5.701-.453-2.467-5.461a.998.998 0 0 0-1.822-.001L8.622 8.05l-5.701.453a1 1 0 0 0-.619 1.713l4.214 4.107-1.29 5.71a1.001 1.001 0 0 0 1.451 1.054L12 18.26l5.324 2.827a1.002 1.002 0 0 0 1.45-1.054l-1.29-5.71 4.214-4.107a1 1 0 0 0 .249-1.037z"></path></svg>`;

  const getAuditParameters = () => {
    const el = document.getElementById("audit-parameters-data");
    if (!el) return [];
    try {
      return JSON.parse(el.getAttribute("data-parameters") || "[]");
    } catch (e) {
      return [];
    }
  };

  const getOperatorFullData = (id: string) => {
    const el = document.getElementById("operators-data");
    if (!el) return null;
    try {
      const map = JSON.parse(el.getAttribute("data-operators") || "{}");
      return map[id] || null;
    } catch (e) {
      return null;
    }
  };

  function renderCallCard(call: QualityCall, index: number) {
    const isUserAgent =
      document
        .querySelector("[data-is-agent]")
        ?.getAttribute("data-is-agent") === "true";
    const s1ScoreColor =
      call.section1.score >= 90
        ? "text-success"
        : call.section1.score >= 70
          ? "text-warning"
          : "text-error";
    const s2ScoreColor =
      call.section2.score >= 90
        ? "text-success"
        : call.section2.score >= 70
          ? "text-warning"
          : "text-error";
    const badgeClass =
      call.totalScore >= 90
        ? "badge-success"
        : call.totalScore >= 80
          ? "badge-warning"
          : "badge-error";

    // Filtrar parámetros dinámicos para el canal de la auditoría
    const params: AuditParameter[] = getAuditParameters();
    const currentChannel = call.channelType || "wise_call";
    const channelParams = params.filter(
      (p) => (p.channel || "wise_call") === currentChannel && p.active !== false,
    );

    let s1Params = channelParams.filter((p) => p.section === "items");
    if (s1Params.length === 0) {
      s1Params = params.filter((p) =>
        call.section1.details.hasOwnProperty(p.code),
      );
    }

    let s2Params = channelParams.filter(
      (p) => p.section === "ticket" || p.section === "mda",
    );
    if (s2Params.length === 0) {
      s2Params = params.filter((p) =>
        call.section2.details.hasOwnProperty(p.code),
      );
    }

    const hasS2 =
      call.channelType === "wise_call"
        ? (call.appliesMda ?? true)
        : call.channelType === "wise_email"
          ? Boolean(call.appliesMda)
          : Boolean(call.staysInMda);

    const s1ListHTML = s1Params
      .map((param) => {
        const isChecked =
          param.code in call.section1.details
            ? Boolean(call.section1.details[param.code])
            : false;
        const comment = call.comments?.[param.code];
        return `
        <li class="flex flex-col group/item border-b border-base-200/40 last:border-b-0 py-1.5">
          <div class="flex items-center justify-between">
            <span class="text-base-content/70 font-medium group-hover/item:text-base-content transition-colors text-xs">
              ${escapeHtml(param.name)}
              <span class="text-xs opacity-50 font-normal ml-1.5">(${param.weight})</span>
            </span>
            <span class="${isChecked ? "text-success" : "text-error"}" title="${isChecked ? "Cumple" : "No Cumple"}">${isChecked ? ICON_CHECK : ICON_X}</span>
          </div>
          ${
            comment
              ? `
            <div class="mt-1 flex items-start gap-1.5 text-xs text-base-content/80 bg-base-200/50 rounded-lg px-2.5 py-1 border border-base-300/40">
              <span class="text-secondary text-xxs font-bold uppercase tracking-wider shrink-0 mt-0.5">Obs:</span>
              <span class="break-words font-sans text-xs">${escapeHtml(comment)}</span>
            </div>
          `
              : ""
          }
        </li>
      `;
      })
      .join("");

    const s2ListHTML = !hasS2
      ? `<li class="text-xs text-base-content/40 italic py-2">${
          call.channelType === "wise_call"
            ? "No aplica evaluación de ticket (no se generó ticket)."
            : "No aplica ticket MDA."
        }</li>`
      : s2Params
          .map((param) => {
            const isChecked =
              param.code in call.section2.details
                ? Boolean(call.section2.details[param.code])
                : call.section2.score === 100;
            const comment = call.comments?.[param.code];
            return `
        <li class="flex flex-col group/item border-b border-base-200/40 last:border-b-0 py-1.5">
          <div class="flex items-center justify-between">
            <span class="text-base-content/70 font-medium group-hover/item:text-base-content transition-colors text-xs">
              ${escapeHtml(param.name)}
              <span class="text-xs opacity-50 font-normal ml-1.5">(${param.weight})</span>
            </span>
            <span class="${isChecked ? "text-success" : "text-error"}" title="${isChecked ? "Cumple" : "No Cumple"}">${isChecked ? ICON_CHECK : ICON_X}</span>
          </div>
          ${
            comment
              ? `
            <div class="mt-1 flex items-start gap-1.5 text-xs text-base-content/80 bg-base-200/50 rounded-lg px-2.5 py-1 border border-base-300/40">
              <span class="text-secondary text-xxs font-bold uppercase tracking-wider shrink-0 mt-0.5">Obs:</span>
              <span class="break-words font-sans text-xs">${escapeHtml(comment)}</span>
            </div>
          `
              : ""
          }
        </li>
      `;
          })
          .join("");

    const notesSection = call.notes
      ? `
        <div class="col-span-full border-t border-base-200/50 pt-4 mt-4">
          <div class="text-xs font-bold uppercase tracking-widest text-base-content/40 mb-1">Notas / Observaciones de la llamada</div>
          <p class="text-sm text-base-content/70 whitespace-pre-line">${escapeHtml(call.notes)}</p>
        </div>
      `
      : "";

    return `
      <div class="call-card-container rounded-3xl border border-base-300 bg-base-100 overflow-hidden shadow-md relative group">
        
        <!-- Decoration Left Border -->
        <div class="absolute left-0 top-0 bottom-0 w-2 ${badgeClass.replace("badge-", "bg-")} opacity-80 group-hover:opacity-100 transition-opacity"></div>
        
        <!-- Card Header -->
        <div class="flex flex-wrap items-center justify-between border-b border-base-200 bg-base-100 p-6 pl-8">
          <div class="flex items-center gap-5">
            <div class="flex size-12 items-center justify-center rounded-2xl bg-base-200 font-black text-base-content/70 border border-base-300 shadow-inner">
              #${index + 1}
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-mono text-lg font-black tracking-tight text-base-content">${escapeHtml(call.callId)}</span>
                ${call.isPas ? '<span class="badge badge-secondary badge-sm font-bold uppercase tracking-wider text-xxs px-2 py-1.5 shadow-sm">PAS</span>' : ""}
              </div>
              <div class="text-xs font-medium text-base-content/50 mt-1 uppercase tracking-widest">Ticket: <span class="font-mono text-base-content/70">${escapeHtml(call.ticketId || "--")}</span> ${call.date ? `<span class="opacity-50 ml-1">(${call.date})</span>` : ""}</div>
            </div>
          </div>
          <div class="flex items-center gap-8 mt-4 sm:mt-0">
            ${
              call.channelType === "wise_call"
                ? `
            <div class="text-right">
              <div class="text-xs font-bold uppercase tracking-widest text-base-content/40 mb-1">Duración</div>
              <div class="text-base font-mono font-bold text-base-content/80">${escapeHtml(call.duration || "00:00")}</div>
            </div>
            `
                : call.channelType === "wise_email"
                  ? `
            <div class="text-right">
              <div class="text-xs font-bold uppercase tracking-widest text-base-content/40 mb-1">Respuesta</div>
              <div class="text-base font-mono font-bold text-base-content/80">${escapeHtml(call.duration || "00:00")}</div>
            </div>
            `
                  : call.takeTime || call.creationTime
                    ? `
            <div class="text-right">
              <div class="text-xs font-bold uppercase tracking-widest text-base-content/40 mb-1">Toma / Lectura</div>
              <div class="text-xs font-mono font-bold text-base-content/80">${escapeHtml(call.takeTime || call.creationTime || "")}</div>
            </div>
            `
                    : ""
            }
            <div class="text-right">
              <div class="text-xs font-bold uppercase tracking-widest text-base-content/40 mb-1">Score Total</div>
              <div class="badge ${badgeClass} font-black shadow-sm text-sm py-3 px-3">
                ${call.totalScore}%
              </div>
            </div>
            ${
              isUserAgent
                ? ""
                : `
            <button 
              class="btn btn-circle btn-ghost btn-sm text-base-content/50 hover:text-secondary ml-1 edit-audit-btn" 
              data-call-id="${call.id}"
              title="Editar Auditoría"
            >
              <svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="fill: currentColor;"><path d="m18.988 2.012-3 3L19.988 9.012l3-3zM3.988 17.012v4h4l12.75-12.75-4-4z"></path></svg>
            </button>
            `
            }
            <button 
              class="btn btn-circle btn-ghost btn-sm text-base-content/50 hover:text-base-content hover:bg-base-200 ml-1" 
              onclick="this.closest('.call-card-container').querySelector('.call-card-details').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');"
              title="Expandir / Minimizar detalles"
            >
              <svg class="size-6 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;"><path d="M16.293 9.293 12 13.586 7.707 9.293l-1.414 1.414L12 16.414l5.707-5.707z"></path></svg>
            </button>
          </div>
        </div>
        
        <!-- Details Grid -->
        <div class="call-card-details hidden grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-base-200 bg-base-200/20">
          
          <!-- Section 1 -->
          <div class="p-6 pl-8">
            <div class="mb-6 flex items-center justify-between border-b border-base-300/50 pb-3">
              <h5 class="font-bold text-xs uppercase tracking-widest text-base-content/70">${call.channelType === "wise_call" ? "Interacción con Usuario" : call.channelType === "wise_email" ? "Gestión del Correo" : "Gestión del Caso"}</h5>
              <div class="flex items-baseline gap-1">
                <span class="text-xl font-black ${s1ScoreColor}">${call.section1.score}</span>
                <span class="text-xs font-bold text-base-content/30">/${call.section1.maxScore}</span>
              </div>
            </div>
            <ul class="space-y-3.5 text-sm">
              ${s1ListHTML}
            </ul>
          </div>
          
          <!-- Section 2 -->
          <div class="p-6">
            <div class="mb-6 flex items-center justify-between border-b border-base-300/50 pb-3">
              <h5 class="font-bold text-xs uppercase tracking-widest text-base-content/70">${call.channelType === "wise_call" ? (!hasS2 ? "Gestión del Ticket (No Aplica)" : "Gestión del Ticket") : call.channelType === "wise_email" ? (call.appliesMda ? "Ticket MDA" : "Ticket MDA (No Aplica)") : (call.staysInMda ? "Ticket MDA" : "Ticket MDA (No Aplica)")}</h5>
              <div class="flex items-baseline gap-1">
                <span class="text-xl font-black ${s2ScoreColor}">${call.section2.score}</span>
                <span class="text-xs font-bold text-base-content/30">/${call.section2.maxScore}</span>
              </div>
            </div>
            <ul class="space-y-3.5 text-sm">
              ${s2ListHTML}
            </ul>
          </div>

          <div class="col-span-full p-6 pl-8 border-t border-base-200 bg-base-200/40">
            ${notesSection}
            ${!call.notes ? '<p class="text-xs text-base-content/40 italic">Sin observaciones o notas registradas.</p>' : ""}
          </div>

        </div>
      </div>
    `;
  }

  function initQualityMasterDetail() {
    const rootContainer =
      document.getElementById("operators-grid") ||
      document.getElementById("operator-details-panel");
    if (!rootContainer) return false;
    if (rootContainer.dataset.masterDetailBound === "true") return true;
    rootContainer.dataset.masterDetailBound = "true";

    let currentActiveChannel = "wise_call";

    const detailsModal = document.getElementById(
      "operator-details-modal",
    ) as HTMLDialogElement | null;

    const monthSelector = document.getElementById(
      "month-selector",
    ) as HTMLSelectElement | null;
    const btnPrevMonth = document.getElementById(
      "btn-prev-month",
    ) as HTMLButtonElement | null;
    const btnNextMonth = document.getElementById(
      "btn-next-month",
    ) as HTMLButtonElement | null;

    const updateMonthButtonsState = () => {
      if (!monthSelector) return;
      const idx = monthSelector.selectedIndex;
      const totalOptions = monthSelector.options.length;

      if (btnPrevMonth) {
        const canGoPrev = idx < totalOptions - 1;
        btnPrevMonth.disabled = !canGoPrev;
        if (!canGoPrev) {
          btnPrevMonth.classList.add("opacity-50");
        } else {
          btnPrevMonth.classList.remove("opacity-50");
        }
      }

      if (btnNextMonth) {
        const canGoNext = idx > 0;
        btnNextMonth.disabled = !canGoNext;
        if (!canGoNext) {
          btnNextMonth.classList.add("opacity-50");
        } else {
          btnNextMonth.classList.remove("opacity-50");
        }
      }
    };

    if (monthSelector) {
      monthSelector.addEventListener("change", (e) => {
        const select = e.target as HTMLSelectElement;
        const url = new URL(window.location.href);
        url.searchParams.set("month", select.value);
        if (activeAgentId) {
          url.searchParams.set("agentId", activeAgentId);
        } else {
          url.searchParams.delete("agentId");
        }
        window.location.href = url.toString();
      });

      updateMonthButtonsState();

      if (btnPrevMonth) {
        btnPrevMonth.addEventListener("click", () => {
          if (monthSelector.selectedIndex < monthSelector.options.length - 1) {
            monthSelector.selectedIndex += 1;
            monthSelector.dispatchEvent(new Event("change"));
          }
        });
      }

      if (btnNextMonth) {
        btnNextMonth.addEventListener("click", () => {
          if (monthSelector.selectedIndex > 0) {
            monthSelector.selectedIndex -= 1;
            monthSelector.dispatchEvent(new Event("change"));
          }
        });
      }
    }

    const dAvatar = document.getElementById("detail-avatar");
    const dName = document.getElementById("detail-name");
    const dId = document.getElementById("detail-id");
    const dMonth = document.getElementById("detail-month");
    const dScore = document.getElementById("detail-score");
    const dStatDiff = document.getElementById("detail-stat-diff");
    const dStatAht = document.getElementById("detail-stat-aht");
    const dStatInteraction = document.getElementById("detail-stat-interaction");
    const dStatManagement = document.getElementById("detail-stat-management");
    const dMonthSummary = document.getElementById("detail-month-summary");
    const dMonthSummaryEmpty = document.getElementById(
      "detail-month-summary-empty",
    );
    const callsContainer = document.getElementById("detail-calls-container");
    const btnBack = document.getElementById("btn-back-to-summary");

    // Modal elements
    const auditModal = document.getElementById(
      "audit-modal",
    ) as HTMLDialogElement;
    const auditForm = document.getElementById("audit-form") as HTMLFormElement;
    const modalTitle = document.getElementById("modal-title");
    const formAuditId = document.getElementById(
      "form-audit-id",
    ) as HTMLInputElement;
    const formAgentId = document.getElementById(
      "form-agent-id",
    ) as HTMLInputElement;
    const formCallId = document.getElementById(
      "form-call-id",
    ) as HTMLInputElement;
    const formTicketId = document.getElementById(
      "form-ticket-id",
    ) as HTMLInputElement;
    const formDuration = document.getElementById(
      "form-duration",
    ) as HTMLInputElement;
    const formDate = document.getElementById("form-date") as HTMLInputElement;
    const btnDeleteAudit = document.getElementById(
      "btn-delete-audit",
    ) as HTMLButtonElement;
    const btnCloseModal = document.getElementById(
      "btn-close-modal",
    ) as HTMLButtonElement;

    // Additional field elements
    const formNotes = document.getElementById(
      "form-notes",
    ) as HTMLTextAreaElement;

    // Month Summary Modal elements
    const summaryModal = document.getElementById(
      "month-summary-modal",
    ) as HTMLDialogElement;
    const summaryForm = document.getElementById(
      "month-summary-form",
    ) as HTMLFormElement;
    const summaryAgentId = document.getElementById(
      "summary-agent-id",
    ) as HTMLInputElement;
    const summaryContent = document.getElementById(
      "summary-content",
    ) as HTMLTextAreaElement;
    const btnCloseSummaryModal = document.getElementById(
      "btn-close-summary-modal",
    ) as HTMLButtonElement;
    const btnEditMonthSummary = document.getElementById(
      "btn-edit-month-summary",
    ) as HTMLButtonElement;

    let activeAgentId = "";
    let activeAgentSummary = "";

    function clearFormErrors(form: HTMLFormElement) {
      form
        .querySelectorAll(".input, .textarea, .checkbox, .select")
        .forEach((el) => {
          el.classList.remove(
            "input-error",
            "textarea-error",
            "checkbox-error",
            "select-error",
          );
        });
      form.querySelectorAll(".field-error-msg").forEach((el) => el.remove());
    }

    interface FormValidationError {
      issues?: Array<{
        path: Array<string | number>;
        message: string;
      }>;
      message?: string;
    }

    function showFormErrors(
      form: HTMLFormElement,
      error: FormValidationError | null | undefined,
    ) {
      clearFormErrors(form);
      if (!error) return;

      const issues = error.issues || [];
      let firstErrorElement: HTMLElement | null = null;

      issues.forEach((issue) => {
        const fieldName = issue.path[0];
        if (!fieldName) return;

        const input = form.querySelector(
          `[name="${fieldName}"]`,
        ) as HTMLElement;
        if (input) {
          if (input.classList.contains("textarea")) {
            input.classList.add("textarea-error");
          } else if (input.classList.contains("checkbox")) {
            input.classList.add("checkbox-error");
          } else if (input.classList.contains("select")) {
            input.classList.add("select-error");
          } else {
            input.classList.add("input-error");
          }

          const errContainer = input.closest("[data-field]");
          if (errContainer) {
            const errMsg = document.createElement("span");
            errMsg.className =
              "text-error text-xs font-bold mt-1 field-error-msg";
            errMsg.textContent = issue.message;
            errContainer.appendChild(errMsg);
          }

          if (!firstErrorElement) {
            firstErrorElement = input;
          }
        }
      });

      if (firstErrorElement) {
        (firstErrorElement as HTMLElement).focus();
      } else {
        alert(error.message || "Error de validación en el formulario.");
      }
    }

    // open modal for editing or new audit
    const openAuditModal = (
      agentId: string,
      callData: QualityCall | null = null,
      defaultChannel: string = "wise_call",
    ) => {
      activeAgentId = agentId;
      if (!auditForm || !auditModal) return;
      auditForm.reset();
      clearFormErrors(auditForm);
      (window as any).resetTicketViewer?.();
      if (formAgentId) formAgentId.value = agentId;

      const targetChannel = callData ? (callData.channelType || "wise_call") : defaultChannel;
      const targetBtn = document.querySelector(`.channel-btn[data-channel="${targetChannel}"]`) as HTMLButtonElement | null;
      if (targetBtn) {
        targetBtn.click();
      }

      if (callData) {
        // Edit mode
        if (modalTitle) {
          modalTitle.innerHTML = `<svg class="size-6 text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="fill: currentColor; margin-right: 0.5rem;"><path d="m18.988 2.012-3 3L19.988 9.012l3-3zM3.988 17.012v4h4l12.75-12.75-4-4z"></path></svg> Editar Auditoría de Calidad`;
        }
        if (formAuditId) formAuditId.value = String(callData.id);
        if (formCallId) formCallId.value = callData.callId;
        if (formTicketId) formTicketId.value = callData.ticketId;
        if (formDuration) formDuration.value = callData.duration;
        if (formDate) formDate.value = callData.date.substring(0, 10);
        if (formNotes) formNotes.value = callData.notes || "";

        const formRing = document.getElementById("form-ring-time") as HTMLInputElement | null;
        const formCreation = document.getElementById("form-creation-time") as HTMLInputElement | null;
        const formTake = document.getElementById("form-take-time") as HTMLInputElement | null;
        const formRecordingUrl = document.getElementById("form-recording-url") as HTMLInputElement | null;
        const formIsPas = document.getElementById("form-is-pas") as HTMLInputElement | null;
        const toggleCallGeneratedTicket = document.getElementById("toggle-call-generated-ticket") as HTMLInputElement | null;
        const toggleAppliesMda = document.getElementById("toggle-applies-mda") as HTMLInputElement | null;
        const toggleStaysMda = document.getElementById("toggle-stays-mda") as HTMLInputElement | null;

        if (formRing) formRing.value = callData.ringTime || "";
        if (formCreation) formCreation.value = callData.creationTime || "";
        if (formTake) formTake.value = callData.takeTime || "";
        if (formRecordingUrl) formRecordingUrl.value = callData.recordingUrl || "";
        if (formIsPas) formIsPas.checked = !!callData.isPas;

        // Populate audio viewer if callData has recordingUrl
        const tvAudioContainer = document.getElementById("tv-audio-container");
        const tvAudioPlayer = document.getElementById("tv-audio-player") as HTMLAudioElement | null;
        const tvAudioDownload = document.getElementById("tv-audio-download") as HTMLAnchorElement | null;
        if (callData.recordingUrl && tvAudioContainer && tvAudioPlayer && tvAudioDownload) {
          const caseId = callData.callId || "llamada";
          const downloadUrl = `${cleanBase}api/calidad/download-audio?url=${encodeURIComponent(callData.recordingUrl)}&filename=grabacion-caso-${encodeURIComponent(caseId)}.mp3&download=1`;
          tvAudioPlayer.src = callData.recordingUrl;
          tvAudioPlayer.load();
          tvAudioDownload.href = downloadUrl;
          tvAudioContainer.classList.remove("hidden");
        }
        if (toggleCallGeneratedTicket) {
          toggleCallGeneratedTicket.checked = (callData.channelType || "wise_call") === "wise_call"
            ? (callData.appliesMda ?? true)
            : (callData.appliesMda !== false);
          toggleCallGeneratedTicket.dispatchEvent(new Event("change"));
        }
        if (toggleAppliesMda) {
          toggleAppliesMda.checked = !!callData.appliesMda;
          toggleAppliesMda.dispatchEvent(new Event("change"));
        }
        if (toggleStaysMda) {
          toggleStaysMda.checked = callData.staysInMda ?? true;
          toggleStaysMda.dispatchEvent(new Event("change"));
        }

        const s1Details = callData.section1?.details || {};
        const s2Details = callData.section2?.details || {};
        const comments = callData.comments || {};

        auditForm.querySelectorAll(".audit-checkbox").forEach((cbEl) => {
          const cb = cbEl as HTMLInputElement;
          const name = cb.name;
          if (s1Details.hasOwnProperty(name)) {
            cb.checked = !!s1Details[name];
          } else if (s2Details.hasOwnProperty(name)) {
            cb.checked = !!s2Details[name];
          }
        });

        // Precargar comentarios por parámetro
        auditForm.querySelectorAll<HTMLInputElement>("input[name$='_comment']").forEach((inp) => {
          const code = inp.name.replace(/_comment$/, "");
          inp.value = comments[code] || "";
        });

        if (btnDeleteAudit) btnDeleteAudit.classList.remove("hidden");
      } else {
        // New mode
        if (modalTitle) {
          modalTitle.innerHTML = `<svg class="size-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="fill: currentColor; margin-right: 0.5rem;"><path d="M19 11h-6V5h-2v6H5v2h6v6h2v-6h6z"></path></svg> Nueva Auditoría de Calidad`;
        }
        if (formAuditId) formAuditId.value = "";
        if (formCallId) formCallId.value = "";
        if (formTicketId) formTicketId.value = "";
        if (formDuration) formDuration.value = "";
        if (formNotes) formNotes.value = "";

        const formRing = document.getElementById("form-ring-time") as HTMLInputElement | null;
        const formCreation = document.getElementById("form-creation-time") as HTMLInputElement | null;
        const formTake = document.getElementById("form-take-time") as HTMLInputElement | null;
        const formIsPas = document.getElementById("form-is-pas") as HTMLInputElement | null;
        const caseSearchInput = document.getElementById("case-search-id") as HTMLInputElement | null;
        const alertBox = document.getElementById("fetch-feedback-alert");

        const toggleCallGeneratedTicket = document.getElementById("toggle-call-generated-ticket") as HTMLInputElement | null;
        const toggleAppliesMda = document.getElementById("toggle-applies-mda") as HTMLInputElement | null;
        const toggleStaysMda = document.getElementById("toggle-stays-mda") as HTMLInputElement | null;

        if (formRing) formRing.value = "";
        if (formCreation) formCreation.value = "";
        if (formTake) formTake.value = "";
        if (formIsPas) formIsPas.checked = false;
        if (caseSearchInput) caseSearchInput.value = "";
        if (alertBox) alertBox.classList.add("hidden");
        if (toggleCallGeneratedTicket) {
          toggleCallGeneratedTicket.checked = true;
          toggleCallGeneratedTicket.dispatchEvent(new Event("change"));
        }
        if (toggleAppliesMda) {
          toggleAppliesMda.checked = false;
          toggleAppliesMda.dispatchEvent(new Event("change"));
        }
        if (toggleStaysMda) {
          toggleStaysMda.checked = true;
          toggleStaysMda.dispatchEvent(new Event("change"));
        }

        const today = new Date().toISOString().substring(0, 10);
        if (formDate) formDate.value = today;

        auditForm.querySelectorAll(".audit-checkbox").forEach((cbEl) => {
          (cbEl as HTMLInputElement).checked = true;
        });

        // Limpiar comentarios por parámetro
        auditForm.querySelectorAll<HTMLInputElement>("input[name$='_comment']").forEach((inp) => {
          inp.value = "";
        });

        if (btnDeleteAudit) btnDeleteAudit.classList.add("hidden");
      }

      (window as any).refreshAuditCommentsVisibility?.();
      (window as any).recalculateAuditScores?.();
      auditModal.showModal();
    };

    // Close modal triggers
    if (btnCloseModal) {
      btnCloseModal.addEventListener("click", () => {
        auditModal?.close();
      });
    }

    // Attach "Nueva Auditoría" button listener
    const btnNewAudit = document.getElementById("btn-new-audit");
    if (btnNewAudit) {
      btnNewAudit.addEventListener("click", () => {
        const monthVal = monthSelector?.value || "";
        if (activeAgentId) {
          window.location.href = `${cleanBase}supervision/calidad-operadores/nueva?agentId=${encodeURIComponent(activeAgentId)}&month=${encodeURIComponent(monthVal)}`;
        } else {
          window.location.href = `${cleanBase}supervision/calidad-operadores/nueva?month=${encodeURIComponent(monthVal)}`;
        }
      });
    }

    // Submit form using Astro Actions
    auditForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearFormErrors(auditForm);

      const btnSubmit = (document.getElementById("btn-submit-audit") ||
        auditForm.querySelector('button[type="submit"]')) as HTMLButtonElement | null;
      const originalText = btnSubmit ? btnSubmit.innerHTML : "";
      if (btnSubmit) {
        btnSubmit.disabled = true;
        btnSubmit.innerHTML =
          '<span class="loading loading-spinner loading-xs"></span> Guardando…';
      }

      const formData = new FormData(auditForm);
      const toggleCallGeneratedTicket = document.getElementById("toggle-call-generated-ticket") as HTMLInputElement | null;
      const toggleAppliesMda = document.getElementById("toggle-applies-mda") as HTMLInputElement | null;
      const toggleStaysMda = document.getElementById("toggle-stays-mda") as HTMLInputElement | null;
      if (toggleCallGeneratedTicket) {
        formData.set("callGeneratedTicket", toggleCallGeneratedTicket.checked ? "true" : "false");
      }
      if (toggleAppliesMda) {
        formData.set("appliesMda", toggleAppliesMda.checked ? "true" : "false");
      }
      if (toggleStaysMda) {
        formData.set("staysInMda", toggleStaysMda.checked ? "true" : "false");
      }
      const activeChannel = (formData.get("channelType") as string) || "wise_call";
      const callIdVal = (formData.get("callId") as string)?.trim() || "";
      const ticketIdVal = (formData.get("ticketId") as string)?.trim() || "";

      // Dynamic validation per channel
      if (activeChannel === "wise_call" && !callIdVal) {
        (window as any).showToast?.("El Nro de Caso / ID de Llamada es requerido.", "alert-warning");
        const callInput = document.getElementById("form-call-id");
        callInput?.focus();
        if (btnSubmit) {
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = originalText;
        }
        return;
      }
      if (activeChannel === "wise_email" && !callIdVal) {
        (window as any).showToast?.("El Nro de Caso / Mail Wise es requerido.", "alert-warning");
        const callInput = document.getElementById("form-call-id");
        callInput?.focus();
        if (btnSubmit) {
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = originalText;
        }
        return;
      }
      if (activeChannel === "invgate_ticket") {
        if (!ticketIdVal && !callIdVal) {
          (window as any).showToast?.("El Nro de Caso / Ticket AG es requerido.", "alert-warning");
          const ticketInput = document.getElementById("form-ticket-id");
          ticketInput?.focus();
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = originalText;
          }
          return;
        }
        if (!callIdVal) {
          formData.set("callId", ticketIdVal);
        }
      }

      if (!formData.get("duration")) {
        formData.set("duration", "00:00");
      }

      // Ensure notes is always present (even if textarea is empty)
      if (!formData.has("notes")) {
        formData.set("notes", "");
      }
      try {
        const result = await actions.saveAudit(formData);
        if (result.error) {
          console.error("Validation error:", result.error);
          showFormErrors(auditForm, result.error);
        } else if (result.data?.success) {
          const url = new URL(window.location.href);
          if (activeAgentId) {
            url.searchParams.set("agentId", activeAgentId);
          }
          url.searchParams.set("toast_msg", "Auditoría guardada con éxito.");
          url.searchParams.set("toast_type", "success");
          window.location.href = url.toString();
        } else {
          (window as any).showToast?.(
            "Error al guardar la auditoría.",
            "alert-error",
          );
        }
      } catch (error) {
        console.error(error);
        (window as any).showToast?.(
          "Ocurrió un error inesperado al guardar la auditoría.",
          "alert-error",
        );
      } finally {
        if (btnSubmit) {
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = originalText;
        }
      }
    });

    // Handle Month Summary Modal
    if (btnEditMonthSummary) {
      btnEditMonthSummary.addEventListener("click", () => {
        if (activeAgentId) {
          summaryForm.reset();
          clearFormErrors(summaryForm);
          summaryAgentId.value = activeAgentId;
          summaryContent.value = activeAgentSummary;
          summaryModal.showModal();
        }
      });
    }

    if (btnCloseSummaryModal) {
      btnCloseSummaryModal.addEventListener("click", () => {
        summaryModal.close();
      });
    }

    summaryForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearFormErrors(summaryForm);

      const btnSubmit = summaryForm.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;
      const originalText = btnSubmit.innerHTML;
      btnSubmit.disabled = true;
      btnSubmit.innerHTML =
        '<span class="loading loading-spinner loading-xs"></span> Guardando…';

      const formData = new FormData(summaryForm);
      // Ensure summary is always present (even if textarea is empty)
      if (!formData.has("summary")) {
        formData.set("summary", "");
      }
      try {
        const result = await actions.saveMonthSummary(formData);
        if (result.error) {
          console.error("Validation error:", result.error);
          showFormErrors(summaryForm, result.error);
        } else if (result.data?.success) {
          const url = new URL(window.location.href);
          if (activeAgentId) {
            url.searchParams.set("agentId", activeAgentId);
          }
          url.searchParams.set(
            "toast_msg",
            "Observaciones del mes guardadas con éxito.",
          );
          url.searchParams.set("toast_type", "success");
          window.location.href = url.toString();
        } else {
          (window as any).showToast?.(
            "Error al guardar el resumen.",
            "alert-error",
          );
        }
      } catch (error) {
        console.error(error);
        (window as any).showToast?.(
          "Ocurrió un error inesperado al guardar el resumen.",
          "alert-error",
        );
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = originalText;
      }
    });

    // Delete audit using Astro Actions
    btnDeleteAudit.addEventListener("click", async () => {
      const auditId = formAuditId.value;
      if (!auditId) return;

      if (confirm("¿Estás seguro de que querés eliminar esta auditoría?")) {
        const originalText = btnDeleteAudit.innerHTML;
        btnDeleteAudit.disabled = true;
        btnDeleteAudit.innerHTML =
          '<span class="loading loading-spinner loading-xs"></span> Eliminando…';

        try {
          const deleteForm = new FormData();
          deleteForm.append("id", auditId);

          const result = await actions.deleteAudit(deleteForm);
          if (result.data?.success) {
            const url = new URL(window.location.href);
            if (activeAgentId) {
              url.searchParams.set("agentId", activeAgentId);
            }
            url.searchParams.set("toast_msg", "Auditoría eliminada con éxito.");
            url.searchParams.set("toast_type", "success");
            window.location.href = url.toString();
          } else {
            (window as any).showToast?.(
              "Error al eliminar la auditoría.",
              "alert-error",
            );
            btnDeleteAudit.disabled = false;
            btnDeleteAudit.innerHTML = originalText;
          }
        } catch (error) {
          console.error(error);
          (window as any).showToast?.(
            "Ocurrió un error inesperado al eliminar la auditoría.",
            "alert-error",
          );
          btnDeleteAudit.disabled = false;
          btnDeleteAudit.innerHTML = originalText;
        }
      }
    });

    if (btnBack) {
      btnBack.addEventListener("click", () => {
        if (detailsModal && typeof detailsModal.close === "function") {
          detailsModal.close();
        }
      });
    }

    let searchInput = document.getElementById(
      "operator-search",
    ) as HTMLInputElement | null;
    const noResultsMsg = document.getElementById("calidad-empty-state");

    const updateOperatorsList = () => {
      const term = searchInput?.value.toLowerCase().trim() || "";
      let hasVisibleItems = false;

      const cards = Array.from(
        document.querySelectorAll(".operator-card"),
      ) as HTMLElement[];

      cards.forEach((card) => {
        const name = card.getAttribute("data-name") || "";
        const id = card.getAttribute("data-id") || "";
        const username = card.getAttribute("data-username") || "";

        const matchesSearch =
          !term ||
          name.includes(term) ||
          id.includes(term) ||
          username.includes(term);

        if (matchesSearch) {
          card.classList.remove("hidden");
          hasVisibleItems = true;
        } else {
          card.classList.add("hidden");
        }
      });

      if (!hasVisibleItems && noResultsMsg) {
        noResultsMsg.classList.remove("hidden");
        noResultsMsg.classList.add("flex");
      } else if (noResultsMsg) {
        noResultsMsg.classList.add("hidden");
        noResultsMsg.classList.remove("flex");
      }
    };

    if (searchInput) {
      searchInput.addEventListener("input", updateOperatorsList);
    }

    const displayOperatorDetails = (operatorId: string) => {
      const operator = getOperatorFullData(operatorId) as OperatorQuality | null;
      if (!operator) return;
      activeAgentId = operator.id;

      if (dAvatar)
        dAvatar.textContent = operator.name
          .split(" ")
          .map((n: string) => n[0])
          .join("")
          .substring(0, 2);
      if (dName) dName.textContent = operator.name;
      if (dId) dId.textContent = `@${operator.username || operator.id}`;
      if (dMonth) dMonth.textContent = formatMonthLabel(operator.month);

      if (dScore) {
        dScore.textContent = `${operator.averageScore}%`;
        dScore.className = `text-5xl font-black tracking-tighter ${operator.averageScore >= 90 ? "text-success" : operator.averageScore >= 80 ? "text-warning" : "text-error"}`;
      }

      if (dStatDiff) {
        const currentScore = operator.averageScore;
        const prevScore = operator.prevAverageScore || 0;
        const hasPrevAudits = (operator.prevCallsCount ?? 0) > 0;

        if (hasPrevAudits) {
          const diff = currentScore - prevScore;
          if (diff > 0) {
            dStatDiff.textContent = `+${diff}%`;
            dStatDiff.className = "text-xl font-black text-success";
          } else if (diff < 0) {
            dStatDiff.textContent = `${diff}%`;
            dStatDiff.className = "text-xl font-black text-error";
          } else {
            dStatDiff.textContent = `0%`;
            dStatDiff.className = "text-xl font-black text-base-content/40";
          }
        } else {
          dStatDiff.textContent = "N/A";
          dStatDiff.className = "text-xl font-black text-base-content/40";
        }
      }

      if (dStatAht) {
        const allAudits = operator.calls || [];
        const callAudits = allAudits.filter(
          (c: any) =>
            (c.channelType || "wise_call") === "wise_call" &&
            c.duration &&
            c.duration !== "00:00",
        );
        if (callAudits.length > 0) {
          const parseDurationToSeconds = (durStr: string) => {
            if (!durStr) return 0;
            const parts = durStr.split(":").map(Number);
            if (parts.length === 2) {
              return parts[0] * 60 + parts[1];
            } else if (parts.length === 3) {
              return parts[0] * 3600 + parts[1] * 60 + parts[2];
            }
            return 0;
          };
          const formatSecondsToDuration = (totalSecs: number) => {
            const m = Math.floor(totalSecs / 60);
            const s = Math.round(totalSecs % 60);
            return `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
          };
          const totalSecs = callAudits.reduce(
            (acc: number, c: any) => acc + parseDurationToSeconds(c.duration),
            0,
          );
          const avgSecs = totalSecs / callAudits.length;
          dStatAht.textContent = formatSecondsToDuration(avgSecs);
        } else {
          dStatAht.textContent = "00:00";
        }
      }

      if (dStatInteraction) {
        const allAudits = operator.calls || [];
        if (allAudits.length > 0) {
          const avg = Math.round(
            allAudits.reduce(
              (acc: number, c: any) => acc + (c.section1?.score || 0),
              0,
            ) / allAudits.length,
          );
          dStatInteraction.textContent = `${avg}%`;
        } else {
          dStatInteraction.textContent = "--%";
        }
      }

      if (dStatManagement) {
        const allAudits = operator.calls || [];
        if (allAudits.length > 0) {
          const avg = Math.round(
            allAudits.reduce(
              (acc: number, c: any) => acc + (c.section2?.score || 0),
              0,
            ) / allAudits.length,
          );
          dStatManagement.textContent = `${avg}%`;
        } else {
          dStatManagement.textContent = "--%";
        }
      }

      activeAgentSummary = operator.monthSummary || "";
      if (dMonthSummary) dMonthSummary.textContent = activeAgentSummary;
      if (dMonthSummaryEmpty) {
        if (activeAgentSummary) {
          dMonthSummaryEmpty.classList.add("hidden");
        } else {
          dMonthSummaryEmpty.classList.remove("hidden");
        }
      }

      const historyContainer = document.getElementById("detail-history-chart");
      if (historyContainer && operator.history) {
        const points = operator.history;
        const width = 300;
        const height = 60;

        const coords = points.map((score: number, i: number) => {
          const x = (i / (points.length - 1)) * width;
          const y = height - (score / 100) * height;
          return { x, y, score };
        });

        const pathD = coords
          .map((c, i) => (i === 0 ? `M ${c.x},${c.y}` : `L ${c.x},${c.y}`))
          .join(" ");

        historyContainer.className = "relative w-full h-16 mt-2 mb-4";
        historyContainer.innerHTML = `
           <svg class="w-full h-full overflow-visible" viewBox="-4 -4 ${width + 8} ${height + 8}" preserveAspectRatio="none">
             <path d="${pathD}" fill="none" stroke="currentColor" stroke-width="3" class="text-secondary drop-shadow-sm" stroke-linecap="round" stroke-linejoin="round" />
             ${coords
               .map(
                 (c, i) => `
               <circle cx="${c.x}" cy="${c.y}" r="${i === points.length - 1 ? "5" : "4"}" fill="currentColor" class="${i === points.length - 1 ? "text-secondary" : "text-base-100"} stroke-secondary stroke-2 hover:r-6" />
             `,
               )
               .join("")}
           </svg>
           <div class="absolute w-full flex justify-between -bottom-5 text-xs font-bold text-base-content/50">
              ${points.map((p: number) => `<span>${p}%</span>`).join("")}
           </div>
         `;
      }

      const insightsContainer = document.getElementById("detail-insights");
      if (insightsContainer && operator.calls) {
        const failures: Record<string, number> = {};

        operator.calls.forEach((c) => {
          Object.entries(c.section1.details).forEach(([key, val]) => {
            if (!val) failures[key] = (failures[key] || 0) + 1;
          });
          Object.entries(c.section2.details).forEach(([key, val]) => {
            if (!val) failures[key] = (failures[key] || 0) + 1;
          });
        });

        const sortedFailures = Object.entries(failures)
          .sort((a, b) => b[1] - a[1])
          .slice(0, 2);

        if (sortedFailures.length > 0) {
          const params: AuditParameter[] = getAuditParameters();
          const paramNameMap = new Map<string, string>(
            params.map((p) => [p.code, p.name]),
          );

          insightsContainer.innerHTML = sortedFailures
            .map(
              ([key, count]) => `
             <li class="flex items-center gap-2">
               ${ICON_ARROW}
               <span>Falla frecuente en: <strong>${escapeHtml(paramNameMap.get(key) || key)}</strong> <span class="opacity-50">(${count} veces)</span></span>
             </li>
           `,
            )
            .join("");
        } else {
          insightsContainer.innerHTML = `<li class="text-success flex items-center gap-2">${ICON_STAR} <span class="font-bold">¡Rendimiento impecable!</span> No se detectaron patrones de error frecuentes.</li>`;
        }
      }

      currentActiveChannel = "wise_call";

      const updateChannelTabsAndList = () => {
        const allAudits = operator.calls || [];
        const wiseCalls = allAudits.filter(
          (c: any) => (c.channelType || "wise_call") === "wise_call",
        );
        const wiseEmails = allAudits.filter(
          (c: any) => c.channelType === "wise_email",
        );
        const invgateAgs = allAudits.filter(
          (c: any) => c.channelType === "invgate_ticket",
        );

        const averages = calculateChannelAverages(allAudits);

        const bCall = document.getElementById("tab-count-wise_call");
        const bEmail = document.getElementById("tab-count-wise_email");
        const bAg = document.getElementById("tab-count-invgate_ticket");

        const bCallAvg = document.getElementById("tab-avg-wise_call");
        const bEmailAvg = document.getElementById("tab-avg-wise_email");
        const bAgAvg = document.getElementById("tab-avg-invgate_ticket");

        const bTotalAvgVal = document.getElementById("total-samples-avg-val");
        const bTotalAvgBadge = document.getElementById(
          "total-samples-avg-badge",
        );
        const bQuota = document.getElementById("quota-progress-badge");

        if (bCall) bCall.textContent = `${wiseCalls.length}/4`;
        if (bEmail) bEmail.textContent = `${wiseEmails.length}/4`;
        if (bAg) bAg.textContent = `${invgateAgs.length}/4`;

        if (bCallAvg) {
          bCallAvg.textContent = formatChannelAverageScore(
            averages.wiseCallsAvg,
          );
          bCallAvg.className = `badge badge-xs font-bold ml-0.5 ${getChannelAverageBadgeClass(averages.wiseCallsAvg)}`;
        }
        if (bEmailAvg) {
          bEmailAvg.textContent = formatChannelAverageScore(
            averages.wiseEmailsAvg,
          );
          bEmailAvg.className = `badge badge-xs font-bold ml-0.5 ${getChannelAverageBadgeClass(averages.wiseEmailsAvg)}`;
        }
        if (bAgAvg) {
          bAgAvg.textContent = formatChannelAverageScore(
            averages.invgateAgAvg,
          );
          bAgAvg.className = `badge badge-xs font-bold ml-0.5 ${getChannelAverageBadgeClass(averages.invgateAgAvg)}`;
        }

        if (bTotalAvgVal && bTotalAvgBadge) {
          bTotalAvgVal.textContent = formatChannelAverageScore(
            averages.globalAverage,
          );
          bTotalAvgBadge.className = `badge text-xs font-bold gap-1 ${getChannelAverageBadgeClass(averages.globalAverage)}`;
        }

        if (bQuota) {
          bQuota.textContent = `${averages.totalAuditsCount}/12 Completadas`;
          bQuota.className = `badge text-xs font-bold ${averages.quotaFulfilled ? "badge-success text-success-content" : "badge-neutral"}`;
        }

        let filteredCalls: QualityCall[] = [];
        let channelEmptyMsg = "";

        if (currentActiveChannel === "wise_call") {
          filteredCalls = wiseCalls;
          channelEmptyMsg =
            "No hay llamadas Wise registradas para este operador en este mes.";
        } else if (currentActiveChannel === "wise_email") {
          filteredCalls = wiseEmails;
          channelEmptyMsg =
            "No hay correos Wise registrados para este operador en este mes.";
        } else {
          filteredCalls = invgateAgs;
          channelEmptyMsg =
            "No hay autogestiones registradas para este operador en este mes.";
        }

        if (callsContainer) {
          if (filteredCalls.length === 0) {
            callsContainer.innerHTML = `
              <div class="col-span-full py-8 text-center bg-base-200/40 rounded-2xl border border-base-300">
                <p class="text-sm text-base-content/50">${channelEmptyMsg}</p>
              </div>
            `;
          } else {
            callsContainer.innerHTML = filteredCalls
              .map((c, idx) => renderCallCard(c, idx))
              .join("");

            callsContainer
              .querySelectorAll(".call-card-toggle")
              .forEach((btn) => {
                btn.addEventListener("click", () => {
                  const card = btn.closest(".call-card");
                  if (!card) return;
                  const details = card.querySelector(".call-card-details");
                  const icon = btn.querySelector(".toggle-icon");
                  if (details) {
                    details.classList.toggle("hidden");
                    if (icon) {
                      icon.classList.toggle("rotate-180");
                    }
                  }
                });
              });

            callsContainer
              .querySelectorAll(".edit-audit-btn")
              .forEach((btn) => {
                btn.addEventListener("click", (e) => {
                  e.stopPropagation();
                  const callIdStr = (
                    btn.closest(".call-card") as HTMLElement
                  ).getAttribute("data-call-id");
                  if (callIdStr) {
                    const callId = parseInt(callIdStr, 10);
                    const call = (operator.calls || []).find(
                      (c: any) => c.id === callId,
                    );
                    if (call) {
                      openAuditModal(
                        operator.id,
                        call,
                        call.channelType || currentActiveChannel,
                      );
                    }
                  }
                });
              });
          }
        }
      };

      document.querySelectorAll(".operator-channel-tab").forEach((tabBtn) => {
        tabBtn.onclick = () => {
          document
            .querySelectorAll(".operator-channel-tab")
            .forEach((b) => b.classList.remove("tab-active"));
          tabBtn.classList.add("tab-active");
          currentActiveChannel =
            tabBtn.getAttribute("data-channel") || "wise_call";
          updateChannelTabsAndList();
        };
      });

      document.querySelectorAll(".operator-channel-tab").forEach((b) => {
        b.classList.toggle(
          "tab-active",
          b.getAttribute("data-channel") === "wise_call",
        );
      });
      currentActiveChannel = "wise_call";
      updateChannelTabsAndList();
    };

    // Attach click listeners to operator cards
    document.querySelectorAll(".operator-card").forEach((card) => {
      card.addEventListener("click", () => {
        const opId = card.getAttribute("data-operator-id");
        if (!opId) return;
        displayOperatorDetails(opId);
        if (detailsModal) {
          detailsModal.showModal();
        }
      });
    });

    // --- PARAMETERS CONFIGURATION MODAL ---
    const parametersModal = document.getElementById(
      "parameters-modal",
    ) as HTMLDialogElement;
    const btnConfigureParameters = document.getElementById(
      "btn-configure-parameters",
    );
    const btnCloseParametersModal = document.getElementById(
      "btn-close-parameters-modal",
    );
    const btnAddParamS1 = document.getElementById("btn-add-param-s1");
    const btnAddParamS2 = document.getElementById("btn-add-param-s2");

    let localParams: any[] = [];
    let activeParamChannel: string = "wise_call";

    const channelLabels: Record<string, { s1: string; s2: string; addS1: string; addS2: string }> = {
      wise_call: {
        s1: "Interacción con Usuario",
        s2: "Gestión del Ticket",
        addS1: "Agregar a Interacción",
        addS2: "Agregar a Gestión",
      },
      wise_email: {
        s1: "Gestión de Correo",
        s2: "Ticket MDA",
        addS1: "Agregar a Correo",
        addS2: "Agregar a Ticket MDA",
      },
      invgate_ticket: {
        s1: "Gestión del Caso",
        s2: "Ticket MDA",
        addS1: "Agregar a Caso",
        addS2: "Agregar a Ticket MDA",
      },
    };

    function updateParamTabLabels() {
      const labels = channelLabels[activeParamChannel] || channelLabels.wise_call;
      const tab1Btn = document.getElementById("param-tab-s1-btn");
      const tab2Btn = document.getElementById("param-tab-s2-btn");
      const add1Label = document.getElementById("btn-add-param-s1-label");
      const add2Label = document.getElementById("btn-add-param-s2-label");

      if (tab1Btn) tab1Btn.textContent = labels.s1;
      if (tab2Btn) tab2Btn.textContent = labels.s2;
      if (add1Label) add1Label.textContent = labels.addS1;
      if (add2Label) add2Label.textContent = labels.addS2;
    }

    // Channel buttons in parameters modal
    document.querySelectorAll(".param-channel-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const ch = btn.getAttribute("data-channel");
        if (!ch) return;
        activeParamChannel = ch;

        document.querySelectorAll(".param-channel-btn").forEach((b) => b.classList.remove("btn-active", "btn-primary"));
        btn.classList.add("btn-active", "btn-primary");

        updateParamTabLabels();
        renderParametersList();
      });
    });

    if (btnConfigureParameters) {
      btnConfigureParameters.addEventListener("click", () => {
        localParams = getAuditParameters().map((p: any) => ({
          ...p,
          channel: p.channel || "wise_call",
          section: p.section || (p.category === "Gestión del Ticket" ? "ticket" : "items"),
          isDeleted: false,
        }));

        activeParamChannel = "wise_call";
        const chBtns = document.querySelectorAll(".param-channel-btn");
        chBtns.forEach((b) => b.classList.remove("btn-active", "btn-primary"));
        chBtns[0]?.classList.add("btn-active", "btn-primary");

        // Reset tabs to S1
        const tabs = document.querySelectorAll(".parameter-tab");
        tabs.forEach((t) => t.classList.remove("tab-active"));
        tabs[0]?.classList.add("tab-active");

        document.getElementById("param-list-s1")?.classList.remove("hidden");
        document.getElementById("param-list-s2")?.classList.add("hidden");
        document.getElementById("btn-add-param-s1")?.classList.remove("hidden");
        document.getElementById("btn-add-param-s2")?.classList.add("hidden");

        updateParamTabLabels();
        renderParametersList();
        parametersModal.showModal();
      });
    }

    if (btnCloseParametersModal) {
      btnCloseParametersModal.addEventListener("click", () => {
        parametersModal.close();
      });
    }

    if (btnAddParamS1) {
      btnAddParamS1.addEventListener("click", () => {
        handleAddParam("items");
      });
    }

    if (btnAddParamS2) {
      btnAddParamS2.addEventListener("click", () => {
        handleAddParam(activeParamChannel === "wise_call" ? "ticket" : "mda");
      });
    }

    const handleAddParam = (section: "items" | "ticket" | "mda") => {
      const category =
        section === "items"
          ? (activeParamChannel === "wise_call" ? "Interacción con Usuario" : "Items")
          : (activeParamChannel === "wise_call" ? "Gestión del Ticket" : "MDA");

      localParams.push({
        id: null,
        name: "",
        weight: 1.0,
        category: category,
        channel: activeParamChannel,
        section: section,
        active: true,
        isDeleted: false,
      });
      renderParametersList();

      const paneId = section === "items" ? "param-list-s1" : "param-list-s2";
      const pane = document.getElementById(paneId);
      if (pane) {
        setTimeout(() => {
          pane.lastElementChild?.scrollIntoView({ behavior: "smooth" });
          (
            pane.lastElementChild?.querySelector(
              ".param-input-name",
            ) as HTMLElement
          )?.focus();
        }, 50);
      }
    };

    function renderParameterRow(
      param: any,
      actualIndex: number,
      displayIndex: number,
    ) {
      const isDeleted = param.isDeleted;
      const isNew = !param.id;

      return `
        <div class="flex items-center gap-3 bg-base-200/40 p-2 rounded-xl border border-base-300 transition-colors ${isDeleted ? "opacity-40 bg-error/5 border-error/20 line-through" : ""}" data-index="${actualIndex}">
          <div class="flex items-center justify-center size-8 rounded-lg bg-base-100 font-mono text-xs text-base-content/50 border border-base-200 shrink-0">
            ${isNew ? '<span class="text-success font-black">+</span>' : displayIndex}
          </div>
          <input 
            type="text" 
            value="${escapeHtml(param.name)}" 
            placeholder="Nombre del criterio..."
            class="input input-sm flex-1 font-semibold bg-base-100 focus:outline-none focus:border-primary param-input-name"
            ${isDeleted ? "disabled" : ""}
            data-index="${actualIndex}"
          />
          <div class="flex items-center gap-1 shrink-0">
            <span class="text-xs font-bold text-base-content/40 uppercase">Peso:</span>
            <input 
              type="number" 
              step="0.1" 
              min="0"
              value="${param.weight}" 
              class="input input-sm w-16 text-center font-bold bg-base-100 focus:outline-none focus:border-primary param-input-weight"
              ${isDeleted ? "disabled" : ""}
              data-index="${actualIndex}"
            />
          </div>
          <div class="shrink-0">
            ${
              isDeleted
                ? `
              <button type="button" class="btn btn-sm btn-circle btn-ghost text-success param-btn-restore animate-fade-in" data-index="${actualIndex}" title="Restaurar">
                <svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="fill: currentColor;"><path d="M12.5 8c-2.65 0-5.05 1-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/></svg>
              </button>
            `
                : `
              <button type="button" class="btn btn-sm btn-circle btn-ghost text-error hover:bg-error/10 param-btn-delete animate-fade-in" data-index="${actualIndex}" title="Eliminar">
                <svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="fill: currentColor;"><path d="m20.37 5.91-1 .92a2 2 0 0 1-1.39.57H6A2 2 0 0 1 4.6 6.84l-1-.93L2.24 7.27l1 .93a4 4 0 0 0 2.76 1.14h12A4 4 0 0 0 20.76 8.2l1-.93zm-3.5 4v9a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-9h-2v9a4 4 0 0 0 4 4h6a4 4 0 0 0 4-4v-9zM8.5 3h7V1h-7z"/></svg>
              </button>
            `
            }
          </div>
        </div>
      `;
    }

    function renderParametersList() {
      const s1Container = document.getElementById("param-list-s1");
      const s2Container = document.getElementById("param-list-s2");
      if (!s1Container || !s2Container) return;

      const isMatchingChannel = (p: any) => {
        const ch = p.channel || "wise_call";
        return ch === activeParamChannel;
      };

      const isS1 = (p: any) => {
        return p.section === "items" || p.category === "Items" || p.category === "Interacción con Usuario";
      };

      const isS2 = (p: any) => {
        return p.section === "ticket" || p.section === "mda" || p.category === "Gestión del Ticket" || p.category === "Ticket" || p.category === "MDA";
      };

      let s1Count = 0;
      const s1Html = localParams
        .map((p, i) => ({ p, i }))
        .filter(
          (item) =>
            isMatchingChannel(item.p) &&
            isS1(item.p) &&
            (item.p.active || !item.p.id || item.p.isDeleted),
        )
        .map((item) => {
          s1Count++;
          return renderParameterRow(item.p, item.i, s1Count);
        })
        .join("");

      let s2Count = 0;
      const s2Html = localParams
        .map((p, i) => ({ p, i }))
        .filter(
          (item) =>
            isMatchingChannel(item.p) &&
            isS2(item.p) &&
            (item.p.active || !item.p.id || item.p.isDeleted),
        )
        .map((item) => {
          s2Count++;
          return renderParameterRow(item.p, item.i, s2Count);
        })
        .join("");

      s1Container.innerHTML =
        s1Html ||
        '<p class="text-xs text-base-content/40 italic text-center py-4">No hay parámetros activos en esta categoría para este canal.</p>';
      s2Container.innerHTML =
        s2Html ||
        '<p class="text-xs text-base-content/40 italic text-center py-4">No hay parámetros activos en esta categoría para este canal.</p>';

      // Attach input change listeners
      s1Container
        .querySelectorAll(".param-input-name, .param-input-weight")
        .forEach(attachInputListeners);
      s2Container
        .querySelectorAll(".param-input-name, .param-input-weight")
        .forEach(attachInputListeners);

      // Attach delete/restore button listeners
      s1Container
        .querySelectorAll(".param-btn-delete")
        .forEach((btn) => btn.addEventListener("click", handleDeleteParam));
      s1Container
        .querySelectorAll(".param-btn-restore")
        .forEach((btn) => btn.addEventListener("click", handleRestoreParam));
      s2Container
        .querySelectorAll(".param-btn-delete")
        .forEach((btn) => btn.addEventListener("click", handleDeleteParam));
      s2Container
        .querySelectorAll(".param-btn-restore")
        .forEach((btn) => btn.addEventListener("click", handleRestoreParam));
    }

    function attachInputListeners(input: Element) {
      input.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.getAttribute("data-index") || "0", 10);
        if (target.classList.contains("param-input-name")) {
          localParams[idx].name = target.value;
        } else if (target.classList.contains("param-input-weight")) {
          localParams[idx].weight = parseFloat(target.value) || 0;
        }
      });
    }

    function handleDeleteParam(e: Event) {
      const target = e.currentTarget as HTMLElement;
      const idx = parseInt(target.getAttribute("data-index") || "0", 10);
      localParams[idx].isDeleted = true;
      renderParametersList();
    }

    function handleRestoreParam(e: Event) {
      const target = e.currentTarget as HTMLElement;
      const idx = parseInt(target.getAttribute("data-index") || "0", 10);
      localParams[idx].isDeleted = false;
      renderParametersList();
    }

    // Tab switching in parameters modal
    const paramTabs = document.querySelectorAll(".parameter-tab");
    paramTabs.forEach((tab) => {
      tab.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const tabName = target.getAttribute("data-tab");

        paramTabs.forEach((t) => t.classList.remove("tab-active"));
        target.classList.add("tab-active");

        const paneS1 = document.getElementById("param-list-s1");
        const paneS2 = document.getElementById("param-list-s2");
        const btnAddS1 = document.getElementById("btn-add-param-s1");
        const btnAddS2 = document.getElementById("btn-add-param-s2");

        if (tabName === "s1") {
          paneS1?.classList.remove("hidden");
          paneS2?.classList.add("hidden");
          btnAddS1?.classList.remove("hidden");
          btnAddS2?.classList.add("hidden");
        } else {
          paneS1?.classList.add("hidden");
          paneS2?.classList.remove("hidden");
          btnAddS1?.classList.add("hidden");
          btnAddS2?.classList.remove("hidden");
        }
      });
    });

    const btnSaveParams = document.getElementById("btn-save-parameters");
    btnSaveParams?.addEventListener("click", async () => {
      const emptyParams = localParams.filter(
        (p) => !p.isDeleted && !p.name.trim(),
      );
      if (emptyParams.length > 0) {
        alert("Por favor, complete el nombre de todos los parámetros.");
        return;
      }

      const originalText = btnSaveParams.innerHTML;
      btnSaveParams.setAttribute("disabled", "true");
      btnSaveParams.innerHTML =
        '<span class="loading loading-spinner loading-xs"></span> Guardando…';

      try {
        const payload = {
          parameters: localParams.map((p) => ({
            id: p.id,
            name: p.name.trim(),
            weight: p.weight,
            category: p.category || (p.section === "items" ? "Items" : "MDA"),
            channel: p.channel || "wise_call",
            section: p.section || (p.category === "Interacción con Usuario" || p.category === "Items" ? "items" : "ticket"),
            isDeleted: p.isDeleted,
          })),
        };

        const result = await actions.saveParameters(payload);
        if (result.error) {
          console.error(result.error);
          alert("Error al guardar los parámetros: " + result.error.message);
        } else if (result.data?.success) {
          window.location.reload();
        } else {
          alert("Error al guardar los parámetros.");
        }
      } catch (err) {
        console.error(err);
        alert("Ocurrió un error inesperado al guardar los parámetros.");
      } finally {
        btnSaveParams.removeAttribute("disabled");
        btnSaveParams.innerHTML = originalText;
      }
    });

    // --- EXPORT TO CSV ---
    const btnExportCSV = document.getElementById("btn-export-csv");
    if (btnExportCSV) {
      btnExportCSV.addEventListener("click", () => {
        const el = document.getElementById("operators-data");
        if (!el) return;
        let operatorsData: Record<string, any> = {};
        try {
          operatorsData = JSON.parse(el.getAttribute("data-operators") || "{}");
        } catch (e) {
          console.error("Error parsing operators data", e);
          return;
        }

        const selectedOp = operatorsData[activeAgentId || ""];
        if (!selectedOp) {
          alert("Por favor, seleccione un operador.");
          return;
        }

        const monthSelector = document.getElementById(
          "month-selector",
        ) as HTMLSelectElement;
        const monthStr = monthSelector ? monthSelector.value : "calidad";

        // Obtener todos los parámetros configurados en el sistema
        const params = getAuditParameters();

        const channelLabelMap: Record<string, string> = {
          wise_call: "Llamada Wise",
          wise_email: "Mail Wise",
          invgate_ticket: "Autogestión",
        };

        // Headers for CSV
        const headers = [
          "Periodo",
          "Canal",
          "Operador",
          "Usuario",
          "Fecha",
          "ID Llamada / Caso",
          "ID Ticket / AG",
          "Duracion",
          "Tiempo Ringueo",
          "Creacion",
          "Toma / Lectura",
          "Es PAS",
          "Puntaje Secc. 1",
          "Puntaje Secc. 2",
          "Puntaje Total",
        ];

        // Añadir una columna por cada parámetro dinámico
        params.forEach((param: any) => {
          headers.push(`[${param.code}] ${param.name}`);
        });

        // La columna de observaciones va al final
        headers.push("Observaciones");

        const csvRows = [headers.join(";")];

        selectedOp.calls.forEach((call: any) => {
          const row = [
            call.month,
            channelLabelMap[call.channelType || "wise_call"] || (call.channelType || "wise_call"),
            selectedOp.name,
            selectedOp.username || "",
            call.date ? call.date.substring(0, 10) : "",
            call.callId,
            call.ticketId,
            call.duration || "",
            call.ringTime || "",
            call.creationTime || "",
            call.takeTime || "",
            call.isPas ? "Si" : "No",
            call.section1.score,
            call.section2.score,
            call.totalScore,
          ];

          // Determinar cumplimiento para cada parámetro dinámico
          params.forEach((param: any) => {
            let compliance = "N/A";

            // Buscar en detalles de Sección 1 (Interacción)
            if (
              call.section1 &&
              call.section1.details &&
              call.section1.details.hasOwnProperty(param.code)
            ) {
              compliance = call.section1.details[param.code]
                ? "Cumple"
                : "No cumple";
            }
            // Buscar en detalles de Sección 2 (Gestión)
            else if (
              call.section2 &&
              call.section2.details &&
              call.section2.details.hasOwnProperty(param.code)
            ) {
              compliance = call.section2.details[param.code]
                ? "Cumple"
                : "No cumple";
            }

            row.push(compliance);
          });

          // Agregar la observación al final de la fila
          row.push(call.notes || "");

          const escapedRow = row.map((val) => {
            const valStr = typeof val === "string" ? val : String(val);
            if (
              valStr.includes(";") ||
              valStr.includes("\n") ||
              valStr.includes("\r") ||
              valStr.includes('"')
            ) {
              return `"${valStr.replace(/"/g, '""')}"`;
            }
            return valStr;
          });
          csvRows.push(escapedRow.join(";"));
        });

        // Add UTF-8 BOM so Excel displays accents correctly
        const csvContent = "\uFEFF" + csvRows.join("\n");
        const blob = new Blob([csvContent], {
          type: "text/csv;charset=utf-8;",
        });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.setAttribute("href", url);
        const fileName = `auditorias_${selectedOp.username || activeAgentId}_${monthStr}.csv`;
        link.setAttribute("download", fileName);
        link.style.visibility = "hidden";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    }

    // Auto-select operator on page load if agentId is in URL or if user is an agent
    const urlParams = new URLSearchParams(window.location.search);
    const urlAgentId = urlParams.get("agentId");
    const rbacContainer = document.querySelector("[data-is-agent]");
    const isUserAgent =
      rbacContainer && rbacContainer.getAttribute("data-is-agent") === "true";

    if (isUserAgent) {
      const operatorsDataEl = document.getElementById("operators-data");
      try {
        const map = JSON.parse(
          operatorsDataEl?.getAttribute("data-operators") || "{}",
        );
        const firstId = Object.keys(map)[0];
        if (firstId) {
          displayOperatorDetails(firstId);
        }
      } catch (e) {}
    } else if (urlAgentId) {
      displayOperatorDetails(urlAgentId);
      if (detailsModal) {
        detailsModal.showModal();
      }
    }
    return true;
  }

  function setupQualityObserver() {
    if (initQualityMasterDetail()) return;

    const observer = new MutationObserver((_, obs) => {
      if (initQualityMasterDetail()) {
        obs.disconnect();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  setupQualityObserver();
  document.addEventListener("astro:page-load", setupQualityObserver);
</script>
