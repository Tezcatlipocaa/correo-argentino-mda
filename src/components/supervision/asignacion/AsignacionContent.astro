---
import { getCleanBase } from "@lib/baseUrl";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";
import Modal from "@components/ui/Modal.astro";
import FormField from "@components/ui/forms/FormField.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import { Icon } from "astro-icon/components";
import { db } from "@db/index";
import { agents } from "@db/schema";
import { eq } from "drizzle-orm";
import {
  getDisponibilidadHoy,
  asignarSiguienteAutogestion,
  asignarManual,
  getLockStatus,
} from "@lib/disponibilidad";
import { getUnassignedTicketsByHelpdesk } from "@/lib/invgate/agsTickets";

import { normalizeRole } from "@lib/rbac";

const cleanBase = getCleanBase();

const invgateApiBase = import.meta.env.INVGATE_QA_BASE_URL || import.meta.env.INVGATE_BASE_URL || "";
const invgateWebBase = invgateApiBase
  ? invgateApiBase.replace(/\/api\/v1\/?$/, "").replace(/\/$/, "")
  : "";

const user = Astro.locals.user;
const role = normalizeRole(user.role);

const initialTab = Astro.url.searchParams.get("tab") === "monitoreo" ? "monitoreo" : "asignacion";

const lockStatus = await getLockStatus();
let hasLock = false;
let lockHolderName: string | null = null;
let lockReleaseRequested = false;

if (lockStatus.status === "occupied") {
  hasLock = lockStatus.user.userId === user?.id;
  lockHolderName = lockStatus.user.username;
  lockReleaseRequested = lockStatus.user.releaseRequested;
}

const isReadOnly = role === "agent" || !hasLock;

if (Astro.request.method === "POST" && !isReadOnly) {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action") as string;
    let msg = "";
    let msgType = "success";

    const userClean = user?.username ? user.username.split("@")[0].toLowerCase().trim() : "";
    const allOpsForAuthor = await getDisponibilidadHoy();
    const loggedInOp = allOpsForAuthor.find((op) => op.username && op.username.split("@")[0].toLowerCase().trim() === userClean);
    const authorInvgateId = loggedInOp?.invgateId;

    if (action === "assign_manual") {
      const agentId = Number(formData.get("agentId"));
      if (!isNaN(agentId)) {
        const res = await asignarManual(agentId, user?.username || "Sistema", authorInvgateId);
        if (res.success) {
          const [ag] = await db
            .select({ name: agents.name })
            .from(agents)
            .where(eq(agents.id, agentId));

          msg = res.ticketNumber
            ? `Autogestión ${res.ticketNumber} asignada manualmente a ${ag?.name ?? `ID ${agentId}`} en InvGate QA.`
            : `Autogestión asignada manualmente a ${ag?.name ?? `ID ${agentId}`}.`;
        } else {
          msg = res.error || "Error al asignar autogestión.";
          msgType = "error";
        }
      }
    } else if (action === "assign_cyclic") {
      const res = await asignarSiguienteAutogestion(user?.username || "Sistema", authorInvgateId);
      if (res.success && res.agent) {
        msg = res.ticketNumber
          ? `Autogestión ${res.ticketNumber} asignada a ${res.agent.nombre} en InvGate QA.`
          : `Autogestión asignada cíclicamente a ${res.agent.nombre}.`;
      } else {
        msg = res.error || "No hay operadores disponibles o dentro de horario operativo para asignar.";
        msgType = "error";
      }
    }

    if (msg) {
      const url = new URL(Astro.request.url);
      url.searchParams.set("toast_msg", msg);
      url.searchParams.set("toast_type", msgType);
      return Astro.redirect(url.pathname + url.search);
    }
  } catch (e: any) {
    const url = new URL(Astro.request.url);
    url.searchParams.set("toast_msg", `Ocurrió un error al procesar la acción: ${e.message}`);
    url.searchParams.set("toast_type", "error");
    return Astro.redirect(url.pathname + url.search);
  }
}

// Fetch availability calculations
const allOperators = await getDisponibilidadHoy();
allOperators.sort((a, b) => a.nombre.localeCompare(b.nombre));

const disponiblesCount = allOperators.filter((op) => op.disponible).length;
const noDisponiblesList = allOperators.filter((op) => !op.disponible);
const noDisponiblesCount = noDisponiblesList.length;

// Find the operator who was most recently assigned
const maxAssignedTime = Math.max(
  ...allOperators.map((o) => o.lastAutogestionAssignedAt ?? 0),
);
const lastAssignedOperator =
  maxAssignedTime > 0
    ? allOperators.find((o) => o.lastAutogestionAssignedAt === maxAssignedTime)
    : null;
const maxAssignedOperatorId = lastAssignedOperator?.agentId ?? null;

// Find the next suggested operators (up to 10) for the queue
const availableOperators = allOperators.filter((o) => o.disponible);
const nextSuggestedOperators = availableOperators.length > 0
  ? [...availableOperators].sort((a, b) => {
      const tA = a.lastAutogestionAssignedAt ?? 0;
      const tB = b.lastAutogestionAssignedAt ?? 0;
      if (a.lastAutogestionAssignedAt === null && b.lastAutogestionAssignedAt !== null) return -1;
      if (a.lastAutogestionAssignedAt !== null && b.lastAutogestionAssignedAt === null) return 1;
      return tA - tB;
    }).slice(0, 10)
  : [];

// Fetch unassigned InvGate tickets for Helpdesk 3866
const unassignedRes = await getUnassignedTicketsByHelpdesk(3866);
const unassignedTickets = unassignedRes.tickets;
const unassignedCount = unassignedTickets.length;

const STATUS_LABELS: Record<string, string> = {
  "En break": "En Break",
  "Fuera de horario": "Fuera de Horario",
  Franco: "Franco",
  Licencia: "Licencia",
  Vacaciones: "Vacaciones",
  Excepción: "Excepción",
};

const PRIORITY_LABELS: Record<number, { label: string; badgeClass: string }> = {
  1: { label: "Baja", badgeClass: "bg-base-200 text-base-content/60 border-none font-medium" },
  2: { label: "Media", badgeClass: "bg-info/15 text-info border-none font-medium" },
  3: { label: "Alta", badgeClass: "bg-warning/15 text-warning border-none font-semibold" },
  4: { label: "Urgente", badgeClass: "bg-warning/20 text-warning border-none font-bold" },
  5: { label: "Crítica", badgeClass: "bg-error/15 text-error border-none font-bold" },
};

const breakdown: Record<string, number> = {
  "En break": 0,
  "Fuera de horario": 0,
  Franco: 0,
  Licencia: 0,
  Vacaciones: 0,
  Excepción: 0,
};

noDisponiblesList.forEach((op) => {
  const mot = op.motivo || "Franco";
  if (
    ["Devolución Supervisor", "Break Extendido", "Problema Técnico"].includes(
      mot,
    )
  ) {
    breakdown["Excepción"]++;
  } else if (breakdown[mot] !== undefined) {
    breakdown[mot]++;
  } else {
    breakdown["Franco"]++;
  }
});

const getBadgeColor = (status: string, disponible: boolean): string => {
  if (disponible) return "badge-success text-success-content shadow-sm shadow-success/20";
  switch (status) {
    case "En break":
      return "badge-warning text-warning-content shadow-sm shadow-warning/20";
    case "Fuera de horario":
    case "Franco":
      return "badge-neutral text-neutral-content/75 opacity-70";
    case "Licencia":
      return "badge-error text-error-content shadow-sm shadow-error/20";
    case "Vacaciones":
      return "badge-info text-info-content shadow-sm shadow-info/20";
    case "Devolución Supervisor":
    case "Break Extendido":
    case "Problema Técnico":
      return "badge-secondary text-secondary-content shadow-sm shadow-secondary/20";
    default:
      return "badge-neutral";
  }
};

const breakdownBadge = (status: string): string => {
  switch (status) {
    case "En break":
      return "bg-warning";
    case "Fuera de horario":
    case "Franco":
      return "bg-neutral opacity-50";
    case "Licencia":
      return "bg-error";
    case "Vacaciones":
      return "bg-info";
    case "Excepción":
      return "bg-secondary";
    default:
      return "bg-neutral";
  }
};

const getExcepcionalShortLabel = (tipo: string): string => {
  switch (tipo) {
    case "devolucion_supervisor":
      return "⚠ Dev. Supervisor";
    case "break_extendido":
      return "⚠ Break extendido";
    case "problema_tecnico":
      return "⚠ Prob. técnico";
    default:
      return "⚠ Excepción";
  }
};

function getInitials(name: string): string {
  if (!name) return "OP";
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}
---

<PageContainer>
  <Modal id="modal-marcar-excepcion">
    <Fragment slot="content">
      <h3
        class="font-bold text-sm uppercase tracking-wider mb-4 text-base-content flex items-center gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-5 text-secondary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Marcar Excepción: <span
          id="modal-operador-nombre"
          class="text-secondary font-black"></span>
      </h3>

      <input type="hidden" id="modal-agent-id" />

      <div class="flex flex-col gap-4">
        <SelectField id="modal-select-tipo" name="modal-select-tipo" label="Tipo de Excepción" size="sm">
          <option value="devolucion_supervisor">Devolución Supervisor</option>
          <option value="break_extendido">Break Extendido</option>
          <option value="problema_tecnico">Problema Técnico</option>
        </SelectField>

        <div id="container-tiempo-extra" class="form-control hidden">
          <SelectField id="modal-select-tiempo-extra" name="modal-select-tiempo-extra" label="Tiempo Extra" size="sm">
            <option value="5">5 minutos</option>
            <option value="10">10 minutos</option>
            <option value="15">15 minutos</option>
            <option value="20" selected>20 minutos</option>
            <option value="25">25 minutos</option>
            <option value="30">30 minutos</option>
            <option value="35">35 minutos</option>
            <option value="40">40 minutos</option>
            <option value="45">45 minutos</option>
            <option value="manual">Manual (Sin auto-limpieza)</option>
          </SelectField>
        </div>

        <FormField id="modal-input-motivo" name="modal-input-motivo" label="Comentario (opcional)" placeholder="Ej. Reunión urgente, corte de internet, etc." size="sm" />
      </div>
    </Fragment>
    <Fragment slot="actions">
      <button
        type="button"
        class="btn btn-ghost btn-sm hover:bg-base-200"
        id="btn-close-modal-excepcion"
      >
        Cancelar
      </button>
      <button
        type="button"
        class="btn btn-secondary btn-sm font-bold uppercase tracking-wider"
        id="btn-confirmar-modal-excepcion"
      >
        Confirmar
      </button>
    </Fragment>
  </Modal>

  <div class="mb-6 border-b border-base-200 pb-5">
    <PageHeader
      description="Distribución equitativa y controlada de autogestiones entre operadores técnicos."
      descriptionClass="max-w-prose"
    />
  </div>

  <!-- Global Header Bar: Tabs Navigation + System Controls -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <!-- Tabs Header -->
    <div class="role-tabs tabs tabs-box bg-base-200/60 p-1.5 rounded-2xl inline-flex gap-1 border border-base-300">
      <button
        type="button"
        id="tab-btn-asignacion"
        data-tab-target="panel-asignacion"
        class={`tab font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-xl transition-all flex items-center gap-2 ${initialTab === 'asignacion' ? 'tab-active bg-primary text-primary-content shadow-sm' : 'text-base-content/70 hover:text-base-content'}`}
      >
        <Icon name="boxicons:user-check" size={18} />
        Asignación Operativa
      </button>
      <button
        type="button"
        id="tab-btn-monitoreo"
        data-tab-target="panel-monitoreo"
        class={`tab font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-xl transition-all flex items-center gap-2 ${initialTab === 'monitoreo' ? 'tab-active bg-primary text-primary-content shadow-sm' : 'text-base-content/70 hover:text-base-content'}`}
      >
        <Icon name="boxicons:group" size={18} />
        Monitoreo de Operadores
      </button>
    </div>

    <!-- Right Controls: Lock Status & Sync -->
    <div class="flex items-center gap-4">
      {role !== "agent" && (
        <>
          <div id="lock-indicator"
               data-user-id={user?.id}
               data-user-username={user?.username}
               data-lock-timeout={10 * 60 * 1000}
               class="grid grid-cols-[auto_minmax(0,1fr)_auto_auto] items-center gap-2 text-xs font-semibold text-base-content/70">
          </div>
          <div class="w-px h-5 bg-base-300/60"></div>
        </>
      )}

      <div class="flex items-center gap-1">
        <span id="sync-indicator" class="text-xs text-base-content/50 font-semibold hidden sm:inline-block w-[180px]">
          Actualizado hace unos instantes
        </span>
        <button id="btn-refresh" class="btn btn-xs btn-circle btn-ghost text-base-content/60 hover:text-base-content" title="Actualizar ahora">
          <Icon name="boxicons:refresh-ccw-filled" size={18} id="refresh-icon" />
        </button>
      </div>
    </div>
  </div>

  <!-- Pestaña 1: Asignación Operativa -->
  <div id="panel-asignacion" class={initialTab === "asignacion" ? "flex flex-col gap-6" : "flex flex-col gap-6 hidden"}>
    <!-- Workspace Panel Dividido / IDE Style (0 Cajas Flotantes) -->
    <div class="bg-base-100 border border-base-300 rounded-2xl overflow-hidden shadow-xs flex flex-col">
      <!-- Header Superior de Acción (Espacio Reservado Fijo - 0 Saltos de Layout) -->
      <div id="action-bar-header" class="border-b border-base-300 bg-base-200/40 p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4 transition-all duration-300">
        <div class="flex items-center gap-3.5">
          <div class={`p-2.5 rounded-xl shrink-0 transition-colors ${!isReadOnly ? "bg-primary/10 text-primary" : "bg-base-200 text-base-content/40"}`}>
            <Icon name={!isReadOnly ? "boxicons:user-check" : "boxicons:lock"} size={24} />
          </div>
          <div>
            <h2 class="font-black text-sm uppercase tracking-wider text-base-content flex items-center gap-2">
              Asignación Automática
              {isReadOnly && (
                <span class="badge badge-neutral badge-xs font-semibold uppercase text-tiny tracking-wider">Modo Lectura</span>
              )}
            </h2>
            <p class="text-xs text-base-content/60 font-medium mt-0.5">
              {!isReadOnly ? (
                nextSuggestedOperators.length > 0 ? (
                  <>Asignará el siguiente ticket a <strong class="text-base-content font-black">{nextSuggestedOperators[0].nombre}</strong></>
                ) : (
                  <>No hay operadores disponibles actualmente</>
                )
              ) : (
                <>Tomá el control desde el indicador de estado para habilitar la asignación automática.</>
              )}
            </p>
          </div>
        </div>

        <button
          id="btn-assign-cyclic"
          type="button"
          disabled={isReadOnly || unassignedCount === 0}
          title={unassignedCount === 0 ? "No hay autogestiones sin asignar para entregar" : (isReadOnly ? "Tomá el control para habilitar la asignación" : "Asignar siguiente autogestión")}
          class={`btn btn-md flex items-center justify-center gap-2 font-bold uppercase tracking-wider shrink-0 w-full sm:w-auto px-6 transition-all ${
            !isReadOnly && unassignedCount > 0
              ? "btn-primary shadow-lg shadow-primary/20"
              : "btn-neutral btn-disabled opacity-50 cursor-not-allowed"
          }`}
        >
          <Icon name="boxicons:user-check" size={20} aria-hidden="true" />
          Asignar Siguiente
        </button>
      </div>

      <!-- Grid de Paneles Divididos (60% Tickets / 40% Cola) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[540px]">
        <!-- Panel Izquierdo (60%): Tickets en Espera -->
        <div class="lg:col-span-7 flex flex-col border-b lg:border-b-0 lg:border-r border-base-300 bg-base-100">
          <div class="p-4 border-b border-base-300 bg-base-200/30 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <Icon name="boxicons:inbox" size={20} class="text-warning" />
              <h3 class="font-bold text-xs uppercase tracking-widest text-base-content/70">
                Sin Asignar (Mesa 3866)
              </h3>
            </div>
            <span class={`badge ${unassignedCount > 0 ? "badge-warning text-warning-content" : "badge-neutral"} font-mono font-bold text-xs`} id="stat-unassigned-count">
              {unassignedCount}
            </span>
          </div>

          <div id="unassigned-tickets-list" class="divide-y divide-base-200/80 max-h-[calc(100vh-320px)] overflow-y-auto">
            {unassignedTickets.length > 0 ? (
              unassignedTickets.map((t: any) => {
                const timeStr = t.created_at ? new Date(t.created_at * 1000).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" }) : "";
                
                let elapsedMin = 0;
                if (t.created_at) {
                  elapsedMin = Math.floor((Date.now() - t.created_at * 1000) / 60000);
                }
                const formatWait = elapsedMin >= 60 
                  ? `${Math.floor(elapsedMin / 60)}h ${elapsedMin % 60}m` 
                  : `${elapsedMin}m`;

                const creatorUsername = (t.creator_username || "").toLowerCase().trim();
                const creatorNameNorm = (t.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

                const matchingAvailableOp = availableOperators.find((op) => {
                  if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
                  if (op.nombre && creatorNameNorm) {
                    const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
                    if (opNameNorm === creatorNameNorm) return true;
                    const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
                    if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
                  }
                  return false;
                });

                const creatorStr = t.creator_name || t.customer_name || "";
                const customerStr = t.customer_name && t.creator_name && t.customer_name !== t.creator_name ? t.customer_name : "";

                return (
                  <div data-ticket-id={t.id} class="p-3.5 hover:bg-base-200/60 transition-colors duration-150 flex flex-col gap-1.5 cursor-pointer group">
                    <div class="flex items-center justify-between gap-2">
                      <div class="flex items-center gap-1.5 min-w-0 flex-wrap">
                        <span class="font-mono font-bold text-primary-content bg-primary px-2 py-0.5 rounded-md text-xs shrink-0">{t.pretty_id || `#${t.id}`}</span>
                        {t.priority_id && (
                          <span class={`badge badge-xs font-bold text-tiny tracking-wider uppercase shrink-0 ${PRIORITY_LABELS[t.priority_id]?.badgeClass || 'badge-neutral'}`}>
                            {PRIORITY_LABELS[t.priority_id]?.label || `P${t.priority_id}`}
                          </span>
                        )}
                        {t.category_last_name && (
                          <span class="badge badge-neutral badge-xs font-semibold text-tiny tracking-tight max-w-[130px] truncate shrink-0" title={t.category_name || t.category_last_name}>
                            {t.category_last_name}
                          </span>
                        )}
                        {t.sla_incident_first_reply && (
                          <span class="badge badge-outline badge-info badge-xs font-mono text-tiny shrink-0" title="SLA de respuesta">
                            SLA: {t.sla_incident_first_reply}
                          </span>
                        )}
                        {t.created_at && (
                          <span class={`badge badge-xs font-mono text-tiny px-1.5 py-0.5 shrink-0 ${
                            elapsedMin >= 60
                              ? "bg-error/15 text-error border-none font-bold"
                              : elapsedMin >= 30
                              ? "bg-warning/15 text-warning border-none font-semibold"
                              : "bg-base-200 text-base-content/70 border-none"
                          }`} title="Tiempo de espera en cola">
                            ⏱ {formatWait}
                          </span>
                        )}
                      </div>
                      <span class="text-xs text-base-content/60 font-mono font-semibold shrink-0">
                        {timeStr}
                      </span>
                    </div>
                    <div class="font-semibold text-base-content text-xs group-hover:text-primary transition-colors" title={t.title}>
                      {t.title}
                    </div>
                    {creatorStr && (
                      <div class="flex items-center justify-between gap-1 text-tiny font-medium truncate mt-1">
                        <div class="flex items-center gap-1 min-w-0 truncate text-base-content/70">
                          <Icon name="boxicons:user" size={13} class={matchingAvailableOp ? "text-success shrink-0" : "opacity-60 shrink-0"} />
                          <span class="truncate">
                            Generado por: <strong class={matchingAvailableOp ? "text-success font-bold" : "text-base-content/80 font-bold"}>{creatorStr}</strong>
                            {matchingAvailableOp && <span class="text-success text-xxs font-semibold"> (Disponible)</span>}
                            {customerStr && <span class="opacity-75"> • Cliente: <strong class="text-base-content/80 font-semibold">{customerStr}</strong></span>}
                          </span>
                        </div>
                        {matchingAvailableOp && (
                          <button
                            type="button"
                            class={`btn btn-ghost btn-xs px-1.5 py-0 h-5 min-h-0 font-bold shrink-0 gap-1 ${
                              isReadOnly
                                ? "btn-disabled opacity-40 cursor-not-allowed text-base-content/40"
                                : "text-success hover:bg-success/15"
                            }`}
                            data-op-assign-btn={matchingAvailableOp.agentId}
                            title={isReadOnly ? "Toma el control para asignar autogestiones" : `Asignar a ${matchingAvailableOp.nombre}`}
                            disabled={isReadOnly}
                          >
                            <Icon name="boxicons:bolt-filled" size={12} class={isReadOnly ? "text-base-content/40 fill-current" : "text-success fill-current"} />
                            <span>Asignar</span>
                          </button>
                        )}
                      </div>
                    )}
                    {t.location_name && (
                      <div class="flex items-center gap-1 text-tiny text-base-content/60 font-medium truncate">
                        <Icon name="boxicons:map-pin" size={13} class="text-info opacity-70 shrink-0" />
                        <span class="truncate">Ubicación: <strong class="text-base-content/80 font-semibold">{t.location_name}</strong></span>
                      </div>
                    )}
                  </div>
                );
              })
            ) : (
              <div class="text-xs text-base-content/40 italic py-12 text-center">No hay tickets sin asignar</div>
            )}
          </div>
        </div>

        <!-- Panel Derecho (40%): Gestión y Cola -->
        <div class="lg:col-span-5 flex flex-col divide-y divide-base-300 bg-base-100">
          <!-- Sección: Próximos en Cola -->
          <div class="flex-1 flex flex-col">
            <div class="p-4 bg-base-200/30 border-b border-base-300 flex items-center gap-2">
              <Icon name="boxicons:sparkles" size={20} class="text-primary" />
              <h3 class="font-bold text-xs uppercase tracking-widest text-base-content/70">
                Próximos en Cola
              </h3>
            </div>

            <div id="queue-container" class="divide-y divide-base-200/80 max-h-[calc(100vh-420px)] overflow-y-auto">
              {nextSuggestedOperators.length > 0 ? (
                nextSuggestedOperators.map((op, idx) => (
                  <div
                    data-agent-id={op.agentId}
                    class={`flex items-center justify-between gap-3 p-3.5 transition-colors hover:bg-base-200/60 cursor-default ${
                      idx === 0
                        ? "bg-primary/5"
                        : ""
                    }`}
                  >
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                      <div class={`avatar placeholder size-9 rounded-full shrink-0 flex items-center justify-center font-bold text-xs ${
                        idx === 0 ? "bg-primary text-primary-content" : "bg-base-300 text-base-content/70"
                      }`}>
                        {getInitials(op.nombre)}
                      </div>
                      <div class="min-w-0 flex-1 flex flex-col gap-0.5">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class={`truncate font-bold text-xs ${idx === 0 ? "text-base-content font-black" : "text-base-content/80"}`}>
                            {op.nombre}
                          </span>
                          {idx === 0 && (
                            <span class="badge badge-primary text-primary-content badge-xs font-bold uppercase text-tiny shrink-0">Siguiente</span>
                          )}
                          <span class="badge badge-success/15 text-success border border-success/30 badge-xs font-bold text-tiny shrink-0">
                            {op.disponible ? "Disponible" : (op.motivo || "No disponible")}
                          </span>
                        </div>
                        <div class="flex items-center gap-2 text-tiny text-base-content/50 font-medium flex-wrap">
                          <span class="uppercase font-semibold text-xxs opacity-75">{op.modalidadHoy === "Home Office" ? "Home Office" : "Presencial"}</span>
                          {op.breakInicioHoy && op.breakFinHoy && (
                            <span class="flex items-center gap-1 font-mono text-base-content/70">
                              <Icon name="boxicons:cup-hot" size={12} class="opacity-60 shrink-0 text-warning" />
                              <span>Break: {op.breakInicioHoy} - {op.breakFinHoy}</span>
                            </span>
                          )}
                        </div>
                      </div>
                    </div>

                    {unassignedTickets[idx] && (
                      <div
                        class="badge badge-warning/15 border border-warning/30 text-warning-content font-mono font-bold text-tiny px-2 py-1 flex items-center gap-1 shrink-0 cursor-help"
                        title={`Si se asigna en orden, recibirá: ${unassignedTickets[idx].title}`}
                      >
                        <span class="text-warning font-sans font-bold">↳</span>
                        <span>{unassignedTickets[idx].pretty_id || `#${unassignedTickets[idx].id}`}</span>
                      </div>
                    )}
                  </div>
                ))
              ) : (
                <div class="text-xs text-base-content/40 italic py-8 text-center" id="stat-suggested-name-empty">
                  No hay operadores disponibles
                </div>
              )}
            </div>
          </div>

          <!-- Sección: Última Asignación -->
          <div class="p-4 bg-base-200/20">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <Icon name="boxicons:history" size={18} class="text-info" />
                <h3 class="font-bold text-xs uppercase tracking-widest text-base-content/60">
                  Última Asignación
                </h3>
              </div>
              <button
                type="button"
                id="btn-open-historial-modal"
                class="btn btn-ghost btn-xs text-info hover:bg-info/10 font-bold gap-1 px-2 py-0.5 h-6 min-h-0 text-tiny"
                title="Ver historial completo y detallado de asignaciones"
              >
                <Icon name="boxicons:clock" size={14} />
                <span>Ver historial</span>
              </button>
            </div>

            <div id="stat-last-assigned-container">
              {lastAssignedOperator ? (
                <div class="text-xs flex flex-wrap items-center justify-between gap-2 bg-base-100 p-3 rounded-xl border border-base-300/60">
                  <div class="flex items-center gap-4">
                    <span class="text-base-content/70">
                      De: <strong class="text-info" id="stat-last-assigned-by">{lastAssignedOperator.lastAutogestionAssignedBy || "Sistema"}</strong>
                    </span>
                    <span class="text-base-content/70">
                      Para: <strong class="text-base-content" id="stat-last-assigned-to">{lastAssignedOperator.nombre}</strong>
                    </span>
                  </div>
                  <span class="text-xxs text-base-content/50 font-mono" id="stat-last-assigned-time">
                    Hora: {new Date(lastAssignedOperator.lastAutogestionAssignedAt!).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" })}
                  </span>
                </div>
              ) : (
                <div class="text-xs text-base-content/40 italic py-1">Sin asignaciones hoy</div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pestaña 2: Monitoreo de Operadores -->
  <div id="panel-monitoreo" class={initialTab === "monitoreo" ? "flex flex-col gap-6" : "flex flex-col gap-6 hidden"}>
    <!-- Top KPIs (Disponibilidad + Fuera de Servicio) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Card Disponibles -->
      <div
        class="card bg-base-100 border border-base-300 shadow-md overflow-hidden group hover:border-success/30 transition-colors duration-300"
      >
        <div
          class="absolute -top-4 -right-4 p-4 opacity-5 group-hover:opacity-10 group-hover:scale-110 transition-transform duration-500 pointer-events-none"
        >
          <Icon name="boxicons:user-check" size={128} />
        </div>
        <div class="card-body p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="p-2 bg-success/10 rounded-lg text-success">
              <Icon name="boxicons:user-check" size={24} />
            </div>
            <h3
              class="font-bold text-xs uppercase tracking-widest text-base-content/50"
            >
              Disponibilidad Actual
            </h3>
          </div>
          <div class="flex items-baseline gap-2">
            <span
              class="text-5xl font-black text-success tracking-tight"
              id="stat-disponibles-count">{disponiblesCount}</span
            >
            <span
              class="text-base-content/40 font-bold uppercase text-xs tracking-wider"
              >operadores activos</span
            >
          </div>
          <div class="mt-6 flex flex-col gap-2">
            <div
              class="flex justify-between text-xs font-bold uppercase tracking-wider px-0.5"
            >
              <span class="text-base-content/40">Tasa de disponibilidad</span>
              <span class="text-success font-mono font-black" id="stat-percentage"
                >{
                  allOperators.length > 0
                    ? Math.round((disponiblesCount / allOperators.length) * 100)
                    : 0
                }%</span
              >
            </div>
            <progress
              class="progress progress-success w-full h-2.5 bg-base-200"
              value={disponiblesCount}
              max={allOperators.length || 1}
              id="stat-progress"></progress>
          </div>
        </div>
      </div>

      <!-- Card No Disponibles -->
      <div
        class="card bg-base-100 border border-base-300 shadow-md overflow-hidden group hover:border-base-content/20 transition-colors duration-300"
      >
        <div
          class="absolute -top-4 -right-4 p-4 opacity-5 group-hover:opacity-10 group-hover:scale-110 transition-transform duration-500 pointer-events-none"
        >
          <Icon name="boxicons:user-x" size={128} />
        </div>
        <div class="card-body p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="p-2 bg-base-content/5 rounded-lg text-base-content/50">
              <Icon name="boxicons:user-x" size={24} />
            </div>
            <h3
              class="font-bold text-xs uppercase tracking-widest text-base-content/50"
            >
              Fuera de Servicio
            </h3>
          </div>
          <div class="flex items-baseline gap-2">
            <span
              class="text-5xl font-black text-base-content/80 tracking-tight"
              id="stat-no-disponibles-count">{noDisponiblesCount}</span
            >
            <span
              class="text-base-content/40 font-bold uppercase text-xs tracking-wider"
              >en estados especiales</span
            >
          </div>

          <div class="mt-4 grid grid-cols-2 gap-2">
            {
              Object.entries(breakdown).map(([estado, count]) => (
                <div
                  class="flex items-center justify-between p-2 rounded-lg bg-base-200/50 border border-transparent hover:border-base-300 transition-colors duration-200 data-[count='0']:opacity-40"
                  data-breakdown-container
                  data-count={count}
                >
                  <div class="flex items-center gap-2 min-w-0">
                    <span
                      class={`size-2 rounded-full shrink-0 ${breakdownBadge(estado)}`}
                    />
                    <span class="text-xs font-bold truncate text-base-content/60 uppercase tracking-tight">
                      {STATUS_LABELS[estado] ?? estado}
                    </span>
                  </div>
                  <span
                    class="text-xs font-mono font-bold text-base-content/90"
                    data-breakdown-count={estado}
                  >
                    {count}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Control Bar: Toggle + Undo -->
    <div class="flex items-center justify-between gap-4">
      <label class="label cursor-pointer justify-start gap-3 bg-base-200/40 hover:bg-base-200/80 px-4 py-2.5 rounded-xl border border-base-300/45 transition-colors duration-250">
        <input type="checkbox" id="toggle-disponibles" class="toggle toggle-primary toggle-sm" />
        <span class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70">
          Solo disponibles
        </span>
      </label>

      {!isReadOnly && (
        <button id="btn-undo" type="button" class="btn btn-secondary btn-outline btn-sm shadow-sm" disabled>
          <Icon name="boxicons:undo" size={18} aria-hidden="true" />
          <span id="btn-undo-text">Deshacer</span>
        </button>
      )}
    </div>

    <!-- Tabla de Operadores -->
    <DataTable
      ariaLabel="Lista de operadores para asignación de autogestiones"
      headerGridClass={isReadOnly ? "grid-cols-[1.8fr_1.5fr_1.2fr] gap-2 md:gap-4" : "grid-cols-[1.8fr_1.5fr_1.2fr_minmax(100px,auto)] gap-2 md:gap-4"}
      rowGridClass={isReadOnly ? "grid grid-cols-[1.8fr_1.5fr_1.2fr] items-center gap-2 md:gap-4" : "grid grid-cols-[1.8fr_1.5fr_1.2fr_minmax(100px,auto)] items-center gap-2 md:gap-4"}
    >
      <Fragment slot="header">
        <DataTableHeaderCell sortKey="nombre">Operador</DataTableHeaderCell>
        <DataTableHeaderCell>Horario / Modo</DataTableHeaderCell>
        <DataTableHeaderCell sortKey="estado">Estado</DataTableHeaderCell>
        {!isReadOnly && <DataTableHeaderCell align="right">Acciones</DataTableHeaderCell>}
      </Fragment>

      {
        allOperators.map((op) => {
          const isHighlighted = op.agentId === maxAssignedOperatorId;
          const isExceptional = !!op.estadoExcepcional;

          let rowClasses =
            "group border-b border-base-300 px-4 py-2.5 transition-colors duration-300 hover:bg-base-200/50";
          if (isExceptional) {
            rowClasses += " bg-secondary/10 border-l-4 border-l-secondary";
          } else if (isHighlighted) {
            rowClasses += " bg-primary/10 border-l-4 border-l-primary";
          }
          if (!op.disponible && !isExceptional) {
            rowClasses += " opacity-50 grayscale-[30%]";
          }

          return (
            <div
              class={rowClasses}
              data-table-row
              data-op-id={op.agentId}
              data-op-estado={
                op.disponible ? "disponible" : op.motivo || "offline"
              }
              data-sort-nombre={op.nombre}
              data-sort-estado={
                op.disponible ? "disponible" : op.motivo || "offline"
              }
            >
              {/* Nombre + Last Assigned */}
              <div class="flex min-w-0 flex-col">
                <span class="truncate text-xs font-bold text-base-content">
                  {op.nombre}
                </span>
                <div data-op-last-assigned-container>
                  {op.lastAutogestionAssignedAt ? (
                    <span
                      class="text-tiny text-base-content/75 bg-base-300/50 rounded px-1.5 py-0.5 inline-block font-semibold mt-0.5"
                      data-last-assigned={op.lastAutogestionAssignedAt}
                    >
                      Asignado:{" "}
                      {new Date(op.lastAutogestionAssignedAt).toLocaleTimeString(
                        "es-AR",
                        { hour: "2-digit", minute: "2-digit" },
                      )}
                    </span>
                  ) : (
                    <span class="text-tiny text-base-content/40 bg-base-200/40 rounded px-1.5 py-0.5 inline-block italic mt-0.5">
                      Nunca asignado
                    </span>
                  )}
                </div>
              </div>

              {/* Horario y Modo */}
              <div class="flex flex-col gap-1 min-w-0">
                <div data-op-horario>
                  {op.horarioHoy ? (
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-small text-base-content/70">
                      <span class="flex items-center gap-1 font-semibold">
                        <Icon
                          name="boxicons:clock-dashed-half-filled"
                          size={14}
                          class="opacity-60 shrink-0"
                        />
                        {op.horarioHoy}
                      </span>
                      {op.breakInicioHoy && op.breakFinHoy && (
                        <span class="flex items-center gap-1 opacity-70">
                          <Icon
                            name="boxicons:cup-hot"
                            size={14}
                            class="opacity-60 shrink-0"
                          />
                          {op.breakInicioHoy} - {op.breakFinHoy}
                        </span>
                      )}
                    </div>
                  ) : (
                    <span class="text-base-content/40 italic">Sin horario</span>
                  )}
                </div>

                <div data-op-modalidad>
                  {op.modalidadHoy && op.modalidadHoy !== "Franco" && (
                    <span class="text-xxs font-bold opacity-60 uppercase tracking-tight">
                      {op.modalidadHoy === "Home Office" ? "Home" : "Presencial"}
                    </span>
                  )}
                </div>
              </div>

              {/* Badge estado */}
              <div
                data-op-status-cell={op.agentId}
                class="flex flex-col items-start gap-1"
              >
                {op.estadoExcepcional ? (
                  <div
                    class="tooltip tooltip-bottom before:text-xxs before:px-2 before:py-1"
                    data-tip={`${op.estadoExcepcionalMotivo || "Sin comentario"} — marcado a las ${op.estadoExcepcionalAt ? new Date(op.estadoExcepcionalAt).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" }) : ""}`}
                  >
                    <span
                      data-op-status-badge={op.agentId}
                      class={`badge ${getBadgeColor(op.motivo || "", op.disponible)} gap-1.5 badge-xs font-semibold uppercase text-tiny tracking-wider py-2 cursor-help`}
                    >
                      {getExcepcionalShortLabel(op.estadoExcepcional)}
                      {op.estadoExcepcional === "break_extendido" &&
                      op.retornoEstimado
                        ? op.retornoEstimado === "Manual"
                          ? " (Manual)"
                          : ` - vuelve ${op.retornoEstimado}`
                        : ""}
                    </span>
                  </div>
                ) : (
                  <span
                    data-op-status-badge={op.agentId}
                    class={`badge ${getBadgeColor(op.motivo || "", op.disponible)} gap-1.5 badge-xs font-semibold uppercase text-tiny tracking-wider py-2`}
                  >
                    {op.disponible && (
                      <span class="size-1.5 rounded-full bg-success-content animate-ping" />
                    )}
                    {!op.disponible && op.motivo === "En break" && (
                      <span class="size-1.5 rounded-full bg-warning-content/75 animate-pulse" />
                    )}
                    {op.disponible
                      ? "Disponible"
                      : op.motivo === "En break"
                        ? `En break - vuelve ${op.retornoEstimado || ""}`
                        : op.motivo || "Franco"}
                  </span>
                )}
                {op.estadoExcepcional && op.estadoExcepcionalMotivo && (
                  <div
                    data-op-exception-comment={op.agentId}
                    class="text-small text-base-content/50 italic font-medium max-w-[150px] truncate mt-0.5"
                    title={op.estadoExcepcionalMotivo}
                  >
                    "{op.estadoExcepcionalMotivo}"
                  </div>
                )}
              </div>

              {/* Botones de acción */}
              {!isReadOnly && (
                <div
                  class="flex items-center justify-end gap-2"
                  data-op-actions={op.agentId}
                >
                  <>
                    <div class="m-0">
                      <button
                        type="button"
                        class="btn btn-secondary btn-xs btn-soft font-bold uppercase tracking-wider"
                        data-op-assign-btn={op.agentId}
                        title={`Asignar autogestión a ${op.nombre}`}
                        disabled={!op.disponible}
                      >
                        Asignar
                      </button>
                    </div>

                    <div data-op-exception-container={op.agentId} class="relative">
                      {op.estadoExcepcional ? (
                        <button
                          type="button"
                          class="btn btn-error btn-xs btn-outline font-bold uppercase tracking-wider"
                          data-action-lift-exception={op.agentId}
                          title="Levantar estado excepcional"
                        >
                          Levantar
                        </button>
                      ) : (
                        <button
                          type="button"
                          class="btn btn-ghost btn-xs text-base-content/60 hover:text-secondary hover:bg-secondary/10 px-1"
                          data-action-open-exception-modal={op.agentId}
                          data-op-nombre={op.nombre}
                          title="Marcar estado excepcional"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="size-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            />
                          </svg>
                        </button>
                      )}
                    </div>
                  </>
                </div>
              )}
            </div>
          );
        })
      }
    </DataTable>
  </div>

  <!-- Modal Detalle de Ticket Sin Asignar -->
  <dialog id="modal-ticket-detail" class="modal" data-invgate-web-base={invgateWebBase}>
    <div class="modal-box w-11/12 max-w-2xl border border-base-300 bg-base-100 p-0 overflow-hidden shadow-2xl">
      <!-- Modal Header -->
      <div class="p-5 bg-base-200/50 border-b border-base-300 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 min-w-0">
          <span id="ticket-modal-id" class="font-mono font-bold text-primary-content bg-primary px-2.5 py-1 rounded-lg text-sm shrink-0">#0</span>
          <span id="ticket-modal-prio" class="badge badge-sm font-bold tracking-wider uppercase shrink-0"></span>
          <span id="ticket-modal-cat" class="badge badge-neutral badge-sm font-semibold truncate shrink-0 max-w-[200px]"></span>
        </div>
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost text-base-content/60 hover:text-base-content" aria-label="Cerrar modal">✕</button>
        </form>
      </div>

      <!-- Modal Body -->
      <div class="p-6 flex flex-col gap-5 max-h-[70vh] overflow-y-auto">
        <!-- Título -->
        <div>
          <label class="text-xxs font-bold text-base-content/40 uppercase tracking-widest block mb-1">Título de la solicitud</label>
          <h3 id="ticket-modal-title" class="text-base font-bold text-base-content leading-snug"></h3>
        </div>

        <!-- Grid de Metadatos -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 bg-base-200/30 p-4 rounded-xl border border-base-300/60">
          <div>
            <span class="text-tiny font-medium text-base-content/50 block">Creado por</span>
            <span id="ticket-modal-creator" class="text-xs font-bold text-base-content"></span>
          </div>
          <div>
            <span class="text-tiny font-medium text-base-content/50 block">Usuario afectado (Cliente)</span>
            <span id="ticket-modal-customer" class="text-xs font-bold text-base-content"></span>
          </div>
          <div>
            <span class="text-tiny font-medium text-base-content/50 block">Ubicación / Sede</span>
            <span id="ticket-modal-location" class="text-xs font-semibold text-base-content"></span>
          </div>
          <div>
            <span class="text-tiny font-medium text-base-content/50 block">Fecha y Hora de Creación</span>
            <span id="ticket-modal-created" class="text-xs font-mono font-semibold text-base-content"></span>
          </div>
          <div>
            <span class="text-tiny font-medium text-base-content/50 block">Tiempo en cola</span>
            <span id="ticket-modal-wait" class="text-xs font-mono font-bold"></span>
          </div>
          <div>
            <span class="text-tiny font-medium text-base-content/50 block">SLA de Respuesta</span>
            <span id="ticket-modal-sla" class="text-xs font-mono font-semibold text-info"></span>
          </div>
        </div>

        <!-- Categoría Completa -->
        <div id="ticket-modal-cat-full-container" class="hidden">
          <label class="text-xxs font-bold text-base-content/40 uppercase tracking-widest block mb-1">Ruta de Categoría</label>
          <span id="ticket-modal-cat-full" class="text-xs font-mono bg-base-200/70 px-3 py-1.5 rounded-lg block text-base-content/80"></span>
        </div>

        <!-- Descripción Completa -->
        <div>
          <label class="text-xxs font-bold text-base-content/40 uppercase tracking-widest block mb-1">Descripción del ticket</label>
          <div id="ticket-modal-description" class="text-xs text-base-content/80 whitespace-pre-wrap bg-base-200/40 p-4 rounded-xl border border-base-300/40 font-sans max-h-60 overflow-y-auto leading-relaxed">
            Sin descripción disponible.
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-4 bg-base-200/50 border-t border-base-300 flex items-center justify-between gap-3">
        <span class="text-tiny text-base-content/50">Mesa de Ayuda #3866</span>
        <div class="flex items-center gap-2">
          <button
            id="ticket-modal-assign-btn"
            type="button"
            class="btn btn-success text-success-content btn-sm font-bold gap-1.5 shadow-sm hidden"
          >
            <Icon name="boxicons:bolt" class="size-4 shrink-0" />
            <span id="ticket-modal-assign-btn-text">Asignar a operador</span>
          </button>
          <a
            id="ticket-modal-invgate-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm font-semibold gap-1.5 shadow-sm"
          >
            <span>Abrir en InvGate</span>
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
          <form method="dialog">
            <button class="btn btn-ghost btn-sm">Cerrar</button>
          </form>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Modal Historial de Asignaciones -->
  <dialog id="modal-historial-asignaciones" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box sm:max-w-2xl bg-base-100 p-0 border border-base-300 shadow-2xl rounded-2xl overflow-hidden flex flex-col max-h-[85vh]">
      <!-- Header -->
      <div class="p-4 sm:p-5 border-b border-base-300 bg-base-200/50 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-info/10 text-info shrink-0">
            <Icon name="boxicons:history" size={22} />
          </div>
          <div>
            <h3 class="font-bold text-sm text-base-content uppercase tracking-wider">Historial de Asignaciones</h3>
            <p class="text-xs text-base-content/60 font-medium">Registro cronológico detallado de asignaciones de autogestión</p>
          </div>
        </div>
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost text-base-content/60 hover:text-base-content">✕</button>
        </form>
      </div>

      <!-- Body -->
      <div class="p-4 sm:p-5 overflow-y-auto flex-1">
        <div id="historial-loading" class="flex flex-col items-center justify-center py-12 gap-3 text-base-content/50">
          <span class="loading loading-spinner loading-md text-info"></span>
          <span class="text-xs font-semibold">Cargando historial...</span>
        </div>

        <div id="historial-empty" class="hidden text-xs text-base-content/40 italic py-12 text-center">
          No hay registros de asignaciones en el historial.
        </div>

        <div id="historial-table-container" class="hidden overflow-x-auto">
          <table class="table table-sm w-full text-xs">
            <thead>
              <tr class="bg-base-200/60 text-base-content/70 uppercase text-tiny font-mono">
                <th>Fecha y Hora</th>
                <th>Operador Asignado</th>
                <th>Ticket InvGate</th>
                <th>Tipo</th>
                <th>Asignado Por</th>
              </tr>
            </thead>
            <tbody id="historial-rows" class="divide-y divide-base-200">
            </tbody>
          </table>
        </div>
      </div>

      <!-- Footer -->
      <div class="p-3.5 bg-base-200/50 border-t border-base-300 flex items-center justify-between">
        <span class="text-tiny text-base-content/50 font-mono">Últimos 50 registros</span>
        <form method="dialog">
          <button class="btn btn-sm btn-neutral font-semibold">Cerrar</button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>cerrar</button>
    </form>
  </dialog>
</PageContainer>

<script>
  import { showToast } from "@/lib/toastClient";
  import { escapeHtml } from "@lib/sanitize";

  let countdownInterval: any = null;
  let timer: any = null;
  let polling: any = null;
  let heartbeatInterval: any = null;
  let checkReady: any = null;

  const init = () => {
    const toggle = document.getElementById(
      "toggle-disponibles",
    ) as HTMLInputElement | null;
    if (!toggle) return false;

    // Tab switching listener
    const tabBtns = document.querySelectorAll("[data-tab-target]");
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-tab-target");

        tabBtns.forEach((b) => {
          b.classList.remove("tab-active", "bg-primary", "text-primary-content", "shadow-sm");
          b.classList.add("text-base-content/70", "hover:text-base-content");
        });
        btn.classList.add("tab-active", "bg-primary", "text-primary-content", "shadow-sm");
        btn.classList.remove("text-base-content/70", "hover:text-base-content");

        const isAsignacion = targetId === "panel-asignacion";
        document.getElementById("panel-asignacion")?.classList.toggle("hidden", !isAsignacion);
        document.getElementById("panel-monitoreo")?.classList.toggle("hidden", isAsignacion);

        const url = new URL(window.location.href);
        url.searchParams.set("tab", isAsignacion ? "asignacion" : "monitoreo");
        window.history.replaceState({}, "", url.toString());
      });
    });

    const syncIndicator = document.getElementById("sync-indicator");
    const refreshIcon = document.getElementById("refresh-icon");
    const btnRefresh = document.getElementById(
      "btn-refresh",
    ) as HTMLButtonElement | null;
    const modalEl = document.getElementById(
      "modal-marcar-excepcion",
    ) as HTMLDialogElement | null;

    if (modalEl) {
      modalEl.addEventListener("close", () => {
        document.body.classList.remove("overflow-hidden");
        document.documentElement.classList.remove("overflow-hidden");
      });
    }

    const selectTipo = document.getElementById(
      "modal-select-tipo",
    ) as HTMLSelectElement | null;
    const containerTiempoExtra = document.getElementById(
      "container-tiempo-extra",
    );
    if (selectTipo && containerTiempoExtra) {
      selectTipo.addEventListener("change", () => {
        if (selectTipo.value === "break_extendido") {
          containerTiempoExtra.classList.remove("hidden");
        } else {
          containerTiempoExtra.classList.add("hidden");
        }
      });
    }

    let secondsSinceSync = 0;
    let lockExpiresAt = 0;
    let lockTimeoutMs = 300000;
    let currentLockStatus: any = null;
    let latestUnassignedTickets: any[] = [];
    let latestDisponibilidadData: any[] = [];

    const formatCountdown = (ms: number): string => {
      if (ms <= 0) return "0:00";
      const totalSeconds = Math.floor(ms / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      return `${minutes}:${seconds.toString().padStart(2, "0")}`;
    };

    const stopCountdown = () => {
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
      }
    };

    const startCountdown = () => {
      stopCountdown();

      const tick = () => {
        const remaining = lockExpiresAt - Date.now();
        const countdownEl = document.getElementById("lock-countdown");
        if (remaining <= 0) {
          if (countdownEl) {
            countdownEl.innerText = "0:00";
          }
          stopCountdown();
          fetchLockStatus().then(updateLockBanner);
          return;
        }
        if (countdownEl) {
          countdownEl.innerText = formatCountdown(remaining);
          if (remaining < 60000) {
            countdownEl.classList.remove("bg-base-100/30");
            countdownEl.classList.add("bg-error/70", "text-error-content");
          } else {
            countdownEl.classList.add("bg-base-100/30");
            countdownEl.classList.remove("bg-error/70", "text-error-content");
          }
        }
      };

      tick();
      countdownInterval = setInterval(tick, 1000);
    };

    const updateIndicatorText = () => {
      if (!syncIndicator) return;
      if (secondsSinceSync === 0) {
        syncIndicator.innerText = "Actualizado hace unos instantes";
      } else {
        syncIndicator.innerText = `Actualizado hace ${secondsSinceSync}s`;
      }
    };

    // Increment elapsed seconds since last successful API call
    timer = setInterval(() => {
      secondsSinceSync++;
      updateIndicatorText();
    }, 1000);

    const updateVisibility = () => {
      const soloDisponibles = toggle.checked;
      const rows = document.querySelectorAll<HTMLElement>("[data-op-id]");
      rows.forEach((row) => {
        const estado = row.getAttribute("data-op-estado") || "";
        if (soloDisponibles && estado !== "disponible") {
          row.classList.add("hidden");
        } else {
          row.classList.remove("hidden");
        }
      });
    };

    toggle.addEventListener("change", updateVisibility);

    // Dynamic UI Update from API Response
    const updateUI = (data: any[]) => {
      latestDisponibilidadData = data || [];
      // Update Undo button state
      const opWithUndo = data.find(op => op.lastAutogestionUndo !== null && op.lastAutogestionUndo !== undefined);
      const btnUndo = document.getElementById("btn-undo") as HTMLButtonElement | null;
      const btnUndoText = document.getElementById("btn-undo-text") as HTMLElement | null;
      if (btnUndo && btnUndoText) {
        if (opWithUndo) {
          btnUndo.disabled = false;
          btnUndoText.innerText = `Deshacer: ${opWithUndo.nombre}`;
        } else {
          btnUndo.disabled = true;
          btnUndoText.innerText = "Deshacer";
        }
      }

      // 1. Calculate highlights (the one with the latest assignment)
      let maxAssignedTime = 0;
      let maxAgentId: number | null = null;
      data.forEach((op) => {
        if (
          op.lastAutogestionAssignedAt &&
          op.lastAutogestionAssignedAt > maxAssignedTime
        ) {
          maxAssignedTime = op.lastAutogestionAssignedAt;
          maxAgentId = op.agentId;
        }
      });

      // 2. Update summary cards
      const disponiblesCount = data.filter((op) => op.disponible).length;
      const totalCount = data.length || 1;
      const pct = Math.round((disponiblesCount / totalCount) * 100);

      const statDisponibles = document.getElementById("stat-disponibles-count");
      if (statDisponibles)
        statDisponibles.innerText = disponiblesCount.toString();

      const statNoDisponibles = document.getElementById(
        "stat-no-disponibles-count",
      );
      if (statNoDisponibles)
        statNoDisponibles.innerText = (
          data.length - disponiblesCount
        ).toString();

      const statPercentage = document.getElementById("stat-percentage");
      if (statPercentage) statPercentage.innerText = `${pct}%`;

      const statProgress = document.getElementById(
        "stat-progress",
      ) as HTMLProgressElement | null;
      if (statProgress) {
        statProgress.value = disponiblesCount;
        statProgress.max = totalCount;
      }

      // 3. Update breakdown counts
      const breakdown = {
        "En break": 0,
        "Fuera de horario": 0,
        Franco: 0,
        Licencia: 0,
        Vacaciones: 0,
        Excepción: 0,
      };

      data.forEach((op) => {
        if (!op.disponible) {
          const mot = op.motivo || "Franco";
          if (
            [
              "Devolución Supervisor",
              "Break Extendido",
              "Problema Técnico",
            ].includes(mot)
          ) {
            breakdown["Excepción"]++;
          } else if (mot in breakdown) {
            breakdown[mot as keyof typeof breakdown]++;
          }
        }
      });

      for (const [status, count] of Object.entries(breakdown)) {
        const el = document.querySelector(
          `[data-breakdown-count="${status}"]`,
        ) as HTMLElement | null;
        if (el) {
          el.textContent = count.toString();
          const container = el.closest("[data-breakdown-container]");
          if (container) {
            container.setAttribute("data-count", count.toString());
            if (count === 0) {
              container.classList.add("opacity-40");
            } else {
              container.classList.remove("opacity-40");
            }
          }
        }
      }

      // 3b. Update last assigned card and suggested card
      let maxAssignedTimeForCard = 0;
      let lastAssignedOp: any = null;
      for (const op of data) {
        if (
          op.lastAutogestionAssignedAt &&
          op.lastAutogestionAssignedAt > maxAssignedTimeForCard
        ) {
          maxAssignedTimeForCard = op.lastAutogestionAssignedAt;
          lastAssignedOp = op;
        }
      }

      const lastAssignedContainer = document.getElementById("stat-last-assigned-container");
      if (lastAssignedContainer) {
        if (lastAssignedOp && maxAssignedTimeForCard > 0) {
          const timeStr = new Date(maxAssignedTimeForCard).toLocaleTimeString("es-AR", {
            hour: "2-digit",
            minute: "2-digit",
          });
          lastAssignedContainer.innerHTML = `
            <div class="text-xs flex flex-wrap items-center justify-between gap-2 bg-base-100 p-3 rounded-xl border border-base-300/60">
              <div class="flex items-center gap-4">
                <span class="text-base-content/70">
                  De: <strong class="text-info" id="stat-last-assigned-by">${escapeHtml(lastAssignedOp.lastAutogestionAssignedBy || "Sistema")}</strong>
                </span>
                <span class="text-base-content/70">
                  Para: <strong class="text-base-content" id="stat-last-assigned-to">${escapeHtml(lastAssignedOp.nombre)}</strong>
                </span>
              </div>
              <span class="text-xxs text-base-content/50 font-mono" id="stat-last-assigned-time">
                Hora: ${timeStr}
              </span>
            </div>
          `;
        } else {
          lastAssignedContainer.innerHTML = `<span class="text-xs text-base-content/40 italic py-1">Sin asignaciones hoy</span>`;
        }
      }

      const updateQueueUI = (data: any[]) => {
        const queueContainer = document.getElementById("queue-container");
        if (!queueContainer) return;

        const available = data.filter((op) => op.disponible);
        const sortedQueue = [...available].sort((a, b) => {
          const tA = a.lastAutogestionAssignedAt ?? 0;
          const tB = b.lastAutogestionAssignedAt ?? 0;
          if (a.lastAutogestionAssignedAt === null && b.lastAutogestionAssignedAt !== null) return -1;
          if (a.lastAutogestionAssignedAt !== null && b.lastAutogestionAssignedAt === null) return 1;
          return tA - tB;
        }).slice(0, 10);

        const getInitialsJs = (name: string) => {
          if (!name) return "OP";
          const parts = name.trim().split(/\s+/);
          if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
          return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        };

        if (sortedQueue.length > 0) {
          queueContainer.innerHTML = sortedQueue.map((op, idx) => {
            const isFirst = idx === 0;
            const avatarBg = isFirst ? "bg-primary text-primary-content" : "bg-base-300 text-base-content/70";
            const containerClass = isFirst ? "bg-primary/5" : "";
            const titleClass = isFirst ? "text-base-content font-black" : "text-base-content/80";

            const projTicket = latestUnassignedTickets[idx];
            const projBadge = projTicket
              ? `<div class="badge badge-warning/15 border border-warning/30 text-warning-content font-mono font-bold text-tiny px-2 py-1 flex items-center gap-1 shrink-0 cursor-help" title="Si se asigna en orden, recibirá: ${escapeHtml(projTicket.title)}"><span class="text-warning font-sans font-bold">↳</span><span>${escapeHtml(projTicket.pretty_id || '#' + projTicket.id)}</span></div>`
              : "";

            const statusText = op.disponible ? "Disponible" : (op.motivo || "No disponible");
            const statusBadgeClass = op.disponible ? "badge-success/15 text-success border border-success/30" : "badge-neutral opacity-70";

            const breakStr = op.breakInicioHoy && op.breakFinHoy
              ? `<span class="flex items-center gap-1 font-mono text-base-content/70"><svg class="size-3 text-warning opacity-70 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg><span>Break: ${escapeHtml(op.breakInicioHoy)} - ${escapeHtml(op.breakFinHoy)}</span></span>`
              : "";

            return `
              <div data-agent-id="${op.agentId}" class="flex items-center justify-between gap-3 p-3.5 transition-colors hover:bg-base-200/60 cursor-default ${containerClass}">
                <div class="flex items-center gap-3 min-w-0 flex-1">
                  <div class="avatar placeholder size-9 rounded-full shrink-0 flex items-center justify-center font-bold text-xs ${avatarBg}">
                    ${escapeHtml(getInitialsJs(op.nombre))}
                  </div>
                  <div class="min-w-0 flex-1 flex flex-col gap-0.5">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="truncate font-bold text-xs ${titleClass}">
                        ${escapeHtml(op.nombre)}
                      </span>
                      ${isFirst ? '<span class="badge badge-primary text-primary-content badge-xs font-bold uppercase text-tiny shrink-0">Siguiente</span>' : ''}
                      <span class="badge ${statusBadgeClass} badge-xs font-bold text-tiny shrink-0">${escapeHtml(statusText)}</span>
                    </div>
                    <div class="flex items-center gap-2 text-tiny text-base-content/50 font-medium flex-wrap">
                      <span class="uppercase font-semibold text-xxs opacity-75">${escapeHtml(op.modalidadHoy === "Home Office" ? "Home Office" : "Presencial")}</span>
                      ${breakStr}
                    </div>
                  </div>
                </div>
                ${projBadge}
              </div>
            `;
          }).join("");
        } else {
          queueContainer.innerHTML = `
            <div class="text-xs text-base-content/40 italic py-8 text-center" id="stat-suggested-name-empty">
              No hay operadores disponibles
            </div>
          `;
        }

        const nextAssignedInfo = document.querySelector("#btn-assign-cyclic + p strong");
        if (nextAssignedInfo) {
          if (sortedQueue.length > 0) {
            nextAssignedInfo.textContent = sortedQueue[0].nombre;
          }
        }
      };

      updateQueueUI(data);

      // 4. Update each table row
      data.forEach((op) => {
        const row = document.querySelector(
          `[data-op-id="${op.agentId}"]`,
        ) as HTMLElement | null;
        if (!row) return;

        const stateKey = op.disponible ? "disponible" : op.motivo || "offline";
        row.setAttribute("data-op-estado", stateKey);
        row.setAttribute("data-sort-estado", stateKey);

        // Clear previous conditional classes to ensure fresh state
        row.classList.remove(
          "bg-primary/10",
          "border-l-primary",
          "bg-secondary/10",
          "border-l-secondary",
          "border-l-4",
          "opacity-50",
          "grayscale-[30%]",
        );

        const isExceptional = !!op.estadoExcepcional;
        const isHighlighted = op.agentId === maxAgentId && maxAssignedTime > 0;

        if (isExceptional) {
          row.classList.add(
            "bg-secondary/10",
            "border-l-4",
            "border-l-secondary",
          );
        } else if (isHighlighted) {
          row.classList.add("bg-primary/10", "border-l-4", "border-l-primary");
        }

        if (!op.disponible && !isExceptional) {
          row.classList.add("opacity-50", "grayscale-[30%]");
        }

        // Update Horario / Break content
        const horarioEl = row.querySelector(`[data-op-horario]`);
        if (horarioEl) {
          if (op.horarioHoy) {
            let breakHtml = "";
            if (op.breakInicioHoy && op.breakFinHoy) {
              breakHtml = `
                <span class="flex items-center gap-1 opacity-70">
                  <svg class="size-3 opacity-60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="2" x2="6" y2="4"></line><line x1="10" y1="2" x2="10" y2="4"></line><line x1="14" y1="2" x2="14" y2="4"></line></svg>
                  ${op.breakInicioHoy} - ${op.breakFinHoy}
                </span>
              `;
            }
            horarioEl.innerHTML = `
              <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-small text-base-content/70">
                <span class="flex items-center gap-1 font-semibold">
                  <svg class="size-3.5 opacity-60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  ${op.horarioHoy}
                </span>
                ${breakHtml}
              </div>
            `;
          } else {
            horarioEl.innerHTML = `<span class="text-base-content/40 italic">Sin horario</span>`;
          }
        }

        // Update Modality text
        const modEl = row.querySelector(`[data-op-modalidad]`);
        if (modEl) {
          if (op.modalidadHoy && op.modalidadHoy !== "Franco") {
            const isHome = op.modalidadHoy === "Home Office";
            modEl.innerHTML = `
              <span class="text-xxs font-bold opacity-60 uppercase tracking-tight">
                ${isHome ? "Home" : "Presencial"}
              </span>
            `;
          } else {
            modEl.innerHTML = "";
          }
        }

        // Update status cell (badge + comment)
        const statusCell = row.querySelector(
          `[data-op-status-cell="${op.agentId}"]`,
        );
        if (statusCell) {
          let badgeHtml = "";
          let commentHtml = "";

          if (op.estadoExcepcional) {
            const badgeClass =
              "badge-secondary text-secondary-content shadow-sm shadow-secondary/20";
            let shortLabel = "⚠ Excepción";
            if (op.estadoExcepcional === "devolucion_supervisor")
              shortLabel = "⚠ Dev. Supervisor";
            else if (op.estadoExcepcional === "break_extendido") {
              const returnSuffix =
                op.retornoEstimado === "Manual"
                  ? " (Manual)"
                  : op.retornoEstimado
                    ? ` - vuelve ${op.retornoEstimado}`
                    : "";
              shortLabel = `⚠ Break extendido${returnSuffix}`;
            } else if (op.estadoExcepcional === "problema_tecnico")
              shortLabel = "⚠ Prob. técnico";

            const timeStr = op.estadoExcepcionalAt
              ? new Date(op.estadoExcepcionalAt).toLocaleTimeString("es-AR", {
                  hour: "2-digit",
                  minute: "2-digit",
                })
              : "";
            const tooltipTip = `${op.estadoExcepcionalMotivo || "Sin comentario"} — marcado a las ${timeStr}`;

            badgeHtml = `
              <div class="tooltip tooltip-bottom before:text-xxs before:px-2 before:py-1" data-tip="${tooltipTip}">
                <span
                  data-op-status-badge="${op.agentId}"
                  class="badge ${badgeClass} gap-1.5 badge-xs font-semibold uppercase text-tiny tracking-wider py-2 cursor-help"
                >
                  ${shortLabel}
                </span>
              </div>
            `;
            if (op.estadoExcepcionalMotivo) {
              commentHtml = `
                <div data-op-exception-comment="${op.agentId}" class="text-small text-base-content/50 italic font-medium max-w-[150px] truncate mt-0.5" title="${op.estadoExcepcionalMotivo}">
                  "${op.estadoExcepcionalMotivo}"
                </div>
              `;
            }
          } else {
            let badgeClass = "badge-neutral";
            let badgeText = op.motivo || "Franco";
            let dotHtml = "";

            if (op.disponible) {
              badgeClass =
                "badge-success text-success-content shadow-sm shadow-success/20";
              badgeText = "Disponible";
              dotHtml = `<span class="size-1.5 rounded-full bg-success-content animate-ping"></span>`;
            } else if (op.motivo === "En break") {
              badgeClass =
                "badge-warning text-warning-content shadow-sm shadow-warning/20";
              badgeText = `En break - vuelve ${op.retornoEstimado || ""}`;
              dotHtml = `<span class="size-1.5 rounded-full bg-warning-content/75 animate-pulse"></span>`;
            } else if (op.motivo === "Fuera de horario") {
              badgeClass = "badge-neutral text-neutral-content/75 opacity-70";
              badgeText = "Fuera de horario";
            } else if (op.motivo === "Licencia") {
              badgeClass = "badge-error text-error-content shadow-sm shadow-error/20";
            } else if (op.motivo === "Vacaciones") {
              badgeClass = "badge-info text-info-content shadow-sm shadow-info/20";
            } else if (op.motivo === "Franco") {
              badgeClass = "badge-neutral text-neutral-content/50";
            }

            badgeHtml = `
              <span
                data-op-status-badge="${op.agentId}"
                class="badge ${badgeClass} gap-1.5 badge-xs font-semibold uppercase text-tiny tracking-wider py-2"
              >
                ${dotHtml}${badgeText}
              </span>
            `;
          }

          statusCell.innerHTML = `${badgeHtml}${commentHtml}`;
        }

        // Update actions container
        const exceptionContainer = row.querySelector(
          `[data-op-exception-container="${op.agentId}"]`,
        );
        if (exceptionContainer) {
          if (op.estadoExcepcional) {
            exceptionContainer.innerHTML = `
              <button
                type="button"
                class="btn btn-error btn-xs btn-outline font-bold uppercase tracking-wider"
                data-action-lift-exception="${op.agentId}"
                title="Levantar estado excepcional"
              >
                Levantar
              </button>
            `;
          } else {
            exceptionContainer.innerHTML = `
              <button
                type="button"
                class="btn btn-ghost btn-xs text-base-content/60 hover:text-secondary hover:bg-secondary/10 px-1"
                data-action-open-exception-modal="${op.agentId}"
                data-op-nombre="${op.nombre}"
                title="Marcar estado excepcional"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </button>
            `;
          }
        }

        // Update Last Assigned text
        const lastAssignedEl = row.querySelector(
          `[data-op-last-assigned-container]`,
        );
        if (lastAssignedEl) {
          if (op.lastAutogestionAssignedAt) {
            const timeStr = new Date(
              op.lastAutogestionAssignedAt,
            ).toLocaleTimeString("es-AR", {
              hour: "2-digit",
              minute: "2-digit",
            });
            lastAssignedEl.innerHTML = `
              <span class="text-tiny text-base-content/75 bg-base-300/50 rounded px-1.5 py-0.5 inline-block font-semibold mt-0.5" data-last-assigned="${op.lastAutogestionAssignedAt}">
                Asignado: ${timeStr}
              </span>
            `;
          } else {
            lastAssignedEl.innerHTML = `<span class="text-tiny text-base-content/40 bg-base-200/40 rounded px-1.5 py-0.5 inline-block italic mt-0.5">Nunca asignado</span>`;
          }
        }

        // Update assign button disabled state
        const assignBtn = row.querySelector(
          `[data-op-assign-btn="${op.agentId}"]`,
        ) as HTMLButtonElement | null;
        if (assignBtn) {
          assignBtn.disabled = !op.disponible;
        }
      });

      // Filter rows based on "Ver solo disponibles" toggle check
      updateVisibility();
    };

    const showAlert = (type: "success" | "error", message: string) => {
      showToast(message, type === "success" ? "alert-success" : "alert-error");
    };

    // Event delegation for exceptional states, assignments, and ticket details
    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;

      // -1. Open unassigned ticket detail modal
      const ticketCard = target.closest("[data-ticket-id]");
      const isAssignBtnClick = target.closest("[data-op-assign-btn]");
      if (ticketCard && !isAssignBtnClick) {
        const ticketId = Number(ticketCard.getAttribute("data-ticket-id"));
        const ticket = latestUnassignedTickets.find((t) => t.id === ticketId);
        const modal = document.getElementById("modal-ticket-detail") as HTMLDialogElement | null;

        if (ticket && modal) {
          const webBase = modal.getAttribute("data-invgate-web-base") || "";

          const elId = document.getElementById("ticket-modal-id");
          const elTitle = document.getElementById("ticket-modal-title");
          const elPrio = document.getElementById("ticket-modal-prio");
          const elCat = document.getElementById("ticket-modal-cat");
          const elCatFull = document.getElementById("ticket-modal-cat-full");
          const elCatFullContainer = document.getElementById("ticket-modal-cat-full-container");
          const elCreator = document.getElementById("ticket-modal-creator");
          const elCustomer = document.getElementById("ticket-modal-customer");
          const elLocation = document.getElementById("ticket-modal-location");
          const elCreated = document.getElementById("ticket-modal-created");
          const elWait = document.getElementById("ticket-modal-wait");
          const elSla = document.getElementById("ticket-modal-sla");
          const elDescription = document.getElementById("ticket-modal-description");
          const elLink = document.getElementById("ticket-modal-invgate-link") as HTMLAnchorElement | null;

          const PRIORITY_MAP: Record<number, { label: string; badgeClass: string }> = {
            1: { label: "Baja", badgeClass: "bg-base-200 text-base-content/60 border-none font-medium" },
            2: { label: "Media", badgeClass: "bg-info/15 text-info border-none font-medium" },
            3: { label: "Alta", badgeClass: "bg-warning/15 text-warning border-none font-semibold" },
            4: { label: "Urgente", badgeClass: "bg-warning/20 text-warning border-none font-bold" },
            5: { label: "Crítica", badgeClass: "bg-error/15 text-error border-none font-bold" },
          };

          if (elId) elId.textContent = ticket.pretty_id || `#${ticket.id}`;
          if (elTitle) elTitle.textContent = ticket.title || "Sin título";
          
          if (elPrio) {
            const prio = PRIORITY_MAP[ticket.priority_id];
            if (prio) {
              elPrio.textContent = prio.label;
              elPrio.className = `badge badge-sm font-bold tracking-wider uppercase shrink-0 ${prio.badgeClass}`;
              elPrio.classList.remove("hidden");
            } else {
              elPrio.classList.add("hidden");
            }
          }

          if (elCat) {
            if (ticket.category_last_name) {
              elCat.textContent = ticket.category_last_name;
              elCat.classList.remove("hidden");
            } else {
              elCat.classList.add("hidden");
            }
          }

          if (elCatFullContainer && elCatFull) {
            if (ticket.category_name) {
              elCatFull.textContent = ticket.category_name;
              elCatFullContainer.classList.remove("hidden");
            } else {
              elCatFullContainer.classList.add("hidden");
            }
          }

          // Match creator with available operators
          const creatorUsername = (ticket.creator_username || "").toLowerCase().trim();
          const creatorNameNorm = (ticket.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

          const matchingAvailableOp = latestDisponibilidadData.find((op) => {
            if (!op.disponible) return false;
            if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
            if (op.nombre && creatorNameNorm) {
              const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
              if (opNameNorm === creatorNameNorm) return true;
              const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
              if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
            }
            return false;
          });

          if (elCreator) {
            if (matchingAvailableOp) {
              elCreator.innerHTML = `<span class="text-success font-bold">${escapeHtml(ticket.creator_name || "Creador")} <span class="text-xxs font-semibold opacity-90">(Disponible)</span></span>`;
            } else {
              elCreator.textContent = ticket.creator_name || "Sin especificar";
            }
          }
          
          if (elCustomer) elCustomer.textContent = ticket.customer_name || "Mismo creador";
          if (elLocation) elLocation.textContent = ticket.location_name || "No especificada";

          const btnAssignModal = document.getElementById("ticket-modal-assign-btn") as HTMLButtonElement | null;
          const btnAssignModalText = document.getElementById("ticket-modal-assign-btn-text");

          if (btnAssignModal) {
            if (matchingAvailableOp) {
              btnAssignModal.setAttribute("data-op-assign-btn", String(matchingAvailableOp.agentId));
              if (btnAssignModalText) {
                btnAssignModalText.textContent = `Asignar a ${matchingAvailableOp.nombre}`;
              }
              btnAssignModal.classList.remove("hidden");
            } else {
              btnAssignModal.removeAttribute("data-op-assign-btn");
              btnAssignModal.classList.add("hidden");
            }
          }

          if (elCreated) {
            elCreated.textContent = ticket.created_at
              ? new Date(ticket.created_at * 1000).toLocaleString("es-AR", {
                  dateStyle: "short",
                  timeStyle: "medium",
                })
              : "Desconocida";
          }

          if (elWait) {
            if (ticket.created_at) {
              const elapsedMin = Math.floor((Date.now() - ticket.created_at * 1000) / 60000);
              const formatWait = elapsedMin >= 60 
                ? `${Math.floor(elapsedMin / 60)}h ${elapsedMin % 60}m` 
                : `${elapsedMin}m`;
              elWait.textContent = formatWait;
              elWait.className = `text-xs font-mono font-bold ${
                elapsedMin >= 60 ? "text-error" : elapsedMin >= 30 ? "text-warning" : "text-base-content/80"
              }`;
            } else {
              elWait.textContent = "-";
            }
          }

          if (elSla) elSla.textContent = ticket.sla_incident_first_reply || "No configurado";

          if (elDescription) {
            const rawDesc = ticket.description && ticket.description.trim().length > 0
              ? ticket.description
              : "Sin descripción provista.";
            
            // Render safe HTML parsing for formatted ticket descriptions (tables, paragraphs, breaks)
            const parser = new DOMParser();
            const doc = parser.parseFromString(rawDesc, "text/html");
            
            // Remove any script or iframe tags if present
            doc.querySelectorAll("script, iframe, object, embed").forEach((node) => node.remove());
            
            elDescription.innerHTML = doc.body.innerHTML;
          }

          if (elLink) {
            if (webBase) {
              elLink.href = `${webBase}/requests/show/index/id/${ticket.id}`;
              elLink.classList.remove("hidden");
            } else {
              elLink.classList.add("hidden");
            }
          }

          modal.showModal();
        }
        return;
      }

      // 0. Open exception modal
      const openModalBtn = target.closest("[data-action-open-exception-modal]");
      if (openModalBtn) {
        const agentId = openModalBtn.getAttribute(
          "data-action-open-exception-modal",
        );
        const nombre = openModalBtn.getAttribute("data-op-nombre") || "";

        const modal = document.getElementById(
          "modal-marcar-excepcion",
        ) as HTMLDialogElement | null;
        const agentIdInput = document.getElementById(
          "modal-agent-id",
        ) as HTMLInputElement | null;
        const operatorNameSpan = document.getElementById(
          "modal-operador-nombre",
        );
        const selectTipo = document.getElementById(
          "modal-select-tipo",
        ) as HTMLSelectElement | null;
        const containerTiempoExtra = document.getElementById(
          "container-tiempo-extra",
        );
        const selectTiempoExtra = document.getElementById(
          "modal-select-tiempo-extra",
        ) as HTMLSelectElement | null;
        const inputMotivo = document.getElementById(
          "modal-input-motivo",
        ) as HTMLInputElement | null;

        if (modal && agentIdInput && operatorNameSpan) {
          agentIdInput.value = agentId || "";
          operatorNameSpan.innerText = nombre;
          if (selectTipo) selectTipo.value = "devolucion_supervisor";
          if (containerTiempoExtra)
            containerTiempoExtra.classList.add("hidden");
          if (selectTiempoExtra) selectTiempoExtra.value = "20";
          if (inputMotivo) inputMotivo.value = "";

          document.body.classList.add("overflow-hidden");
          document.documentElement.classList.add("overflow-hidden");
          modal.showModal();
        }
        return;
      }

      // 0.5. Close exception modal
      const closeModalBtn = target.closest("#btn-close-modal-excepcion");
      if (closeModalBtn) {
        const modal = document.getElementById(
          "modal-marcar-excepcion",
        ) as HTMLDialogElement | null;
        if (modal) {
          modal.close();
        }
        return;
      }

      // 1. Confirm exceptional state from modal
      const confirmModalBtn = target.closest("#btn-confirmar-modal-excepcion");
      if (confirmModalBtn) {
        const agentIdInput = document.getElementById(
          "modal-agent-id",
        ) as HTMLInputElement | null;
        const selectTipo = document.getElementById(
          "modal-select-tipo",
        ) as HTMLSelectElement | null;
        const selectTiempoExtra = document.getElementById(
          "modal-select-tiempo-extra",
        ) as HTMLSelectElement | null;
        const inputMotivo = document.getElementById(
          "modal-input-motivo",
        ) as HTMLInputElement | null;
        const modal = document.getElementById(
          "modal-marcar-excepcion",
        ) as HTMLDialogElement | null;

        if (agentIdInput && selectTipo && modal) {
          const agentId = Number(agentIdInput.value);
          const tipo = selectTipo.value;
          const motivo = inputMotivo ? inputMotivo.value : "";
          const tiempoExtra =
            tipo === "break_extendido" &&
            selectTiempoExtra &&
            selectTiempoExtra.value !== "manual"
              ? Number(selectTiempoExtra.value)
              : null;

          if (!isNaN(agentId)) {
            confirmModalBtn.setAttribute("disabled", "true");
            try {
              const res = await fetch("/api/disponibilidad/excepcional", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ agentId, tipo, motivo, tiempoExtra }),
              });
              const resData = await res.json();
              if (res.status === 423) {
                modal.close();
                showAlert("error", resData.error || "Perdiste el control de asignación. Recargando...");
                setTimeout(() => window.location.reload(), 1500);
                return;
              }
              if (res.ok) {
                modal.close();
                await fetchDisponibilidad();
              } else {
                showAlert("error", resData.error || "No se pudo marcar el estado excepcional");
              }
            } catch (err) {
              console.error(err);
            } finally {
              confirmModalBtn.removeAttribute("disabled");
            }
          }
        }
        return;
      }

      // 2. Lift/clear exceptional state
      const liftBtn = target.closest("[data-action-lift-exception]");
      if (liftBtn) {
        const agentId = Number(
          liftBtn.getAttribute("data-action-lift-exception"),
        );
        if (!isNaN(agentId)) {
          liftBtn.setAttribute("disabled", "true");
          try {
            const res = await fetch("/api/disponibilidad/excepcional", {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ agentId }),
            });
            const resData = await res.json();
            if (res.status === 423) {
              showAlert("error", resData.error || "Perdiste el control de asignación. Recargando...");
              setTimeout(() => window.location.reload(), 1500);
              return;
            }
            if (res.ok) {
              await fetchDisponibilidad();
            } else {
              showAlert("error", resData.error || "No se pudo levantar la excepción");
            }
          } catch (err) {
            console.error(err);
          } finally {
            liftBtn.removeAttribute("disabled");
          }
        }
        return;
      }

      // 2.5 Deshacer assign
      const btnUndoEl = target.closest("#btn-undo");
      if (btnUndoEl && !btnUndoEl.hasAttribute("disabled")) {
        btnUndoEl.setAttribute("disabled", "true");
        try {
          const res = await fetch("/api/disponibilidad/deshacer", {
            method: "POST",
            headers: { "Content-Type": "application/json" }
          });
          const resData = await res.json();
          if (res.status === 423) {
            showAlert("error", resData.error || "Perdiste el control de asignación. Recargando...");
            setTimeout(() => window.location.reload(), 1500);
            return;
          }
          if (res.ok && resData.success) {
            showAlert("success", `Asignación de ${resData.agentName} deshecha.`);
            await fetchDisponibilidad();
          } else {
            showAlert("error", resData.error || "No se pudo deshacer la asignación.");
          }
        } catch (err: any) {
          console.error(err);
          showAlert("error", `Ocurrió un error al deshacer: ${err.message || err}`);
        }
        return;
      }

      // 3. Cyclic assign
      const assignCyclicBtn = target.closest("#btn-assign-cyclic");
      if (assignCyclicBtn) {
        assignCyclicBtn.setAttribute("disabled", "true");
        // Micro-animación: desvanecer hacia la izquierda el primer operador en cola
        const firstQueueItem = document.querySelector("#queue-container > [data-agent-id]:first-child") as HTMLElement | null;
        if (firstQueueItem) {
          firstQueueItem.style.transition = "all 0.3s ease-in-out";
          firstQueueItem.style.transform = "translateX(-24px)";
          firstQueueItem.style.opacity = "0";
        }
        try {
          const res = await fetch("/api/disponibilidad/asignar", {
            method: "POST",
            headers: { "Content-Type": "application/json" }
          });
          const data = await res.json();
          if (res.status === 423) {
            showAlert("error", data.error || "Perdiste el control de asignación. Recargando...");
            setTimeout(() => window.location.reload(), 1500);
            return;
          }
          if (res.ok && data.success && data.agent) {
            showAlert("success", `Autogestión asignada cíclicamente a ${data.agent.nombre || data.agent.name}.`);
            await fetchDisponibilidad();
          } else {
            showAlert("error", data.error || "No hay operadores disponibles o dentro de horario operativo para asignar.");
            if (firstQueueItem) {
              firstQueueItem.style.transform = "";
              firstQueueItem.style.opacity = "";
            }
          }
        } catch (err: any) {
          console.error(err);
          showAlert("error", `Ocurrió un error al procesar la asignación cíclica: ${err.message || err}`);
          if (firstQueueItem) {
            firstQueueItem.style.transform = "";
            firstQueueItem.style.opacity = "";
          }
        } finally {
          assignCyclicBtn.removeAttribute("disabled");
        }
        return;
      }

      // 4. Manual assign
      const assignManualBtn = target.closest("[data-op-assign-btn]");
      if (assignManualBtn && !assignManualBtn.hasAttribute("disabled") && !(assignManualBtn as HTMLButtonElement).disabled) {
        const agentId = Number(assignManualBtn.getAttribute("data-op-assign-btn"));
        if (!isNaN(agentId)) {
          assignManualBtn.setAttribute("disabled", "true");
          try {
            const res = await fetch("/api/disponibilidad/asignar-manual", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ agentId }),
            });
            const data = await res.json();
            if (res.status === 423) {
              showAlert("error", data.error || "Perdiste el control de asignación. Recargando...");
              setTimeout(() => window.location.reload(), 1500);
              return;
            }
            if (res.ok && data.success) {
              const modalTicket = document.getElementById("modal-ticket-detail") as HTMLDialogElement | null;
              if (modalTicket && modalTicket.open) {
                modalTicket.close();
              }
              const tNumStr = data.ticketNumber ? ` ${data.ticketNumber}` : "";
              showAlert("success", `Autogestión${tNumStr} asignada manualmente a ${data.agentName || `ID ${agentId}`}.`);
              await fetchDisponibilidad();
            } else {
              showAlert("error", data.error || "No se pudo realizar la asignación manual.");
            }
          } catch (err: any) {
            console.error(err);
            showAlert("error", `Ocurrió un error al procesar la asignación manual: ${err.message || err}`);
          } finally {
            assignManualBtn.removeAttribute("disabled");
          }
        }
        return;
      }
    });

    // Fetch unassigned tickets for Helpdesk 3866
    const fetchUnassignedTickets = async () => {
      try {
        const res = await fetch("/api/invgate/unassigned-tickets?helpdesk_id=3866");
        if (!res.ok) return;
        const data = await res.json();
        latestUnassignedTickets = data.tickets || [];
        const countEl = document.getElementById("stat-unassigned-count");
        const listEl = document.getElementById("unassigned-tickets-list");
        const count = data.count ?? 0;

        const btnAssignCyclic = document.getElementById("btn-assign-cyclic") as HTMLButtonElement | null;
        if (btnAssignCyclic) {
          const lockIndicator = document.getElementById("lock-indicator");
          const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
          const clientIsReadOnly = !clientHasLock;
          const isDisabled = clientIsReadOnly || count === 0;

          if (isDisabled) {
            btnAssignCyclic.setAttribute("disabled", "true");
            btnAssignCyclic.className = "btn btn-md flex items-center justify-center gap-2 font-bold uppercase tracking-wider shrink-0 w-full sm:w-auto px-6 transition-all btn-neutral btn-disabled opacity-50 cursor-not-allowed";
            btnAssignCyclic.title = count === 0 ? "No hay autogestiones sin asignar para entregar" : "Tomá el control para habilitar la asignación";
          } else {
            btnAssignCyclic.removeAttribute("disabled");
            btnAssignCyclic.className = "btn btn-md flex items-center justify-center gap-2 font-bold uppercase tracking-wider shrink-0 w-full sm:w-auto px-6 transition-all btn-primary shadow-lg shadow-primary/20";
            btnAssignCyclic.title = "Asignar siguiente autogestión";
          }
        }

        if (countEl) {
          countEl.textContent = String(count);
          countEl.className = `badge ${count > 0 ? "badge-warning text-warning-content" : "badge-neutral"} font-mono font-bold text-xs`;
        }
        if (listEl) {
          if (data.tickets && data.tickets.length > 0) {
            const PRIORITY_MAP: Record<number, { label: string; badgeClass: string }> = {
              1: { label: "Baja", badgeClass: "bg-base-200 text-base-content/60 border-none font-medium" },
              2: { label: "Media", badgeClass: "bg-info/15 text-info border-none font-medium" },
              3: { label: "Alta", badgeClass: "bg-warning/15 text-warning border-none font-semibold" },
              4: { label: "Urgente", badgeClass: "bg-warning/20 text-warning border-none font-bold" },
              5: { label: "Crítica", badgeClass: "bg-error/15 text-error border-none font-bold" },
            };

            listEl.innerHTML = data.tickets.map((t: any) => {
              const timeStr = t.created_at ? new Date(t.created_at * 1000).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" }) : "";
              
              // Calculate elapsed waiting time
              let waitingBadge = "";
              if (t.created_at) {
                const elapsedMin = Math.floor((Date.now() - t.created_at * 1000) / 60000);
                let colorClass = "bg-base-200 text-base-content/70 border-none";
                if (elapsedMin >= 60) {
                  colorClass = "bg-error/15 text-error border-none font-bold";
                } else if (elapsedMin >= 30) {
                  colorClass = "bg-warning/15 text-warning border-none font-semibold";
                }
                const formatWait = elapsedMin >= 60 
                  ? `${Math.floor(elapsedMin / 60)}h ${elapsedMin % 60}m` 
                  : `${elapsedMin}m`;
                waitingBadge = `<span class="badge badge-xs font-mono text-tiny px-1.5 py-0.5 shrink-0 ${colorClass}" title="Tiempo de espera en cola">⏱ ${formatWait}</span>`;
              }

              // SLA first reply badge
              let slaBadge = "";
              if (t.sla_incident_first_reply) {
                slaBadge = `<span class="badge badge-outline badge-info badge-xs font-mono text-tiny shrink-0" title="SLA de respuesta">SLA: ${escapeHtml(t.sla_incident_first_reply)}</span>`;
              }

              const prioInfo = PRIORITY_MAP[t.priority_id] || (t.priority_id ? { label: `P${t.priority_id}`, badgeClass: "badge-neutral" } : null);
              const prioBadge = prioInfo
                ? `<span class="badge badge-xs font-bold text-tiny tracking-wider uppercase shrink-0 ${prioInfo.badgeClass}">${escapeHtml(prioInfo.label)}</span>`
                : "";
              const catBadge = t.category_last_name
                ? `<span class="badge badge-neutral badge-xs font-semibold text-tiny tracking-tight max-w-[130px] truncate shrink-0" title="${escapeHtml(t.category_name || t.category_last_name)}">${escapeHtml(t.category_last_name)}</span>`
                : "";

              // Check if creator matches any available operator
              const creatorUsername = (t.creator_username || "").toLowerCase().trim();
              const creatorNameNorm = (t.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

              const matchingAvailableOp = latestDisponibilidadData.find((op) => {
                if (!op.disponible) return false;
                if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
                if (op.nombre && creatorNameNorm) {
                  const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
                  if (opNameNorm === creatorNameNorm) return true;
                  const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
                  if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
                }
                return false;
              });

              const creatorStr = t.creator_name || t.customer_name || "";
              const customerStr = t.customer_name && t.creator_name && t.customer_name !== t.creator_name ? t.customer_name : "";

              let userRow = "";
              if (creatorStr) {
                if (matchingAvailableOp) {
                  const lockIndicator = document.getElementById("lock-indicator");
                  const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
                  const clientIsReadOnly = !clientHasLock;

                  const btnClass = clientIsReadOnly
                    ? "btn btn-ghost btn-xs btn-disabled opacity-40 cursor-not-allowed text-base-content/40 px-1.5 py-0 h-5 min-h-0 font-bold shrink-0 gap-1"
                    : "btn btn-ghost btn-xs text-success hover:bg-success/15 px-1.5 py-0 h-5 min-h-0 font-bold shrink-0 gap-1";

                  const btnTitle = clientIsReadOnly
                    ? "Toma el control para asignar autogestiones"
                    : `Asignar a ${escapeHtml(matchingAvailableOp.nombre)}`;

                  const btnDisabledAttr = clientIsReadOnly ? 'disabled="true"' : "";
                  const iconClass = clientIsReadOnly ? "text-base-content/40 fill-current" : "text-success fill-current";

                  userRow = `
                    <div class="flex items-center justify-between gap-1 text-tiny font-medium truncate mt-1">
                      <div class="flex items-center gap-1 min-w-0 truncate text-base-content/70">
                        <svg class="size-3 text-success shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <span class="truncate">
                          Generado por: <strong class="text-success font-bold">${escapeHtml(creatorStr)}</strong> <span class="text-success text-xxs font-semibold">(Disponible)</span>${customerStr ? ` <span class="opacity-75">• Cliente: <strong class="text-base-content/80 font-semibold">${escapeHtml(customerStr)}</strong></span>` : ''}
                        </span>
                      </div>
                      <button
                        type="button"
                        class="${btnClass}"
                        data-op-assign-btn="${matchingAvailableOp.agentId}"
                        title="${btnTitle}"
                        ${btnDisabledAttr}
                      >
                        <svg class="size-3 ${iconClass}" viewBox="0 0 24 24"><path d="M12 2 3.5 13h7L9 22l11.5-11h-7z"/></svg>
                        <span>Asignar</span>
                      </button>
                    </div>
                  `;
                } else {
                  userRow = `<div class="flex items-center gap-1 text-tiny text-base-content/60 font-medium truncate mt-1"><svg class="size-3 opacity-60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg><span class="truncate">Generado por: <strong class="text-base-content/80 font-bold">${escapeHtml(creatorStr)}</strong>${customerStr ? ` <span class="opacity-75">• Cliente: <strong class="text-base-content/80 font-semibold">${escapeHtml(customerStr)}</strong></span>` : ''}</span></div>`;
                }
              }

              const locationRow = t.location_name
                ? `<div class="flex items-center gap-1 text-tiny text-base-content/60 font-medium truncate"><svg class="size-3 text-info opacity-70 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg><span class="truncate">Ubicación: <strong class="text-base-content/80 font-semibold">${escapeHtml(t.location_name)}</strong></span></div>`
                : "";

              return `
                <div data-ticket-id="${t.id}" class="p-3.5 hover:bg-base-200/60 transition-colors duration-150 flex flex-col gap-1.5 cursor-pointer group">
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 min-w-0 flex-wrap">
                      <span class="font-mono font-bold text-primary-content bg-primary px-2 py-0.5 rounded-md text-xs shrink-0">${escapeHtml(t.pretty_id || '#' + t.id)}</span>
                      ${waitingBadge}
                      ${prioBadge}
                      ${catBadge}
                      ${slaBadge}
                    </div>
                    <span class="text-xs text-base-content/60 font-mono font-semibold shrink-0">${timeStr}</span>
                  </div>
                  <div class="font-semibold text-base-content text-xs group-hover:text-primary transition-colors" title="${escapeHtml(t.title)}">${escapeHtml(t.title)}</div>
                  ${userRow}
                  ${locationRow}
                </div>
              `;
            }).join("");
          } else {
            listEl.innerHTML = '<div class="text-xs text-base-content/40 italic py-12 text-center">No hay tickets sin asignar</div>';
          }
        }
      } catch (err) {
        console.error("Error fetching unassigned tickets:", err);
      }
    };

    // Fetch availability data
    const fetchDisponibilidad = async () => {
      if (refreshIcon) refreshIcon.classList.add("animate-spin");
      if (btnRefresh) btnRefresh.disabled = true;

      try {
        const res = await fetch("/api/disponibilidad");
        if (!res.ok) throw new Error("Error fetching availability");
        const data = await res.json();

        updateUI(data);
        await fetchUnassignedTickets();

        secondsSinceSync = 0;
        updateIndicatorText();
      } catch (error) {
        console.error("Failed to sync availability data:", error);
      } finally {
        if (refreshIcon) refreshIcon.classList.remove("animate-spin");
        if (btnRefresh) btnRefresh.disabled = false;
      }
    };

    // Fetch lock status
    const fetchLockStatus = async () => {
      try {
        const res = await fetch("/api/disponibilidad/lock");
        if (!res.ok) throw new Error("Error fetching lock status");
        return await res.json();
      } catch (error) {
        console.error("Failed to fetch lock status:", error);
        return null;
      }
    };

    // Dynamic lock banner UI update
    const updateLockBanner = (lockStatus: any) => {
      if (!lockStatus) return;
      currentLockStatus = lockStatus;

      const indicator = document.getElementById("lock-indicator");
      if (!indicator) return;

      const currentUserId = Number(indicator.getAttribute("data-user-id"));
      const bannerTimeoutAttr = Number(indicator.getAttribute("data-lock-timeout")) || 600000;

      let hasLock = false;
      let lockHolderName = null;
      let lockReleaseRequested = false;

      if (lockStatus.status === "occupied") {
        hasLock = lockStatus.user?.userId === currentUserId;
        lockHolderName = lockStatus.user?.username;
        lockReleaseRequested = lockStatus.user?.releaseRequested;

        lockTimeoutMs = lockReleaseRequested ? 60000 : bannerTimeoutAttr;
        lockExpiresAt = lockStatus.user.lastActivityAt + lockTimeoutMs;
        startCountdown();
      } else {
        stopCountdown();
      }

      if (hasLock) {
        indicator.setAttribute("data-has-lock", "true");
      } else {
        indicator.removeAttribute("data-has-lock");
      }

      let dotColor = "bg-base-content/30";
      let statusText = "Sin asignador";
      let showTimer = false;
      let timerMs = 0;
      let buttonsHtml = "";

      if (lockStatus.status === "free") {
        dotColor = "bg-base-content/30";
        statusText = "Sin asignador";
        buttonsHtml = `<button type="button" id="btn-acquire-lock" class="btn btn-primary btn-xs font-bold uppercase tracking-wider shadow-sm">Tomar control</button>`;
      } else if (lockStatus.status === "expired") {
        dotColor = "bg-neutral/50";
        statusText = `Expirado: ${escapeHtml(lockHolderName)}`;
        buttonsHtml = `<button type="button" id="btn-acquire-lock" class="btn btn-primary btn-xs font-bold uppercase tracking-wider shadow-sm">Tomar control</button>`;
      } else if (lockStatus.status === "occupied") {
        showTimer = true;
        timerMs = lockExpiresAt - Date.now();
        if (hasLock) {
          dotColor = "bg-success";
          statusText = "En control";
          
          let rejectBtn = "";
          if (lockReleaseRequested) {
            rejectBtn = `<button type="button" id="btn-reject-release" class="btn btn-success btn-ghost btn-xs font-bold uppercase tracking-wider">Rechazar</button>`;
          }
          buttonsHtml = `
            ${rejectBtn}
            <button type="button" id="btn-release-lock" class="btn btn-ghost btn-xs font-bold uppercase tracking-wider text-error">Liberar</button>
          `;
        } else {
          dotColor = "bg-warning";
          statusText = `Ocupado: ${escapeHtml(lockHolderName)}`;
          buttonsHtml = `
            <button type="button" id="btn-request-release" class="btn btn-ghost btn-xs font-bold uppercase tracking-wider text-warning" ${lockReleaseRequested ? 'disabled' : ''}>
              ${lockReleaseRequested ? 'Solicitado' : 'Pedir liberación'}
            </button>
          `;
        }
      }

      let timerHtml = "";
      if (showTimer) {
        const initialCountdown = timerMs > 0 ? formatCountdown(timerMs) : "0:00";
        const isCritical = timerMs > 0 && timerMs < 60000;
        const badgeClass = isCritical ? "bg-error/70 text-error-content" : "bg-base-100/30";
        timerHtml = `<span id="lock-countdown" class="badge badge-xs tabular-nums font-mono border-0 ${badgeClass}">${initialCountdown}</span>`;
      }

      indicator.innerHTML = `
        <span class="size-2 rounded-full ${dotColor}"></span>
        <span>${statusText}</span>
        ${timerHtml}
        <div class="flex items-center gap-1.5 ml-1">
          ${buttonsHtml}
        </div>
      `;

      if (hasLock) {
        startHeartbeat();
      } else {
        stopHeartbeat();
      }
    };

    // Click handler for manual refresh
    if (btnRefresh) {
      btnRefresh.addEventListener("click", async () => {
        await Promise.all([
          fetchDisponibilidad(),
          fetchLockStatus().then(updateLockBanner)
        ]);
      });
    }

    // Click handler for history modal
    const btnOpenHistorial = document.getElementById("btn-open-historial-modal");
    if (btnOpenHistorial) {
      btnOpenHistorial.addEventListener("click", async () => {
        const modal = document.getElementById("modal-historial-asignaciones") as HTMLDialogElement | null;
        const loadingEl = document.getElementById("historial-loading");
        const emptyEl = document.getElementById("historial-empty");
        const tableContainer = document.getElementById("historial-table-container");
        const rowsEl = document.getElementById("historial-rows");

        if (modal) {
          if (loadingEl) loadingEl.classList.remove("hidden");
          if (emptyEl) emptyEl.classList.add("hidden");
          if (tableContainer) tableContainer.classList.add("hidden");
          modal.showModal();

          const TYPE_MAP: Record<string, { label: string; badgeClass: string }> = {
            cyclic: { label: "Cíclica", badgeClass: "badge-primary text-primary-content font-bold" },
            manual: { label: "Manual", badgeClass: "badge-info text-info-content font-bold" },
            undo: { label: "Deshecha", badgeClass: "badge-warning text-warning-content font-bold" },
          };

          try {
            const res = await fetch("/api/disponibilidad/historial");
            const data = await res.json();
            if (loadingEl) loadingEl.classList.add("hidden");

            if (res.ok && data.history && data.history.length > 0) {
              if (tableContainer) tableContainer.classList.remove("hidden");
              if (rowsEl) {
                rowsEl.innerHTML = data.history.map((item: any) => {
                  const dateStr = item.assignedAt ? new Date(item.assignedAt).toLocaleString("es-AR", { dateStyle: "short", timeStyle: "medium" }) : "-";
                  const typeInfo = TYPE_MAP[item.type] || { label: item.type || "Asignación", badgeClass: "badge-neutral" };
                  const ticketBadge = item.ticketNumber
                    ? `<span class="badge badge-primary badge-xs font-mono font-bold px-1.5 py-0.5">${escapeHtml(item.ticketNumber)}</span>`
                    : `<span class="text-base-content/40 font-mono text-tiny">-</span>`;

                  return `
                    <tr class="hover:bg-base-200/50">
                      <td class="font-mono text-tiny font-semibold text-base-content/70">${escapeHtml(dateStr)}</td>
                      <td class="font-bold text-xs text-base-content">${escapeHtml(item.agentName)}</td>
                      <td>${ticketBadge}</td>
                      <td><span class="badge badge-xs ${typeInfo.badgeClass} text-tiny">${escapeHtml(typeInfo.label)}</span></td>
                      <td class="font-medium text-xs text-base-content/80">${escapeHtml(item.assignedBy || "Sistema")}</td>
                    </tr>
                  `;
                }).join("");
              }
            } else {
              if (emptyEl) emptyEl.classList.remove("hidden");
            }
          } catch (err) {
            console.error("Error fetching assignment history:", err);
            if (loadingEl) loadingEl.classList.add("hidden");
            if (emptyEl) {
              emptyEl.textContent = "Ocurrió un error al cargar el historial.";
              emptyEl.classList.remove("hidden");
            }
          }
        }
      });
    }

    // Set up 10-second polling interval
    polling = setInterval(async () => {
      await Promise.all([
        fetchDisponibilidad(),
        fetchLockStatus().then(updateLockBanner)
      ]);
    }, 10000);

    // Close dropdowns on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        document.querySelectorAll(".dropdown.dropdown-open").forEach((d) => {
          d.classList.remove("dropdown-open");
        });
      }
    });

    // Lock heartbeat cada 2 minutos
    const LOCK_HEARTBEAT_MS = 2 * 60 * 1000;

    const startHeartbeat = () => {
      if (heartbeatInterval) clearInterval(heartbeatInterval);
      heartbeatInterval = setInterval(async () => {
        try {
          const res = await fetch("/api/disponibilidad/lock/heartbeat", { method: "POST" });
          if (res.ok) {
            lockExpiresAt = Date.now() + lockTimeoutMs;
          } else {
            console.warn("Heartbeat failed, lock might have been lost");
          }
        } catch (err) {
          console.error("Heartbeat error:", err);
        }
      }, LOCK_HEARTBEAT_MS);
    };

    const stopHeartbeat = () => {
      if (heartbeatInterval) {
        clearInterval(heartbeatInterval);
        heartbeatInterval = null;
      }
    };

    // Event delegation on #lock-indicator
    const bannerEl = document.getElementById("lock-indicator");
    if (bannerEl) {
      bannerEl.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;

        // Acquire lock
        const acquireLockBtn = target.closest("#btn-acquire-lock") as HTMLButtonElement | null;
        if (acquireLockBtn) {
          acquireLockBtn.setAttribute("disabled", "true");
          acquireLockBtn.innerText = "Adquiriendo...";
          try {
            const res = await fetch("/api/disponibilidad/lock", { method: "POST" });
            if (res.ok) {
              window.location.reload();
            } else {
              const data = await res.json();
              showAlert("error", data.error || "No se pudo adquirir el control");
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            }
          } catch (err: any) {
            showAlert("error", "Error al adquirir el control");
            const lockStatus = await fetchLockStatus();
            if (lockStatus) updateLockBanner(lockStatus);
          }
          return;
        }

        // Reject release
        const rejectReleaseBtn = target.closest("#btn-reject-release") as HTMLButtonElement | null;
        if (rejectReleaseBtn) {
          rejectReleaseBtn.setAttribute("disabled", "true");
          rejectReleaseBtn.innerText = "Rechazando...";
          try {
            const res = await fetch("/api/disponibilidad/lock/reject-release", { method: "POST" });
            if (res.ok) {
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
              showToast("Solicitud de liberación rechazada", "alert-success");
            } else {
              const data = await res.json();
              showToast(data.error || "Error al rechazar", "alert-error");
            }
          } catch {
            showToast("Error al rechazar liberación", "alert-error");
          }
          rejectReleaseBtn.removeAttribute("disabled");
          rejectReleaseBtn.innerText = "Rechazar liberación";
          return;
        }

        // Release lock
        const releaseLockBtn = target.closest("#btn-release-lock") as HTMLButtonElement | null;
        if (releaseLockBtn) {
          releaseLockBtn.setAttribute("disabled", "true");
          try {
            const res = await fetch("/api/disponibilidad/lock", { method: "DELETE" });
            if (res.ok) {
              window.location.reload();
            } else {
              const data = await res.json();
              showAlert("error", data.error || "No se pudo liberar el control");
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            }
          } catch (err: any) {
            showAlert("error", "Error al liberar el control");
            const lockStatus = await fetchLockStatus();
            if (lockStatus) updateLockBanner(lockStatus);
          }
          return;
        }

        // Request release
        const requestReleaseBtn = target.closest("#btn-request-release") as HTMLButtonElement | null;
        if (requestReleaseBtn) {
          requestReleaseBtn.setAttribute("disabled", "true");
          requestReleaseBtn.innerText = "Enviando...";
          try {
            const res = await fetch("/api/disponibilidad/lock/request-release", { method: "POST" });
            if (res.ok) {
              requestReleaseBtn.innerText = "Solicitud enviada";
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            } else {
              showAlert("error", "No se pudo enviar la solicitud");
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            }
          } catch (err: any) {
            showAlert("error", "Error al solicitar liberación");
            const lockStatus = await fetchLockStatus();
            if (lockStatus) updateLockBanner(lockStatus);
          }
          return;
        }
      });
    }

    // Initial fetch of lock status immediately
    fetchLockStatus().then(updateLockBanner);

    // Release lock on page unload using fetch with keepalive: true
    window.addEventListener("beforeunload", () => {
      const indicator = document.getElementById("lock-indicator");
      if (indicator && indicator.getAttribute("data-has-lock") === "true") {
        fetch("/api/disponibilidad/lock", { method: "DELETE", keepalive: true });
      }
    });

    // Run first UI update visibility check
    updateVisibility();

    return true;
  };

  // Wait for dynamic server island component initialization
  if (!init()) {
    checkReady = setInterval(() => {
      if (init()) {
        clearInterval(checkReady);
      }
    }, 50);
  }

  document.addEventListener("astro:before-swap", () => {
    if (countdownInterval) clearInterval(countdownInterval);
    if (timer) clearInterval(timer);
    if (polling) clearInterval(polling);
    if (heartbeatInterval) clearInterval(heartbeatInterval);
    if (checkReady) clearInterval(checkReady);
  });
</script>

<style is:global>
  [data-queue-item] {
    position: absolute;
    transition: top 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease-out;
  }
</style>
