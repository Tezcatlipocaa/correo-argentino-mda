<script>
  import { showToast } from "@/lib/toastClient";
  import { escapeHtml } from "@lib/sanitize";

  let countdownInterval: any = null;
  let timer: any = null;
  let polling: any = null;
  let heartbeatInterval: any = null;
  let checkReady: any = null;

  const init = () => {
    const toggle = document.getElementById(
      "toggle-disponibles",
    ) as HTMLInputElement | null;
    if (!toggle) return false;

    // Tab switching listener
    const tabBtns = document.querySelectorAll("[data-tab-target]");
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-tab-target");

        tabBtns.forEach((b) => {
          b.classList.remove("tab-active", "bg-primary", "text-primary-content", "shadow-sm");
          b.classList.add("text-base-content/70", "hover:text-base-content");
        });
        btn.classList.add("tab-active", "bg-primary", "text-primary-content", "shadow-sm");
        btn.classList.remove("text-base-content/70", "hover:text-base-content");

        const isAsignacion = targetId === "panel-asignacion";
        document.getElementById("panel-asignacion")?.classList.toggle("hidden", !isAsignacion);
        document.getElementById("panel-monitoreo")?.classList.toggle("hidden", isAsignacion);

        const url = new URL(window.location.href);
        url.searchParams.set("tab", isAsignacion ? "asignacion" : "monitoreo");
        window.history.replaceState({}, "", url.toString());
      });
    });

    const syncIndicator = document.getElementById("sync-indicator");
    const refreshIcon = document.getElementById("refresh-icon");
    const btnRefresh = document.getElementById(
      "btn-refresh",
    ) as HTMLButtonElement | null;
    const modalEl = document.getElementById(
      "modal-marcar-excepcion",
    ) as HTMLDialogElement | null;

    if (modalEl) {
      modalEl.addEventListener("close", () => {
        document.body.classList.remove("overflow-hidden");
        document.documentElement.classList.remove("overflow-hidden");
      });
    }

    const selectTipo = document.getElementById(
      "modal-select-tipo",
    ) as HTMLSelectElement | null;
    const containerTiempoExtra = document.getElementById(
      "container-tiempo-extra",
    );
    if (selectTipo && containerTiempoExtra) {
      selectTipo.addEventListener("change", () => {
        if (selectTipo.value === "break_extendido") {
          containerTiempoExtra.classList.remove("hidden");
        } else {
          containerTiempoExtra.classList.add("hidden");
        }
      });
    }

    let secondsSinceSync = 0;
    let lockExpiresAt = 0;
    let lockTimeoutMs = 300000;
    let currentLockStatus: any = null;
    let latestUnassignedTickets: any[] = [];
    let latestDisponibilidadData: any[] = [];

    const rawTicketsEl = document.getElementById("initial-unassigned-data");
    if (rawTicketsEl && rawTicketsEl.textContent) {
      try {
        latestUnassignedTickets = JSON.parse(rawTicketsEl.textContent);
      } catch {}
    }
    const rawOpsEl = document.getElementById("initial-disponibilidad-data");
    if (rawOpsEl && rawOpsEl.textContent) {
      try {
        latestDisponibilidadData = JSON.parse(rawOpsEl.textContent);
      } catch {}
    }

    const formatCountdown = (ms: number): string => {
      if (ms <= 0) return "0:00";
      const totalSeconds = Math.floor(ms / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      return `${minutes}:${seconds.toString().padStart(2, "0")}`;
    };

    const stopCountdown = () => {
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
      }
    };

    const startCountdown = () => {
      stopCountdown();

      const tick = () => {
        const remaining = lockExpiresAt - Date.now();
        const countdownEl = document.getElementById("lock-countdown");
        if (remaining <= 0) {
          if (countdownEl) {
            countdownEl.innerText = "0:00";
          }
          stopCountdown();
          fetchLockStatus().then(updateLockBanner);
          return;
        }
        if (countdownEl) {
          countdownEl.innerText = formatCountdown(remaining);
          if (remaining < 60000) {
            countdownEl.classList.remove("bg-base-100/30");
            countdownEl.classList.add("bg-error/70", "text-error-content");
          } else {
            countdownEl.classList.add("bg-base-100/30");
            countdownEl.classList.remove("bg-error/70", "text-error-content");
          }
        }
      };

      tick();
      countdownInterval = setInterval(tick, 1000);
    };

    const updateIndicatorText = () => {
      if (!syncIndicator) return;
      if (secondsSinceSync === 0) {
        syncIndicator.innerText = "Actualizado hace unos instantes";
      } else {
        syncIndicator.innerText = `Actualizado hace ${secondsSinceSync}s`;
      }
    };

    // Increment elapsed seconds since last successful API call
    timer = setInterval(() => {
      secondsSinceSync++;
      updateIndicatorText();
    }, 1000);

    const updateVisibility = () => {
      const soloDisponibles = toggle.checked;
      const rows = document.querySelectorAll<HTMLElement>("[data-op-id]");
      rows.forEach((row) => {
        const estado = row.getAttribute("data-op-estado") || "";
        if (soloDisponibles && estado !== "disponible") {
          row.classList.add("hidden");
        } else {
          row.classList.remove("hidden");
        }
      });
    };

    toggle.addEventListener("change", updateVisibility);

    // Dynamic UI Update from API Response
    const updateUI = (data: any[]) => {
      latestDisponibilidadData = data || [];
      // Update Undo button state
      const opWithUndo = data.find(op => op.lastAutogestionUndo !== null && op.lastAutogestionUndo !== undefined);
      const btnUndo = document.getElementById("btn-undo") as HTMLButtonElement | null;
      const btnUndoText = document.getElementById("btn-undo-text") as HTMLElement | null;
      if (btnUndo && btnUndoText) {
        if (opWithUndo) {
          btnUndo.disabled = false;
          btnUndoText.innerText = `Deshacer: ${opWithUndo.nombre}`;
        } else {
          btnUndo.disabled = true;
          btnUndoText.innerText = "Deshacer";
        }
      }

      // 1. Calculate highlights (the one with the latest assignment)
      let maxAssignedTime = 0;
      let maxAgentId: number | null = null;
      data.forEach((op) => {
        if (
          op.lastAutogestionAssignedAt &&
          op.lastAutogestionAssignedAt > maxAssignedTime
        ) {
          maxAssignedTime = op.lastAutogestionAssignedAt;
          maxAgentId = op.agentId;
        }
      });

      // 2. Update summary cards
      const disponiblesCount = data.filter((op) => op.disponible).length;
      const totalCount = data.length || 1;
      const pct = Math.round((disponiblesCount / totalCount) * 100);

      const statDisponibles = document.getElementById("stat-disponibles-count");
      if (statDisponibles)
        statDisponibles.innerText = disponiblesCount.toString();

      const statNoDisponibles = document.getElementById(
        "stat-no-disponibles-count",
      );
      if (statNoDisponibles)
        statNoDisponibles.innerText = (
          data.length - disponiblesCount
        ).toString();

      const statPercentage = document.getElementById("stat-percentage");
      if (statPercentage) statPercentage.innerText = `${pct}%`;

      const statProgress = document.getElementById(
        "stat-progress",
      ) as HTMLProgressElement | null;
      if (statProgress) {
        statProgress.value = disponiblesCount;
        statProgress.max = totalCount;
      }

      // 3. Update breakdown counts
      const breakdown = {
        "En break": 0,
        "Fuera de horario": 0,
        Franco: 0,
        Licencia: 0,
        Vacaciones: 0,
        Excepción: 0,
      };

      data.forEach((op) => {
        if (!op.disponible) {
          const mot = op.motivo || "Franco";
          if (
            [
              "Devolución Supervisor",
              "Break Extendido",
              "Problema Técnico",
            ].includes(mot)
          ) {
            breakdown["Excepción"]++;
          } else if (mot in breakdown) {
            breakdown[mot as keyof typeof breakdown]++;
          }
        }
      });

      for (const [status, count] of Object.entries(breakdown)) {
        const el = document.querySelector(
          `[data-breakdown-count="${status}"]`,
        ) as HTMLElement | null;
        if (el) {
          el.textContent = count.toString();
          const container = el.closest("[data-breakdown-container]");
          if (container) {
            container.setAttribute("data-count", count.toString());
            if (count === 0) {
              container.classList.add("opacity-40");
            } else {
              container.classList.remove("opacity-40");
            }
          }
        }
      }

      // 3b. Update last assigned card and suggested card
      let maxAssignedTimeForCard = 0;
      let lastAssignedOp: any = null;
      for (const op of data) {
        if (
          op.lastAutogestionAssignedAt &&
          op.lastAutogestionAssignedAt > maxAssignedTimeForCard
        ) {
          maxAssignedTimeForCard = op.lastAutogestionAssignedAt;
          lastAssignedOp = op;
        }
      }

      const lastAssignedContainer = document.getElementById("stat-last-assigned-container");
      if (lastAssignedContainer) {
        if (lastAssignedOp && maxAssignedTimeForCard > 0) {
          const timeStr = new Date(maxAssignedTimeForCard).toLocaleTimeString("es-AR", {
            hour: "2-digit",
            minute: "2-digit",
          });
          lastAssignedContainer.innerHTML = `
            <div class="text-xs flex flex-wrap items-center justify-between gap-2 bg-base-100 p-3 rounded-xl border border-base-300/60">
              <div class="flex items-center gap-4">
                <span class="text-base-content/70">
                  De: <strong class="text-info" id="stat-last-assigned-by">${escapeHtml(lastAssignedOp.lastAutogestionAssignedBy || "Sistema")}</strong>
                </span>
                <span class="text-base-content/70">
                  Para: <strong class="text-base-content" id="stat-last-assigned-to">${escapeHtml(lastAssignedOp.nombre)}</strong>
                </span>
              </div>
              <span class="text-xxs text-base-content/50 font-mono" id="stat-last-assigned-time">
                Hora: ${timeStr}
              </span>
            </div>
          `;
        } else {
          lastAssignedContainer.innerHTML = `<span class="text-xs text-base-content/40 italic py-1">Sin asignaciones hoy</span>`;
        }
      }

      const updateQueueUI = (data: any[]) => {
        const queueContainer = document.getElementById("queue-container");
        if (!queueContainer) return;

        const available = data.filter((op) => op.disponible);
        const sortedQueue = [...available].sort((a, b) => {
          const tA = a.lastAutogestionAssignedAt ?? 0;
          const tB = b.lastAutogestionAssignedAt ?? 0;
          if (a.lastAutogestionAssignedAt === null && b.lastAutogestionAssignedAt !== null) return -1;
          if (a.lastAutogestionAssignedAt !== null && b.lastAutogestionAssignedAt === null) return 1;
          return tA - tB;
        }).slice(0, 10);

        const getInitialsJs = (name: string) => {
          if (!name) return "OP";
          const parts = name.trim().split(/\s+/);
          if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
          return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        };

        if (sortedQueue.length > 0) {
          queueContainer.innerHTML = sortedQueue.map((op, idx) => {
            const isFirst = idx === 0;
            const avatarBg = isFirst ? "bg-primary text-primary-content shadow-xs" : "bg-base-300 text-base-content/70";
            const containerClass = isFirst ? "bg-primary/5" : "";
            const titleClass = isFirst ? "text-base-content font-black" : "text-base-content/85";

            const projTicket = latestUnassignedTickets[idx];
            const projBadge = projTicket
              ? `<div class="badge badge-warning/15 border border-warning/30 text-warning-content font-mono font-bold text-xs px-2.5 py-1 flex items-center gap-1 shrink-0 cursor-help" title="Si se asigna en orden, recibirá: ${escapeHtml(projTicket.title)}"><span class="text-warning font-sans font-bold">↳</span><span>${escapeHtml(projTicket.pretty_id || '#' + projTicket.id)}</span></div>`
              : "";

            const statusText = op.disponible ? "Disponible" : (op.motivo || "No disponible");
            const statusBadgeClass = op.disponible ? "badge-success/15 text-success border border-success/30" : "badge-neutral opacity-70";

            const breakStr = op.breakInicioHoy && op.breakFinHoy
              ? `<span class="flex items-center gap-1 font-mono text-base-content/75"><svg class="size-3.5 text-warning opacity-70 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg><span>Break: ${escapeHtml(op.breakInicioHoy)} - ${escapeHtml(op.breakFinHoy)}</span></span>`
              : "";

            return `
              <div data-agent-id="${op.agentId}" class="flex items-center justify-between gap-3.5 p-3.5 transition-colors hover:bg-base-200/60 cursor-default min-w-[360px] sm:min-w-0 ${containerClass}">
                <div class="flex items-center gap-3.5 min-w-0 flex-1">
                  <div class="avatar placeholder size-10 rounded-full shrink-0 flex items-center justify-center font-bold text-sm ${avatarBg}">
                    ${escapeHtml(getInitialsJs(op.nombre))}
                  </div>
                  <div class="min-w-0 flex-1 flex flex-col gap-0.5">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="truncate font-extrabold text-sm ${titleClass}">
                        ${escapeHtml(op.nombre)}
                      </span>
                      ${isFirst ? '<span class="badge badge-primary text-primary-content badge-sm font-bold uppercase text-xs shrink-0">Siguiente</span>' : ''}
                      <span class="badge ${statusBadgeClass} badge-sm font-bold text-xs shrink-0">${escapeHtml(statusText)}</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-base-content/60 font-medium flex-wrap">
                      <span class="uppercase font-semibold text-xs opacity-75">${escapeHtml(op.modalidadHoy === "Home Office" ? "Home Office" : "Presencial")}</span>
                      ${breakStr}
                    </div>
                  </div>
                </div>
                ${projBadge}
              </div>
            `;
          }).join("");
        } else {
          queueContainer.innerHTML = `
            <div class="text-sm text-base-content/40 italic py-12 text-center" id="stat-suggested-name-empty">
              No hay operadores disponibles
            </div>
          `;
        }
      };

      updateQueueUI(data);
      updateActionBarButtons();

      // 4. Update each table row
      data.forEach((op) => {
        const row = document.querySelector(
          `[data-op-id="${op.agentId}"]`,
        ) as HTMLElement | null;
        if (!row) return;

        const stateKey = op.disponible ? "disponible" : op.motivo || "offline";
        row.setAttribute("data-op-estado", stateKey);
        row.setAttribute("data-sort-estado", stateKey);

        // Clear previous conditional classes to ensure fresh state
        row.classList.remove(
          "bg-primary/10",
          "border-l-primary",
          "bg-secondary/10",
          "border-l-secondary",
          "border-l-4",
          "opacity-50",
          "grayscale-[30%]",
        );

        const isExceptional = !!op.estadoExcepcional;
        const isHighlighted = op.agentId === maxAgentId && maxAssignedTime > 0;

        if (isExceptional) {
          row.classList.add(
            "bg-secondary/10",
            "border-l-4",
            "border-l-secondary",
          );
        } else if (isHighlighted) {
          row.classList.add("bg-primary/10", "border-l-4", "border-l-primary");
        }

        if (!op.disponible && !isExceptional) {
          row.classList.add("opacity-50", "grayscale-[30%]");
        }

        // Update Horario / Break content
        const horarioEl = row.querySelector(`[data-op-horario]`);
        if (horarioEl) {
          if (op.horarioHoy) {
            let breakHtml = "";
            if (op.breakInicioHoy && op.breakFinHoy) {
              breakHtml = `
                <span class="flex items-center gap-1 opacity-70">
                  <svg class="size-3 opacity-60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="2" x2="6" y2="4"></line><line x1="10" y1="2" x2="10" y2="4"></line><line x1="14" y1="2" x2="14" y2="4"></line></svg>
                  ${op.breakInicioHoy} - ${op.breakFinHoy}
                </span>
              `;
            }
            horarioEl.innerHTML = `
              <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-small text-base-content/70">
                <span class="flex items-center gap-1 font-semibold">
                  <svg class="size-3.5 opacity-60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  ${op.horarioHoy}
                </span>
                ${breakHtml}
              </div>
            `;
          } else {
            horarioEl.innerHTML = `<span class="text-base-content/40 italic">Sin horario</span>`;
          }
        }

        // Update Modality text
        const modEl = row.querySelector(`[data-op-modalidad]`);
        if (modEl) {
          if (op.modalidadHoy && op.modalidadHoy !== "Franco") {
            const isHome = op.modalidadHoy === "Home Office";
            modEl.innerHTML = `
              <span class="text-xxs font-bold opacity-60 uppercase tracking-tight">
                ${isHome ? "Home" : "Presencial"}
              </span>
            `;
          } else {
            modEl.innerHTML = "";
          }
        }

        // Update status cell (badge + comment)
        const statusCell = row.querySelector(
          `[data-op-status-cell="${op.agentId}"]`,
        );
        if (statusCell) {
          let badgeHtml = "";
          let commentHtml = "";

          if (op.estadoExcepcional) {
            const badgeClass =
              "badge-secondary text-secondary-content shadow-sm shadow-secondary/20";
            let shortLabel = "⚠ Excepción";
            if (op.estadoExcepcional === "devolucion_supervisor")
              shortLabel = "⚠ Dev. Supervisor";
            else if (op.estadoExcepcional === "break_extendido") {
              const returnSuffix =
                op.retornoEstimado === "Manual"
                  ? " (Manual)"
                  : op.retornoEstimado
                    ? ` - vuelve ${op.retornoEstimado}`
                    : "";
              shortLabel = `⚠ Break extendido${returnSuffix}`;
            } else if (op.estadoExcepcional === "problema_tecnico")
              shortLabel = "⚠ Prob. técnico";

            const timeStr = op.estadoExcepcionalAt
              ? new Date(op.estadoExcepcionalAt).toLocaleTimeString("es-AR", {
                  hour: "2-digit",
                  minute: "2-digit",
                })
              : "";
            const tooltipTip = `${op.estadoExcepcionalMotivo || "Sin comentario"} — marcado a las ${timeStr}`;

            badgeHtml = `
              <div class="tooltip tooltip-bottom before:text-xxs before:px-2 before:py-1" data-tip="${tooltipTip}">
                <span
                  data-op-status-badge="${op.agentId}"
                  class="badge ${badgeClass} gap-1.5 badge-xs font-semibold uppercase text-tiny tracking-wider py-2 cursor-help"
                >
                  ${shortLabel}
                </span>
              </div>
            `;
            if (op.estadoExcepcionalMotivo) {
              commentHtml = `
                <div data-op-exception-comment="${op.agentId}" class="text-small text-base-content/50 italic font-medium max-w-[150px] truncate mt-0.5" title="${op.estadoExcepcionalMotivo}">
                  "${op.estadoExcepcionalMotivo}"
                </div>
              `;
            }
          } else {
            let badgeClass = "badge-neutral";
            let badgeText = op.motivo || "Franco";
            let dotHtml = "";

            if (op.disponible) {
              badgeClass =
                "badge-success text-success-content shadow-sm shadow-success/20";
              badgeText = "Disponible";
              dotHtml = `<span class="size-1.5 rounded-full bg-success-content animate-ping"></span>`;
            } else if (op.motivo === "En break") {
              badgeClass =
                "badge-warning text-warning-content shadow-sm shadow-warning/20";
              badgeText = `En break - vuelve ${op.retornoEstimado || ""}`;
              dotHtml = `<span class="size-1.5 rounded-full bg-warning-content/75 animate-pulse"></span>`;
            } else if (op.motivo === "Fuera de horario") {
              badgeClass = "badge-neutral text-neutral-content/75 opacity-70";
              badgeText = "Fuera de horario";
            } else if (op.motivo === "Licencia") {
              badgeClass = "badge-error text-error-content shadow-sm shadow-error/20";
            } else if (op.motivo === "Vacaciones") {
              badgeClass = "badge-info text-info-content shadow-sm shadow-info/20";
            } else if (op.motivo === "Franco") {
              badgeClass = "badge-neutral text-neutral-content/50";
            }

            badgeHtml = `
              <span
                data-op-status-badge="${op.agentId}"
                class="badge ${badgeClass} gap-1.5 badge-xs font-semibold uppercase text-tiny tracking-wider py-2"
              >
                ${dotHtml}${badgeText}
              </span>
            `;
          }

          statusCell.innerHTML = `${badgeHtml}${commentHtml}`;
        }

        // Update actions container
        const exceptionContainer = row.querySelector(
          `[data-op-exception-container="${op.agentId}"]`,
        );
        if (exceptionContainer) {
          if (op.estadoExcepcional) {
            exceptionContainer.innerHTML = `
              <button
                type="button"
                class="btn btn-error btn-xs btn-outline font-bold uppercase tracking-wider"
                data-action-lift-exception="${op.agentId}"
                title="Levantar estado excepcional"
              >
                Levantar
              </button>
            `;
          } else {
            exceptionContainer.innerHTML = `
              <button
                type="button"
                class="btn btn-ghost btn-xs text-base-content/60 hover:text-secondary hover:bg-secondary/10 px-1"
                data-action-open-exception-modal="${op.agentId}"
                data-op-nombre="${op.nombre}"
                title="Marcar estado excepcional"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </button>
            `;
          }
        }

        // Update Last Assigned text
        const lastAssignedEl = row.querySelector(
          `[data-op-last-assigned-container]`,
        );
        if (lastAssignedEl) {
          if (op.lastAutogestionAssignedAt) {
            const timeStr = new Date(
              op.lastAutogestionAssignedAt,
            ).toLocaleTimeString("es-AR", {
              hour: "2-digit",
              minute: "2-digit",
            });
            lastAssignedEl.innerHTML = `
              <span class="text-tiny text-base-content/75 bg-base-300/50 rounded px-1.5 py-0.5 inline-block font-semibold mt-0.5" data-last-assigned="${op.lastAutogestionAssignedAt}">
                Asignado: ${timeStr}
              </span>
            `;
          } else {
            lastAssignedEl.innerHTML = `<span class="text-tiny text-base-content/40 bg-base-200/40 rounded px-1.5 py-0.5 inline-block italic mt-0.5">Nunca asignado</span>`;
          }
        }

        // Update assign button disabled state
        const assignBtn = row.querySelector(
          `[data-op-assign-btn="${op.agentId}"]`,
        ) as HTMLButtonElement | null;
        if (assignBtn) {
          assignBtn.disabled = !op.disponible;
        }
      });

      // Filter rows based on "Ver solo disponibles" toggle check
      updateVisibility();
    };

    const showAlert = (type: "success" | "error", message: string) => {
      showToast(message, type === "success" ? "alert-success" : "alert-error");
    };

    const getBadgeColorClient = (status: string, disponible: boolean): string => {
      if (disponible) return "badge-success text-success-content shadow-xs";
      switch (status) {
        case "En break":
          return "badge-warning text-warning-content shadow-xs";
        case "Fuera de horario":
        case "Franco":
          return "badge-neutral text-neutral-content/75 opacity-70";
        case "Licencia":
          return "badge-error text-error-content shadow-xs";
        case "Vacaciones":
          return "badge-info text-info-content shadow-xs";
        case "Devolución Supervisor":
        case "Break Extendido":
        case "Problema Técnico":
          return "badge-secondary text-secondary-content shadow-xs";
        default:
          return "badge-neutral";
      }
    };

    const getInitialsClient = (name: string): string => {
      if (!name) return "?";
      const parts = name.trim().split(" ");
      if (parts.length >= 2) {
        return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
      }
      return name.slice(0, 2).toUpperCase();
    };

    const renderModalOpItem = (op: any, ticketId: number, isReadOnly: boolean, isCreator: boolean = false): string => {
      const isAvailable = !!op.disponible;
      const initials = getInitialsClient(op.nombre);
      const badgeColor = getBadgeColorClient(op.motivo || "", isAvailable);
      const statusLabel = isAvailable 
        ? "Disponible" 
        : (op.motivo === "En break" && op.retornoEstimado 
            ? `En break (vuelve ${escapeHtml(op.retornoEstimado)})` 
            : escapeHtml(op.motivo || "Franco"));

      const scheduleInfo = op.horarioHoy ? escapeHtml(op.horarioHoy) : "Sin horario";
      const breakInfo = (op.breakInicioHoy && op.breakFinHoy) ? ` • Break: ${escapeHtml(op.breakInicioHoy)} - ${escapeHtml(op.breakFinHoy)}` : "";
      const modality = op.modalidadHoy === "Home Office" ? "Home Office" : "Presencial";

      const btnDisabled = isReadOnly ? 'disabled="true"' : "";

      let containerClasses = "";
      let avatarClasses = "";
      let creatorBadge = "";
      let btnClass = "";

      if (isAvailable) {
        if (isCreator) {
          containerClasses = "border-2 border-success/80 bg-success/15 hover:bg-success/20 shadow-md ring-2 ring-success/30 transition-all";
          avatarClasses = "bg-success text-success-content font-black ring-2 ring-success/80 ring-offset-2 ring-offset-base-100 shadow-sm";
          creatorBadge = `<span class="badge badge-success text-success-content badge-sm font-black text-xs gap-1 px-2.5 py-1 shadow-sm"><svg class="size-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2 3.5 13h7L9 22l11.5-11h-7z"/></svg>Creador del ticket</span>`;
          btnClass = isReadOnly 
            ? "btn btn-sm btn-disabled opacity-40" 
            : "btn btn-success text-success-content btn-sm font-black uppercase tracking-wider gap-1.5 shadow-md px-4";
        } else {
          containerClasses = "border border-base-300/70 bg-base-100 hover:bg-base-200/60 transition-all shadow-xs";
          avatarClasses = "bg-primary text-primary-content shadow-xs";
          creatorBadge = "";
          btnClass = isReadOnly 
            ? "btn btn-sm btn-disabled opacity-40" 
            : "btn btn-primary btn-sm font-bold uppercase tracking-wider gap-1.5 shadow-sm px-4";
        }
      } else {
        if (isCreator) {
          containerClasses = "border-2 border-warning/70 bg-warning/10 hover:bg-warning/15 shadow-sm ring-2 ring-warning/20 transition-all";
          avatarClasses = "bg-warning/25 text-warning font-black border border-warning/40 shadow-xs";
          creatorBadge = `<span class="badge badge-warning text-warning-content badge-sm font-bold text-xs gap-1 px-2.5 py-1 shadow-xs"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>Creador del ticket</span>`;
          btnClass = isReadOnly 
            ? "btn btn-sm btn-disabled opacity-40" 
            : "btn btn-warning btn-outline btn-sm font-bold uppercase tracking-wider gap-1.5 px-4";
        } else {
          containerClasses = "border border-base-300/70 bg-base-100 hover:bg-base-200/60 transition-all shadow-xs";
          avatarClasses = "bg-base-300 text-base-content/60";
          creatorBadge = "";
          btnClass = isReadOnly 
            ? "btn btn-sm btn-disabled opacity-40" 
            : "btn btn-secondary btn-outline btn-sm font-bold uppercase tracking-wider gap-1.5 px-4";
        }
      }

      return `
        <div
          data-modal-op-item
          data-op-name="${escapeHtml(op.nombre.toLowerCase())}"
          data-op-username="${escapeHtml((op.username || '').toLowerCase())}"
          class="flex items-center justify-between gap-4 p-3.5 rounded-2xl ${containerClasses}"
        >
          <div class="flex items-center gap-3.5 min-w-0 flex-1">
            <div class="avatar placeholder size-10 rounded-full shrink-0 flex items-center justify-center font-bold text-sm ${avatarClasses}">
              ${initials}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-extrabold text-sm text-base-content truncate">${escapeHtml(op.nombre)}</span>
                ${creatorBadge}
                <span class="badge ${badgeColor} badge-sm text-xs font-semibold px-2.5 py-1">${statusLabel}</span>
              </div>
              <div class="text-xs text-base-content/65 font-medium truncate mt-0.5">
                <span class="font-semibold text-base-content/80">${modality}</span> • <span class="font-mono">${scheduleInfo}${breakInfo}</span>
              </div>
            </div>
          </div>
          <button
            type="button"
            class="${btnClass}"
            data-op-assign-btn="${op.agentId}"
            data-ticket-id="${ticketId}"
            title="${isReadOnly ? 'Toma el control para asignar autogestiones' : `Asignar ticket a ${escapeHtml(op.nombre)}`}"
            ${btnDisabled}
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Asignar</span>
          </button>
        </div>
      `;
    };

    const renderAssignToModalLists = (ticketId: number, searchQuery: string = "") => {
      const availableContainer = document.getElementById("modal-assign-to-available-list");
      const unavailableContainer = document.getElementById("modal-assign-to-unavailable-list");
      const availableCountEl = document.getElementById("modal-assign-to-available-count");
      const unavailableCountEl = document.getElementById("modal-assign-to-unavailable-count");
      if (!availableContainer || !unavailableContainer) return;

      const lockIndicator = document.getElementById("lock-indicator");
      const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
      const clientIsReadOnly = !clientHasLock;

      const ticket = latestUnassignedTickets.find((t) => t.id === ticketId);
      const creatorUsername = (ticket?.creator_username || "").toLowerCase().trim();
      const creatorNameNorm = (ticket?.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

      const isCreatorOp = (op: any) => {
        if (!creatorUsername && !creatorNameNorm) return false;
        if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
        if (op.nombre && creatorNameNorm) {
          const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
          if (opNameNorm === creatorNameNorm) return true;
          const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
          if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
        }
        return false;
      };

      const q = searchQuery.toLowerCase().trim();
      const opsList = latestDisponibilidadData.length > 0 ? latestDisponibilidadData : [];
      const filteredOps = opsList.filter((op: any) => {
        if (!q) return true;
        const name = (op.nombre || "").toLowerCase();
        const user = (op.username || "").toLowerCase();
        return name.includes(q) || user.includes(q);
      });

      const availableOps = filteredOps
        .filter((op: any) => op.disponible)
        .sort((a: any, b: any) => {
          const aCreator = isCreatorOp(a) ? 1 : 0;
          const bCreator = isCreatorOp(b) ? 1 : 0;
          return bCreator - aCreator;
        });

      const unavailableOps = filteredOps
        .filter((op: any) => !op.disponible)
        .sort((a: any, b: any) => {
          const aCreator = isCreatorOp(a) ? 1 : 0;
          const bCreator = isCreatorOp(b) ? 1 : 0;
          return bCreator - aCreator;
        });

      if (availableCountEl) availableCountEl.textContent = String(availableOps.length);
      if (unavailableCountEl) unavailableCountEl.textContent = String(unavailableOps.length);

      if (availableOps.length > 0) {
        availableContainer.innerHTML = availableOps.map((op: any) => renderModalOpItem(op, ticketId, clientIsReadOnly, isCreatorOp(op))).join("");
      } else {
        availableContainer.innerHTML = '<div class="text-xs text-base-content/40 italic py-3 text-center bg-base-200/20 rounded-xl">No hay operadores disponibles' + (q ? ' que coincidan con la búsqueda' : '') + '</div>';
      }

      if (unavailableOps.length > 0) {
        unavailableContainer.innerHTML = unavailableOps.map((op: any) => renderModalOpItem(op, ticketId, clientIsReadOnly, isCreatorOp(op))).join("");
      } else {
        unavailableContainer.innerHTML = '<div class="text-xs text-base-content/40 italic py-3 text-center bg-base-200/20 rounded-xl">No hay operadores no disponibles' + (q ? ' que coincidan con la búsqueda' : '') + '</div>';
      }
    };

    const openAssignToModal = (ticketId: number) => {
      const modal = document.getElementById("modal-asignar-operador") as HTMLDialogElement | null;
      if (!modal) return;

      const ticket = latestUnassignedTickets.find((t) => t.id === ticketId);
      const badgeEl = document.getElementById("modal-assign-to-ticket-badge");
      const titleEl = document.getElementById("modal-assign-to-ticket-title");
      const creatorEl = document.getElementById("modal-assign-to-ticket-creator");
      const searchInput = document.getElementById("modal-assign-to-search") as HTMLInputElement | null;

      if (badgeEl) badgeEl.textContent = ticket ? (ticket.pretty_id || `#${ticket.id}`) : `#${ticketId}`;
      if (titleEl) titleEl.textContent = ticket?.title || `Ticket #${ticketId}`;
      if (creatorEl) {
        if (ticket?.creator_name) {
          creatorEl.textContent = `Generado por: ${ticket.creator_name}`;
          creatorEl.classList.remove("hidden");
        } else {
          creatorEl.classList.add("hidden");
        }
      }
      if (searchInput) searchInput.value = "";

      renderAssignToModalLists(ticketId);
      modal.showModal();
    };

    const searchInput = document.getElementById("modal-assign-to-search") as HTMLInputElement | null;
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const badgeEl = document.getElementById("modal-assign-to-ticket-badge");
        const rawId = badgeEl?.textContent?.replace("#", "").trim() || "0";
        const ticketId = Number(rawId) || 0;
        renderAssignToModalLists(ticketId, searchInput.value);
      });
    }

    const updateActionBarButtons = () => {
      const btnAssignSuggested = document.getElementById("btn-assign-suggested") as HTMLButtonElement | null;
      const btnAssignAll = document.getElementById("btn-assign-all") as HTMLButtonElement | null;
      const badgeSuggestedCount = document.getElementById("badge-suggested-count");
      const badgeAllCount = document.getElementById("badge-all-count");
      const subtitleEl = document.getElementById("action-bar-subtitle");

      const lockIndicator = document.getElementById("lock-indicator");
      const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
      const clientIsReadOnly = !clientHasLock;

      const availableOps = latestDisponibilidadData.filter((op: any) => op.disponible && op.invgateId);
      const unassignedTickets = latestUnassignedTickets || [];

      // Calculate suggested matches
      const suggestedMatches: Array<{ ticket: any; op: any }> = [];
      for (const t of unassignedTickets) {
        const creatorUsername = (t.creator_username || "").toLowerCase().trim();
        const creatorNameNorm = (t.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
        const matchingOp = availableOps.find((op: any) => {
          if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
          if (op.nombre && creatorNameNorm) {
            const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
            if (opNameNorm === creatorNameNorm) return true;
            const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
            if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
          }
          return false;
        });
        if (matchingOp) {
          suggestedMatches.push({ ticket: t, op: matchingOp });
        }
      }

      const suggestedCount = suggestedMatches.length;
      const allCount = Math.min(unassignedTickets.length, availableOps.length);

      if (badgeSuggestedCount) badgeSuggestedCount.textContent = String(suggestedCount);
      if (badgeAllCount) badgeAllCount.textContent = String(allCount);

      if (subtitleEl) {
        if (clientIsReadOnly) {
          subtitleEl.textContent = "Tomá el control desde el indicador de estado para habilitar la asignación.";
        } else {
          subtitleEl.textContent = `${suggestedCount} sugeridas con creador disponible • ${allCount} asignables por cola (${availableOps.length} operadores disponibles)`;
        }
      }

      if (btnAssignSuggested) {
        const disabled = clientIsReadOnly || suggestedCount === 0;
        btnAssignSuggested.disabled = disabled;
        if (disabled) {
          btnAssignSuggested.className = "btn btn-md flex-1 sm:flex-initial flex items-center justify-center gap-2 font-extrabold uppercase tracking-wider px-5 text-xs sm:text-sm transition-all btn-neutral btn-disabled opacity-50 cursor-not-allowed";
          btnAssignSuggested.title = suggestedCount === 0 ? "No hay autogestiones con creadores disponibles actualmente" : "Tomá el control para habilitar la asignación";
        } else {
          btnAssignSuggested.className = "btn btn-md flex-1 sm:flex-initial flex items-center justify-center gap-2 font-extrabold uppercase tracking-wider px-5 text-xs sm:text-sm transition-all btn-success text-success-content shadow-md shadow-success/20 hover:scale-[1.02]";
          btnAssignSuggested.title = `Asignar ${suggestedCount} autogestión(es) a sus respectivos creadores disponibles`;
        }
      }

      if (btnAssignAll) {
        const disabled = clientIsReadOnly || allCount === 0;
        btnAssignAll.disabled = disabled;
        if (disabled) {
          btnAssignAll.className = "btn btn-md flex-1 sm:flex-initial flex items-center justify-center gap-2 font-extrabold uppercase tracking-wider px-5 text-xs sm:text-sm transition-all btn-neutral btn-disabled opacity-50 cursor-not-allowed";
          btnAssignAll.title = unassignedTickets.length === 0 ? "No hay autogestiones sin asignar" : availableOps.length === 0 ? "No hay operadores disponibles en cola" : "Tomá el control para habilitar la asignación";
        } else {
          btnAssignAll.className = "btn btn-md flex-1 sm:flex-initial flex items-center justify-center gap-2 font-extrabold uppercase tracking-wider px-5 text-xs sm:text-sm transition-all btn-primary shadow-md shadow-primary/20 hover:scale-[1.02]";
          btnAssignAll.title = `Asignar ${allCount} autogestión(es) por orden de cola a operadores disponibles`;
        }
      }
    };

    let currentBatchMode: "suggested" | "all" = "suggested";

    const openBatchConfirmModal = (mode: "suggested" | "all") => {
      currentBatchMode = mode;
      const modal = document.getElementById("modal-confirm-batch-assign") as HTMLDialogElement | null;
      const titleEl = document.getElementById("modal-batch-title");
      const subtitleEl = document.getElementById("modal-batch-subtitle");
      const alertEl = document.getElementById("modal-batch-summary-alert");
      const summaryTextEl = document.getElementById("modal-batch-summary-text");
      const itemsContainer = document.getElementById("modal-batch-items-container");
      const confirmBtn = document.getElementById("modal-batch-confirm-btn") as HTMLButtonElement | null;

      if (!modal || !itemsContainer) return;

      const availableOps = latestDisponibilidadData.filter((op: any) => op.disponible && op.invgateId);
      availableOps.sort((a: any, b: any) => {
        const tA = a.lastAutogestionAssignedAt ?? 0;
        const tB = b.lastAutogestionAssignedAt ?? 0;
        if (a.lastAutogestionAssignedAt === null && b.lastAutogestionAssignedAt !== null) return -1;
        if (a.lastAutogestionAssignedAt !== null && b.lastAutogestionAssignedAt === null) return 1;
        return tA - tB;
      });

      const unassignedTickets = latestUnassignedTickets || [];

      if (mode === "suggested") {
        if (titleEl) titleEl.textContent = "Asignar Autogestiones Sugeridas";
        if (subtitleEl) subtitleEl.textContent = "Asignará cada ticket a su operador creador disponible";

        const suggestedMatches: Array<{ ticket: any; op: any }> = [];
        for (const t of unassignedTickets) {
          const creatorUsername = (t.creator_username || "").toLowerCase().trim();
          const creatorNameNorm = (t.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
          const matchingOp = availableOps.find((op: any) => {
            if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
            if (op.nombre && creatorNameNorm) {
              const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
              if (opNameNorm === creatorNameNorm) return true;
              const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
              if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
            }
            return false;
          });
          if (matchingOp) {
            suggestedMatches.push({ ticket: t, op: matchingOp });
          }
        }

        if (suggestedMatches.length === 0) {
          showAlert("warning", "No hay autogestiones con creadores disponibles para asignar.");
          return;
        }

        if (alertEl) {
          alertEl.className = "alert alert-success text-xs font-semibold rounded-xl flex items-center gap-2.5";
        }
        if (summaryTextEl) {
          summaryTextEl.textContent = `Se asignarán ${suggestedMatches.length} autogestión(es) directamente a sus operadores creadores disponibles.`;
        }

        itemsContainer.innerHTML = suggestedMatches.map(({ ticket, op }) => `
          <div class="flex items-center justify-between gap-3 p-3 rounded-xl border border-success/40 bg-success/10">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="font-mono font-bold text-xs px-2 py-0.5 bg-base-100 rounded text-success">${escapeHtml(ticket.pretty_id || `#${ticket.id}`)}</span>
                <span class="font-semibold text-xs text-base-content truncate">${escapeHtml(ticket.title || "Autogestión")}</span>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-xs text-base-content/60 font-medium">Asignar a:</span>
              <span class="badge badge-success text-success-content font-bold text-xs px-2.5 py-1">${escapeHtml(op.nombre)}</span>
            </div>
          </div>
        `).join("");

      } else {
        if (titleEl) titleEl.textContent = "Asignar Todas las Autogestiones en Cola";
        if (subtitleEl) subtitleEl.textContent = "Asignará tickets en orden secuencial a los operadores en cola";

        const assignCount = Math.min(unassignedTickets.length, availableOps.length);
        if (assignCount === 0) {
          showAlert("warning", "No hay tickets o no hay operadores disponibles para asignar en cola.");
          return;
        }

        if (alertEl) {
          alertEl.className = "alert alert-info text-xs font-semibold rounded-xl flex items-center gap-2.5";
        }
        if (summaryTextEl) {
          summaryTextEl.textContent = `Se asignarán ${assignCount} autogestión(es) a los ${assignCount} operadores siguientes en la cola de disponibilidad.`;
        }

        const previewPairs: Array<{ ticket: any; op: any; pos: number }> = [];
        for (let i = 0; i < assignCount; i++) {
          previewPairs.push({ ticket: unassignedTickets[i], op: availableOps[i], pos: i + 1 });
        }

        itemsContainer.innerHTML = previewPairs.map(({ ticket, op, pos }) => `
          <div class="flex items-center justify-between gap-3 p-3 rounded-xl border border-base-300 bg-base-100">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="badge badge-neutral badge-xs font-mono font-bold">${pos}°</span>
                <span class="font-mono font-bold text-xs px-2 py-0.5 bg-base-200 rounded">${escapeHtml(ticket.pretty_id || `#${ticket.id}`)}</span>
                <span class="font-semibold text-xs text-base-content truncate">${escapeHtml(ticket.title || "Autogestión")}</span>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-xs text-base-content/60 font-medium">Asignar a:</span>
              <span class="badge badge-primary font-bold text-xs px-2.5 py-1">${escapeHtml(op.nombre)}</span>
            </div>
          </div>
        `).join("");
      }

      if (confirmBtn) {
        confirmBtn.disabled = false;
      }

      modal.showModal();
    };

    const executeBatchAssignment = async () => {
      const confirmBtn = document.getElementById("modal-batch-confirm-btn") as HTMLButtonElement | null;
      const modal = document.getElementById("modal-confirm-batch-assign") as HTMLDialogElement | null;

      if (confirmBtn) {
        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<span class="loading loading-spinner loading-xs"></span><span>Asignando...</span>';
      }

      try {
        const res = await fetch("/api/disponibilidad/asignar-batch", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ mode: currentBatchMode }),
        });
        const data = await res.json();

        if (res.status === 423) {
          showAlert("error", data.error || "Perdiste el control de asignación. Recargando...");
          setTimeout(() => window.location.reload(), 1500);
          return;
        }

        if (res.ok && data.success) {
          if (modal && modal.open) modal.close();
          const label = currentBatchMode === "suggested" ? "autogestión(es) sugerida(s)" : "autogestión(es) en cola";
          showAlert("success", `¡Éxito! Se asignaron ${data.assignedCount} ${label}.`);
          await Promise.all([fetchDisponibilidad(), fetchUnassignedTickets()]);
        } else {
          showAlert("error", data.error || "Ocurrió un error al procesar la asignación masiva.");
        }
      } catch (err: any) {
        console.error(err);
        showAlert("error", `Error de conexión al asignar: ${err.message || err}`);
      } finally {
        if (confirmBtn) {
          confirmBtn.disabled = false;
          confirmBtn.innerHTML = '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Confirmar Asignación</span>';
        }
      }
    };

    // Event delegation for exceptional states, assignments, and ticket details
    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;

      // -0. Open specific operator assignment modal
      const assignToBtn = target.closest("[data-action-assign-to]");
      if (assignToBtn) {
        const ticketId = Number(assignToBtn.getAttribute("data-action-assign-to"));
        if (!isNaN(ticketId) && ticketId > 0) {
          openAssignToModal(ticketId);
        }
        return;
      }

      // -1. Open unassigned ticket detail modal
      const ticketCard = target.closest("[data-ticket-id]");
      const isAssignBtnClick = target.closest("[data-op-assign-btn]") || target.closest("[data-action-assign-to]");
      if (ticketCard && !isAssignBtnClick) {
        const ticketId = Number(ticketCard.getAttribute("data-ticket-id"));
        const ticket = latestUnassignedTickets.find((t) => t.id === ticketId);
        const modal = document.getElementById("modal-ticket-detail") as HTMLDialogElement | null;

        if (ticket && modal) {
          const webBase = modal.getAttribute("data-invgate-web-base") || "";

          const elId = document.getElementById("ticket-modal-id");
          const elTitle = document.getElementById("ticket-modal-title");
          const elPrio = document.getElementById("ticket-modal-prio");
          const elCat = document.getElementById("ticket-modal-cat");
          const elCatFull = document.getElementById("ticket-modal-cat-full");
          const elCatFullContainer = document.getElementById("ticket-modal-cat-full-container");
          const elCreator = document.getElementById("ticket-modal-creator");
          const elCustomer = document.getElementById("ticket-modal-customer");
          const elLocation = document.getElementById("ticket-modal-location");
          const elCreated = document.getElementById("ticket-modal-created");
          const elWait = document.getElementById("ticket-modal-wait");
          const elSla = document.getElementById("ticket-modal-sla");
          const elDescription = document.getElementById("ticket-modal-description");
          const elLink = document.getElementById("ticket-modal-invgate-link") as HTMLAnchorElement | null;

          const PRIORITY_MAP: Record<number, { label: string; badgeClass: string }> = {
            1: { label: "Baja", badgeClass: "bg-base-200 text-base-content/60 border-none font-medium" },
            2: { label: "Media", badgeClass: "bg-info/15 text-info border-none font-medium" },
            3: { label: "Alta", badgeClass: "bg-warning/15 text-warning border-none font-semibold" },
            4: { label: "Urgente", badgeClass: "bg-warning/20 text-warning border-none font-bold" },
            5: { label: "Crítica", badgeClass: "bg-error/15 text-error border-none font-bold" },
          };

          if (elId) elId.textContent = ticket.pretty_id || `#${ticket.id}`;
          if (elTitle) elTitle.textContent = ticket.title || "Sin título";
          
          if (elPrio) {
            const prio = PRIORITY_MAP[ticket.priority_id];
            if (prio) {
              elPrio.textContent = prio.label;
              elPrio.className = `badge badge-sm font-bold tracking-wider uppercase shrink-0 ${prio.badgeClass}`;
              elPrio.classList.remove("hidden");
            } else {
              elPrio.classList.add("hidden");
            }
          }

          if (elCat) {
            if (ticket.category_last_name) {
              elCat.textContent = ticket.category_last_name;
              elCat.classList.remove("hidden");
            } else {
              elCat.classList.add("hidden");
            }
          }

          if (elCatFullContainer && elCatFull) {
            if (ticket.category_name) {
              elCatFull.textContent = ticket.category_name;
              elCatFullContainer.classList.remove("hidden");
            } else {
              elCatFullContainer.classList.add("hidden");
            }
          }

          // Match creator with available operators
          const creatorUsername = (ticket.creator_username || "").toLowerCase().trim();
          const creatorNameNorm = (ticket.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

          const matchingAvailableOp = latestDisponibilidadData.find((op) => {
            if (!op.disponible) return false;
            if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
            if (op.nombre && creatorNameNorm) {
              const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
              if (opNameNorm === creatorNameNorm) return true;
              const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
              if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
            }
            return false;
          });

          if (elCreator) {
            if (matchingAvailableOp) {
              elCreator.innerHTML = `<span class="text-success font-bold">${escapeHtml(ticket.creator_name || "Creador")} <span class="text-xxs font-semibold opacity-90">(Disponible)</span></span>`;
            } else {
              elCreator.textContent = ticket.creator_name || "Sin especificar";
            }
          }
          
          if (elCustomer) elCustomer.textContent = ticket.customer_name || "Mismo creador";
          if (elLocation) elLocation.textContent = ticket.location_name || "No especificada";

          const btnAssignToModal = document.getElementById("ticket-modal-assign-to-btn") as HTMLButtonElement | null;
          if (btnAssignToModal) {
            btnAssignToModal.setAttribute("data-action-assign-to", String(ticket.id));
            const lockIndicator = document.getElementById("lock-indicator");
            const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
            if (!clientHasLock) {
              btnAssignToModal.disabled = true;
              btnAssignToModal.classList.add("btn-disabled", "opacity-50");
              btnAssignToModal.title = "Toma el control para habilitar la asignación";
            } else {
              btnAssignToModal.disabled = false;
              btnAssignToModal.classList.remove("btn-disabled", "opacity-50");
              btnAssignToModal.title = `Asignar ticket #${ticket.pretty_id || ticket.id} a un operador...`;
            }
          }

          if (elCreated) {
            elCreated.textContent = ticket.created_at
              ? new Date(ticket.created_at * 1000).toLocaleString("es-AR", {
                  dateStyle: "short",
                  timeStyle: "medium",
                })
              : "Desconocida";
          }

          if (elWait) {
            if (ticket.created_at) {
              const elapsedMin = Math.floor((Date.now() - ticket.created_at * 1000) / 60000);
              const formatWait = elapsedMin >= 60 
                ? `${Math.floor(elapsedMin / 60)}h ${elapsedMin % 60}m` 
                : `${elapsedMin}m`;
              elWait.textContent = formatWait;
              elWait.className = `text-xs font-mono font-bold ${
                elapsedMin >= 60 ? "text-error" : elapsedMin >= 30 ? "text-warning" : "text-base-content/80"
              }`;
            } else {
              elWait.textContent = "-";
            }
          }

          if (elSla) elSla.textContent = ticket.sla_incident_first_reply || "No configurado";

          if (elDescription) {
            const rawDesc = ticket.description && ticket.description.trim().length > 0
              ? ticket.description
              : "Sin descripción provista.";
            
            // Render safe HTML parsing for formatted ticket descriptions (tables, paragraphs, breaks)
            const parser = new DOMParser();
            const doc = parser.parseFromString(rawDesc, "text/html");
            
            // Remove any script or iframe tags if present
            doc.querySelectorAll("script, iframe, object, embed").forEach((node) => node.remove());
            
            elDescription.innerHTML = doc.body.innerHTML;
          }

          if (elLink) {
            if (webBase) {
              elLink.href = `${webBase}/requests/show/index/id/${ticket.id}`;
              elLink.classList.remove("hidden");
            } else {
              elLink.classList.add("hidden");
            }
          }

          modal.showModal();
        }
        return;
      }

      // 0. Open exception modal
      const openModalBtn = target.closest("[data-action-open-exception-modal]");
      if (openModalBtn) {
        const agentId = openModalBtn.getAttribute(
          "data-action-open-exception-modal",
        );
        const nombre = openModalBtn.getAttribute("data-op-nombre") || "";

        const modal = document.getElementById(
          "modal-marcar-excepcion",
        ) as HTMLDialogElement | null;
        const agentIdInput = document.getElementById(
          "modal-agent-id",
        ) as HTMLInputElement | null;
        const operatorNameSpan = document.getElementById(
          "modal-operador-nombre",
        );
        const selectTipo = document.getElementById(
          "modal-select-tipo",
        ) as HTMLSelectElement | null;
        const containerTiempoExtra = document.getElementById(
          "container-tiempo-extra",
        );
        const selectTiempoExtra = document.getElementById(
          "modal-select-tiempo-extra",
        ) as HTMLSelectElement | null;
        const inputMotivo = document.getElementById(
          "modal-input-motivo",
        ) as HTMLInputElement | null;

        if (modal && agentIdInput && operatorNameSpan) {
          agentIdInput.value = agentId || "";
          operatorNameSpan.innerText = nombre;
          if (selectTipo) selectTipo.value = "devolucion_supervisor";
          if (containerTiempoExtra)
            containerTiempoExtra.classList.add("hidden");
          if (selectTiempoExtra) selectTiempoExtra.value = "20";
          if (inputMotivo) inputMotivo.value = "";

          document.body.classList.add("overflow-hidden");
          document.documentElement.classList.add("overflow-hidden");
          modal.showModal();
        }
        return;
      }

      // 0.5. Close exception modal
      const closeModalBtn = target.closest("#btn-close-modal-excepcion");
      if (closeModalBtn) {
        const modal = document.getElementById(
          "modal-marcar-excepcion",
        ) as HTMLDialogElement | null;
        if (modal) {
          modal.close();
        }
        return;
      }

      // 1. Confirm exceptional state from modal
      const confirmModalBtn = target.closest("#btn-confirmar-modal-excepcion");
      if (confirmModalBtn) {
        const agentIdInput = document.getElementById(
          "modal-agent-id",
        ) as HTMLInputElement | null;
        const selectTipo = document.getElementById(
          "modal-select-tipo",
        ) as HTMLSelectElement | null;
        const selectTiempoExtra = document.getElementById(
          "modal-select-tiempo-extra",
        ) as HTMLSelectElement | null;
        const inputMotivo = document.getElementById(
          "modal-input-motivo",
        ) as HTMLInputElement | null;
        const modal = document.getElementById(
          "modal-marcar-excepcion",
        ) as HTMLDialogElement | null;

        if (agentIdInput && selectTipo && modal) {
          const agentId = Number(agentIdInput.value);
          const tipo = selectTipo.value;
          const motivo = inputMotivo ? inputMotivo.value : "";
          const tiempoExtra =
            tipo === "break_extendido" &&
            selectTiempoExtra &&
            selectTiempoExtra.value !== "manual"
              ? Number(selectTiempoExtra.value)
              : null;

          if (!isNaN(agentId)) {
            confirmModalBtn.setAttribute("disabled", "true");
            try {
              const res = await fetch("/api/disponibilidad/excepcional", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ agentId, tipo, motivo, tiempoExtra }),
              });
              const resData = await res.json();
              if (res.status === 423) {
                modal.close();
                showAlert("error", resData.error || "Perdiste el control de asignación. Recargando...");
                setTimeout(() => window.location.reload(), 1500);
                return;
              }
              if (res.ok) {
                modal.close();
                await fetchDisponibilidad();
              } else {
                showAlert("error", resData.error || "No se pudo marcar el estado excepcional");
              }
            } catch (err) {
              console.error(err);
            } finally {
              confirmModalBtn.removeAttribute("disabled");
            }
          }
        }
        return;
      }

      // 2. Lift/clear exceptional state
      const liftBtn = target.closest("[data-action-lift-exception]");
      if (liftBtn) {
        const agentId = Number(
          liftBtn.getAttribute("data-action-lift-exception"),
        );
        if (!isNaN(agentId)) {
          liftBtn.setAttribute("disabled", "true");
          try {
            const res = await fetch("/api/disponibilidad/excepcional", {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ agentId }),
            });
            const resData = await res.json();
            if (res.status === 423) {
              showAlert("error", resData.error || "Perdiste el control de asignación. Recargando...");
              setTimeout(() => window.location.reload(), 1500);
              return;
            }
            if (res.ok) {
              await fetchDisponibilidad();
            } else {
              showAlert("error", resData.error || "No se pudo levantar la excepción");
            }
          } catch (err) {
            console.error(err);
          } finally {
            liftBtn.removeAttribute("disabled");
          }
        }
        return;
      }

      // 2.5 Deshacer assign
      const btnUndoEl = target.closest("#btn-undo");
      if (btnUndoEl && !btnUndoEl.hasAttribute("disabled")) {
        btnUndoEl.setAttribute("disabled", "true");
        try {
          const res = await fetch("/api/disponibilidad/deshacer", {
            method: "POST",
            headers: { "Content-Type": "application/json" }
          });
          const resData = await res.json();
          if (res.status === 423) {
            showAlert("error", resData.error || "Perdiste el control de asignación. Recargando...");
            setTimeout(() => window.location.reload(), 1500);
            return;
          }
          if (res.ok && resData.success) {
            showAlert("success", `Asignación de ${resData.agentName} deshecha.`);
            await fetchDisponibilidad();
          } else {
            showAlert("error", resData.error || "No se pudo deshacer la asignación.");
          }
        } catch (err: any) {
          console.error(err);
          showAlert("error", `Ocurrió un error al deshacer: ${err.message || err}`);
        }
        return;
      }

      // 3. Batch assign buttons
      const assignSuggestedBtn = target.closest("#btn-assign-suggested");
      if (assignSuggestedBtn && !assignSuggestedBtn.hasAttribute("disabled") && !(assignSuggestedBtn as HTMLButtonElement).disabled) {
        openBatchConfirmModal("suggested");
        return;
      }

      const assignAllBtn = target.closest("#btn-assign-all");
      if (assignAllBtn && !assignAllBtn.hasAttribute("disabled") && !(assignAllBtn as HTMLButtonElement).disabled) {
        openBatchConfirmModal("all");
        return;
      }

      const batchConfirmBtn = target.closest("#modal-batch-confirm-btn");
      if (batchConfirmBtn && !batchConfirmBtn.hasAttribute("disabled") && !(batchConfirmBtn as HTMLButtonElement).disabled) {
        executeBatchAssignment();
        return;
      }

      // 4. Manual assign
      const assignManualBtn = target.closest("[data-op-assign-btn]");
      if (assignManualBtn && !assignManualBtn.hasAttribute("disabled") && !(assignManualBtn as HTMLButtonElement).disabled) {
        const agentId = Number(assignManualBtn.getAttribute("data-op-assign-btn"));
        const ticketIdAttr = assignManualBtn.getAttribute("data-ticket-id");
        const ticketId = ticketIdAttr ? Number(ticketIdAttr) : undefined;

        if (!isNaN(agentId)) {
          assignManualBtn.setAttribute("disabled", "true");
          try {
            const res = await fetch("/api/disponibilidad/asignar-manual", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ agentId, ticketId }),
            });
            const data = await res.json();
            if (res.status === 423) {
              showAlert("error", data.error || "Perdiste el control de asignación. Recargando...");
              setTimeout(() => window.location.reload(), 1500);
              return;
            }
            if (res.ok && data.success) {
              const modalTicket = document.getElementById("modal-ticket-detail") as HTMLDialogElement | null;
              if (modalTicket && modalTicket.open) {
                modalTicket.close();
              }
              const modalAssignOp = document.getElementById("modal-asignar-operador") as HTMLDialogElement | null;
              if (modalAssignOp && modalAssignOp.open) {
                modalAssignOp.close();
              }
              const tNumStr = data.ticketNumber ? ` ${data.ticketNumber}` : "";
              showAlert("success", `Autogestión${tNumStr} asignada manualmente a ${data.agentName || `ID ${agentId}`}.`);
              await fetchDisponibilidad();
            } else {
              showAlert("error", data.error || "No se pudo realizar la asignación manual.");
            }
          } catch (err: any) {
            console.error(err);
            showAlert("error", `Ocurrió un error al procesar la asignación manual: ${err.message || err}`);
          } finally {
            assignManualBtn.removeAttribute("disabled");
          }
        }
        return;
      }
    });

    // Fetch unassigned tickets for Helpdesk 3950
    const fetchUnassignedTickets = async () => {
      try {
        const res = await fetch("/api/invgate/unassigned-tickets?helpdesk_id=3950");
        if (!res.ok) return;
        const data = await res.json();
        latestUnassignedTickets = data.tickets || [];
        const countEl = document.getElementById("stat-unassigned-count");
        const listEl = document.getElementById("unassigned-tickets-list");
        const count = data.count ?? 0;

        updateActionBarButtons();

        if (countEl) {
          countEl.textContent = String(count);
          countEl.className = `badge badge-md ${count > 0 ? "badge-warning text-warning-content" : "badge-neutral"} font-mono font-bold text-sm px-2.5 py-1`;
        }
        if (listEl) {
          if (data.tickets && data.tickets.length > 0) {
            const PRIORITY_MAP: Record<number, { label: string; badgeClass: string }> = {
              1: { label: "Baja", badgeClass: "bg-base-200 text-base-content/60 border-none font-medium" },
              2: { label: "Media", badgeClass: "bg-info/15 text-info border-none font-medium" },
              3: { label: "Alta", badgeClass: "bg-warning/15 text-warning border-none font-semibold" },
              4: { label: "Urgente", badgeClass: "bg-warning/20 text-warning border-none font-bold" },
              5: { label: "Crítica", badgeClass: "bg-error/15 text-error border-none font-bold" },
            };

            listEl.innerHTML = data.tickets.map((t: any) => {
              const timeStr = t.created_at ? new Date(t.created_at * 1000).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" }) : "";
              
              // Calculate elapsed waiting time
              let waitingBadge = "";
              if (t.created_at) {
                const elapsedMin = Math.floor((Date.now() - t.created_at * 1000) / 60000);
                let colorClass = "bg-base-200 text-base-content/70 border-none";
                if (elapsedMin >= 60) {
                  colorClass = "bg-error/15 text-error border-none font-bold";
                } else if (elapsedMin >= 30) {
                  colorClass = "bg-warning/15 text-warning border-none font-semibold";
                }
                const formatWait = elapsedMin >= 60 
                  ? `${Math.floor(elapsedMin / 60)}h ${elapsedMin % 60}m` 
                  : `${elapsedMin}m`;
                waitingBadge = `<span class="badge badge-sm font-mono text-xs px-2 py-0.5 shrink-0 ${colorClass}" title="Tiempo de espera en cola">⏱ ${formatWait}</span>`;
              }

              // SLA first reply badge
              let slaBadge = "";
              if (t.sla_incident_first_reply) {
                slaBadge = `<span class="badge badge-outline badge-info badge-sm font-mono text-xs shrink-0" title="SLA de respuesta">SLA: ${escapeHtml(t.sla_incident_first_reply)}</span>`;
              }

              const prioInfo = PRIORITY_MAP[t.priority_id] || (t.priority_id ? { label: `P${t.priority_id}`, badgeClass: "badge-neutral" } : null);
              const prioBadge = prioInfo
                ? `<span class="badge badge-sm font-bold text-xs tracking-wider uppercase shrink-0 ${prioInfo.badgeClass}">${escapeHtml(prioInfo.label)}</span>`
                : "";
              const catBadge = t.category_last_name
                ? `<span class="badge badge-neutral badge-sm font-semibold text-xs tracking-tight max-w-[170px] truncate shrink-0" title="${escapeHtml(t.category_name || t.category_last_name)}">${escapeHtml(t.category_last_name)}</span>`
                : "";

              // Check if creator matches any available operator
              const creatorUsername = (t.creator_username || "").toLowerCase().trim();
              const creatorNameNorm = (t.creator_name || "").toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();

              const matchingAvailableOp = latestDisponibilidadData.find((op) => {
                if (!op.disponible) return false;
                if (op.username && creatorUsername && op.username.split("@")[0].toLowerCase().trim() === creatorUsername) return true;
                if (op.nombre && creatorNameNorm) {
                  const opNameNorm = op.nombre.toLowerCase().replace(/[^a-z0-9]/g, " ").replace(/\s+/g, " ").trim();
                  if (opNameNorm === creatorNameNorm) return true;
                  const tokens = creatorNameNorm.split(" ").filter((k: string) => k.length > 2);
                  if (tokens.length >= 2 && tokens.every((k: string) => opNameNorm.includes(k))) return true;
                }
                return false;
              });

              const creatorStr = t.creator_name || t.customer_name || "";
              const customerStr = t.customer_name && t.creator_name && t.customer_name !== t.creator_name ? t.customer_name : "";

              const lockIndicator = document.getElementById("lock-indicator");
              const clientHasLock = lockIndicator ? lockIndicator.getAttribute("data-has-lock") === "true" : false;
              const clientIsReadOnly = !clientHasLock;
              const clientIsDisabled = clientIsReadOnly ? 'disabled="true"' : "";
              const clientAssignToClass = clientIsReadOnly
                ? "btn btn-ghost btn-xs btn-disabled opacity-40 cursor-not-allowed text-base-content/40 px-2.5 py-0 h-6.5 min-h-0 font-bold shrink-0 gap-1.5 text-xs"
                : "btn btn-ghost btn-xs text-base-content/70 hover:text-primary hover:bg-primary/10 px-2.5 py-0 h-6.5 min-h-0 font-bold shrink-0 gap-1.5 text-xs";

              const assignButtons = `
                <button
                  type="button"
                  class="${clientAssignToClass}"
                  data-action-assign-to="${t.id}"
                  title="${clientIsReadOnly ? 'Toma el control para asignar autogestiones' : `Asignar ticket #${escapeHtml(t.pretty_id || t.id)} a un operador...`}"
                  ${clientIsDisabled}
                >
                  <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                  <span>Asignar a...</span>
                </button>
              `;

              const creatorContent = creatorStr
                ? `
                  <svg class="size-3.5 ${matchingAvailableOp ? 'text-success' : 'opacity-60'} shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                  <span class="truncate">
                    Generado por: <strong class="${matchingAvailableOp ? 'text-success font-bold text-sm' : 'text-base-content/90 font-bold text-sm'}">${escapeHtml(creatorStr)}</strong> ${matchingAvailableOp ? '<span class="text-success text-xs font-semibold">(Disponible)</span>' : ''}${customerStr ? ` <span class="opacity-75">• Cliente: <strong class="text-base-content/85 font-semibold">${escapeHtml(customerStr)}</strong></span>` : ''}
                  </span>
                `
                : `<span class="opacity-50 italic text-xs">Sin creador especificado</span>`;

              const userRow = `
                <div class="flex items-center justify-between gap-2 text-xs font-medium truncate mt-1">
                  <div class="flex items-center gap-1.5 min-w-0 truncate text-base-content/75">
                    ${creatorContent}
                  </div>
                  <div class="flex items-center gap-1.5 shrink-0">
                    ${assignButtons}
                  </div>
                </div>
              `;

              const locationRow = t.location_name
                ? `<div class="flex items-center gap-1.5 text-xs text-base-content/70 font-medium truncate"><svg class="size-3.5 text-info opacity-75 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg><span class="truncate">Ubicación: <strong class="text-base-content/90 font-bold">${escapeHtml(t.location_name)}</strong></span></div>`
                : "";

              return `
                <div data-ticket-id="${t.id}" class="p-4 hover:bg-base-200/60 transition-colors duration-150 flex flex-col gap-2 cursor-pointer group min-w-[480px] sm:min-w-0">
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2 min-w-0 flex-wrap">
                      <span class="font-mono font-bold text-primary-content bg-primary px-2.5 py-1 rounded-lg text-xs sm:text-sm shrink-0">${escapeHtml(t.pretty_id || '#' + t.id)}</span>
                      ${prioBadge}
                      ${catBadge}
                      ${slaBadge}
                      ${waitingBadge}
                    </div>
                    <span class="text-xs sm:text-sm text-base-content/60 font-mono font-semibold shrink-0">${timeStr}</span>
                  </div>
                  <div class="font-bold text-base-content text-sm sm:text-base leading-snug group-hover:text-primary transition-colors" title="${escapeHtml(t.title)}">${escapeHtml(t.title)}</div>
                  ${userRow}
                  ${locationRow}
                </div>
              `;
            }).join("");
          } else {
            listEl.innerHTML = '<div class="text-sm text-base-content/40 italic py-16 text-center">No hay tickets sin asignar</div>';
          }
        }
      } catch (err) {
        console.error("Error fetching unassigned tickets:", err);
      }
    };

    // Fetch availability data
    const fetchDisponibilidad = async () => {
      if (refreshIcon) refreshIcon.classList.add("animate-spin");
      if (btnRefresh) btnRefresh.disabled = true;

      try {
        const res = await fetch("/api/disponibilidad");
        if (!res.ok) throw new Error("Error fetching availability");
        const data = await res.json();

        updateUI(data);
        await fetchUnassignedTickets();

        secondsSinceSync = 0;
        updateIndicatorText();
      } catch (error) {
        console.error("Failed to sync availability data:", error);
      } finally {
        if (refreshIcon) refreshIcon.classList.remove("animate-spin");
        if (btnRefresh) btnRefresh.disabled = false;
      }
    };

    // Fetch lock status
    const fetchLockStatus = async () => {
      try {
        const res = await fetch("/api/disponibilidad/lock");
        if (!res.ok) throw new Error("Error fetching lock status");
        return await res.json();
      } catch (error) {
        console.error("Failed to fetch lock status:", error);
        return null;
      }
    };

    // Dynamic lock banner UI update
    const updateLockBanner = (lockStatus: any) => {
      if (!lockStatus) return;
      currentLockStatus = lockStatus;

      const indicator = document.getElementById("lock-indicator");
      if (!indicator) return;

      const currentUserId = Number(indicator.getAttribute("data-user-id"));
      const bannerTimeoutAttr = Number(indicator.getAttribute("data-lock-timeout")) || 600000;

      let hasLock = false;
      let lockHolderName = null;
      let lockReleaseRequested = false;

      if (lockStatus.status === "occupied") {
        hasLock = lockStatus.user?.userId === currentUserId;
        lockHolderName = lockStatus.user?.username;
        lockReleaseRequested = lockStatus.user?.releaseRequested;

        lockTimeoutMs = lockReleaseRequested ? 60000 : bannerTimeoutAttr;
        lockExpiresAt = lockStatus.user.lastActivityAt + lockTimeoutMs;
        startCountdown();
      } else {
        stopCountdown();
      }

      if (hasLock) {
        indicator.setAttribute("data-has-lock", "true");
      } else {
        indicator.removeAttribute("data-has-lock");
      }

      let dotColor = "bg-base-content/30";
      let statusText = "Sin asignador";
      let showTimer = false;
      let timerMs = 0;
      let buttonsHtml = "";

      if (lockStatus.status === "free") {
        dotColor = "bg-base-content/30";
        statusText = "Sin asignador";
        buttonsHtml = `<button type="button" id="btn-acquire-lock" class="btn btn-primary btn-xs font-bold uppercase tracking-wider shadow-sm">Tomar control</button>`;
      } else if (lockStatus.status === "expired") {
        dotColor = "bg-neutral/50";
        statusText = `Expirado: ${escapeHtml(lockHolderName)}`;
        buttonsHtml = `<button type="button" id="btn-acquire-lock" class="btn btn-primary btn-xs font-bold uppercase tracking-wider shadow-sm">Tomar control</button>`;
      } else if (lockStatus.status === "occupied") {
        showTimer = true;
        timerMs = lockExpiresAt - Date.now();
        if (hasLock) {
          dotColor = "bg-success";
          statusText = "En control";
          
          let rejectBtn = "";
          if (lockReleaseRequested) {
            rejectBtn = `<button type="button" id="btn-reject-release" class="btn btn-success btn-ghost btn-xs font-bold uppercase tracking-wider">Rechazar</button>`;
          }
          buttonsHtml = `
            ${rejectBtn}
            <button type="button" id="btn-release-lock" class="btn btn-ghost btn-xs font-bold uppercase tracking-wider text-error">Liberar</button>
          `;
        } else {
          dotColor = "bg-warning";
          statusText = `Ocupado: ${escapeHtml(lockHolderName)}`;
          buttonsHtml = `
            <button type="button" id="btn-request-release" class="btn btn-ghost btn-xs font-bold uppercase tracking-wider text-warning" ${lockReleaseRequested ? 'disabled' : ''}>
              ${lockReleaseRequested ? 'Solicitado' : 'Pedir liberación'}
            </button>
          `;
        }
      }

      let timerHtml = "";
      if (showTimer) {
        const initialCountdown = timerMs > 0 ? formatCountdown(timerMs) : "0:00";
        const isCritical = timerMs > 0 && timerMs < 60000;
        const badgeClass = isCritical ? "bg-error/70 text-error-content" : "bg-base-100/30";
        timerHtml = `<span id="lock-countdown" class="badge badge-xs tabular-nums font-mono border-0 ${badgeClass}">${initialCountdown}</span>`;
      }

      indicator.innerHTML = `
        <span class="size-2 rounded-full ${dotColor}"></span>
        <span>${statusText}</span>
        ${timerHtml}
        <div class="flex items-center gap-1.5 ml-1">
          ${buttonsHtml}
        </div>
      `;

      if (hasLock) {
        startHeartbeat();
      } else {
        stopHeartbeat();
      }
    };

    // Click handler for manual refresh
    if (btnRefresh) {
      btnRefresh.addEventListener("click", async () => {
        await Promise.all([
          fetchDisponibilidad(),
          fetchLockStatus().then(updateLockBanner)
        ]);
      });
    }

    // Click handler for history modal
    const btnOpenHistorial = document.getElementById("btn-open-historial-modal");
    if (btnOpenHistorial) {
      btnOpenHistorial.addEventListener("click", async () => {
        const modal = document.getElementById("modal-historial-asignaciones") as HTMLDialogElement | null;
        const loadingEl = document.getElementById("historial-loading");
        const emptyEl = document.getElementById("historial-empty");
        const tableContainer = document.getElementById("historial-table-container");
        const rowsEl = document.getElementById("historial-rows");

        if (modal) {
          if (loadingEl) loadingEl.classList.remove("hidden");
          if (emptyEl) emptyEl.classList.add("hidden");
          if (tableContainer) tableContainer.classList.add("hidden");
          modal.showModal();

          const TYPE_MAP: Record<string, { label: string; badgeClass: string }> = {
            cyclic: { label: "Cíclica", badgeClass: "badge-primary text-primary-content font-bold" },
            manual: { label: "Manual", badgeClass: "badge-info text-info-content font-bold" },
            undo: { label: "Deshecha", badgeClass: "badge-warning text-warning-content font-bold" },
          };

          try {
            const res = await fetch("/api/disponibilidad/historial");
            const data = await res.json();
            if (loadingEl) loadingEl.classList.add("hidden");

            if (res.ok && data.history && data.history.length > 0) {
              if (tableContainer) tableContainer.classList.remove("hidden");
              if (rowsEl) {
                rowsEl.innerHTML = data.history.map((item: any) => {
                  const dateStr = item.assignedAt ? new Date(item.assignedAt).toLocaleString("es-AR", { dateStyle: "short", timeStyle: "medium" }) : "-";
                  const typeInfo = TYPE_MAP[item.type] || { label: item.type || "Asignación", badgeClass: "badge-neutral" };
                  const ticketBadge = item.ticketNumber
                    ? `<span class="badge badge-primary badge-xs font-mono font-bold px-1.5 py-0.5">${escapeHtml(item.ticketNumber)}</span>`
                    : `<span class="text-base-content/40 font-mono text-tiny">-</span>`;

                  const actionBtn = item.canUndo
                    ? `<button type="button" class="btn btn-ghost btn-xs text-warning hover:bg-warning/15 px-2 py-0.5 h-6 min-h-0 font-bold gap-1 shrink-0" data-undo-ticket="${escapeHtml(item.ticketNumber)}" title="Devolver ${escapeHtml(item.ticketNumber)} a la cola de sin asignar en InvGate"><svg class="size-3 text-warning shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg><span>Deshacer</span></button>`
                    : `<span class="text-base-content/30 text-tiny italic">-</span>`;

                  return `
                    <tr class="hover:bg-base-200/50">
                      <td class="font-mono text-tiny font-semibold text-base-content/70">${escapeHtml(dateStr)}</td>
                      <td class="font-bold text-xs text-base-content">${escapeHtml(item.agentName)}</td>
                      <td>${ticketBadge}</td>
                      <td><span class="badge badge-xs ${typeInfo.badgeClass} text-tiny">${escapeHtml(typeInfo.label)}</span></td>
                      <td class="font-medium text-xs text-base-content/80">${escapeHtml(item.assignedBy || "Sistema")}</td>
                      <td class="text-right">${actionBtn}</td>
                    </tr>
                  `;
                }).join("");

                if (rowsEl && !rowsEl.hasAttribute("data-listener-attached")) {
                  rowsEl.setAttribute("data-listener-attached", "true");
                  rowsEl.addEventListener("click", async (e) => {
                    const target = e.target as HTMLElement;
                    const btn = target.closest("[data-undo-ticket]") as HTMLButtonElement | null;
                    if (!btn || btn.disabled) return;

                    const ticketNumber = btn.getAttribute("data-undo-ticket");
                    if (!ticketNumber) return;

                    btn.disabled = true;
                    btn.innerHTML = `<span class="loading loading-spinner loading-xs text-warning"></span><span>Deshaciendo...</span>`;

                    try {
                      const res = await fetch("/api/disponibilidad/deshacer-ticket", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ ticketNumber }),
                      });
                      const data = await res.json();
                      if (res.ok && data.success) {
                        showAlert("success", data.message || `Ticket ${ticketNumber} devuelto a sin asignar.`);
                        await fetchDisponibilidad();
                        btnOpenHistorial.click();
                      } else {
                        showAlert("error", data.error || "Error al desasignar ticket.");
                        btn.disabled = false;
                        btn.innerHTML = `<svg class="size-3 text-warning shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg><span>Deshacer</span>`;
                      }
                    } catch (err: any) {
                      console.error("Error undoing ticket:", err);
                      showAlert("error", `Error: ${err.message || err}`);
                      btn.disabled = false;
                      btn.innerHTML = `<svg class="size-3 text-warning shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg><span>Deshacer</span>`;
                    }
                  });
                }
              }
            } else {
              if (emptyEl) emptyEl.classList.remove("hidden");
            }
          } catch (err) {
            console.error("Error fetching assignment history:", err);
            if (loadingEl) loadingEl.classList.add("hidden");
            if (emptyEl) {
              emptyEl.textContent = "Ocurrió un error al cargar el historial.";
              emptyEl.classList.remove("hidden");
            }
          }
        }
      });
    }

    // Set up 1-second polling interval
    let isPollingBusy = false;
    polling = setInterval(async () => {
      if (isPollingBusy) return;
      isPollingBusy = true;
      try {
        await Promise.all([
          fetchDisponibilidad(),
          fetchLockStatus().then(updateLockBanner)
        ]);
      } finally {
        isPollingBusy = false;
      }
    }, 1000);

    // Close dropdowns on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        document.querySelectorAll(".dropdown.dropdown-open").forEach((d) => {
          d.classList.remove("dropdown-open");
        });
      }
    });

    // Lock heartbeat cada 2 minutos
    const LOCK_HEARTBEAT_MS = 2 * 60 * 1000;

    const startHeartbeat = () => {
      if (heartbeatInterval) clearInterval(heartbeatInterval);
      heartbeatInterval = setInterval(async () => {
        try {
          const res = await fetch("/api/disponibilidad/lock/heartbeat", { method: "POST" });
          if (res.ok) {
            lockExpiresAt = Date.now() + lockTimeoutMs;
          } else {
            console.warn("Heartbeat failed, lock might have been lost");
          }
        } catch (err) {
          console.error("Heartbeat error:", err);
        }
      }, LOCK_HEARTBEAT_MS);
    };

    const stopHeartbeat = () => {
      if (heartbeatInterval) {
        clearInterval(heartbeatInterval);
        heartbeatInterval = null;
      }
    };

    // Event delegation on #lock-indicator
    const bannerEl = document.getElementById("lock-indicator");
    if (bannerEl) {
      bannerEl.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;

        // Acquire lock
        const acquireLockBtn = target.closest("#btn-acquire-lock") as HTMLButtonElement | null;
        if (acquireLockBtn) {
          acquireLockBtn.setAttribute("disabled", "true");
          acquireLockBtn.innerText = "Adquiriendo...";
          try {
            const res = await fetch("/api/disponibilidad/lock", { method: "POST" });
            if (res.ok) {
              window.location.reload();
            } else {
              const data = await res.json();
              showAlert("error", data.error || "No se pudo adquirir el control");
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            }
          } catch (err: any) {
            showAlert("error", "Error al adquirir el control");
            const lockStatus = await fetchLockStatus();
            if (lockStatus) updateLockBanner(lockStatus);
          }
          return;
        }

        // Reject release
        const rejectReleaseBtn = target.closest("#btn-reject-release") as HTMLButtonElement | null;
        if (rejectReleaseBtn) {
          rejectReleaseBtn.setAttribute("disabled", "true");
          rejectReleaseBtn.innerText = "Rechazando...";
          try {
            const res = await fetch("/api/disponibilidad/lock/reject-release", { method: "POST" });
            if (res.ok) {
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
              showToast("Solicitud de liberación rechazada", "alert-success");
            } else {
              const data = await res.json();
              showToast(data.error || "Error al rechazar", "alert-error");
            }
          } catch {
            showToast("Error al rechazar liberación", "alert-error");
          }
          rejectReleaseBtn.removeAttribute("disabled");
          rejectReleaseBtn.innerText = "Rechazar liberación";
          return;
        }

        // Release lock
        const releaseLockBtn = target.closest("#btn-release-lock") as HTMLButtonElement | null;
        if (releaseLockBtn) {
          releaseLockBtn.setAttribute("disabled", "true");
          try {
            const res = await fetch("/api/disponibilidad/lock", { method: "DELETE" });
            if (res.ok) {
              window.location.reload();
            } else {
              const data = await res.json();
              showAlert("error", data.error || "No se pudo liberar el control");
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            }
          } catch (err: any) {
            showAlert("error", "Error al liberar el control");
            const lockStatus = await fetchLockStatus();
            if (lockStatus) updateLockBanner(lockStatus);
          }
          return;
        }

        // Request release
        const requestReleaseBtn = target.closest("#btn-request-release") as HTMLButtonElement | null;
        if (requestReleaseBtn) {
          requestReleaseBtn.setAttribute("disabled", "true");
          requestReleaseBtn.innerText = "Enviando...";
          try {
            const res = await fetch("/api/disponibilidad/lock/request-release", { method: "POST" });
            if (res.ok) {
              requestReleaseBtn.innerText = "Solicitud enviada";
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            } else {
              showAlert("error", "No se pudo enviar la solicitud");
              const lockStatus = await fetchLockStatus();
              if (lockStatus) updateLockBanner(lockStatus);
            }
          } catch (err: any) {
            showAlert("error", "Error al solicitar liberación");
            const lockStatus = await fetchLockStatus();
            if (lockStatus) updateLockBanner(lockStatus);
          }
          return;
        }
      });
    }

    // Initial fetch of lock status immediately
    fetchLockStatus().then(updateLockBanner);

    // Release lock on page unload using fetch with keepalive: true
    window.addEventListener("beforeunload", () => {
      const indicator = document.getElementById("lock-indicator");
      if (indicator && indicator.getAttribute("data-has-lock") === "true") {
        fetch("/api/disponibilidad/lock", { method: "DELETE", keepalive: true });
      }
    });

    // Run first UI update visibility check
    updateVisibility();

    return true;
  };

  // Wait for dynamic server island component initialization
  if (!init()) {
    checkReady = setInterval(() => {
      if (init()) {
        clearInterval(checkReady);
      }
    }, 50);
  }

  document.addEventListener("astro:before-swap", () => {
    if (countdownInterval) clearInterval(countdownInterval);
    if (timer) clearInterval(timer);
    if (polling) clearInterval(polling);
    if (heartbeatInterval) clearInterval(heartbeatInterval);
    if (checkReady) clearInterval(checkReady);
  });
</script>

<style is:global>
  [data-queue-item] {
    position: absolute;
    transition: top 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease-out;
  }
</style>
