---
import { Icon } from "astro-icon/components";

const plans = [
  {
    id: "homonimos",
    title: "Fusiones Homónimas",
    badge: "35 grupos redundantes",
    badgeColor: "badge-warning",
    icon: "boxicons:git-merge",
    iconColor: "text-warning",
    summary: "64 categorías redundantes identificadas que acumulan 442 tickets dispersos.",
    impact: "Impacto: -64 categorías",
    details: [
      "Unificación de nodos con nombres duplicados o equivalentes entre ramas.",
      "Reducción de ambigüedad para los operadores en la selección inicial.",
      "Consolidación del historial de tipificación en nodos unificados.",
    ],
  },
  {
    id: "desiertos",
    title: "Nodos Desiertos",
    badge: "165 nodos con 0 tickets",
    badgeColor: "badge-error",
    icon: "boxicons:trash",
    iconColor: "text-error",
    summary: "148 hojas y 17 ramas intermedias totalmente desiertas sin actividad registrada.",
    impact: "Impacto: -165 nodos",
    details: [
      "Eliminación/depreciación de ramas obsoletas acumuladas en el árbol.",
      "Reducción del 22.9% de la carga cognitiva en menús desplegables.",
      "Disminución directa de la tasa de desperdicio estructural.",
    ],
  },
  {
    id: "atajos",
    title: "Atajos Inmediatos",
    badge: "19 hojas rápidas",
    badgeColor: "badge-success",
    icon: "boxicons:timer",
    iconColor: "text-success",
    summary: "19 categorías con resolución en ≤15 min que representan el 22.4% del volumen total.",
    impact: "Meta: 3 clics fijos",
    details: [
      "Exposición de accesos rápidos para las tareas de resolución inmediata.",
      "Reducción del promedio ponderado de clics de navegación.",
      "Aceleración de tiempos de cierre para incidencias repetitivas.",
    ],
  },
];
---

<section class="space-y-4" aria-label="Planes de acción para optimización de categorías">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold tracking-tight text-base-content">
        Planes de Acción Recomendados
      </h2>
      <p class="text-xs text-base-content/60 mt-0.5">
        Estrategias de remediación derivadas de la auditoría estructural del catálogo.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {
      plans.map((plan) => (
        <div class="card card-border bg-base-100 border-base-200 shadow-sm hover:shadow-md transition-shadow">
          <div class="card-body p-5 gap-3">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2">
                <div class:list={["p-2 rounded-box bg-base-200/60", plan.iconColor]}>
                  <Icon name={plan.icon} size={20} />
                </div>
                <div>
                  <h3 class="font-bold text-sm text-base-content">{plan.title}</h3>
                  <span class:list={["badge badge-xs font-medium mt-0.5", plan.badgeColor]}>
                    {plan.badge}
                  </span>
                </div>
              </div>
            </div>

            <p class="text-xs text-base-content/75 leading-relaxed">
              {plan.summary}
            </p>

            <div class="pt-2 border-t border-base-200">
              <span class="text-xs font-semibold text-primary">{plan.impact}</span>
              <ul class="mt-2 space-y-1 text-xs text-base-content/65 list-disc list-inside">
                {plan.details.map((d) => (
                  <li class="leading-tight">{d}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
