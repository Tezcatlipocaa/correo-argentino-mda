---
import { Icon } from "astro-icon/components";
import SearchBar from "@components/ui/SearchBar.astro";
import rawData from "@lib/categories/fixtures/mda-ti-canonical.json";

const rawTreeData = {
  actual: rawData.actual,
  a: rawData.a,
  b: rawData.b,
  c: rawData.c,
  comp: rawData.comp,
  ej: rawData.ejemplos,
  meta: rawData.meta,
};
---

<div
  id="tree-explorer-container"
  class="relative flex flex-col bg-base-100 border border-base-300 rounded-box shadow-sm overflow-hidden"
  data-testid="tree-explorer"
>
  <div class="sticky top-0 z-30 flex flex-col gap-2.5 p-3.5 bg-base-200/90 backdrop-blur-md border-b border-base-300">
    <div class="flex flex-wrap items-center justify-between gap-2.5">
      <div class="join overflow-x-auto max-w-full" role="group" aria-label="Selector de vistas del catálogo">
        <button
          id="vC"
          type="button"
          class="btn btn-sm join-item btn-primary btn-active on"
          data-view="c"
        >
          3. Propuesta C - híbrida
        </button>
        <button
          id="vCur"
          type="button"
          class="btn btn-sm join-item"
          data-view="cur"
        >
          4. Árbol actual
        </button>
        <button
          id="vA"
          type="button"
          class="btn btn-sm join-item"
          data-view="a"
        >
          1. Propuesta A
        </button>
        <button
          id="vB"
          type="button"
          class="btn btn-sm join-item"
          data-view="b"
        >
          2. Propuesta B
        </button>
        <button
          id="vCmp"
          type="button"
          class="btn btn-sm join-item"
          data-view="cmp"
        >
          5. Comparativa
        </button>
      </div>

      <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
        <button
          id="btn-toggle-fullscreen"
          type="button"
          class="btn btn-sm btn-outline gap-1.5"
          title="Alternar pantalla completa"
          aria-label="Alternar pantalla completa"
        >
          <Icon name="boxicons:fullscreen" size={18} class="icon-expand" />
          <Icon name="boxicons:fullscreen-exit" size={18} class="icon-compress hidden" />
          <span class="fs-text text-xs">Pantalla completa</span>
        </button>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2.5 pt-2 border-t border-base-300/60">
      <div class="join">
        <button
          id="btn-expand-all"
          type="button"
          class="btn btn-sm btn-outline join-item gap-1 text-xs"
          title="Expandir todas las ramas del árbol"
        >
          <Icon name="boxicons:chevron-down" size={16} />
          <span>Expandir todo</span>
        </button>
        <button
          id="btn-collapse-all"
          type="button"
          class="btn btn-sm btn-outline join-item gap-1 text-xs"
          title="Colapsar todo el árbol"
        >
          <Icon name="boxicons:chevron-up" size={16} />
          <span>Colapsar todo</span>
        </button>
      </div>

      <div class="w-60 sm:w-80">
        <SearchBar
          id="tree-search-input"
          placeholder="Buscar categoría o ruta..."
          size="sm"
          clearable
        />
      </div>
    </div>
  </div>

  <div class="px-4 py-2.5 border-b border-base-200 bg-base-200/40 text-xs space-y-2">
    <div class="flex items-center justify-between">
      <span class="font-semibold text-xs text-base-content/80 flex items-center gap-1.5">
        <Icon name="boxicons:info-circle" size={14} class="text-secondary" />
        Guía de colores, convenciones y códigos
      </span>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-base-content/70">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-warning"></span>
        <span>nivel 1</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-info"></span>
        <span>nivel 2</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-base-content/40"></span>
        <span>hoja</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
        <span>uso interno</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-base-content/20"></span>
        <span>sin volumen</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-error"></span>
        <span>padre duplicado</span>
      </span>
    </div>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xxs font-mono text-base-content/70 pt-1.5 border-t border-base-200">
      <span><strong class="text-base-content">tk</strong> tickets</span>
      <span><strong class="text-base-content">h</strong> hojas</span>
      <span class="badge badge-xs badge-ghost border border-base-300/60 opacity-60">0 tk</span>
      <span class="badge badge-xs badge-soft badge-neutral font-medium text-base-content">&lt; 50 tk</span>
      <span class="badge badge-xs bg-info/15 text-info border-info/30">&lt; 200 tk</span>
      <span class="badge badge-xs bg-secondary/20 text-secondary border-secondary/35 font-bold">&ge; 200 tk</span>
      <span>[id] InvGate</span>
    </div>
  </div>

  <div class="p-4 overflow-x-auto min-h-[480px]">
    <div id="tree-note" class="alert alert-soft alert-info text-xs mb-4"></div>
    <ul id="tree" class="root space-y-1" role="tree"></ul>
    <div id="cmp" class="hidden space-y-6"></div>
  </div>

  <div class="flex items-center justify-between px-4 py-2 bg-base-200/50 border-t border-base-300 text-xs text-base-content/60 font-mono">
    <span id="tree-explorer-foot"></span>
    <span class="fs-escape-hint text-xxs text-base-content/40 hidden">Presione Escape para salir de pantalla completa</span>
  </div>
</div>

<script is:inline type="application/json" id="tree-canonical-data" set:html={JSON.stringify(rawTreeData)}></script>

<style is:global>
  #tree-explorer-container.fullscreen-active,
  #tree-explorer-container:fullscreen {
    position: fixed !important;
    inset: 0 !important;
    z-index: 250 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-width: 100% !important;
    max-height: 100% !important;
    background-color: var(--color-base-100) !important;
    padding: 1.25rem !important;
    overflow-y: auto !important;
    border-radius: 0 !important;
    margin: 0 !important;
  }
  #tree-explorer-container .c1 > .row .nm {
    color: var(--color-warning);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  #tree-explorer-container .c1 {
    margin-top: 0.65rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--color-base-300);
  }
  #tree-explorer-container .c2 > .row .nm {
    color: var(--color-info);
    font-size: 0.95rem;
    font-weight: 600;
  }
  #tree-explorer-container .cint > .row .nm {
    color: var(--color-secondary);
    font-weight: 600;
  }
  #tree-explorer-container .cdead > .row .nm,
  #tree-explorer-container .cdead > .row .id {
    color: var(--color-base-content);
    opacity: 0.45;
  }
  #tree-explorer-container.fullscreen-active .fs-escape-hint,
  #tree-explorer-container:fullscreen .fs-escape-hint {
    display: inline-block !important;
  }
</style>

<script>
  interface RawNode {
    id?: number | string;
    name?: string;
    n?: string;
    type?: string;
    t?: string;
    tickets?: number;
    v?: number;
    oldPath?: string;
    o?: string;
    conf?: boolean;
    pend?: boolean;
    into?: number | string;
    fuse?: Array<{ id: number | string; v: number }>;
    children?: RawNode[];
    h?: RawNode[];
  }

  interface CatalogPayload {
    actual: RawNode;
    a: RawNode[];
    b: RawNode[];
    c: RawNode[];
    comp: Array<{ m: string; u?: string; actual: string; a: string; b: string; c: string; mejor?: string }>;
    ej: Array<{ v: number; id: string; desde: string; hasta: string; hastaC: string }>;
    meta: Record<string, unknown>;
  }

  const FIXW: Record<string, string> = {
    instalacion: "instalación",
    configuracion: "configuración",
    modificacion: "modificación",
    impresion: "impresión",
    distribucion: "distribución",
    actualizacion: "actualización",
    extraccion: "extracción",
    escaner: "escáner",
    conexion: "conexión",
    telefono: "teléfono",
    telefonia: "telefonía",
    totem: "tótem",
    toner: "tóner",
    laser: "láser",
    dano: "daño",
    danados: "dañados",
    energia: "energía",
    electrica: "eléctrica",
    codigos: "códigos",
    contrasena: "contraseña",
    modulo: "módulo",
    examenes: "exámenes",
    medicos: "médicos",
    senal: "señal",
    extravio: "extravío",
    perdida: "pérdida",
    revision: "revisión",
    tecnico: "técnico",
    moviles: "móviles",
    autogestion: "autogestión",
    bateria: "batería",
    quedo: "quedó",
    menu: "menú",
    sobrepaso: "sobrepasó",
    aplicacion: "aplicación",
    geolocalizacion: "geolocalización",
    reimpresion: "reimpresión",
    reenvio: "reenvío",
  };

  function matchCase(w: string, rep: string): string {
    return w[0] !== w[0].toLowerCase() ? rep[0].toUpperCase() + rep.slice(1) : rep;
  }

  function fixWords(s: string): string {
    return String(s).replace(/[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+/g, (w) => {
      const f = FIXW[w.toLowerCase()];
      return f ? matchCase(w, f) : w;
    });
  }

  function stripPadre(raw: string, padre: string | null): string {
    if (!padre || !raw) return raw;
    const re = new RegExp("^" + padre.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\s*[-\u2013\u2014:]+\\s+", "i");
    const m = re.exec(raw);
    if (!m) return raw;
    const rest = raw.slice(m[0].length).trim();
    return rest.length >= 3 && /[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]/.test(rest) ? rest : raw;
  }

  function cleanName(raw: string, padre: string | null): string {
    const out = fixWords(stripPadre(raw, padre));
    return out === "No Responde" ? "No responde" : out;
  }

  function esc(s: unknown): string {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function cleanPath(p: string): string {
    const seg = String(p).split(" > ");
    const raw: string[] = [];
    const out: string[] = [];
    for (let i = 0; i < seg.length; i++) {
      const c = cleanName(seg[i], i ? raw[i - 1] : null);
      raw.push(c);
      out.push(esc(c));
    }
    return out.join(" &rsaquo; ");
  }

  function cls(t?: string): string {
    const map: Record<string, string> = {
      l1: "c1",
      l2: "c2",
      l2d: "c2d",
      leaf: "cleaf",
      dead: "cdead",
      int: "cint",
      cur: "ccur",
    };
    return (t && map[t]) || "cleaf";
  }

  function isLeafish(t?: string): boolean {
    return t === "leaf" || t === "cur" || t === "int" || t === "dead";
  }

  const NOTES: Record<string, string> = {
    cur: "<strong>Estado actual:</strong> 719 nodos, 490 hojas, hasta 7 selecciones (promedio 4,71). El nivel 1 es el sector, no lo que el usuario necesita. 148 hojas sin tickets, 9 intermedios con nombre genérico, 39 nodos tienen un solo hijo. Clic en una categoría para abrir o cerrar.",
    b: "<strong>Propuesta B - sistema &gt; síntoma:</strong> Nivel 1 = sistema (52 opciones), nivel 2 = síntoma. <strong>2 selecciones</strong>, <strong>cero conflictos</strong>: cada sistema es un nodo con un solo padre. Elegir un sistema muestra todos sus problemas.",
    c: "<strong>Propuesta C - híbrida (recomendada):</strong> Nivel 1 = familia (10 agrupaciones), nivel 2 = sistema, nivel 3 = síntoma. <strong>3 selecciones</strong>, <strong>cero conflictos</strong>, primera pantalla de 52 a 10 opciones. Peor pantalla: 28 opciones, contra 42 de A y 56 de B.",
    a: "<strong>Propuesta A - intención &gt; sistema &gt; síntoma:</strong> Nivel 1 = intención, nivel 2 = sistema, nivel 3 = síntoma. <strong>3 selecciones</strong>. Los nodos con la marca <em>2 padres</em> no son implementables en InvGate sin duplicar.",
    cmp: "<strong>Comparativa de los tres árboles:</strong> El promedio de selecciones está ponderado por el volumen real de cada hoja. En verde, la mejor opción de cada métrica.",
  };

  let currentView: "c" | "cur" | "a" | "b" | "cmp" = "c";
  let query = "";
  let debounceTimer: ReturnType<typeof setTimeout> | null = null;
  let abortController: AbortController | null = null;

  function getCatalogData(): CatalogPayload {
    const dataScript = document.getElementById("tree-canonical-data");
    return dataScript ? JSON.parse(dataScript.textContent || "{}") : ({} as CatalogPayload);
  }

  function label(n: RawNode, padre: string | null): string {
    const name = n.n || n.name || "";
    if (currentView === "cur" || !name) return name;
    return cleanName(name, padre);
  }

  function markFusions(nodes?: RawNode[]): void {
    (nodes || []).forEach((n) => {
      const children = n.h || n.children;
      if (children && children.length) {
        const buckets: Record<string, RawNode[]> = {};
        children.forEach((c) => {
          const type = c.t || c.type;
          const name = c.n || c.name;
          if (type === "leaf" && name) {
            (buckets[name] = buckets[name] || []).push(c);
          }
        });
        Object.keys(buckets).forEach((name) => {
          const g = buckets[name];
          if (g.length < 2) return;
          g.sort((a, b) => (b.v || b.tickets || 0) - (a.v || a.tickets || 0));
          const keeper = g[0];
          keeper.pend = true;
          keeper.fuse = g.slice(1).map((l) => ({ id: l.id ?? "", v: l.v || l.tickets || 0 }));
          g.slice(1).forEach((l) => {
            l.into = keeper.id;
          });
        });
      }
      if (children) markFusions(children);
    });
  }

  function childUl(li: HTMLElement): HTMLUListElement | null {
    for (let i = 0; i < li.children.length; i++) {
      if (li.children[i].tagName === "UL") return li.children[i] as HTMLUListElement;
    }
    return null;
  }

  function setOpen(li: HTMLElement, open: boolean): void {
    const ul = childUl(li);
    if (!ul) return;
    if (open) ul.classList.remove("hidden");
    else ul.classList.add("hidden");
    li.setAttribute("aria-expanded", open ? "true" : "false");
    const tw = li.querySelector<HTMLElement>(":scope > .row > .tw");
    if (tw) {
      if (open) {
        tw.classList.add("rotate-90");
        tw.setAttribute("aria-label", "Plegar rama");
      } else {
        tw.classList.remove("rotate-90");
        tw.setAttribute("aria-label", "Desplegar rama");
      }
    }
  }

  function isOpen(li: HTMLElement): boolean {
    const ul = childUl(li);
    return Boolean(ul && !ul.classList.contains("hidden"));
  }

  function toggle(li: HTMLElement): void {
    const ul = childUl(li);
    if (!ul) return;
    setOpen(li, !isOpen(li));
  }

  function allLis(): NodeListOf<HTMLElement> {
    return document.querySelectorAll("#tree-explorer-container #tree li");
  }

  function getVisibleTreeItems(): HTMLElement[] {
    const all = Array.from(document.querySelectorAll<HTMLElement>("#tree-explorer-container #tree li[role='treeitem']"));
    return all.filter((li) => {
      let p = li.parentElement;
      while (p && p.id !== "tree") {
        if (p.tagName === "UL" && p.classList.contains("hidden")) {
          return false;
        }
        p = p.parentElement;
      }
      return true;
    });
  }

  function updateRovingTabindex(newActiveLi: HTMLElement): void {
    const all = document.querySelectorAll<HTMLElement>("#tree-explorer-container #tree li[role='treeitem']");
    all.forEach((li) => {
      li.tabIndex = li === newActiveLi ? 0 : -1;
    });
    newActiveLi.focus();
  }

  function expandAll(): void {
    const list = allLis();
    list.forEach((li) => {
      if (childUl(li)) setOpen(li, true);
    });
  }

  function collapseAll(): void {
    const list = allLis();
    list.forEach((li) => {
      if (childUl(li)) setOpen(li, false);
    });
  }

  function expandFirst(): void {
    const t = document.getElementById("tree");
    if (!t) return;
    const top = t.children;
    for (let i = 0; i < top.length; i++) {
      const el = top[i] as HTMLElement;
      if (childUl(el)) setOpen(el, true);
    }
  }

  function expandTo(depthLimit: number): void {
    const t = document.getElementById("tree");
    if (!t) return;
    const step = (ul: HTMLElement, lvl: number) => {
      const k = ul.children;
      for (let i = 0; i < k.length; i++) {
        const li = k[i] as HTMLElement;
        const u = childUl(li);
        if (!u) continue;
        if (lvl <= depthLimit) {
          setOpen(li, true);
          step(u, lvl + 1);
        }
      }
    };
    step(t, 1);
  }

  function openAncestors(el: HTMLElement): void {
    let p = el.parentElement;
    while (p && p.id !== "tree") {
      if (p.tagName === "LI") {
        setOpen(p as HTMLElement, true);
      }
      p = p.parentElement;
    }
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function highlightMatch(text: string, q: string): string {
    if (!q) return escapeHtml(text);
    const lower = text.toLowerCase();
    const qLower = q.toLowerCase();
    let idx = 0;
    let result = "";
    while (idx < text.length) {
      const matchIdx = lower.indexOf(qLower, idx);
      if (matchIdx === -1) {
        result += escapeHtml(text.slice(idx));
        break;
      }
      result += escapeHtml(text.slice(idx, matchIdx));
      result += `<mark class="bg-warning/35 text-base-content font-bold px-0.5 rounded">${escapeHtml(text.slice(matchIdx, matchIdx + q.length))}</mark>`;
      idx = matchIdx + q.length;
    }
    return result;
  }

  function applyFilter(): void {
    const list = allLis();
    let hits = 0;
    const q = query.toLowerCase().trim();

    list.forEach((li) => {
      const row = li.querySelector(":scope > .row") as HTMLElement | null;
      const nm = li.querySelector(":scope > .row > .nm") as HTMLElement | null;
      if (!row || !nm) return;

      const origText = nm.getAttribute("data-label") || nm.textContent || "";
      const rawText = (origText + " " + (row.getAttribute("data-raw") || "")).toLowerCase();
      const isHit = Boolean(q && rawText.indexOf(q) >= 0);

      if (isHit) {
        li.classList.add("hit");
        hits++;
        if (origText.toLowerCase().includes(q)) {
          nm.innerHTML = highlightMatch(origText, q);
        } else {
          nm.textContent = origText;
        }
      } else {
        li.classList.remove("hit");
        nm.textContent = origText;
      }
    });

    if (q) {
      list.forEach((li) => {
        if (li.classList.contains("hit")) {
          openAncestors(li);
        }
      });
    }

    const foot = document.getElementById("tree-explorer-foot");
    if (foot) {
      foot.textContent = q ? `Coincidencias encontradas: ${hits}` : "";
    }
  }

  function renderTreeNodes(nodes: RawNode[], parentEl: HTMLElement, depth: number, padre: string | null): void {
    nodes.forEach((n) => {
      const name = n.n || n.name || "";
      const type = n.t || n.type;
      const tickets = n.v ?? n.tickets;
      const children = n.h || n.children;
      const oldPath = n.o || n.oldPath;

      const li = document.createElement("li");
      li.className = cls(type);
      li.setAttribute("role", "treeitem");
      li.tabIndex = -1;

      const row = document.createElement("div");
      row.className = "row flex items-center gap-2 flex-wrap py-1 px-2.5 rounded-lg hover:bg-base-200 transition-colors text-xs";
      row.setAttribute("data-raw", name);

      const has = Boolean(children && children.length);
      if (has) li.setAttribute("aria-expanded", "false");

      let tw: HTMLElement;
      if (has) {
        const toggleIcon = document.createElement("span");
        toggleIcon.className = "tw inline-flex items-center justify-center w-5 h-5 text-base-content/60 hover:text-primary cursor-pointer select-none transition-transform duration-150 shrink-0";
        toggleIcon.setAttribute("role", "button");
        toggleIcon.setAttribute("aria-label", "Alternar rama");
        toggleIcon.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10.707 17.707 16.414 12l-5.707-5.707-1.414 1.414L13.586 12l-4.293 4.293z"/></svg>`;
        tw = toggleIcon;
      } else {
        const sp = document.createElement("span");
        sp.className = "tw inline-flex items-center justify-center w-5 h-5 text-base-content/25 select-none shrink-0";
        sp.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="6" height="6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="6"/></svg>`;
        tw = sp;
      }

      const nm = document.createElement("span");
      nm.className = "nm font-medium text-base-content";
      const lb = label(n, padre);
      nm.textContent = lb;
      nm.setAttribute("data-label", lb);
      if (lb !== name) nm.title = name;
      if (has) nm.classList.add("clk", "cursor-pointer", "hover:text-primary");

      row.appendChild(tw);
      row.appendChild(nm);

      if (n.id) {
        const idSpan = document.createElement("span");
        idSpan.className = "id text-xxs font-mono text-base-content/40";
        idSpan.textContent = `[${n.id}]`;
        row.appendChild(idSpan);
      }

      if (tickets !== undefined && tickets !== null) {
        if (tickets > 0 || !has) {
          const vSpan = document.createElement("span");
          let tierClass = "badge-ghost opacity-60";
          if (tickets === 0) {
            tierClass = "badge-ghost border border-base-300/60 opacity-60";
          } else if (tickets < 50) {
            tierClass = "badge-soft badge-neutral font-medium text-base-content";
          } else if (tickets < 200) {
            tierClass = "bg-info/15 text-info border-info/30";
          } else {
            tierClass = "bg-secondary/20 text-secondary border-secondary/35 font-bold";
          }
          vSpan.className = `v badge badge-sm font-mono tabular-nums ${tierClass}`;
          vSpan.textContent = `${tickets} ${isLeafish(type) ? "tk" : "h"}`;
          row.appendChild(vSpan);
        }
      }

      if (n.conf) {
        const tConf = document.createElement("span");
        tConf.className = "tag conf badge badge-xs badge-error gap-1";
        tConf.textContent = "2 padres";
        row.appendChild(tConf);
      }

      if (n.pend) {
        const tPend = document.createElement("span");
        tPend.className = "tag pend badge badge-xs badge-warning gap-1";
        tPend.textContent = "fusión pendiente";
        row.appendChild(tPend);
      }

      if (n.into) {
        const tGone = document.createElement("span");
        tGone.className = "tag gone badge badge-xs badge-info gap-1";
        tGone.textContent = `se fusiona en [${n.into}]`;
        row.appendChild(tGone);
      }

      if (oldPath && currentView !== "cur" && type === "leaf") {
        const od = document.createElement("span");
        od.className = "old text-xxs text-base-content/50 w-full pl-7";
        od.innerHTML = `&larr; <span class="font-normal font-sans">${esc(oldPath)}</span>`;
        row.appendChild(od);
      }

      li.appendChild(row);

      if (n.fuse && n.fuse.length) {
        const fb = document.createElement("div");
        fb.className = "fuse alert alert-warning alert-soft text-xs border border-warning/30 p-2.5 my-1 ml-7 rounded-xl";
        const fh = document.createElement("div");
        fh.className = "fh block font-semibold text-warning tracking-wide mb-1";
        const fvol = n.fuse.reduce((acc, x) => acc + x.v, 0);
        fh.innerHTML = `absorbe <strong>${n.fuse.length}</strong> ${n.fuse.length === 1 ? "categoría" : "categorías"} &middot; <strong>${fvol.toLocaleString("es")}</strong> tk`;
        fb.appendChild(fh);

        n.fuse.forEach((x) => {
          const fi = document.createElement("div");
          fi.className = "fi block font-mono text-xs tabular-nums text-base-content/80";
          const fid = document.createElement("span");
          fid.className = "id mr-2 text-base-content/40";
          fid.textContent = x.id ? `[${x.id}]` : "[sin id]";
          fi.appendChild(fid);
          const fvn = document.createElement("strong");
          fvn.textContent = x.v.toLocaleString("es");
          fi.appendChild(fvn);
          fi.appendChild(document.createTextNode(" tk"));
          fb.appendChild(fi);
        });
        li.appendChild(fb);
      }

      if (has && children) {
        const ul = document.createElement("ul");
        ul.className = "tree-children ml-3.5 border-l border-base-200 pl-2 space-y-0.5 hidden";
        ul.setAttribute("role", "group");
        renderTreeNodes(children, ul, depth + 1, name);
        li.appendChild(ul);
      }

      parentEl.appendChild(li);
    });
  }

  function buildCmp(): void {
    const treeEl = document.getElementById("tree");
    const cmpEl = document.getElementById("cmp");
    const noteEl = document.getElementById("tree-note");
    if (!treeEl || !cmpEl || !noteEl) return;

    treeEl.classList.add("hidden");
    cmpEl.classList.remove("hidden");
    noteEl.innerHTML = NOTES.cmp;

    const D = getCatalogData();
    const comp = D.comp || [];
    const ej = D.ej || [];

    let h = '<h3 class="text-sm font-bold text-base-content mb-2 border-b border-base-300 pb-1.5">Métricas estructurales</h3><p class="text-xs text-base-content/60 mb-3">12.076 tickets de la rama 2 (2025-11-21 a 2026-10-06).</p>';
    h += '<div class="table-shell table-shell--stack rounded-box border border-base-300 bg-base-100 mb-6"><div class="scrollbar-thin overflow-x-auto max-h-none" data-table-scroll><table class="table table-sm table-zebra w-full text-xs font-mono"><caption class="sr-only">Métricas estructurales comparativas</caption><thead><tr><th scope="col">Métrica</th><th scope="col" class="text-right">Actual</th><th scope="col" class="text-right">A - intención</th><th scope="col" class="text-right">B - sistema</th><th scope="col" class="text-right">C - híbrida</th></tr></thead><tbody>';

    comp.forEach((r) => {
      const w = { actual: "", a: "", b: "", c: "" };
      if (r.mejor === "a") w.a = "text-success font-bold bg-success/10";
      else if (r.mejor === "b") w.b = "text-success font-bold bg-success/10";
      else if (r.mejor === "c") w.c = "text-success font-bold bg-success/10";
      else if (r.mejor === "actual") w.actual = "text-success font-bold bg-success/10";

      h += `<tr><td scope="row" class="font-sans font-medium">${esc(r.m)}${r.u ? ` <span class="text-base-content/50 font-normal">(${esc(r.u)})</span>` : ""}</td>` +
           `<td class="text-right ${w.actual}" data-label="Actual">${esc(r.actual)}</td>` +
           `<td class="text-right ${w.a}" data-label="A - intención">${esc(r.a)}</td>` +
           `<td class="text-right ${w.b}" data-label="B - sistema">${esc(r.b)}</td>` +
           `<td class="text-right ${w.c}" data-label="C - híbrida">${esc(r.c)}</td></tr>`;
    });
    h += '</tbody></table></div></div>';

    h += '<h3 class="text-sm font-bold text-base-content mb-2 border-b border-base-300 pb-1.5">Las 30 categorías más usadas: dónde están hoy y dónde quedarían</h3>';
    h += '<p class="text-xs text-base-content/60 mb-3">Ordenadas por volumen. En B todas quedan a 2 selecciones.</p>';
    h += '<div class="table-shell table-shell--stack rounded-box border border-base-300 bg-base-100"><div class="scrollbar-thin overflow-x-auto max-h-none" data-table-scroll><table class="table table-sm table-zebra w-full text-xs font-mono"><caption class="sr-only">30 categorías más usadas</caption><thead><tr><th scope="col" class="text-right">Tickets</th><th scope="col" class="text-right">Sel. hoy</th><th scope="col">Ruta actual</th><th scope="col">Ruta B</th><th scope="col">Ruta C</th></tr></thead><tbody>';

    ej.forEach((r) => {
      const seg = (r.desde || "").split(" > ");
      h += `<tr><td class="text-right font-bold" data-label="Tickets">${r.v}</td><td class="text-right" data-label="Sel. hoy">${seg.length}</td>` +
           `<td class="font-sans" data-label="Ruta actual">${esc(r.desde)}</td><td class="font-sans" data-label="Ruta B">${cleanPath(r.hasta)}</td><td class="font-sans" data-label="Ruta C">${cleanPath(r.hastaC)}</td></tr>`;
    });
    h += '</tbody></table></div></div>';

    cmpEl.innerHTML = h;

    const foot = document.getElementById("tree-explorer-foot");
    if (foot) foot.textContent = "";
  }

  function build(): void {
    const treeEl = document.getElementById("tree");
    const cmpEl = document.getElementById("cmp");
    const noteEl = document.getElementById("tree-note");
    if (!treeEl || !cmpEl || !noteEl) return;

    if (currentView === "cmp") {
      buildCmp();
      return;
    }

    cmpEl.classList.add("hidden");
    treeEl.classList.remove("hidden");
    treeEl.innerHTML = "";

    const D = getCatalogData();
    const rawNodes = currentView === "cur" ? [D.actual] : currentView === "a" ? D.a : currentView === "b" ? D.b : D.c;
    const nodes = JSON.parse(JSON.stringify(rawNodes || [])) as RawNode[];

    if (currentView !== "cur") {
      markFusions(nodes);
    }

    renderTreeNodes(nodes, treeEl, 0, null);
    noteEl.innerHTML = NOTES[currentView] || "";

    const firstItem = document.querySelector<HTMLElement>("#tree-explorer-container #tree li[role='treeitem']");
    if (firstItem) {
      firstItem.tabIndex = 0;
    }

    if (currentView === "a" || currentView === "b" || currentView === "c") {
      expandFirst();
    } else {
      expandTo(2);
    }

    if (query) {
      applyFilter();
    }
  }

  function setView(v: "c" | "cur" | "a" | "b" | "cmp"): void {
    currentView = v;
    const viewButtons = [
      { id: "vC", v: "c" },
      { id: "vCur", v: "cur" },
      { id: "vA", v: "a" },
      { id: "vB", v: "b" },
      { id: "vCmp", v: "cmp" },
    ];

    viewButtons.forEach(({ id, v: btnView }) => {
      const btn = document.getElementById(id);
      if (!btn) return;
      if (btnView === v) {
        btn.classList.add("btn-primary", "btn-active", "on");
      } else {
        btn.classList.remove("btn-primary", "btn-active", "on");
      }
    });

    build();
  }

  function updateFullscreenUI(active: boolean): void {
    const container = document.getElementById("tree-explorer-container");
    const btnFs = document.getElementById("btn-toggle-fullscreen");
    if (!container) return;
    const iconExpand = btnFs?.querySelector(".icon-expand");
    const iconCompress = btnFs?.querySelector(".icon-compress");
    const fsText = btnFs?.querySelector(".fs-text");
    const fsEscapeHint = container.querySelector(".fs-escape-hint");

    if (active) {
      container.classList.add("fullscreen-active");
      iconExpand?.classList.add("hidden");
      iconCompress?.classList.remove("hidden");
      if (fsText) fsText.textContent = "Salir";
      btnFs?.setAttribute("aria-pressed", "true");
      fsEscapeHint?.classList.remove("hidden");
    } else {
      container.classList.remove("fullscreen-active");
      iconExpand?.classList.remove("hidden");
      iconCompress?.classList.add("hidden");
      if (fsText) fsText.textContent = "Pantalla completa";
      btnFs?.setAttribute("aria-pressed", "false");
      fsEscapeHint?.classList.add("hidden");
    }
  }

  function toggleFullscreen(forceActive?: boolean): void {
    const container = document.getElementById("tree-explorer-container");
    if (!container) return;

    const currentActive =
      container.classList.contains("fullscreen-active") ||
      document.fullscreenElement === container;

    const shouldBeActive = forceActive !== undefined ? forceActive : !currentActive;

    updateFullscreenUI(shouldBeActive);

    if (shouldBeActive) {
      if (container.requestFullscreen && document.fullscreenElement !== container) {
        container.requestFullscreen().catch(() => {});
      }
    } else {
      if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      }
    }
  }

  function teardownTreeExplorer(): void {
    if (abortController) {
      abortController.abort();
      abortController = null;
    }
    if (debounceTimer) {
      clearTimeout(debounceTimer);
      debounceTimer = null;
    }
    currentView = "c";
    query = "";
  }

  function initTreeExplorer(): void {
    const container = document.getElementById("tree-explorer-container");
    if (!container) return;

    teardownTreeExplorer();
    abortController = new AbortController();
    const { signal } = abortController;

    const handleFullscreenChange = () => {
      const isNowFs = document.fullscreenElement === container;
      if (!isNowFs && container.classList.contains("fullscreen-active")) {
        updateFullscreenUI(false);
      } else if (isNowFs && !container.classList.contains("fullscreen-active")) {
        updateFullscreenUI(true);
      }
    };
    document.addEventListener("fullscreenchange", handleFullscreenChange, { signal });

    window.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Escape") {
          const isFs =
            container.classList.contains("fullscreen-active") ||
            document.fullscreenElement === container;
          if (isFs) {
            toggleFullscreen(false);
          }
        }
      },
      { signal }
    );

    const btnFs = document.getElementById("btn-toggle-fullscreen");
    btnFs?.addEventListener("click", () => toggleFullscreen(), { signal });

    const searchInput = document.getElementById("tree-search-input") as HTMLInputElement | null;
    const clearBtn =
      document.getElementById("clear-tree-search-input") ||
      document.querySelector('[data-clear-btn="tree-search-input"]');

    searchInput?.addEventListener(
      "input",
      (e) => {
        query = (e.target as HTMLInputElement).value;
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          applyFilter();
        }, 180);
      },
      { signal }
    );

    clearBtn?.addEventListener(
      "click",
      () => {
        if (debounceTimer) clearTimeout(debounceTimer);
        query = "";
        if (searchInput) searchInput.value = "";
        applyFilter();
      },
      { signal }
    );

    document.getElementById("vC")?.addEventListener("click", () => setView("c"), { signal });
    document.getElementById("vCur")?.addEventListener("click", () => setView("cur"), { signal });
    document.getElementById("vA")?.addEventListener("click", () => setView("a"), { signal });
    document.getElementById("vB")?.addEventListener("click", () => setView("b"), { signal });
    document.getElementById("vCmp")?.addEventListener("click", () => setView("cmp"), { signal });

    document.getElementById("btn-expand-all")?.addEventListener(
      "click",
      () => {
        expandAll();
        if (query) applyFilter();
      },
      { signal }
    );

    document.getElementById("btn-collapse-all")?.addEventListener(
      "click",
      () => {
        collapseAll();
        if (query) applyFilter();
      },
      { signal }
    );

    const treeList = document.getElementById("tree");
    treeList?.addEventListener(
      "click",
      (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const clkNm = target.closest(".nm.clk");
        const tw = target.closest(".tw");
        if (clkNm || tw) {
          const li = target.closest<HTMLElement>('li[role="treeitem"]');
          if (li && childUl(li)) {
            toggle(li);
            updateRovingTabindex(li);
          }
        }
      },
      { signal }
    );

    treeList?.addEventListener(
      "keydown",
      (e) => {
        const target = e.target as HTMLElement | null;
        const li = target?.closest<HTMLElement>('li[role="treeitem"]');
        if (!li) return;
        const ul = childUl(li);
        const k = e.key;

        if (k === "Enter" || k === " ") {
          if (ul) {
            e.preventDefault();
            toggle(li);
          }
        } else if (k === "ArrowDown") {
          e.preventDefault();
          const visible = getVisibleTreeItems();
          const idx = visible.indexOf(li);
          if (idx >= 0 && idx < visible.length - 1) {
            updateRovingTabindex(visible[idx + 1]);
          }
        } else if (k === "ArrowUp") {
          e.preventDefault();
          const visible = getVisibleTreeItems();
          const idx = visible.indexOf(li);
          if (idx > 0) {
            updateRovingTabindex(visible[idx - 1]);
          }
        } else if (k === "ArrowRight") {
          if (ul) {
            e.preventDefault();
            if (!isOpen(li)) {
              setOpen(li, true);
            } else {
              const first = li.querySelector<HTMLElement>(":scope > ul > li");
              if (first) updateRovingTabindex(first);
            }
          }
        } else if (k === "ArrowLeft") {
          if (ul && isOpen(li)) {
            e.preventDefault();
            setOpen(li, false);
          } else {
            const up = li.parentElement?.closest<HTMLElement>('li[role="treeitem"]');
            if (up) {
              e.preventDefault();
              updateRovingTabindex(up);
            }
          }
        }
      },
      { signal }
    );

    build();
  }

  document.addEventListener("astro:page-load", initTreeExplorer);
  document.addEventListener("astro:before-swap", teardownTreeExplorer);

  if (document.readyState === "complete" || document.readyState === "interactive") {
    initTreeExplorer();
  }
</script>
