<style is:global>
  #category-executive-report.fullscreen-active,
  #category-executive-report:fullscreen {
    position: fixed !important;
    inset: 0 !important;
    z-index: 250 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-width: 100% !important;
    max-height: 100% !important;
    background-color: var(--color-base-100) !important;
    padding: 2rem 1.5rem !important;
    overflow-y: auto !important;
    margin: 0 !important;
  }
</style>

<script>
  let abortController: AbortController | null = null;

  function toggleReportFullscreen(forceActive?: boolean): void {
    const container = document.getElementById("category-executive-report");
    const btnFs = document.getElementById("btn-report-fullscreen");
    if (!container) return;

    const iconExpand = btnFs?.querySelector(".icon-expand");
    const iconCompress = btnFs?.querySelector(".icon-compress");
    const fsText = btnFs?.querySelector(".fs-text");

    const isNativeFs = document.fullscreenElement === container;
    const isClassFs = container.classList.contains("fullscreen-active");
    const willBeActive = forceActive !== undefined ? forceActive : !(isNativeFs || isClassFs);

    if (willBeActive) {
      if (container.requestFullscreen) {
        container.requestFullscreen().catch(() => {
          container.classList.add("fullscreen-active");
        });
      } else {
        container.classList.add("fullscreen-active");
      }
      container.classList.add("fullscreen-active");
      iconExpand?.classList.add("hidden");
      iconCompress?.classList.remove("hidden");
      btnFs?.setAttribute("aria-pressed", "true");
      if (fsText) fsText.textContent = "Salir";
    } else {
      if (document.fullscreenElement === container && document.exitFullscreen) {
        void document.exitFullscreen().catch(() => {});
      }
      container.classList.remove("fullscreen-active");
      iconExpand?.classList.remove("hidden");
      iconCompress?.classList.add("hidden");
      btnFs?.setAttribute("aria-pressed", "false");
      if (fsText) fsText.textContent = "Pantalla completa";
    }
  }

  function teardownReportFullscreen(): void {
    if (abortController) {
      abortController.abort();
      abortController = null;
    }
  }

  function initReportFullscreen(): void {
    const container = document.getElementById("category-executive-report");
    const btnFs = document.getElementById("btn-report-fullscreen");
    if (!container || !btnFs) return;

    teardownReportFullscreen();
    abortController = new AbortController();
    const { signal } = abortController;

    btnFs.addEventListener("click", () => toggleReportFullscreen(), { signal });

    document.addEventListener(
      "fullscreenchange",
      () => {
        const isFs = document.fullscreenElement === container;
        if (!isFs && container.classList.contains("fullscreen-active")) {
          toggleReportFullscreen(false);
        }
      },
      { signal }
    );

    window.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Escape" && container.classList.contains("fullscreen-active")) {
          toggleReportFullscreen(false);
        }
      },
      { signal }
    );
  }

  initReportFullscreen();
  document.addEventListener("astro:page-load", initReportFullscreen);
  document.addEventListener("astro:before-swap", teardownReportFullscreen);
</script>
