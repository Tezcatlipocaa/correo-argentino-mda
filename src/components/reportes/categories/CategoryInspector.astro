---
import { Icon } from "astro-icon/components";
---

<div
  id="category-inspector-backdrop"
  class="pointer-events-none fixed inset-0 z-40 bg-black/30 opacity-0 backdrop-blur-xs transition-opacity duration-300"
  aria-hidden="true"
>
</div>

<aside
  id="category-inspector-drawer"
  class="border-base-300 bg-base-100 fixed top-20 right-0 z-50 flex h-[calc(100vh-5rem)] w-96 translate-x-full flex-col justify-between border-l p-6 shadow-2xl transition-transform duration-300"
  aria-label="Inspector de categoría"
>
  <div class="space-y-6 overflow-y-auto">
    <div
      class="border-base-200 flex items-center justify-between border-b pb-4"
    >
      <div class="flex items-center gap-2">
        <Icon
          name="boxicons:info-circle-filled"
          size={24}
          class="text-secondary"
        />
        <h2 class="text-base-content text-lg font-bold">
          Detalle de Categoría
        </h2>
      </div>
      <button
        id="inspect-close"
        type="button"
        class="btn btn-ghost btn-circle btn-sm"
        aria-label="Cerrar inspector"
      >
        <Icon name="boxicons:x" size={20} />
      </button>
    </div>

    <div class="space-y-4">
      <div>
        <span
          class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
          >Nombre</span
        >
        <p
          id="inspect-name"
          class="text-base-content mt-0.5 text-base font-bold"
        >
          -
        </p>
      </div>

      <div>
        <span
          class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
          >Ruta Jerárquica</span
        >
        <p
          id="inspect-path"
          class="bg-base-200 rounded-box text-base-content/80 mt-1 p-2.5 font-mono text-xs wrap-break-word"
        >
          -
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="bg-base-200/50 rounded-box border-base-200 border p-3">
          <span class="text-base-content/60 text-xs">Total Tickets</span>
          <p
            id="inspect-tickets"
            class="text-base-content mt-1 font-mono text-lg font-bold"
          >
            0 tk
          </p>
        </div>
        <div class="bg-base-200/50 rounded-box border-base-200 border p-3">
          <span class="text-base-content/60 text-xs">% Mesa / Total</span>
          <p
            id="inspect-share"
            class="text-base-content mt-1 font-mono text-lg font-bold"
          >
            -%
          </p>
        </div>
        <div class="bg-base-200/50 rounded-box border-base-200 border p-3">
          <span class="text-base-content/60 text-xs">Profundidad</span>
          <p
            id="inspect-depth"
            class="text-base-content mt-1 font-mono text-lg font-bold"
          >
            Nivel -
          </p>
        </div>
        <div class="bg-base-200/50 rounded-box border-base-200 border p-3">
          <span class="text-base-content/60 text-xs">Hijos Directos</span>
          <p
            id="inspect-children"
            class="text-base-content mt-1 font-mono text-lg font-bold"
          >
            0
          </p>
        </div>
      </div>

      <div>
        <span
          class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
          >Estado y Anomalías</span
        >
        <div id="inspect-badges" class="mt-1.5 flex flex-wrap gap-1.5">
          <span class="badge badge-sm badge-neutral">Ninguno</span>
        </div>
      </div>

      <div
        class="bg-base-200/50 rounded-box border-base-300 space-y-2 border p-3.5"
      >
        <div class="flex items-center justify-between">
          <div
            class="text-secondary flex items-center gap-1.5 text-xs font-bold tracking-wider uppercase"
          >
            <Icon name="boxicons:network-chart-filled" size={16} />
            <span>Vínculo InvGate & KB</span>
          </div>
          <span id="inspect-invgate-badge" class="badge badge-xs badge-neutral"
            >Consultando...</span
          >
        </div>
        <div id="inspect-kb-container" class="space-y-1 text-xs">
          <p class="text-base-content/60">
            Buscando guías operativas asociadas...
          </p>
        </div>
      </div>

      <div
        class="bg-base-200/60 rounded-box border-base-300 space-y-1.5 border p-4"
      >
        <div
          class="text-secondary flex items-center gap-1.5 text-xs font-bold tracking-wider uppercase"
        >
          <Icon name="boxicons:light-bulb-filled" size={16} />
          <span>Acción Recomendada</span>
        </div>
        <p
          id="inspect-action"
          class="text-base-content/80 text-xs leading-relaxed"
        >
          Seleccione un nodo del árbol para analizar su plan de remediación
          sugerido.
        </p>
      </div>
    </div>
  </div>

  <div class="border-base-200 flex justify-end border-t pt-4">
    <button id="inspect-close-btn" type="button" class="btn btn-sm btn-ghost">
      Cerrar
    </button>
  </div>
</aside>

<script>
  import { getCleanBase } from "@lib/baseUrl";

  interface InspectedNode {
    id: number;
    name: string;
    path: string;
    totalTickets: number;
    depth: number;
    status: string;
    anomalies: string[];
    isLeaf: boolean;
    children?: InspectedNode[];
  }

  const cleanBase = getCleanBase();
  const drawer = document.getElementById("category-inspector-drawer");
  const backdrop = document.getElementById("category-inspector-backdrop");
  const closeBtn = document.getElementById("inspect-close");
  const closeBtnBottom = document.getElementById("inspect-close-btn");
  const nameEl = document.getElementById("inspect-name");
  const pathEl = document.getElementById("inspect-path");
  const ticketsEl = document.getElementById("inspect-tickets");
  const shareEl = document.getElementById("inspect-share");
  const depthEl = document.getElementById("inspect-depth");
  const childrenEl = document.getElementById("inspect-children");
  const badgesEl = document.getElementById("inspect-badges");
  const actionEl = document.getElementById("inspect-action");
  const invgateBadgeEl = document.getElementById("inspect-invgate-badge");
  const kbContainerEl = document.getElementById("inspect-kb-container");

  let rootTotalTickets: number | null = null;
  let currentRequestId = 0;

  function closeDrawer() {
    drawer?.classList.add("translate-x-full");
    backdrop?.classList.add("opacity-0", "pointer-events-none");
    backdrop?.classList.remove("opacity-100");
  }

  function openDrawer(node: InspectedNode) {
    if (!drawer) return;

    if (
      rootTotalTickets === null &&
      (node.depth === 0 || !node.path || node.path === node.name)
    ) {
      rootTotalTickets = node.totalTickets;
    }

    if (nameEl) nameEl.textContent = node.name;
    if (pathEl) pathEl.textContent = node.path;
    if (ticketsEl)
      ticketsEl.textContent = `${node.totalTickets.toLocaleString("es-AR")} tk`;
    if (depthEl) depthEl.textContent = `Nivel ${node.depth}`;

    const childrenCount = node.children ? node.children.length : 0;
    if (childrenEl) childrenEl.textContent = String(childrenCount);

    if (shareEl) {
      if (rootTotalTickets && rootTotalTickets > 0) {
        const pct = ((node.totalTickets / rootTotalTickets) * 100).toFixed(1);
        shareEl.textContent = `${pct}%`;
      } else {
        shareEl.textContent = "-%";
      }
    }

    if (badgesEl) {
      badgesEl.innerHTML = "";

      const statusBadge = document.createElement("span");
      if (node.totalTickets === 0) {
        statusBadge.className =
          "badge badge-sm font-mono opacity-50 bg-base-300/50 text-base-content/50 border-transparent";
        statusBadge.textContent = "0 tk (Sin uso)";
      } else if (node.totalTickets < 50) {
        statusBadge.className =
          "badge badge-sm font-mono bg-base-200 text-base-content border-base-300";
        statusBadge.textContent = "Bajo Volumen (<50 tk)";
      } else if (node.totalTickets < 200) {
        statusBadge.className =
          "badge badge-sm font-mono font-semibold bg-info/15 text-info border-info/30";
        statusBadge.textContent = "Volumen Medio (50-199 tk)";
      } else {
        statusBadge.className =
          "badge badge-sm font-mono font-bold bg-secondary/20 text-secondary border-secondary/35 shadow-xs";
        statusBadge.textContent = "Alto Volumen (200+ tk)";
      }
      badgesEl.appendChild(statusBadge);

      if (node.anomalies && node.anomalies.length > 0) {
        node.anomalies.forEach((anomaly) => {
          const aBadge = document.createElement("span");
          aBadge.className =
            "badge badge-sm badge-warning badge-outline font-sans";
          if (anomaly === "single_child") {
            aBadge.textContent = "Hijo Único";
          } else if (anomaly === "wildcard_name") {
            aBadge.textContent = "Nombre Genérico";
          } else {
            aBadge.textContent = anomaly;
          }
          badgesEl.appendChild(aBadge);
        });
      }
    }

    if (actionEl) {
      if (
        node.status === "dead" ||
        node.status === "zero" ||
        node.totalTickets === 0
      ) {
        actionEl.textContent =
          "Desactivar o podar de la taxonomía activa para reducir fricción de carga en el árbol.";
      } else if (node.anomalies?.includes("wildcard_name")) {
        actionEl.textContent =
          "Eliminar categoría genérica ('Consulta'/'Otros') y reemplazarla por subtemas tipificados.";
      } else if (node.anomalies?.includes("single_child")) {
        actionEl.textContent =
          "Colapsar nivel redundante: el nodo tiene un único hijo descendiente directo.";
      } else if (node.totalTickets >= 200 || node.status === "hot") {
        actionEl.textContent =
          "Alta concentración de volumen: evaluar creación de atajo inmediato o acceso rápido.";
      } else {
        actionEl.textContent =
          "Conservar en estructura estándar de navegación.";
      }
    }

    if (invgateBadgeEl) {
      invgateBadgeEl.className = "badge badge-xs badge-neutral";
      invgateBadgeEl.textContent = "Consultando...";
    }
    if (kbContainerEl) {
      kbContainerEl.innerHTML =
        '<div class="flex items-center gap-1.5 text-base-content/60"><span class="loading loading-spinner loading-xs text-secondary"></span><span>Buscando guías operativas asociadas...</span></div>';
    }

    const requestId = ++currentRequestId;
    fetch(
      `${cleanBase}api/reportes/categorias/node-details?id=${node.id}&name=${encodeURIComponent(node.name)}`,
    )
      .then((res) => {
        if (!res.ok) throw new Error("Error fetching node details");
        return res.json();
      })
      .then((data) => {
        if (requestId !== currentRequestId) return;

        if (invgateBadgeEl) {
          if (data.invgateStatus?.existsInCatalog) {
            invgateBadgeEl.className =
              "badge badge-xs badge-success text-success-content font-mono";
            invgateBadgeEl.textContent = `ID: ${data.invgateStatus.catalogId ?? node.id}`;
          } else {
            invgateBadgeEl.className =
              "badge badge-xs badge-ghost text-base-content/60";
            invgateBadgeEl.textContent = "Fuera de catálogo";
          }
        }

        if (kbContainerEl) {
          if (Array.isArray(data.kbArticles) && data.kbArticles.length > 0) {
            kbContainerEl.innerHTML = "";
            const ul = document.createElement("ul");
            ul.className = "space-y-1";
            data.kbArticles.forEach(
              (art: { id: number; title: string; url: string }) => {
                const li = document.createElement("li");
                const a = document.createElement("a");
                a.href = art.url;
                a.target = "_blank";
                a.rel = "noopener noreferrer";
                a.className =
                  "inline-flex items-center gap-1 text-secondary hover:underline line-clamp-1";
                a.textContent = art.title;
                li.appendChild(a);
                ul.appendChild(li);
              },
            );
            kbContainerEl.appendChild(ul);
          } else {
            kbContainerEl.innerHTML =
              '<p class="text-base-content/60 italic">Sin artículos de KB vinculados</p>';
          }
        }
      })
      .catch((err) => {
        if (requestId !== currentRequestId) return;
        console.error(err);
        if (invgateBadgeEl) {
          invgateBadgeEl.className =
            "badge badge-xs badge-ghost text-base-content/60";
          invgateBadgeEl.textContent = "No disponible";
        }
        if (kbContainerEl) {
          kbContainerEl.innerHTML =
            '<p class="text-base-content/60 italic">Sin artículos de KB vinculados</p>';
        }
      });

    drawer.classList.remove("translate-x-full");
    backdrop?.classList.remove("opacity-0", "pointer-events-none");
    backdrop?.classList.add("opacity-100");
  }

  closeBtn?.addEventListener("click", closeDrawer);
  closeBtnBottom?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !drawer?.classList.contains("translate-x-full")) {
      closeDrawer();
    }
  });

  window.addEventListener("category:inspect", (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (detail?.node) {
      openDrawer(detail.node);
    }
  });
</script>
