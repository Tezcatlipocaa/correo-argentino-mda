---
// NewMonthModal.astro
import Modal from "@components/ui/Modal.astro";
import FormField from "@components/ui/forms/FormField.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";
---

<Modal
  id="new-month-modal"
  title="Agregar Nuevo Mes"
  icon="boxicons:calendar-plus-filled"
  titleClass="font-black text-lg uppercase tracking-tight"
  zIndex="z-200"
  actionsFooter
>
  <Fragment slot="content">
    <div class="space-y-4">
      <FormField
        id="new-month-year"
        name="new-month-year"
        label="Seleccionar Año"
        type="number"
        value="2026"
        min="2020"
        max="2035"
        size="sm"
        inputClass="font-mono"
      />
      <SelectField
        id="new-month-month"
        name="new-month-month"
        label="Seleccionar Mes"
        size="sm"
      >
        <option value="0">Enero</option>
        <option value="1">Febrero</option>
        <option value="2">Marzo</option>
        <option value="3">Abril</option>
        <option value="4">Mayo</option>
        <option value="5">Junio</option>
        <option value="6">Julio</option>
        <option value="7">Agosto</option>
        <option value="8">Septiembre</option>
        <option value="9">Octubre</option>
        <option value="10">Noviembre</option>
        <option value="11">Diciembre</option>
      </SelectField>
    </div>
  </Fragment>
  <Fragment slot="actions">
    <ActionCancelButton
      type="button"
      id="cancel-new-month"
      label="Cancelar"
      icon="boxicons:x-filled"
      variant="error"
    />
    <ActionConfirmButton
      type="button"
      id="confirm-new-month"
      color="btn-secondary"
      label="Agregar Mes"
      icon="boxicons:check-filled"
    />
  </Fragment>
</Modal>

<script>
  import { createMonth } from "../lib/api";
  import { state } from "../lib/state";
  import { showToast } from "../lib/notifications";

  const modal = document.getElementById(
    "new-month-modal",
  ) as HTMLDialogElement | null;
  if (modal) {
    const yearInput = document.getElementById(
      "new-month-year",
    ) as HTMLInputElement | null;
    const monthSelect = document.getElementById(
      "new-month-month",
    ) as HTMLSelectElement | null;
    const cancelBtn = document.getElementById("cancel-new-month");
    const confirmBtn = document.getElementById(
      "confirm-new-month",
    ) as HTMLButtonElement | null;

    cancelBtn?.addEventListener("click", () => {
      if (yearInput) yearInput.value = "2026";
      if (monthSelect) monthSelect.value = "0";
      modal.close();
    });

    confirmBtn?.addEventListener("click", async (e) => {
      e.preventDefault();
      if (!yearInput || !monthSelect) return;

      const year = parseInt(yearInput.value, 10);
      const month = parseInt(monthSelect.value, 10);

      const newMonthStr = `${year}-${(month + 1).toString().padStart(2, "0")}`;
      const uniqueMonths = state.uniqueMonths;

      if (uniqueMonths.includes(newMonthStr)) {
        showToast(
          "El mes seleccionado ya existe en los registros. No se puede volver a crear para evitar pérdida de datos.",
          "error",
        );
        return;
      }
      confirmBtn.disabled = true;
      try {
        await createMonth(year, month);
        modal.close();

        document.dispatchEvent(
          new CustomEvent("cronograma:month-created", {
            detail: { year, month },
          }),
        );
      } catch (err: unknown) {
        console.error("Error creating month:", err);
        const msg =
          err instanceof Error
            ? err.message
            : "Error al intentar crear el mes.";
        showToast(msg, "error");
      } finally {
        confirmBtn.disabled = false;
      }
    });
  }
</script>
