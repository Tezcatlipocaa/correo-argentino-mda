---
// OperatorFormModal.astro
import Modal from "@components/ui/Modal.astro";
import FormField from "@components/ui/forms/FormField.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";
---

<Modal
  id="edit-operator-modal"
  title="Editar Operador"
  icon="boxicons:edit-alt-filled"
  titleClass="font-black text-lg uppercase tracking-tight"
  zIndex="z-[200]"
  class="max-w-md"
  actionsFooter
>
  <Fragment slot="content">
    <input type="hidden" id="edit-op-original-name" />
    <div class="space-y-4">
      <FormField
        id="edit-op-name"
        name="edit-op-name"
        label="Nombre Completo"
        placeholder="Ej: Juan Pérez"
        size="sm"
      />
      <FormField
        id="edit-op-username"
        name="edit-op-username"
        label="Nombre de Usuario (Red)"
        placeholder="Ej: jperez"
        size="sm"
        inputClass="font-mono"
      />
      <SelectField
        id="edit-op-location"
        name="edit-op-location"
        label="Sede Principal"
        size="sm"
      >
        <option value="Monte Grande">Monte Grande</option>
        <option value="Parque Patricios">Parque Patricios</option>
      </SelectField>
    </div>
  </Fragment>
  <Fragment slot="actions">
    <ActionCancelButton
      type="button"
      id="cancel-edit-op"
      label="Cancelar"
      variant="error"
    />
    <ActionConfirmButton
      type="button"
      id="confirm-edit-op"
      color="btn-secondary"
      label="Guardar Cambios"
      icon="boxicons:check-filled"
    />
  </Fragment>
</Modal>

<script>
  import { editOperator } from "../lib/api";
  import { showToast } from "../lib/notifications";

  const editModal = document.getElementById(
    "edit-operator-modal",
  ) as HTMLDialogElement | null;
  if (editModal) {
    const originalNameInput = document.getElementById(
      "edit-op-original-name",
    ) as HTMLInputElement | null;
    const nameInput = document.getElementById(
      "edit-op-name",
    ) as HTMLInputElement | null;
    const usernameInput = document.getElementById(
      "edit-op-username",
    ) as HTMLInputElement | null;
    const locationSelect = document.getElementById(
      "edit-op-location",
    ) as HTMLSelectElement | null;
    const confirmBtn = document.getElementById(
      "confirm-edit-op",
    ) as HTMLButtonElement | null;
    const cancelBtn = document.getElementById(
      "cancel-edit-op",
    ) as HTMLButtonElement | null;

    cancelBtn?.addEventListener("click", () => {
      editModal.close();
    });

    confirmBtn?.addEventListener("click", async () => {
      const originalName = originalNameInput?.value?.trim();
      const name = nameInput?.value?.trim();
      const username = usernameInput?.value?.trim() || "";
      const location = locationSelect?.value || "Monte Grande";
      const horarioDefault = "";

      if (!name || !originalName) {
        showToast("El nombre completo es requerido.", "warning");
        return;
      }

      confirmBtn.disabled = true;
      try {
        await editOperator({
          originalName,
          name,
          username,
          location,
          horarioDefault,
        });
        editModal.close();
        document.dispatchEvent(new CustomEvent("cronograma:data-changed"));
      } catch (err: unknown) {
        console.error("Error editing operator:", err);
        const msg =
          err instanceof Error
            ? err.message
            : "Error al intentar modificar operador.";
        showToast(msg, "error");
      } finally {
        confirmBtn.disabled = false;
      }
    });
  }
</script>
