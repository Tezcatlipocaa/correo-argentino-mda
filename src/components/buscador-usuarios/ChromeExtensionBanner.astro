---
import { Icon } from "astro-icon/components";
import CopyButton from "@components/ui/CopyButton.astro";
import { db } from "@db/index";
import { applications } from "@db/schema";
import { eq } from "drizzle-orm";
import { decryptData } from "@lib/encryption";
import { canUserAccessCredentials } from "@lib/credentialAccess";

const FALLBACK_API_URL = "https://mda.correo.local/api/usuarios";
const MDA_FIND_TITLE = "Extensión MDA FIND";

const isWebUrl = (value: string): boolean => /^https?:\/\//i.test(value);

const mdaFindApp = await db.query.applications.findFirst({
  where: eq(applications.title, MDA_FIND_TITLE),
});

const user = Astro.locals.user;
const isAuthenticated = user && user.id !== 0;

let rawEntries: Array<{ label: string; value: string; minRole?: any; helpdesk?: string | null }> = [];

if (isAuthenticated && mdaFindApp?.metadata) {
  try {
    const parsed = JSON.parse(decryptData(mdaFindApp.metadata));
    if (Array.isArray(parsed)) {
      rawEntries = parsed.filter(
        (meta) => meta && typeof meta === "object" && meta.label,
      );
    }
  } catch (err) {
    console.error("Error al desencriptar metadatos de la extensión MDA:", err);
  }
}

const entries = rawEntries
  .map((meta, originalIndex) => ({ ...meta, originalIndex }))
  .filter((meta) => canUserAccessCredentials(user, { minRole: meta.minRole, helpdesk: meta.helpdesk }));

const displayEntries = entries.length > 0 ? entries : (isAuthenticated ? [] : [{ label: "URL de la API", value: FALLBACK_API_URL, originalIndex: -1 }]);
---

<div
  class="group border-accent/20 from-accent/5 relative flex flex-col justify-center overflow-hidden rounded-2xl border bg-linear-to-br via-transparent to-transparent p-6 backdrop-blur-md transition-all duration-300 lg:p-8"
>
  <!-- Efecto de brillo sutil de fondo -->
  <div
    class="bg-accent/10 group-hover:bg-accent/20 absolute -right-12 -bottom-12 size-48 rounded-full blur-3xl transition-colors duration-500"
  >
  </div>

  <div class="relative z-10 mb-4 flex items-center gap-4">
    <div
      class="bg-accent/10 text-accent flex size-12 shrink-0 items-center justify-center rounded-xl shadow-inner transition-transform duration-300 group-hover:scale-105"
    >
      <Icon name="boxicons:puzzle-filled" size={24} />
    </div>
    <div>
      <h2 class="text-accent text-lg font-bold tracking-tight">
        Extensi&#243;n MDA
      </h2>
      <div
        class="text-xxs text-base-content/40 mt-1 font-bold tracking-widest uppercase"
      >
        Chrome / Edge
      </div>
    </div>
  </div>

  <p class="text-base-content/60 relative z-10 flex-1 text-sm">
    Busca usuarios al instante desde cualquier pestaña sin interrumpir tu tarea
    actual.
  </p>

  <div
    class="border-accent/10 relative z-10 mt-4 space-y-3 border-t pt-4"
  >
    {
      displayEntries.map((meta) => (
        <div
          data-extension-credential-row
          data-app-id={mdaFindApp?.id}
          data-meta-index={meta.originalIndex}
        >
          <div
            class="text-xxs text-base-content/40 mb-1.5 font-bold tracking-widest uppercase"
          >
            {meta.label}
          </div>
          {isWebUrl(meta.value) ? (
            <div class="flex items-center gap-2">
              <code
                class="bg-base-300/50 border-base-300 text-base-content/70 flex-1 truncate rounded-lg border px-2.5 py-1.5 font-mono text-xs select-all"
              >
                {meta.value}
              </code>
              <CopyButton
                variant="icon"
                value={meta.value}
                label={`Copiar ${meta.label}`}
                copiedLabel="Copiado"
                ariaLabel={`Copiar ${meta.label}`}
                size="xs"
                showTooltip={false}
                class="shrink-0"
              />
            </div>
          ) : (
            <div class="flex items-center gap-2">
              <input
                type="password"
                placeholder="••••••••"
                readonly
                aria-label={`Valor de ${meta.label}`}
                class="input input-sm bg-base-300/50 border-base-300 text-base-content/70 min-w-0 flex-1 font-mono text-xs"
                data-password-input
              />
              <button
                type="button"
                class="btn btn-sm btn-ghost btn-square text-base-content/60 shrink-0"
                data-toggle-password
                title="Mostrar/Ocultar valor"
                aria-label="Mostrar u ocultar valor"
              >
                <Icon name="boxicons:eye-filled" size={16} data-show-icon />
                <Icon
                  name="boxicons:eye-slash-filled"
                  size={16}
                  class="hidden"
                  data-hide-icon
                />
              </button>
              <button
                type="button"
                class="btn btn-sm btn-ghost btn-square text-base-content/60 shrink-0"
                data-copy-credential
                title={`Copiar ${meta.label}`}
                aria-label={`Copiar ${meta.label}`}
              >
                <Icon
                  name="boxicons:clipboard-filled"
                  size={16}
                  data-copy-icon-default
                  aria-hidden="true"
                />
                <Icon
                  name="boxicons:check-filled"
                  size={16}
                  class="text-success hidden"
                  data-copy-icon-success
                  aria-hidden="true"
                />
              </button>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <a
    href="https://chromewebstore.google.com/detail/gijihnlphpfonpcglommpbefnmkobeoc?utm_source=item-share-cb"
    target="_blank"
    rel="noopener noreferrer"
    class="border-accent/10 group relative z-10 mt-6 flex items-center justify-between border-t pt-4"
  >
    <span
      class="text-base-content/50 group-hover:text-base-content/80 text-xs font-medium transition-colors"
      >Instalar desde Web Store</span
    >
    <Icon
      name="boxicons:chevron-right"
      size={20}
      class="text-accent transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    />
  </a>
</div>

<script>
  import { fetchRevealedCredential, copySecretToClipboard } from "@lib/credentialRevealClient";
  import { showToast } from "@lib/toastClient";

  const initExtensionReveal = () => {
    document.querySelectorAll("[data-extension-credential-row]").forEach((row) => {
      const toggleBtn = row.querySelector("[data-toggle-password]");
      const copyBtn = row.querySelector("[data-copy-credential]");
      const input = row.querySelector<HTMLInputElement>("[data-password-input]");
      const showIcon = row.querySelector<HTMLElement>("[data-show-icon]");
      const hideIcon = row.querySelector<HTMLElement>("[data-hide-icon]");

      const appId = Number(row.getAttribute("data-app-id"));
      const metaIndex = Number(row.getAttribute("data-meta-index"));

      if (toggleBtn && !toggleBtn.getAttribute("data-listener-added")) {
        toggleBtn.setAttribute("data-listener-added", "true");
        toggleBtn.addEventListener("click", async () => {
          if (!input) return;

          if (input.type === "text") {
            input.type = "password";
            showIcon?.classList.remove("hidden");
            hideIcon?.classList.add("hidden");
            return;
          }

          if (!input.value) {
            toggleBtn.setAttribute("disabled", "true");
            const secret = await fetchRevealedCredential({
              entityType: "application",
              entityId: appId,
              metaIndex,
            });
            toggleBtn.removeAttribute("disabled");
            if (secret === null) return;
            input.value = secret;
          }

          input.type = "text";
          showIcon?.classList.add("hidden");
          hideIcon?.classList.remove("hidden");
        });
      }

      if (copyBtn && !copyBtn.getAttribute("data-listener-added")) {
        copyBtn.setAttribute("data-listener-added", "true");
        copyBtn.addEventListener("click", async () => {
          if (!input) return;
          const defaultIcon = copyBtn.querySelector<HTMLElement>("[data-copy-icon-default]");
          const successIcon = copyBtn.querySelector<HTMLElement>("[data-copy-icon-success]");

          let secret = input.value;
          if (!secret) {
            copyBtn.setAttribute("disabled", "true");
            const fetched = await fetchRevealedCredential({
              entityType: "application",
              entityId: appId,
              metaIndex,
            });
            copyBtn.removeAttribute("disabled");
            if (fetched === null) return;
            secret = fetched;
            input.value = fetched;
          }

          const ok = await copySecretToClipboard(secret);
          if (ok) {
            defaultIcon?.classList.add("hidden");
            successIcon?.classList.remove("hidden");
            showToast("Copiado al portapapeles", "alert-success");
            setTimeout(() => {
              defaultIcon?.classList.remove("hidden");
              successIcon?.classList.add("hidden");
            }, 1800);
          }
        });
      }
    });
  };

  initExtensionReveal();
  document.addEventListener("astro:page-load", initExtensionReveal);
</script>
