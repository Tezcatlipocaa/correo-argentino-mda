---
import { Icon } from "astro-icon/components";
import Modal from "@components/ui/Modal.astro";
import InfoCard from "@components/ui/InfoCard.astro";
import SearchBar from "@components/ui/SearchBar.astro";
---

<Modal
  id="terminal-modal"
  size="full"
  class="w-full p-0 font-mono overflow-hidden flex flex-col h-[80vh]"
>
  <Fragment slot="content">
    <!-- Header -->
    <div
      class="bg-base-200 px-4 py-2.5 flex items-center justify-between border-b border-base-300 select-none shrink-0"
    >
      <div class="flex items-center gap-2 min-w-0">
        <Icon
          name="boxicons:command-filled"
          size={16}
          class="text-secondary shrink-0"
        />
        <span class="text-xs font-semibold text-base-content/70 truncate"
          >net user <span id="terminal-user-title" class="font-mono"></span> /domain</span
        >
      </div>
      <button
        type="button"
        class="btn btn-ghost btn-xs gap-1.5 cursor-pointer shrink-0"
        id="refresh-terminal-btn"
        title="Refrescar consulta"
      >
        <Icon
          name="boxicons:refresh-ccw-filled"
          size={16}
          class="transition-transform duration-300"
          id="refresh-terminal-icon"
        />
        <span class="text-xxs">Refrescar</span>
      </button>
    </div>

    <!-- Tabs -->
    <div class="flex border-b border-base-300 bg-base-200/50 px-4 shrink-0">
      <button
        id="tab-panel-btn"
        class="px-4 py-2.5 text-xs font-bold border-b-2 border-secondary text-secondary transition-all focus:outline-hidden cursor-pointer font-sans"
        type="button"
      >
        Panel Organizado
      </button>
      <button
        id="tab-console-btn"
        class="px-4 py-2.5 text-xs font-bold border-b-2 border-transparent text-base-content/60 hover:text-base-content transition-all focus:outline-hidden cursor-pointer font-sans"
        type="button"
      >
        Consola CMD
      </button>
      <button
        id="tab-invgate-btn"
        class="hidden px-4 py-2.5 text-xs font-bold border-b-2 border-transparent text-base-content/60 hover:text-base-content transition-all focus:outline-hidden cursor-pointer font-sans"
        type="button"
      >
        InvGate
      </button>
    </div>

    <!-- Contenido principal -->
    <div class="relative flex-1 min-h-0 overflow-hidden flex flex-col">
      <!-- Loader general -->
      <div
        id="terminal-loading"
        class="hidden absolute inset-0 bg-base-100/95 flex-col items-center justify-center gap-3 z-20"
      >
        <span class="loading loading-spinner loading-lg text-secondary"></span>
        <span class="text-xs text-base-content/60 font-sans text-center"
          >Consultando en AD</span
        >
      </div>

      <!-- VISTA 1: Panel Organizado -->
      <div
        id="view-panel"
        class="flex-1 min-h-0 grid grid-cols-1 md:grid-cols-5 gap-4 p-4 overflow-y-auto"
      >
        <!-- Columna Izquierda: Detalles (2/5) — scroll permitido -->
        <div
          class="md:col-span-2 space-y-2 border-r border-base-300 pr-4 overflow-y-auto scrollbar-thin"
        >
          <div
            class="text-xxs text-base-content/50 uppercase tracking-widest border-b border-base-300 pb-1 mb-1 font-bold font-sans"
          >
            Detalles de Red
          </div>

          <InfoCard
            icon="boxicons:user"
            label="Cuenta de Red"
            id="term-info-username"
            copyId="btn-copy-username"
            monospace
            copyLabel="Copiar cuenta"
          />
          <InfoCard
            icon="boxicons:user-id-card"
            label="Nombre Completo"
            id="term-info-fullname"
            copyId="btn-copy-fullname"
            copyLabel="Copiar nombre"
          />
          <InfoCard
            icon="boxicons:briefcase"
            label="Cargo / Puesto"
            id="term-info-title"
            copyId="btn-copy-title"
            copyLabel="Copiar cargo"
          />
          <InfoCard
            icon="boxicons:badge"
            label="Número de Legajo"
            id="term-info-employeenumber"
            copyId="btn-copy-employeenumber"
            monospace
            copyLabel="Copiar legajo"
          />
          <InfoCard
            icon="boxicons:building"
            label="Ubicación / Oficina"
            id="term-info-office"
            copyId="btn-copy-office"
            copyLabel="Copiar oficina"
          />
          <InfoCard
            icon="boxicons:user-circle"
            label="Jefe Directo"
            id="term-info-manager"
            showCopy={false}
            copyLabel="Copiar jefe"
          >
            <button
              slot="action"
              type="button"
              id="btn-search-manager"
              class="btn btn-secondary btn-sm font-sans px-2 hidden cursor-pointer shrink-0"
              title="Buscar supervisor en el portal"
            >
              <Icon name="boxicons:search-filled" size={16} class="shrink-0" />
              <span class="text-xs">Buscar</span>
            </button>
          </InfoCard>

          <div
            class="text-xxs text-base-content/50 uppercase tracking-widest border-b border-base-300 pb-1 mt-3 mb-1 font-bold font-sans"
          >
            Seguridad y Acceso
          </div>

          <InfoCard
            icon="boxicons:lock"
            label="Último cambio de clave"
            id="term-info-pwdlastset"
            copyId="btn-copy-pwdlastset"
            copyLabel="Copiar fecha"
          />
          <InfoCard
            icon="boxicons:door-open"
            label="Último login en red"
            id="term-info-lastlogon"
            copyId="btn-copy-lastlogon"
            copyLabel="Copiar login"
          />
          <InfoCard
            icon="boxicons:calendar-plus"
            label="Fecha de alta (cuenta)"
            id="term-info-whencreated"
            copyId="btn-copy-whencreated"
            copyLabel="Copiar fecha de alta"
          />
          <InfoCard
            icon="boxicons:timer"
            label="Vencimiento cuenta"
            id="term-info-expires"
            copyId="btn-copy-expires"
            copyLabel="Copiar vencimiento"
          />
        </div>

        <!-- Columna Derecha: Grupos (3/5) — scroll solo en el listado -->
        <div class="md:col-span-3 flex flex-col gap-2.5 overflow-hidden">
          <div
            class="flex items-center justify-between border-b border-base-300 pb-2 shrink-0"
          >
            <div class="flex items-center gap-2">
              <span
                class="text-xxs text-base-content/50 uppercase tracking-widest font-bold font-sans"
                >Grupos de Dominio</span
              >
              <span
                class="badge badge-sm badge-secondary text-secondary-content text-xxs font-sans font-bold"
                id="terminal-groups-count">0 grupos</span
              >
            </div>
            <button
              type="button"
              class="btn btn-ghost btn-xs text-secondary hover:bg-secondary/10 font-sans cursor-pointer gap-1 transition-all"
              id="copy-all-groups-btn"
              title="Copiar lista de grupos filtrados"
            >
              <Icon name="boxicons:copy" size={16} />
              <span>Copiar todos</span>
            </button>
          </div>

          <div class="flex items-center gap-3 shrink-0">
            <SearchBar
              id="terminal-groups-search"
              placeholder="Buscar o filtrar grupos..."
              size="xs"
              clearable
              class="flex-1"
            />
            <div class="join bg-base-200/50 shrink-0">
              <button
                type="button"
                id="btn-view-grid"
                class="btn btn-sm join-item px-3 text-secondary bg-base-300 cursor-pointer border-0"
                title="Vista Grilla"
              >
                <Icon name="boxicons:grid" size={16} />
              </button>
              <button
                type="button"
                id="btn-view-list"
                class="btn btn-sm join-item px-3 text-base-content/50 hover:text-base-content bg-transparent cursor-pointer border-0"
                title="Vista Lista"
              >
                <Icon name="boxicons:list-ul" size={16} />
              </button>
            </div>
          </div>

          <div
            class="flex flex-wrap gap-1.5 py-1 border-b border-base-300/40 pb-2 shrink-0"
            id="group-category-filters"
          >
            <button
              type="button"
              data-filter="all"
              class="btn btn-xs rounded-full"
              >Todos (<span id="count-all">0</span>)</button
            >
            <button
              type="button"
              data-filter="seguridad"
              class="btn btn-xs rounded-full"
              ><Icon name="boxicons:shield-filled" size={16} />Seguridad (<span
                id="count-seguridad">0</span
              >)</button
            >
            <button
              type="button"
              data-filter="correo"
              class="btn btn-xs rounded-full"
              ><Icon name="boxicons:envelope-filled" size={16} />Correo (<span
                id="count-correo">0</span
              >)</button
            >
            <button
              type="button"
              data-filter="sistemas"
              class="btn btn-xs rounded-full"
              ><Icon name="boxicons:desktop-filled" size={16} />Sistemas (<span
                id="count-sistemas">0</span
              >)</button
            >
            <button
              type="button"
              data-filter="otros"
              class="btn btn-xs rounded-full"
              ><Icon name="boxicons:key-filled" size={16} />Otros (<span
                id="count-otros">0</span
              >)</button
            >
          </div>

          <div
            id="terminal-groups-list"
            class="flex-1 min-h-0 bg-base-200/30 border border-base-300 p-3 rounded-lg overflow-y-auto scrollbar-thin transition-all grid grid-cols-2 gap-1.5 content-start auto-rows-max"
          >
          </div>
        </div>
      </div>

      <!-- VISTA 2: Consola CMD -->
      <div
        id="view-console"
        class="hidden flex-1 min-h-0 flex flex-col p-4 overflow-hidden"
      >
        <div
          class="flex items-center gap-2 text-base-content/50 text-xs shrink-0"
        >
          <span>Microsoft Windows [Versión 10.0.19045]</span>
        </div>
        <div class="text-xs text-base-content/50 shrink-0">
          (c) Microsoft Corporation. Todos los derechos reservados.
        </div>
        <div class="flex items-start gap-1 text-xs mt-2 shrink-0">
          <span class="text-secondary font-bold shrink-0">C:\Users\mda&gt;</span
          >
          <span class="text-base-content font-mono"
            >net user "<span id="terminal-command-username"></span>" /domain</span
          >
        </div>
        <div
          class="bg-base-250 border border-base-300 p-4 rounded-md flex-1 min-h-0 overflow-y-auto text-xs scrollbar-thin mt-3"
        >
          <pre
            id="terminal-output"
            class="whitespace-pre-wrap text-base-content/90 font-mono">
          </pre>
        </div>
      </div>

      <!-- VISTA 3: InvGate (sin scroll salvo tickets) -->
      <div
        id="view-invgate"
        class="hidden relative flex-1 min-h-0 overflow-y-auto scrollbar-thin p-3"
      >
        <!-- Loader de InvGate -->
        <div
          id="invgate-loading"
          class="hidden absolute inset-0 bg-base-100/95 flex-col items-center justify-center gap-3 z-20"
        >
          <span class="loading loading-spinner loading-lg text-secondary"
          ></span>
          <span class="text-xs text-base-content/60 font-sans text-center"
            >Consultando datos en InvGate</span
          >
        </div>

        <!-- Error de InvGate -->
        <div
          id="invgate-error"
          class="hidden absolute inset-0 bg-base-100/95 flex-col items-center justify-center gap-3 z-20 px-6"
        >
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-1.5">
          <div
            class="col-span-full text-xxs text-base-content/50 uppercase tracking-widest border-b border-base-300 pb-1 mb-0.5 mt-1 font-bold font-sans"
          >
            Cuenta InvGate
          </div>

          <InfoCard
            icon="boxicons:user-id-card"
            label="Nombre Completo"
            id="invgate-fullname"
            copyId="btn-copy-invgate-fullname"
            copyLabel="Copiar nombre"
          />
          <InfoCard
            icon="boxicons:envelope"
            label="Email"
            id="invgate-email"
            copyId="btn-copy-invgate-email"
            monospace
            copyLabel="Copiar email"
          />
          <InfoCard
            icon="boxicons:briefcase"
            label="Rol"
            id="invgate-role"
            copyId="btn-copy-invgate-role"
            copyLabel="Copiar rol"
          />
          <InfoCard
            icon="boxicons:briefcase-alt"
            label="Cargo / Puesto"
            id="invgate-position"
            copyId="btn-copy-invgate-position"
            copyLabel="Copiar cargo"
          />
          <!-- Jefe Directo -->
          <div
            class="bg-base-200/50 border border-base-300 rounded-lg p-2 group relative flex items-start gap-2 min-w-0"
          >
            <div
              class="size-10 rounded-md bg-secondary/10 text-secondary flex items-center justify-center shrink-0"
            >
              <Icon name="boxicons:user-circle-filled" size={24} />
            </div>
            <div class="min-w-0 flex-1">
              <span
                class="text-base-content/50 text-xs uppercase font-bold tracking-wider select-none block truncate"
                >Jefe Directo</span
              >
              <span
                id="invgate-manager"
                class="text-xs font-semibold text-base-content mt-0.5 truncate block"
                >-</span
              >
            </div>
            <button
              type="button"
              id="btn-search-invgate-manager"
              class="btn btn-secondary btn-sm font-sans px-2 hidden cursor-pointer shrink-0"
              title="Buscar jefe en el portal"
            >
              <Icon name="boxicons:search" size={16} class="shrink-0" />
              <span class="text-xs">Buscar</span>
            </button>
          </div>
          <InfoCard
            icon="boxicons:badge"
            label="ID de usuario"
            id="invgate-userid"
            copyId="btn-copy-invgate-userid"
            monospace
            copyLabel="Copiar ID"
          />

          <!-- Teléfonos -->
          <div
            class="col-span-full text-xxs text-base-content/50 uppercase tracking-widest border-b border-base-300 pb-1 mb-0.5 mt-2 font-bold font-sans"
          >
            Teléfonos
          </div>
          <div
            id="invgate-phones"
            class="col-span-full grid grid-cols-2 gap-1.5"
          >
          </div>

          <div
            class="col-span-full text-xxs text-base-content/50 uppercase tracking-widest border-b border-base-300 pb-1 mb-0.5 mt-2 font-bold font-sans"
          >
            Organización
          </div>

          <div class="col-span-full grid grid-cols-2 gap-1.5">
            <!-- Grupos -->
            <div
              class="bg-base-200/50 border border-base-300 rounded-lg p-2 flex flex-col gap-1.5 min-w-0 col-span-2"
            >
              <div class="flex items-center gap-1.5">
                <div
                  class="size-10 rounded-md bg-secondary/10 text-secondary flex items-center justify-center shrink-0"
                >
                  <Icon name="boxicons:group-filled" size={24} />
                </div>
                <span
                  class="text-base-content/50 text-xs uppercase font-bold tracking-wider select-none"
                  >Grupos</span
                >
              </div>
              <div
                class="flex flex-wrap gap-1 max-h-20 overflow-y-auto scrollbar-thin"
                id="invgate-groups"
              >
              </div>
            </div>

            <!-- Mesas de ayuda (chips) -->
            <div
              class="bg-base-200/50 border border-base-300 rounded-lg p-2 flex flex-col gap-1.5 min-w-0"
            >
              <div class="flex items-center gap-1.5">
                <div
                  class="size-10 rounded-md bg-secondary/10 text-secondary flex items-center justify-center shrink-0"
                >
                  <Icon name="boxicons:headphone-filled" size={24} />
                </div>
                <span
                  class="text-base-content/50 text-xs uppercase font-bold tracking-wider select-none"
                  >Mesas de ayuda</span
                >
              </div>
              <div
                class="flex flex-wrap gap-1 max-h-20 overflow-y-auto scrollbar-thin"
                id="invgate-helpdesks"
              >
              </div>
            </div>

            <!-- Ubicaciones (chips) -->
            <div
              class="bg-base-200/50 border border-base-300 rounded-lg p-2 flex flex-col gap-1.5 min-w-0"
            >
              <div class="flex items-center gap-1.5">
                <div
                  class="size-10 rounded-md bg-secondary/10 text-secondary flex items-center justify-center shrink-0"
                >
                  <Icon name="boxicons:building-filled" size={24} />
                </div>
                <span
                  class="text-base-content/50 text-xs uppercase font-bold tracking-wider select-none"
                  >Ubicaciones</span
                >
              </div>
              <div
                class="flex flex-wrap gap-1 max-h-20 overflow-y-auto scrollbar-thin"
                id="invgate-locations"
              >
              </div>
            </div>

            <div
              class="col-span-full text-xxs text-base-content/50 uppercase tracking-widest border-b border-base-300 pb-1 mb-0.5 mt-2 font-bold font-sans"
            >
              Actividad
            </div>

            <!-- Tickets relacionados -->
            <div
              class="bg-base-200/50 border border-base-300 rounded-lg p-2 flex flex-col gap-1.5 min-w-0 col-span-full"
            >
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5">
                  <div
                    class="size-10 rounded-md bg-secondary/10 text-secondary flex items-center justify-center shrink-0"
                  >
                    <Icon name="boxicons:task-filled" size={24} />
                  </div>
                  <span
                    class="text-base-content/50 text-xs uppercase font-bold tracking-wider select-none"
                    >Tickets relacionados</span
                  >
                </div>
                <span
                  id="invgate-open-tickets"
                  class="badge badge-sm badge-soft bg-success/10 text-success font-semibold"
                  >0</span
                >
              </div>
              <div
                id="invgate-tickets-list"
                class="flex flex-col gap-1 max-h-40 overflow-y-auto scrollbar-thin"
              >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div
        class="bg-base-200 px-4 py-2.5 flex items-center justify-between border-t border-base-300 select-none shrink-0"
      >
        <span class="text-xxs text-base-content/50 font-sans"
          >Conexión LDAP segura con mda.correo.local</span
        >
        <div class="flex gap-2">
          <button
            type="button"
            class="btn btn-ghost btn-xs gap-1"
            id="copy-terminal-btn"
          >
            <Icon name="boxicons:copy" size={16} />
            <span>Copiar salida raw</span>
          </button>
          <button
            type="button"
            class="btn btn-ghost btn-xs"
            id="close-terminal-footer-btn"
          >
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </Fragment>
</Modal>
