---
import DataTable from "@components/ui/DataTable.astro";
import { getModulePermissions } from "@lib/rbac";
import { can } from "@lib/roleConfig";

const user = Astro.locals.user;
const canWrite = getModulePermissions("base-conocimiento", user.role).canWrite;
const isAdmin = can(user.role, "admin");

const headerGridClass = isAdmin
  ? "grid-cols-[minmax(0,1.5fr)_180px_140px_110px_160px_180px_180px] gap-3"
  : canWrite
    ? "grid-cols-[minmax(0,1.5fr)_140px_110px_160px_180px_180px] gap-3"
    : "grid-cols-[minmax(0,1.5fr)_140px_160px_180px_180px] gap-3";
const rowGridClass = `grid ${headerGridClass} items-center`;
const minWidthClass = isAdmin
  ? "min-w-250"
  : canWrite
    ? "min-w-200"
    : "min-w-160";
---

<div class="skeleton-debounced space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="skeleton h-6 w-32"></div>
      <div class="skeleton h-5 w-8 rounded-full"></div>
    </div>
    {canWrite && <div class="skeleton h-10 w-36 rounded-lg" />}
  </div>

  <div class="skeleton h-12 w-full rounded-lg"></div>

  <DataTable
    ariaLabel="Cargando artículos"
    minWidthClass={minWidthClass}
    headerGridClass={headerGridClass}
    rowGridClass={rowGridClass}
  >
    <div slot="header">
      <div class="skeleton h-4 w-24"></div>
    </div>
    {
      isAdmin && (
        <div slot="header">
          <div class="skeleton h-4 w-28" />
        </div>
      )
    }
    <div slot="header">
      <div class="skeleton h-4 w-20"></div>
    </div>
    {
      canWrite && (
        <div slot="header">
          <div class="skeleton h-4 w-16" />
        </div>
      )
    }
    <div slot="header">
      <div class="skeleton h-4 w-20"></div>
    </div>
    <div slot="header">
      <div class="skeleton h-4 w-28"></div>
    </div>
    <div slot="header">
      <div class="skeleton h-4 w-16"></div>
    </div>

    {
      Array.from({ length: 5 }).map(() => (
        <div
          class:list={[
            rowGridClass,
            "border-base-300 border-b px-4 py-3 last:border-b-0",
          ]}
        >
          <div class="skeleton h-4 w-full" />
          {isAdmin && <div class="skeleton h-4 w-28" />}
          <div class="skeleton h-4 w-20" />
          {canWrite && <div class="skeleton h-5 w-16 rounded-full" />}
          <div class="skeleton h-4 w-24" />
          <div class="skeleton h-4 w-28" />
          <div class="flex justify-end gap-2">
            <div class="skeleton h-8 w-8 rounded-lg" />
            <div class="skeleton h-8 w-8 rounded-lg" />
          </div>
        </div>
      ))
    }
  </DataTable>
</div>
