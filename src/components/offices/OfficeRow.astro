---
import { Icon } from "astro-icon/components";
import CopyButton from "@components/ui/CopyButton.astro";
import OfficeContactsSection from "@components/offices/OfficeContactsSection.astro";
import OfficeEquipmentCard from "@components/offices/OfficeEquipmentCard.astro";
import ActionEditButton from "@components/ui/ActionEditButton.astro";
import ActionDeleteButton from "@components/ui/ActionDeleteButton.astro";
import { isAllowed } from "@lib/rolesMatrix";
import type { OfficeDirectoryItem } from "@types/offices";
import {
  officeTypeLabelByType,
  officeTypeChipClassByType,
  defaultChipClass,
  assetOrderByType,
} from "@lib/officeHelpers";
import { getDetailColumnLayout } from "@lib/officeLayout";

interface Props {
  office: OfficeDirectoryItem;
  isVisibleByDefault?: boolean;
}

const { office, isVisibleByDefault = true } = Astro.props;

const user = Astro.locals.user;
const isAllowedAdmin = user
  ? isAllowed("Administrar Contenido", user.role)
  : false;

const normalizedType =
  office.type === "SUCURSAL"
    ? office.officeType === "AUTOMATIZADA"
      ? "SUCURSAL_AUTOMATIZADA"
      : "SUCURSAL_NO_AUTOMATIZADA"
    : office.type;

const searchText = `${office.name} ${office.code} ${office.region} ${office.provinceName} ${office.location} ${office.postalCode} ${officeTypeLabelByType[normalizedType] || office.type} ${office.parentNis ?? ""} ${office.costCenter}`;
const hasContacts = office.contacts && office.contacts.length > 0;
const hasInfo = Boolean(office.email || office.notes);
const hasInvgateDetail: boolean = office.invgateLinked === true;

const totalAssets =
  (office.assets?.length || 0) + (office.terminals?.length || 0);
const hasAssetsSection = totalAssets > 0;
const siblings = office.siblings ?? [];
const hasSiblings = siblings.length > 0;

const layout = getDetailColumnLayout({
  hasInvgate: hasInvgateDetail,
  hasInfo,
  contactsCount: office.contacts?.length ?? 0,
  hasSiblings,
  hasAssets: hasAssetsSection,
});

const contactsToCenter = layout.contactsToCenter;
const hasDetails =
  hasInvgateDetail || hasInfo || hasContacts || hasAssetsSection || hasSiblings;

const officeDirectoryRowGridClass = isAllowedAdmin
  ? "grid grid-cols-[48px_80px_1.2fr_90px_1.8fr_110px_120px] items-center gap-4"
  : "grid grid-cols-[48px_80px_1.2fr_90px_1.8fr_110px] items-center gap-4";
---

<article
  data-master-detail-sort-item
  data-office-id={office.id}
  data-office-type={office.type}
  data-office-location={office.location}
  data-region={office.region}
  data-province-code={office.provinceCode}
  data-search-text={searchText}
  data-sort-code={office.code}
  data-sort-name={office.name}
  data-sort-parent-nis={office.parentNis ?? ""}
  data-sort-address={`${office.address} ${office.location} ${office.region} ${office.postalCode}`}
  data-sort-group={office.location}
  class:list={["block transition-all", !isVisibleByDefault && "hidden"]}
>
  <div
    data-office-master-row={hasDetails ? "" : undefined}
    data-office-id={office.id}
    aria-expanded={hasDetails ? "false" : undefined}
    class:list={[
      officeDirectoryRowGridClass,
      "border-b border-base-300 px-4 py-3 transition-colors",
      office.active === false &&
        "bg-base-200/50 [&_>_div:not(.action-buttons)]:grayscale [&_>_div:not(.action-buttons)]:opacity-80",
    ]}
  >
    <div>
      {
        hasDetails ? (
          <button
            type="button"
            data-chevron-toggle
            class="inline-flex size-8 cursor-pointer items-center justify-center rounded-lg border border-base-300 bg-base-200 text-base-content/70 transition-colors hover:bg-base-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
            aria-label="Expandir detalle"
          >
            <Icon
              name="boxicons:chevron-down-filled"
              data-chevron-closed
              size={16}
            />
            <Icon
              name="boxicons:chevron-up-filled"
              data-chevron-open
              class="hidden"
              size={16}
            />
          </button>
        ) : (
          <span class="inline-flex size-8" />
        )
      }
    </div>

    <div class="relative inline-flex">
      {
        office.invgateLinked ? (
          <span
            class="absolute -top-0.5 right-4.5 z-10 size-2 rounded-full bg-info dot-delayed-fade-in"
            title="Presente en InvGate"
          />
        ) : (
          <span
            class="absolute -top-0.5 right-4.5 z-10 size-2 rounded-full bg-neutral dot-delayed-fade-in"
            title="No registrada en InvGate"
          />
        )
      }
      <CopyButton
        value={office.code}
        variant="value"
        feedbackOnly={true}
        copiedLabel={`NIS ${office.code} copiado al portapapeles`}
        size="xs"
        appearance="ghost"
        monospace={true}
        highlightable={true}
        class={`font-semibold ${officeTypeChipClassByType[normalizedType] || "office-type-chip bg-base-300 text-base-content"}`}
      />
    </div>

    <div class="min-w-0">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <p class="truncate text-sm font-semibold text-base-content">
            <span data-highlight-target>{office.name}</span>
          </p>
          {
            office.active === false && (
              <span
                class="badge badge-error badge-sm font-semibold"
                title={office.closedReason || "Oficina inactiva/cerrada"}
              >
                Cerrada
              </span>
            )
          }
        </div>
        <div
          class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-base-content/55"
        >
          <span>
            {officeTypeLabelByType[normalizedType] || office.type}
          </span>
          <span class="text-base-content/35">/</span>
          <span>{office.contacts.length} contactos</span>
          <span class="text-base-content/35">/</span>
          <span>{totalAssets} activos</span>
        </div>
      </div>
    </div>

    {/* Dependencia (parent NIS) */}
    <div class="min-w-0">
      {
        office.parentNis ? (
          <span
            data-highlight-target
            class="inline-flex px-2 py-1 font-mono text-xs font-semibold bg-base-200 border border-base-300 rounded text-base-content/70"
          >
            {office.parentNis}
          </span>
        ) : (
          <span class="text-base-content/30">&mdash;</span>
        )
      }
    </div>

    <div class="min-w-0">
      <div class="min-w-0 space-y-1">
        <p class="flex min-w-0 items-center gap-2 text-sm text-base-content/75">
          <Icon
            name="boxicons:location-alt-filled"
            class="shrink-0 text-secondary"
            size={16}
            aria-hidden="true"
          />
          <span class="truncate" title={office.address}>
            {office.address}
          </span>
        </p>
        <p class="truncate text-xs text-base-content/55">
          {office.location}
        </p>
        <div
          class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-base-content/60"
        >
          <span data-highlight-target>
            {office.region}
          </span>
          {
            office.postalCode && (
              <>
                <span class="text-base-content/35">/</span>
                <span class="font-mono" data-highlight-target>
                  CP {office.postalCode}
                </span>
              </>
            )
          }
        </div>
      </div>
    </div>

    <div class="min-w-0">
      <span
        data-highlight-target
        class="font-mono text-xs text-base-content/70"
      >
        {office.costCenter}
      </span>
    </div>

    {
      isAllowedAdmin && (
        <div class="min-w-0 flex items-center justify-end gap-2 action-buttons">
          <ActionEditButton
            href={`${import.meta.env.BASE_URL}oficinas/edit/${office.dbId}`}
            ariaLabel={`Editar oficina ${office.name}`}
          />
          <form
            method="POST"
            action={`${import.meta.env.BASE_URL}oficinas/edit/${office.dbId}/eliminar`}
            class="inline"
            onsubmit={`return confirm('¿Estás seguro de que deseas eliminar la oficina \`${office.name}\` (${office.code})?');`}
          >
            <ActionDeleteButton ariaLabel={`Eliminar oficina ${office.name}`} />
          </form>
        </div>
      )
    }
  </div>

  <div
    data-office-detail-row
    data-office-id={office.id}
    class="hidden border-b border-base-300 bg-base-200/20"
  >
    <div class="office-detail-panel mx-4 my-3">
      <div class="bg-base-100 border border-base-300 rounded-box p-4">
        <div class="flex flex-col lg:flex-row gap-6">
          {
            layout.hasLeft && (
              <div
                class:list={["flex flex-col gap-5 min-w-0", layout.leftClass]}
              >
                {hasInfo && (
                  <section class="space-y-3">
                    <h2 class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-base-content/70">
                      <Icon
                        name="boxicons:info-circle-filled"
                        size={16}
                        class="text-secondary"
                        aria-hidden="true"
                      />
                      Información
                    </h2>
                    <div class="rounded-lg border border-base-300 bg-base-100/50 p-3 shadow-sm space-y-2">
                      {office.email && (
                        <p class="flex items-center gap-2 text-sm text-base-content/80">
                          <Icon
                            name="boxicons:envelope-filled"
                            size={14}
                            class="shrink-0 text-base-content/50"
                            aria-hidden="true"
                          />
                          <span class="font-mono text-xs break-all">
                            {office.email}
                          </span>
                        </p>
                      )}
                      {office.notes && (
                        <p class="flex items-start gap-2 text-xs text-base-content/60">
                          <Icon
                            name="boxicons:note-filled"
                            size={14}
                            class="mt-0.5 shrink-0 text-base-content/40"
                            aria-hidden="true"
                          />
                          <span>{office.notes}</span>
                        </p>
                      )}
                    </div>
                  </section>
                )}

                {hasInvgateDetail && (
                  <section class="space-y-3">
                    <h2 class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-base-content/70">
                      <Icon
                        name="boxicons:database-alt-filled"
                        size={16}
                        class="text-secondary"
                        aria-hidden="true"
                      />
                      Datos InvGate
                    </h2>
                    <div
                      class:list={[
                        "rounded-lg border border-base-300 bg-base-100/50 p-3 shadow-sm",
                        !hasAssetsSection
                          ? "flex flex-wrap items-start gap-x-5 gap-y-2"
                          : "space-y-2",
                      ]}
                    >
                      {office.invgateDisplayName && (
                        <p class="flex items-center gap-3 text-sm">
                          <span class="inline-block shrink-0 text-xs font-semibold text-base-content/60">
                            Nombre
                          </span>
                          <span class="text-sm text-base-content/90">
                            {office.invgateDisplayName}
                          </span>
                        </p>
                      )}
                      {office.invgateAddress && (
                        <p class="flex items-center gap-3 text-sm">
                          <span class="inline-block shrink-0 text-xs font-semibold text-base-content/60">
                            Dirección
                          </span>
                          <span class="text-sm text-base-content/90">
                            {office.invgateAddress}
                          </span>
                        </p>
                      )}
                      {office.invgateCp && (
                        <p class="flex items-center gap-3 text-sm">
                          <span class="inline-block shrink-0 text-xs font-semibold text-base-content/60">
                            CP
                          </span>
                          <span class="font-mono text-sm text-base-content/90">
                            {office.invgateCp}
                          </span>
                        </p>
                      )}
                      {office.invgateCc && (
                        <p class="flex items-center gap-3 text-sm">
                          <span class="inline-block shrink-0 text-xs font-semibold text-base-content/60">
                            CC
                          </span>
                          <span class="font-mono text-sm text-base-content/90">
                            {office.invgateCc}
                          </span>
                        </p>
                      )}
                      {office.invgateParentName && (
                        <p class="flex items-center gap-3 text-sm">
                          <span class="inline-block shrink-0 text-xs font-semibold text-base-content/60">
                            Ubicación superior
                          </span>
                          <span class="text-sm text-base-content/90">
                            {office.invgateParentName}
                          </span>
                        </p>
                      )}
                      {(office.invgateDuplicateCount ?? 0) > 0 && (
                        <p class="flex items-start gap-2 text-xs text-warning">
                          <span>
                            En InvGate se encontraron{" "}
                            {office.invgateDuplicateCount} registros con el
                            mismo NIS. Se vinculó el primero.
                          </span>
                        </p>
                      )}
                      {office.invgateLinked && (
                        <p class="flex items-center gap-3 text-sm">
                          <span class="inline-block shrink-0 text-xs font-semibold text-base-content/60">
                            Usuarios
                          </span>
                          <span class="text-sm text-base-content/90">
                            {office.invgateUserTotal ?? "-"}
                          </span>
                        </p>
                      )}
                      {!office.invgateCp &&
                        !office.invgateCc &&
                        !office.invgateAddress &&
                        !office.invgateDisplayName &&
                        !office.invgateParentName && (
                          <p class="text-xs text-base-content/50 italic">
                            Sin datos adicionales de InvGate
                          </p>
                        )}
                    </div>
                  </section>
                )}

                {/* Personal de la sucursal */}
                <section
                  class="space-y-3 hidden"
                  data-branch-personnel
                  data-nis={office.code}
                >
                  <h2 class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-base-content/70">
                    <Icon
                      name="boxicons:group-filled"
                      size={16}
                      class="text-secondary"
                      aria-hidden="true"
                    />
                    Referentes del sitio
                  </h2>
                  <div
                    data-branch-personnel-content
                    class="rounded-lg border border-base-300 bg-base-100/50 p-3 shadow-sm"
                  />
                </section>

                {hasContacts && !contactsToCenter && (
                  <OfficeContactsSection contacts={office.contacts} />
                )}
              </div>
            )
          }

          {
            layout.hasCenter && (
              <div
                class:list={["flex flex-col gap-5 min-w-0", layout.centerClass]}
              >
                {hasSiblings && (
                  <section class="space-y-3" data-siblings-section>
                    <h2 class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-base-content/70">
                      <Icon
                        name="boxicons:building-filled"
                        size={16}
                        class="text-secondary"
                        aria-hidden="true"
                      />
                      Oficinas en el mismo edificio ({siblings.length})
                    </h2>
                    <div class="grid grid-cols-1 gap-3">
                      {siblings.map((sib) => (
                        <div
                          data-sibling-office
                          data-sibling-code={sib.code}
                          data-sibling-type={sib.type}
                          class="flex items-center justify-between gap-3 rounded-lg border border-base-300 bg-base-100/50 p-3 shadow-sm"
                        >
                          <div class="min-w-0">
                            <p
                              class="truncate text-sm font-semibold text-base-content"
                              title={sib.name}
                            >
                              {sib.name}
                            </p>
                            <p class="text-xxs tracking-wide text-base-content/50">
                              {officeTypeLabelByType[sib.type] || sib.type}
                            </p>
                          </div>
                          <CopyButton
                            value={sib.code}
                            variant="value"
                            feedbackOnly={true}
                            monospace={true}
                            size="xs"
                            appearance="ghost"
                            copiedLabel={`NIS ${sib.code} copiado al portapapeles`}
                            class={`shrink-0 font-semibold ${officeTypeChipClassByType[sib.type] || defaultChipClass}`}
                          />
                        </div>
                      ))}
                    </div>
                  </section>
                )}

                {contactsToCenter && hasContacts && (
                  <OfficeContactsSection
                    contacts={office.contacts}
                    dense={true}
                  />
                )}
              </div>
            )
          }

          {
            layout.hasRight && (
              <div
                class:list={[
                  "relative flex flex-col min-w-0",
                  layout.rightClass,
                ]}
              >
                <h2 class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-base-content/70 mb-3">
                  <Icon
                    name="boxicons:desktop-filled"
                    size={16}
                    class="text-secondary"
                    aria-hidden="true"
                  />
                  Equipos ({totalAssets})
                </h2>
                <div class="office-assets-scroll flex-1 overflow-y-auto pr-1 min-h-0 lg:max-h-[480px]">
                  <div
                    data-assets-compact={
                      layout.compactAssets ? "true" : undefined
                    }
                    class:list={[
                      "grid gap-3 p-1",
                      layout.compactAssets || layout.hasLeft
                        ? "grid-cols-1 xl:grid-cols-2"
                        : "grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3",
                    ]}
                  >
                    {/* Terminales sincronizadas */}
                    {[...office.terminals]
                      .sort((a, b) => {
                        const osCompare = (
                          a.operatingSystem || ""
                        ).localeCompare(b.operatingSystem || "");
                        if (osCompare !== 0) return osCompare;
                        return (a.hostname || "").localeCompare(
                          b.hostname || "",
                        );
                      })
                      .map((terminal) => (
                        <OfficeEquipmentCard
                          terminal={terminal}
                          compact={layout.compactAssets}
                          isTelegrafia={office.type === "TELEGRAFIA"}
                        />
                      ))}

                    {/* Activos manuales */}
                    {[...office.assets]
                      .sort(
                        (a, b) =>
                          assetOrderByType[a.type] - assetOrderByType[b.type],
                      )
                      .map((asset) => (
                        <OfficeEquipmentCard
                          asset={asset}
                          compact={layout.compactAssets}
                        />
                      ))}
                  </div>
                </div>
                {layout.compactAssets && (
                  <div
                    class="pointer-events-none absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-base-100 to-transparent"
                    aria-hidden="true"
                  />
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  function loadPersonnel(section) {
    if (section.dataset.branchPersonnelLoaded) return;
    section.dataset.branchPersonnelLoaded = "true";

    const nis = section.getAttribute("data-nis");
    const content = section.querySelector("[data-branch-personnel-content]");
    if (!nis || !content) return;

    fetch(`/api/offices/branch-personnel/${encodeURIComponent(nis)}`)
      .then((res) => {
        if (!res.ok) throw new Error("API error");
        return res.json();
      })
      .then((data) => {
        if (!data.ok || !data.personnel || data.personnel.length === 0) {
          section.classList.add("hidden");
          return;
        }

        section.classList.remove("hidden");
        const html = data.personnel
          .map(
            (p) => `
             <div class="flex items-center justify-between gap-3 py-2 border-b border-base-200 last:border-b-0">
                 <div class="min-w-0">
                 <p class="flex flex-wrap items-center gap-x-1.5 text-xs font-semibold text-base-content">
                   ${escapeHTML(p.fullname ?? "Sin nombre")}
                   ${p.position ? `<span class="badge badge-soft badge-secondary text-xxs">${escapeHTML(p.position.replace(/Supervisor/g, "Sup."))}</span>` : ""}
                 </p>
               </div>
              <div class="flex items-center gap-2 shrink-0">
                ${
                  p.telefono
                    ? `
                  <button
                    type="button"
                    class="btn btn-ghost btn-xs gap-1 text-accent"
                    onclick="copyValue('${escapeHTML(p.telefono)}', this)"
                    title="Copiar teléfono: ${escapeHTML(p.telefono)}"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    <span class="font-mono text-xs">${escapeHTML(p.telefono)}</span>
                  </button>
                `
                    : ""
                }
                ${
                  p.interno
                    ? `
                  <button
                    type="button"
                    class="btn btn-ghost btn-xs gap-1 text-info"
                    onclick="copyValue('${escapeHTML(p.interno)}', this)"
                    title="Copiar interno: ${escapeHTML(p.interno)}"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>
                    <span class="font-mono text-xs">${escapeHTML(p.interno)}</span>
                  </button>
                `
                    : ""
                }
                  ${
                    p.dni
                      ? `
                    <a
                      href="/buscador-usuarios?q=${escapeHTML(p.dni)}"
                      class="btn btn-ghost btn-xs gap-1 text-base-content/50"
                      title="Ver en buscador de usuarios"
                      target="_blank"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                    </a>
                  `
                      : ""
                  }
                </div>
              </div>
            `,
          )
          .join("");

        content.innerHTML = html;
      })
      .catch(() => {
        section.classList.remove("hidden");
        content.innerHTML =
          '<p class="text-xs text-error">Error al cargar personal</p>';
      });
  }

  function escapeHTML(str) {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function copyValue(value, btn) {
    navigator.clipboard
      .writeText(value)
      .then(() => {
        const original = btn.innerHTML;
        btn.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
        setTimeout(() => {
          btn.innerHTML = original;
        }, 1500);
        showToast("Copiado: " + value, "alert-success");
      })
      .catch(() => {});
  }

  function showToast(message, type) {
    const container = document.getElementById("global-toast-container");
    if (!container) return;
    const toastDiv = document.createElement("div");
    const alertClass =
      type === "alert-success"
        ? "alert-success text-success-content"
        : type === "alert-error"
          ? "alert-error text-error-content"
          : type === "alert-warning"
            ? "alert-warning text-warning-content"
            : "alert-info text-info-content";
    toastDiv.className =
      "alert " +
      alertClass +
      " shadow-xl rounded-2xl border border-base-content/5 flex items-center gap-3 text-sm font-semibold slide-in-right";
    const span = document.createElement("span");
    span.textContent = message;
    toastDiv.appendChild(span);
    container.appendChild(toastDiv);
    setTimeout(() => {
      toastDiv.classList.replace("slide-in-right", "slide-out-right");
      toastDiv.addEventListener("animationend", () => toastDiv.remove());
    }, 2500);
  }

  let globalObserver = null;

  function observePersonnelSections() {
    if (globalObserver) {
      globalObserver.disconnect();
    }

    globalObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (
          mutation.type === "attributes" &&
          mutation.attributeName === "class"
        ) {
          const target = mutation.target;
          if (
            target.hasAttribute("data-office-detail-row") &&
            !target.classList.contains("hidden")
          ) {
            const section = target.querySelector("[data-branch-personnel]");
            if (section) {
              loadPersonnel(section);
            }
          }
        } else if (mutation.type === "childList") {
          mutation.addedNodes.forEach((node) => {
            if (node.nodeType === Node.ELEMENT_NODE) {
              const el = node;
              if (
                el.hasAttribute("data-office-detail-row") &&
                !el.classList.contains("hidden")
              ) {
                const section = el.querySelector("[data-branch-personnel]");
                if (section) loadPersonnel(section);
              }
              const expandedDetails = el.querySelectorAll(
                "[data-office-detail-row]:not(.hidden)",
              );
              expandedDetails.forEach((detail) => {
                const section = detail.querySelector("[data-branch-personnel]");
                if (section) loadPersonnel(section);
              });
            }
          });
        }
      });
    });

    globalObserver.observe(document.body, {
      attributes: true,
      attributeFilter: ["class"],
      childList: true,
      subtree: true,
    });

    const visibleDetails = document.querySelectorAll(
      "[data-office-detail-row]:not(.hidden)",
    );
    visibleDetails.forEach((detail) => {
      const section = detail.querySelector("[data-branch-personnel]");
      if (section) loadPersonnel(section);
    });
  }

  document.addEventListener("astro:page-load", observePersonnelSections);
  observePersonnelSections();
</script>

