---
interface Props {
  title: string;
  description?: string;
  /** Número o etiqueta corta que precede al título (ej. secciones de un informe). */
  index?: string | number;
  id?: string;
  class?: string;
}

const {
  title,
  description,
  index,
  id,
  class: className = "",
} = Astro.props;
---

<header class:list={["flex flex-col gap-1", className]}>
  <h2
    id={id}
    class="text-base-content flex items-baseline gap-2 text-2xl font-bold tracking-tight"
  >
    {index && <span class="text-error font-mono">{index}.</span>}
    <span>{title}</span>
  </h2>
  {
    description && (
      <p class="text-base-content/60 max-w-3xl text-sm">{description}</p>
    )
  }
</header>
