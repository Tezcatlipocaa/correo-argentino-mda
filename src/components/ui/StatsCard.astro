---
import { Icon } from "astro-icon/components";
import MetricInfo from "./MetricInfo.astro";

interface Delta {
  value: number | null;
  suffix?: string;
  /** true (default): subir es bueno (verde). */
  goodWhenUp?: boolean;
}

interface Props {
  label: string;
  value: string | number;
  /** Ícono del KPI. Si se omite, no se renderiza la figura. */
  icon?: string;
  /** Descripción breve bajo el número. Si se omite, no se renderiza. */
  subtitle?: string;
  color?:
    | "primary"
    | "secondary"
    | "accent"
    | "info"
    | "success"
    | "warning"
    | "error"
    /** Acento del módulo (`.acc`): secondary en claro, primary en oscuro. */
    | "auto";
  /** Texto de ayuda: muestra un ícono info con tooltip. */
  hint?: string;
  formula?: string;
  delta?: Delta;
  /** `lg`: número, label e ícono más grandes (KPI destacado de sección). */
  size?: "default" | "lg";
  class?: string;
}

const {
  icon,
  label,
  value,
  subtitle,
  color = "primary",
  hint,
  formula,
  delta,
  size = "default",
  class: className = "",
} = Astro.props;

const isLarge = size === "lg";
const iconSize = isLarge ? 32 : 24;
const colorClass = color === "auto" ? "acc-text" : `text-${color}`;

const deltaValue = delta?.value ?? null;
const hasDelta = deltaValue !== null;
const deltaUp = (deltaValue ?? 0) >= 0;
const deltaGood = hasDelta && deltaUp === (delta?.goodWhenUp ?? true);
const deltaArrow = deltaUp ? "boxicons:trending-up" : "boxicons:trending-down";
const deltaSign = (deltaValue ?? 0) > 0 ? "+" : "";
const deltaSuffix = delta?.suffix ?? "%";
---

<div
  class:list={[
    "stats bg-base-100 border-base-200 w-full min-w-0 overflow-visible! border shadow-sm",
    className,
  ]}
>
  <div class="stat min-w-0">
    {
      icon && (
        <div class:list={["stat-figure", colorClass]}>
          <Icon
            name={`boxicons:${icon}`}
            size={iconSize}
            class="inline-block"
            is:inline
          />
        </div>
      )
    }
    <div
      class="stat-title flex min-w-0 items-center gap-1 whitespace-normal!"
    >
      <span class="min-w-0">{label}</span>
      {hint && <MetricInfo label={label} description={hint} formula={formula} />}
    </div>
    <div
      class:list={[
        "stat-value flex min-w-0 flex-wrap items-center gap-2 whitespace-normal!",
        colorClass,
        isLarge && "text-4xl!",
      ]}
    >
      <span data-kpi-value class="tabular-nums">{value}</span>
      {
        hasDelta && (
          <span
            class:list={[
              "badge badge-sm gap-0.5 font-normal",
              deltaGood ? "badge-success badge-soft" : "badge-error badge-soft",
            ]}
          >
            <Icon name={deltaArrow} size={12} aria-hidden="true" />
            {deltaSign}
            {deltaValue}
            {deltaSuffix}
          </span>
        )
      }
    </div>
    {
      subtitle && (
        <div class="stat-desc min-w-0 whitespace-normal!">{subtitle}</div>
      )
    }
  </div>
</div>
