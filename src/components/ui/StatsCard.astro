---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  label: string;
  value: string | number;
  subtitle: string;
  color?:
    | "primary"
    | "secondary"
    | "accent"
    | "info"
    | "success"
    | "warning"
    | "error";
  class?: string;
}

const {
  icon,
  label,
  value,
  subtitle,
  color = "primary",
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "card card-border bg-base-100 border-base-200 shadow-sm p-5",
    className,
  ]}
>
  <div class="flex flex-col gap-3">
    <div class="flex items-start justify-between gap-2">
      <span
        class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
      >
        {label}
      </span>
      <span class:list={[`text-${color}`]}>
        <Icon name={`boxicons:${icon}`} size={28} is:inline />
      </span>
    </div>
    <div class:list={["font-mono text-4xl font-bold", `text-${color}`]}>
      {value}
    </div>
    <div class="text-base-content/60 text-sm">{subtitle}</div>
  </div>
</div>
