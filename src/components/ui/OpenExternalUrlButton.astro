---
import { Icon } from "astro-icon/components";

interface Props {
  href?: string;
  ariaLabel: string;
  variant?: "icon" | "text";
  label?: string;
  size?: "xs" | "sm" | "md";
  /** Forma del botón; `ghost` ignora `tone` (DaisyUI no combina ambos). */
  appearance?: "solid" | "outline" | "ghost";
  /** Color del botón (solo solid/outline). */
  tone?: "primary" | "secondary" | "accent" | "neutral";
  disabled?: boolean;
  newTab?: boolean;
  class?: string;
  buttonClass?: string;
}

const {
  href,
  ariaLabel,
  variant = "icon",
  label = "Abrir",
  size = "sm",
  appearance = "solid",
  tone = "secondary",
  disabled = false,
  newTab = true,
  class: className = "",
  buttonClass = "",
} = Astro.props;

const sizeClassMap: Record<NonNullable<Props["size"]>, string> = {
  xs: "btn-xs",
  sm: "btn-sm",
  md: "",
};

const toneClass: Record<NonNullable<Props["tone"]>, string> = {
  primary: "btn-primary",
  secondary: "btn-secondary",
  accent: "btn-accent",
  neutral: "btn-neutral",
};

const appearanceClass =
  appearance === "ghost"
    ? "btn-ghost"
    : appearance === "outline"
      ? `btn-outline ${toneClass[tone]}`
      : toneClass[tone];

const canOpen = Boolean(href) && !disabled;
const isIconVariant = variant === "icon";
const baseClasses = [
  "btn rounded-lg transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
  sizeClassMap[size],
  canOpen
    ? appearanceClass
    : "btn-disabled border-base-300 bg-base-200 text-base-content/45",
  isIconVariant ? "btn-square min-h-8 min-w-8" : "gap-1",
  className,
  buttonClass,
];
---

{
  canOpen ? (
    <a
      href={href}
      target={newTab ? "_blank" : undefined}
      rel={newTab ? "noopener noreferrer" : undefined}
      class:list={baseClasses}
      aria-label={ariaLabel}
    >
      <Icon
        name="boxicons:arrow-up-right-square-filled"
        size={16}
        aria-hidden="true"
        is:inline
      />
      {!isIconVariant && <span>{label}</span>}
    </a>
  ) : (
    <button
      type="button"
      class:list={baseClasses}
      disabled
      aria-label={ariaLabel}
    >
      <Icon
        name="boxicons:arrow-up-right-square-filled"
        size={16}
        aria-hidden="true"
        is:inline
      />
      {!isIconVariant && <span>{label}</span>}
    </button>
  )
}
