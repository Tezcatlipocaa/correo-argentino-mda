---
interface Props {
  /** Columnas en pantallas chicas. */
  base?: 1 | 2;
  sm?: 1 | 2 | 3 | 4 | 5 | 6;
  /** Columnas desde 768px. Si se omite, no se fuerza breakpoint. */
  md?: 2 | 3 | 4 | 5 | 6;
  /** Columnas desde 1024px. */
  lg?: 3 | 4 | 5 | 6;
  class?: string;
  ariaLabel?: string;
}

const {
  base = 2,
  sm,
  md,
  lg = 5,
  class: className = "",
  ariaLabel,
} = Astro.props;

// Mapas con clases literales: Tailwind no detecta nombres de clase dinámicos.
const BASE = { 1: "grid-cols-1", 2: "grid-cols-2" } as const;
const SM = {
  1: "sm:grid-cols-1",
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
  4: "sm:grid-cols-4",
  5: "sm:grid-cols-5",
  6: "sm:grid-cols-6",
} as const;
const MD = {
  2: "md:grid-cols-2",
  3: "md:grid-cols-3",
  4: "md:grid-cols-4",
  5: "md:grid-cols-5",
  6: "md:grid-cols-6",
} as const;
const LG = {
  3: "lg:grid-cols-3",
  4: "lg:grid-cols-4",
  5: "lg:grid-cols-5",
  6: "lg:grid-cols-6",
} as const;
---

<div
  class:list={[
    "grid w-full gap-4",
    BASE[base],
    sm && SM[sm],
    md && MD[md],
    lg && LG[lg],
    className,
  ]}
  aria-label={ariaLabel}
>
  <slot />
</div>
