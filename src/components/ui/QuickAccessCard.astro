---
import { getCleanBase } from "@lib/baseUrl";
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  title: string;
  description: string;
  icon: string;
  iconTone?: string;
  locked?: boolean;
  comingSoon?: boolean;
  layout?: "horizontal" | "vertical" | "compact";
}

const {
  href,
  title,
  description,
  icon,
  iconTone = "bg-secondary/10 text-secondary",
  locked = false,
  comingSoon = false,
  layout = "vertical",
} = Astro.props;

const cleanBase = getCleanBase();
const isWebUrl = (value: string): boolean => /^https?:\/\//i.test(value);
const resolvedHref =
  isWebUrl(href) ||
  href.startsWith("mailto:") ||
  href.startsWith("tel:") ||
  href.startsWith(cleanBase)
    ? href
    : `${cleanBase}${href.startsWith("/") ? href.slice(1) : href}`;

const Wrapper = locked || comingSoon ? "div" : "a";
---

{
  layout === "compact" ? (
    <Wrapper
      {...(!(locked || comingSoon)
        ? {
            href: resolvedHref,
            "aria-label": `Abrir ${title}${description ? `: ${description}` : ""}`,
            title: description || title,
          }
        : {
            "aria-label": `${title} (${comingSoon ? "Próximamente" : "Restringido"})`,
          })}
      class:list={[
        "rounded-box border-base-300 bg-base-100 group relative flex items-center gap-3 p-3 shadow-md transition-all duration-300",
        locked || comingSoon
          ? "cursor-not-allowed opacity-40 grayscale select-none"
          : "hover:border-primary focus:ring-primary cursor-pointer hover:-translate-y-1 hover:shadow-lg focus:ring-2 focus:ring-offset-2 focus:outline-none",
      ]}
    >
      <div
        class:list={[
          "flex h-8 w-8 shrink-0 items-center justify-center rounded-lg transition-transform duration-300",
          iconTone,
        ]}
        aria-hidden="true"
      >
        <Icon
          name={icon}
          size={20}
          class={
            locked || comingSoon
              ? ""
              : "transition-transform duration-300 group-hover:scale-110"
          }
        />
      </div>
      <span
        class:list={[
          "min-w-0 flex-1 text-sm leading-tight font-semibold",
          locked || comingSoon
            ? "text-base-content/50"
            : "text-base-content/85 group-hover:text-base-content",
        ]}
      >
        {title}
      </span>
      <div class="flex shrink-0 items-center" aria-hidden="true">
        {locked || comingSoon ? (
          <Icon name="boxicons:lock-filled" size={18} class="text-base-content/40" />
        ) : (
          <Icon
            name="boxicons:chevron-right"
            size={20}
            class="text-base-content/30 transition-transform duration-300 group-hover:translate-x-1"
          />
        )}
      </div>
    </Wrapper>
  ) : layout === "horizontal" ? (
    <Wrapper
      {...(!(locked || comingSoon)
        ? { href: resolvedHref, "aria-label": `Abrir ${title}` }
        : {
            "aria-label": `${title} (${comingSoon ? "Próximamente" : "Restringido"})`,
          })}
      class:list={[
        "rounded-box border-base-300 bg-base-100 relative flex h-full w-full items-center justify-between overflow-hidden border p-5 shadow-md transition-all duration-300",
        locked || comingSoon
          ? "cursor-not-allowed opacity-40 grayscale select-none"
          : "hover:border-primary group focus:ring-primary cursor-pointer hover:-translate-y-1 hover:shadow-lg focus:ring-2 focus:ring-offset-2 focus:outline-none",
      ]}
    >
      <div class="flex items-center gap-4">
        <div
          class:list={[
            "flex h-12 w-12 shrink-0 items-center justify-center rounded-xl transition-transform duration-300",
            iconTone,
          ]}
        >
          <Icon
            name={icon}
            size={32}
            class={
              locked || comingSoon
                ? ""
                : "transition-transform duration-300 group-hover:scale-110"
            }
            aria-hidden="true"
          />
        </div>
        <div>
          <h3 class="text-base-content text-lg font-bold">{title}</h3>
          <p class="text-base-content/70 text-xs">{description}</p>
        </div>
      </div>
      <div class="flex items-center" aria-hidden="true">
        {locked || comingSoon ? (
          <Icon name="boxicons:lock-filled" size={24} class="text-base-content/40" />
        ) : (
          <Icon
            name="boxicons:chevron-right"
            size={24}
            class="text-base-content/30 transition-transform duration-300 group-hover:translate-x-1"
          />
        )}
      </div>
    </Wrapper>
  ) : (
    <Wrapper
      {...(!(locked || comingSoon)
        ? { href: resolvedHref, "aria-label": `Abrir ${title}` }
        : {
            "aria-label": `${title} (${comingSoon ? "Próximamente" : "Restringido"})`,
          })}
      class:list={[
        "card card-compact bg-base-100 border-base-300 h-full border shadow-md",
        locked || comingSoon
          ? "cursor-not-allowed opacity-40 grayscale select-none"
          : "hover:border-primary group focus:ring-primary transition-all duration-300 hover:-translate-y-1 hover:shadow-lg focus:ring-2 focus:ring-offset-2 focus:outline-none",
      ]}
    >
      <div class="card-body flex h-full flex-col gap-3">
        <div
          aria-hidden="true"
          class:list={[
            "flex h-12 w-12 shrink-0 items-center justify-center rounded-xl transition-transform duration-300",
            iconTone,
          ]}
        >
          <Icon
            name={icon}
            size={32}
            class={
              locked || comingSoon
                ? ""
                : "transition-transform duration-300 group-hover:scale-110"
            }
          />
        </div>
        <h3 class="text-base-content text-lg font-bold">{title}</h3>
        <p class="text-base-content/70 text-xs">{description}</p>
        <div class="card-actions mt-2 justify-end">
          {comingSoon ? (
            <span class="badge badge-warning font-bold">Próximamente</span>
          ) : locked ? (
            <Icon
              name="boxicons:lock-filled"
              size={24}
              class="text-base-content/40"
              aria-hidden="true"
            />
          ) : (
            <span class="text-base-content/40 flex items-center gap-1 text-sm font-medium">
              Acceder
              <Icon
                name="boxicons:chevron-right"
                size={24}
                class="transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              />
            </span>
          )}
        </div>
      </div>
    </Wrapper>
  )
}
