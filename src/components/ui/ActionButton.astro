---
import { Icon } from "astro-icon/components";

interface Props {
  id?: string;
  icon?: string;
  label?: string;
  shortLabel?: string;
  labelId?: string;
  ariaLabel?: string;
  title?: string;
  size?: "xs" | "sm" | "md" | "default";
  iconSize?: number;
  color?: string;
  type?: "button" | "submit";
  class?: string;
  [key: string]: any;
}

const {
  id,
  icon,
  label,
  shortLabel,
  labelId,
  ariaLabel,
  title,
  size = "xs",
  iconSize,
  color = "btn-secondary",
  type = "button",
  class: className = "",
  ...attrs
} = Astro.props;

const sizeMap: Record<string, string> = {
  xs: "btn-xs",
  sm: "btn-sm",
  md: "btn-md",
  default: "",
};
const sizeClass = sizeMap[size] || "";
const defaultIconSize =
  size === "md" ? 18 : size === "default" ? 15 : 13;
const resolvedIconSize = iconSize ?? defaultIconSize;
const textSizeClass = size === "md" || size === "default" ? "text-sm" : "text-tiny";
const baseClass = `btn ${sizeClass} btn-soft ${color} items-center justify-center gap-1.5 font-bold uppercase tracking-wider ${textSizeClass}`;
---

<button
  type={type}
  id={id}
  title={title}
  aria-label={ariaLabel}
  class:list={[baseClass, className]}
  {...attrs}
>
  {icon && <Icon name={icon} size={resolvedIconSize} />}
  {
    shortLabel ? (
      <>
        <span class="inline xl:hidden">{shortLabel}</span>
        <span id={labelId} class="hidden xl:inline">
          {label}
        </span>
      </>
    ) : (
      label && <span id={labelId}>{label}</span>
    )
  }
</button>
