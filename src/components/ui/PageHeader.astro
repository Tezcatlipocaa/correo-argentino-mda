---
import ActionButton from "./ActionButton.astro";
import { getSectionTitle, getResolvedPathname } from "@lib/navigation";

interface Props {
  title?: string;
  description?: string;
  headingLevel?: "h1" | "h2";
  class?: string;
  titleClass?: string;
  titleStyle?: string;
  descriptionClass?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  headingLevel = "h1",
  class: className,
  titleClass,
  titleStyle,
  descriptionClass,
  backHref,
  backLabel,
} = Astro.props;

const resolvedPath = getResolvedPathname(Astro.request, Astro.url);
const inferredTitle = title || getSectionTitle(resolvedPath) || "Portal";

const HeadingTag = headingLevel;
---

<header class:list={["space-y-2", className]}>
  <div class="flex items-center gap-2">
    {backHref && (
      <ActionButton
        href={backHref}
        variant="ghost"
        size="sm"
        square
        icon="boxicons:chevron-left"
        iconSize={24}
        ariaLabel={backLabel ?? "Volver"}
        title={backLabel ?? "Volver"}
      />
    )}
    <HeadingTag
      class:list={[
        "text-base-content text-3xl font-bold tracking-tight",
        titleClass,
      ]}
      style={titleStyle}
    >
      {inferredTitle}
    </HeadingTag>
  </div>

  {
    Astro.slots.has("description") ? (
      <div
        class:list={[
          "text-base-content/70 max-w-3xl text-sm sm:text-base",
          descriptionClass,
        ]}
      >
        <slot name="description" />
      </div>
    ) : description ? (
      <p
        class:list={[
          "text-base-content/70 max-w-3xl text-sm sm:text-base",
          descriptionClass,
        ]}
      >
        {description}
      </p>
    ) : null
  }
</header>
