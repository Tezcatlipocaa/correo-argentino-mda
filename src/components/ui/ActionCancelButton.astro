---
interface Props {
  href?: string;
  label?: string;
  size?: "xs" | "sm" | "default";
  type?: "button" | "submit";
  variant?: "ghost" | "error";
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  href,
  label = "Cancelar",
  size = "default",
  type = "button",
  variant = "ghost",
  class: className = "",
  id,
  ...attrs
} = Astro.props;

const sizeClasses = {
  xs: "btn-xs",
  sm: "btn-sm",
  default: "btn-sm md:btn-md",
};
const sizeClass = sizeClasses[size] || sizeClasses.default;
const variantClass = variant === "error" ? "btn-soft btn-error" : "btn-soft btn-ghost";
const btnClasses = `btn ${sizeClass} ${variantClass} gap-2`;
---

{
  href ? (
    <a id={id} href={href} class:list={[btnClasses, className]} {...attrs}>
      {label}
    </a>
  ) : (
    <button type={type} id={id} class:list={[btnClasses, className]} {...attrs}>
      {label}
    </button>
  )
}
