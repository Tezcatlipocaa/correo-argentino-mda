---
import { Icon } from "astro-icon/components";
---

<div id="global-toast-container" class="toast toast-end"></div>

<div id="toast-icon-templates" class="hidden" aria-hidden="true">
  <div id="template-success">
    <Icon name="boxicons:badge-check-filled" size={20} class="shrink-0" />
  </div>
  <div id="template-error">
        <Icon name="boxicons:x-circle-filled" size={20} class="shrink-0" is:inline />
  </div>
  <div id="template-warning">
    <Icon name="boxicons:alert-triangle-filled" size={20} class="shrink-0" is:inline />
  </div>
  <div id="template-info">
    <Icon name="boxicons:info-square-filled" size={20} class="shrink-0" />
  </div>
</div>

<script>
  import { showToast, type ToastType } from "@lib/toastClient";

  // Exponer a nivel global para llamadas dinámicas desde islas de servidor
  (window as any).showToast = showToast;

  // Los modales del proyecto usan <dialog>.showModal(), que promueve el dialog a
  // la "top layer": ningún z-index lo supera. Mientras haya un dialog abierto, el
  // contenedor de toasts se reubica dentro del dialog más reciente, para que sus
  // hijos se pinten por encima del modal. Al cerrarlos vuelve al body.
  const container = document.getElementById("global-toast-container");
  const openDialogs: HTMLElement[] = [];

  function toastHost(): HTMLElement {
    while (
      openDialogs.length > 0 &&
      !openDialogs[openDialogs.length - 1].isConnected
    ) {
      openDialogs.pop();
    }
    const tracked = openDialogs[openDialogs.length - 1];
    if (tracked) return tracked;
    const dialogs = document.querySelectorAll<HTMLDialogElement>("dialog[open]");
    return dialogs[dialogs.length - 1] ?? document.body;
  }

  function syncToastHost() {
    if (!container) return;
    const host = toastHost();
    if (container.parentElement !== host) host.appendChild(container);
  }

  if (container) {
    new MutationObserver((records) => {
      for (const record of records) {
        const el = record.target as HTMLElement;
        if (el.tagName !== "DIALOG") continue;
        const index = openDialogs.indexOf(el);
        if (el.hasAttribute("open")) {
          if (index === -1) openDialogs.push(el);
        } else if (index !== -1) {
          openDialogs.splice(index, 1);
        }
      }
      syncToastHost();
    }).observe(document.body, {
      subtree: true,
      childList: true,
      attributes: true,
      attributeFilter: ["open"],
    });
  }

  function checkUrlToasts() {
    const url = new URL(window.location.href);
    const msg = url.searchParams.get("toast_msg");
    const typeParam = url.searchParams.get("toast_type") || "info";

    if (msg) {
      const typeMap: Record<string, ToastType> = {
        success: "alert-success",
        error: "alert-error",
        warning: "alert-warning",
        info: "alert-info",
      };
      const toastType = typeMap[typeParam] || "alert-info";

      showToast(msg, toastType);

      url.searchParams.delete("toast_msg");
      url.searchParams.delete("toast_type");
      window.history.replaceState({}, "", url.pathname + url.search);
    }
  }

  checkUrlToasts();
  document.addEventListener("astro:page-load", checkUrlToasts);
</script>
