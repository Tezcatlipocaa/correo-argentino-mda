---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";

interface Props {
  backHref: string;
  title: string;
  subtitle?: string;
  formId?: string;
  width?: "default" | "xl" | "xxl" | "full";
  cancelLabel?: string;
  cancelIcon?: string;
  saveLabel?: string;
  saveIcon?: string;
  saveColor?: string;
  class?: string;
}

const {
  backHref,
  title,
  subtitle,
  formId = "editor-form",
  width = "xxl",
  cancelLabel = "Cancelar",
  cancelIcon = "boxicons:arrow-left-filled",
  saveLabel = "Guardar cambios",
  saveIcon = "boxicons:save-filled",
  saveColor = "btn-secondary",
  class: className = "",
} = Astro.props;
---

<BaseLayout title={title}>
  <PageContainer width={width}>
    <PageHeader title={title} description={subtitle} />

    <form id={formId} method="POST" class:list={["mt-6 space-y-4", className]}>
      <slot />

      <div class="flex items-center justify-end gap-3 pt-4">
        <ActionCancelButton
          href={backHref}
          label={cancelLabel}
          icon={cancelIcon}
          variant="error"
        />
        <ActionConfirmButton
          type="submit"
          color={saveColor}
          label={saveLabel}
          icon={saveIcon}
        />
      </div>
    </form>
  </PageContainer>
</BaseLayout>
