---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import { Icon } from "astro-icon/components";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";

interface Props {
  backHref: string;
  backLabel: string;
  title: string;
  subtitle?: string;
  formId?: string;
  width?: "default" | "xl" | "xxl" | "full";
  cancelLabel?: string;
  cancelIcon?: string;
  saveLabel?: string;
  saveIcon?: string;
  saveColor?: string;
  class?: string;
}

const {
  backHref,
  backLabel,
  title,
  subtitle,
  formId = "editor-form",
  width = "xxl",
  cancelLabel = "Cancelar",
  cancelIcon = "boxicons:arrow-left-filled",
  saveLabel = "Guardar cambios",
  saveIcon = "boxicons:save-filled",
  saveColor = "btn-secondary",
  class: className = "",
} = Astro.props;
---

<BaseLayout title={title}>
  <PageContainer width={width}>
    <nav aria-label="Breadcrumb" class="mb-4">
      <ul class="breadcrumbs text-base-content/60 text-sm">
        <li>
          <a
            href={backHref}
            class="hover:text-base-content flex items-center gap-1.5 transition-colors"
          >
            <Icon name={cancelIcon} size={16} />
            {backLabel}
          </a>
        </li>
        <li>
          <span class="text-base-content truncate font-medium">{title}</span>
        </li>
      </ul>
    </nav>

    <PageHeader title={title} description={subtitle} />

    <form id={formId} method="POST" class:list={["mt-6 space-y-4", className]}>
      <slot />

      <div class="sticky bottom-4 flex items-center justify-end gap-3">
        <ActionCancelButton
          href={backHref}
          label={cancelLabel}
          icon={cancelIcon}
        />
        <ActionConfirmButton
          type="submit"
          color={saveColor}
          label={saveLabel}
          icon={saveIcon}
        />
      </div>
    </form>
  </PageContainer>
</BaseLayout>
