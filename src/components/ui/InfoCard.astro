---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  label: string;
  value?: string;
  id?: string;
  copyId?: string;
  copyLabel?: string;
  monospace?: boolean;
  showCopy?: boolean;
  badgeClass?: string;
  fullWidth?: boolean;
  compact?: boolean;
}

const {
  icon,
  label,
  value = "-",
  id,
  copyId,
  copyLabel = "",
  monospace = false,
  showCopy = true,
  badgeClass,
  fullWidth = false,
  compact = false,
} = Astro.props;

const resolvedIcon = icon.endsWith("-filled") ? icon : `${icon}-filled`;
---

<div
  class:list={[
    "bg-base-200/50 border border-base-300 rounded-lg group relative flex items-start gap-2 min-w-0",
    compact ? "p-1.5" : "p-2",
    fullWidth && "col-span-full",
  ]}
>
  <div
    class="rounded-md bg-secondary/10 text-secondary flex items-center justify-center shrink-0 size-10"
  >
    <Icon name={resolvedIcon} size={24} />
  </div>
  <div class="min-w-0 flex-1">
    <span
      class="text-base-content/50 text-xs uppercase font-bold tracking-wider select-none block truncate"
    >
      {label}
    </span>
    {
      badgeClass ? (
        <div class="mt-0.5">
          <span
            id={id}
            class:list={["badge badge-sm badge-soft font-semibold", badgeClass]}
          >
            {value}
          </span>
        </div>
      ) : (
        <div
          id={id}
          class:list={[
            "text-xs font-semibold text-base-content mt-0.5 truncate",
            monospace && "font-mono",
          ]}
          title={value}
        >
          {value}
        </div>
      )
    }
  </div>
  {
    showCopy && (
      <button
        type="button"
        class="btn btn-ghost btn-xs opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity p-0.5 cursor-pointer shrink-0"
        data-copy-control
        data-copy-value={value}
        data-copy-label-default={copyLabel || `Copiar ${label.toLowerCase()}`}
        data-copy-label-success="Copiado"
        data-copy-replace-label="false"
        id={copyId}
        title={copyLabel || `Copiar ${label.toLowerCase()}`}
        aria-label={copyLabel || `Copiar ${label.toLowerCase()}`}
      >
        <Icon
          name="boxicons:copy"
          size={14}
          data-copy-icon-default
          class="transition-all duration-200"
        />
        <Icon
          name="boxicons:check-filled"
          size={14}
          data-copy-icon-success
          class="hidden opacity-0 scale-75 text-success transition-all duration-200"
        />
      </button>
    )
  }
  <slot name="action" />
</div>
