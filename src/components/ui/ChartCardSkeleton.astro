---
interface Props {
  count?: number;
  class?: string;
}

const { count = 1, class: className = "" } = Astro.props;
---

{
  Array.from({ length: count }).map(() => (
    <div
      class:list={[
        "bg-base-100 border-base-300 flex flex-col gap-4 rounded-2xl border p-5 shadow-sm",
        className,
      ]}
    >
      <div class="skeleton h-4 w-44 rounded"></div>
      <div class="skeleton h-55 w-full rounded-xl"></div>
    </div>
  ))
}
