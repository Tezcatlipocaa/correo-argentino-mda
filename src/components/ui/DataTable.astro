---
import { Icon } from "astro-icon/components";
import ActionButton from "./ActionButton.astro";
import SearchEmptyState from "./SearchEmptyState.astro";

interface Props {
  ariaLabel: string;
  minWidthClass?: string;
  headerGridClass: string;
  rowGridClass: string;
  class?: string;
  bodyClass?: string;
  wrapperClass?: string;
  id?: string;
  /** Muestra el botón de pantalla completa (Fullscreen API). */
  fullscreen?: boolean;
  /**
   * Apila cada fila como tarjeta en pantallas chicas para evitar el scroll
   * horizontal. Requiere que cada celda declare `data-label="..."`.
   */
  stackOnMobile?: boolean;
  // empty state props
  emptyStateTitle?: string;
  emptyStateDescription?: string;
  // muestra el empty state también cuando el body arranca sin filas (no solo
  // cuando todas fueron filtradas)
  whenEmpty?: boolean;
  showClearButton?: boolean;
  clearButtonText?: string;
  clearButtonId?: string;
  clearButtonHref?: string;
  serverSideSort?: boolean;
  defaultSortKey?: string;
  defaultSortDirection?: "ascending" | "descending";
  /**
   * Estilo de la fila de encabezado: "primary" (azul, por defecto) o
   * "subtle" (superficie clara, para tablas embebidas en contenido).
   */
  headerVariant?: "primary" | "subtle";
}

const {
  ariaLabel,
  minWidthClass = "min-w-max md:min-w-full",
  headerGridClass,
  rowGridClass,
  class: className = "",
  bodyClass = "",
  wrapperClass = "rounded-box border border-base-300 bg-base-200/70 shadow-md overflow-x-auto",
  id,
  fullscreen = false,
  stackOnMobile = false,
  emptyStateTitle,
  emptyStateDescription,
  whenEmpty = false,
  showClearButton = false,
  clearButtonText,
  clearButtonId,
  clearButtonHref,
  serverSideSort = false,
  defaultSortKey,
  defaultSortDirection = "descending",
  headerVariant = "primary",
} = Astro.props;

const HEADER_VARIANT = {
  primary:
    "border-secondary/40 bg-secondary text-secondary-content border-b shadow-sm",
  subtle: "border-base-300 bg-base-200 text-base-content/70 border-b",
} as const;
---

<section
  id={id}
  class:list={[
    "relative w-full",
    stackOnMobile && "data-table--stack",
    className,
  ]}
  aria-label={ariaLabel}
  data-table-sort-root
  data-fullscreen-root
  data-table-when-empty={whenEmpty ? "true" : undefined}
  data-table-row-grid-class={rowGridClass}
  data-server-side-sort={serverSideSort ? "true" : undefined}
  data-table-sort-default-key={defaultSortKey}
  data-table-sort-default-direction={defaultSortKey
    ? defaultSortDirection
    : undefined}
>
  {
    fullscreen && (
      <div class="flex justify-end px-1 pb-2">
        <ActionButton
          type="button"
          variant="ghost"
          size="xs"
          data-fullscreen-toggle
          title="Ver en pantalla completa"
          ariaLabel={`Ver ${ariaLabel} en pantalla completa`}
        >
          <Icon name="boxicons:fullscreen" size={16} data-fs-enter is:inline />
          <Icon
            name="boxicons:fullscreen-exit"
            size={16}
            class="hidden"
            data-fs-exit
            is:inline
          />
        </ActionButton>
      </div>
    )
  }
  <div class:list={wrapperClass} data-table-wrapper>
    <div class:list={[minWidthClass]}>
      <div
        class:list={[
          "grid px-4 py-2.5 font-mono uppercase",
          HEADER_VARIANT[headerVariant],
          headerGridClass,
        ]}
        data-table-header
      >
        <slot name="header" />
      </div>

      <div class:list={bodyClass} data-table-sort-body>
        <slot />
      </div>
    </div>
  </div>

  <SearchEmptyState
    id={id ? `${id}-empty-state` : undefined}
    title={emptyStateTitle}
    description={emptyStateDescription}
    showClearButton={showClearButton}
    clearButtonText={clearButtonText}
    clearButtonId={clearButtonId}
    clearButtonHref={clearButtonHref}
  />
</section>

<script>
  import { initTableSortObserver } from "@lib/clientTableSort";
  import { initFullscreenToggle } from "@lib/fullscreenToggle";

  initTableSortObserver();
  initFullscreenToggle();

  document.addEventListener("astro:page-load", () => {
    initTableSortObserver();
  });
</script>

<style is:global>
  section[data-table-sort-root].is-fullscreen {
    display: flex;
    flex-direction: column;
    background-color: var(--color-base-100);
    border-radius: 0;
  }

  section[data-table-sort-root].is-fullscreen [data-table-wrapper] {
    flex: 1 1 auto;
    min-height: 0;
    border-radius: 0;
    border: none;
    overflow-y: auto;
  }

  @media (max-width: 767px) {
    .data-table--stack [data-table-header] {
      display: none;
    }

    .data-table--stack [data-table-row] {
      display: block !important;
      border: 1px solid var(--color-base-200);
      border-radius: var(--radius-box);
      margin-bottom: 0.75rem;
      padding: 0.5rem 0.75rem;
      min-height: 0;
    }

    .data-table--stack [data-table-row]:last-child {
      margin-bottom: 0;
    }

    .data-table--stack [data-table-row] > * {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.3rem 0;
    }

    .data-table--stack [data-table-row] > [data-label]::before {
      content: attr(data-label);
      flex: 0 0 auto;
      font-weight: 600;
      color: color-mix(in oklab, var(--color-base-content) 65%, transparent);
    }
  }
</style>
