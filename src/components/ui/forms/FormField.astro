---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import FormLegend from "@components/ui/forms/FormLegend.astro";

interface Props extends HTMLAttributes<"input"> {
  id: string;
  name: string;
  label: string;
  helpText?: string;
  inputClass?: string;
  icon?: string;
  size?: "default" | "sm" | "xs";
  reveal?: boolean;
}

const {
  id,
  name,
  label,
  helpText,
  type = "text",
  inputClass = "",
  icon,
  size = "default",
  reveal = false,
  class: className = "",
  ...rest
} = Astro.props;

const sizeClass = size === "sm" ? "input-sm" : size === "xs" ? "input-xs" : "";
---

<fieldset class:list={["fieldset", className]}>
  <FormLegend class="font-bold tracking-wider">
    {label}
    {rest.required && <span class="text-error">*</span>}
  </FormLegend>
  {
    type === "file" ? (
      <div class="flex items-center gap-4">
        <slot name="preview" />
        <input
          type="file"
          id={id}
          name={name}
          class="file-input file-w-full"
          {...rest}
        />
      </div>
    ) : type === "password" && reveal ? (
      <div class="join w-full">
        <input
          type="password"
          id={id}
          name={name}
          class:list={["input join-item w-full", sizeClass, inputClass]}
          data-password-input
          autocomplete="new-password"
          {...rest}
        />
        <button
          type="button"
          class="btn join-item text-base-content/60"
          data-toggle-password
          title="Mostrar/Ocultar contraseña"
          aria-label="Mostrar u ocultar contraseña"
        >
          <Icon name="boxicons:eye-filled" size={16} data-show-icon />
          <Icon
            name="boxicons:eye-slash-filled"
            size={16}
            class="hidden"
            data-hide-icon
          />
        </button>
      </div>
    ) : icon ? (
      <label
        class:list={[
          "input flex w-full items-center gap-2",
          sizeClass,
          inputClass,
        ]}
      >
        <Icon name={icon} size={16} class="shrink-0 opacity-50" is:inline />
        <input type={type} id={id} name={name} class="grow" {...rest} />
      </label>
    ) : (
      <input
        type={type}
        id={id}
        name={name}
        class:list={["input w-full", sizeClass, inputClass]}
        {...rest}
      />
    )
  }
  {
    helpText && (
      <p class="fieldset-label text-base-content/50 text-xs">{helpText}</p>
    )
  }
</fieldset>

<script>
  const initFormFieldReveal = () => {
    document.querySelectorAll("[data-toggle-password]").forEach((btn) => {
      if (btn.getAttribute("data-listener-added") === "true") return;
      btn.setAttribute("data-listener-added", "true");

      btn.addEventListener("click", () => {
        const parent = btn.closest("div");
        if (!parent) return;
        const input = parent.querySelector(
          "[data-password-input]",
        ) as HTMLInputElement | null;
        const showIcon = parent.querySelector(
          "[data-show-icon]",
        ) as HTMLElement | null;
        const hideIcon = parent.querySelector(
          "[data-hide-icon]",
        ) as HTMLElement | null;

        if (input) {
          if (input.type === "password") {
            input.type = "text";
            showIcon?.classList.add("hidden");
            hideIcon?.classList.remove("hidden");
          } else {
            input.type = "password";
            showIcon?.classList.remove("hidden");
            hideIcon?.classList.add("hidden");
          }
        }
      });
    });
  };

  initFormFieldReveal();
  document.addEventListener("astro:page-load", initFormFieldReveal);
</script>
