---
import { getCleanBase } from "@lib/baseUrl";
import "@styles/global.css";
import geistLatinWoff2 from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoLatinWoff2 from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

const cleanBase = getCleanBase();

const globalFontFaceCss = `
  @font-face {
    font-family: "Geist Variable";
    src: url("${geistLatinWoff2}") format("woff2");
    font-display: swap;
    font-style: normal;
    font-weight: 100 900;
  }

  @font-face {
    font-family: "Geist Mono Variable";
    src: url("${geistMonoLatinWoff2}") format("woff2");
    font-display: swap;
    font-style: normal;
    font-weight: 100 900;
  }
`;

interface Props {
  title?: string;
}

const { title } = Astro.props;
const inferredTitle = title ? `Portal MDA | ${title}` : "Portal MDA";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("theme");
        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style is:global set:html={globalFontFaceCss}></style>
    <link
      rel="preload"
      href={geistLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistMonoLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href={`${cleanBase}favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{inferredTitle}</title>
  </head>

  <body class="bg-base-100 text-base-content min-h-screen">
    <main class="flex min-h-screen items-center justify-center p-4">
      <slot />
    </main>

    <script src="../../scripts/toggle-mode.ts"></script>
  </body>
</html>
