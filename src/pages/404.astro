---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCleanBase } from "@lib/baseUrl";

const homeUrl = getCleanBase();
---

<BaseLayout title="Página no encontrada">
  <div
    class="relative -m-4 md:-m-6 flex h-[calc(100%+2rem)] md:h-[calc(100%+3rem)] flex-col overflow-hidden bg-base-100"
  >
    <div
      class="absolute inset-0 flex flex-col items-center justify-center"
      aria-hidden="true"
    >
      {
        Array.from({ length: 7 }).map((_, i) => (
          <span
            key={i}
            class="text-base-content/5 text-[22vw] font-black leading-none tracking-tighter select-none"
          >
            404
          </span>
        ))
      }
    </div>
    <div
      class="relative z-10 flex flex-1 flex-col items-center justify-center gap-10 px-6 text-center"
    >
      <p class="text-base-content text-2xl md:text-4xl font-medium max-w-2xl">
        Esta consulta no figura en ninguna mesa. Nadie la derivó.
      </p>
      <a
        href={homeUrl}
        class="text-base-content text-xl md:text-2xl font-semibold underline underline-offset-8 transition-opacity hover:opacity-70"
      >
        Volver al inicio
      </a>
    </div>
  </div>
</BaseLayout>
