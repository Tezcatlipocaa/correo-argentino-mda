---
import FormField from "@components/ui/forms/FormField.astro";
import FormTextarea from "@components/ui/forms/FormTextarea.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import { Icon } from "astro-icon/components";
import { db } from "@db/index";
import { applications, applicationCategories } from "@db/schema";
import { eq } from "drizzle-orm";
import { logAdminFromAstro } from "@lib/auditLogger";
import { processIconUpload } from "@lib/iconUpload";
import { encryptData, decryptData } from "@lib/encryption";
import AsyncFormScript from "@components/admin/ui/AsyncFormScript.astro";
import { getPdfsDir, ensureDir, iconExists } from "@lib/storage";
import { processAppFileUpload } from "@lib/appFileUpload";
import { resolveUrl } from "@lib/url";
import { redirectWithToast } from "@lib/api/redirectWithToast";
import { toastResponse } from "@lib/api/toastResponse";
import SectionCard from "@components/ui/SectionCard.astro";
import FormLegend from "@components/ui/forms/FormLegend.astro";
import FormShell from "@components/ui/FormShell.astro";
import ActionButton from "@components/ui/ActionButton.astro";

const { id } = Astro.params;

let errorMsg = "";
let app = {
  id: 0,
  title: "",
  categoryId: "",
  description: "",
  version: "",
  filePath: "",
  iconPath: "",
  metadata: [] as Array<{ label: string; value: string }>,
  instructionPdfPath: "",
  inPackBase: false,
};

const categories = await db.select().from(applicationCategories);

if (!id || isNaN(Number(id))) {
  return Astro.redirect(resolveUrl("/admin/aplicativos"));
}

const numericId = Number(id);

const existing = await db.query.applications.findFirst({
  where: eq(applications.id, numericId),
});

let decryptedMetadata: Array<{ label: string; value: string }> = [];
if (existing && existing.metadata) {
  try {
    const jsonStr = decryptData(existing.metadata);
    decryptedMetadata = JSON.parse(jsonStr);
  } catch (err) {
    console.error("Error al desencriptar metadatos:", err);
  }
}

const maskedMetadata = decryptedMetadata.map((meta, index) => ({
  label: meta.label,
  value: "••••••••",
  minRole: (meta as any).minRole || "",
  helpdesk: (meta as any).helpdesk || "",
  originalIndex: index,
}));

if (existing) {
  app = {
    id: existing.id,
    title: existing.title,
    categoryId: existing.categoryId ? String(existing.categoryId) : "",
    description: existing.description || "",
    version: existing.version || "",
    filePath: existing.filePath || "",
    iconPath: existing.iconPath || "",
    metadata: maskedMetadata as any,
    instructionPdfPath: existing.instructionPdfPath || "",
    inPackBase: existing.inPackBase ?? false,
  };
} else {
  return Astro.redirect(resolveUrl("/admin/aplicativos"));
}

let formUploadType = "";
let formExternalUrl = "";
let formSnapshot: FormData | null = null;

if (Astro.request.method === "POST") {
  const isAjax = Astro.request.headers
    .get("accept")
    ?.includes("application/json");
  try {
    const formData = await Astro.request.formData();
    formSnapshot = formData;

    const title = formData.get("title")?.toString().trim();
    const categoryIdRaw = formData.get("categoryId")?.toString().trim();
    const categoryId =
      categoryIdRaw && !isNaN(Number(categoryIdRaw))
        ? Number(categoryIdRaw)
        : null;
    const description = formData.get("description")?.toString().trim() || null;
    const version = formData.get("version")?.toString().trim() || null;
    const uploadType = formData.get("uploadType")?.toString() as
      "local" | "external" | null;
    const inPackBase =
      uploadType === "external"
        ? false
        : formData.get("inPackBase") === "true" ||
          formData.get("inPackBase") === "on";

    if (!title) {
      throw new Error("El título es obligatorio.");
    }
    if (title.length > 50) {
      throw new Error("El título no puede superar los 50 caracteres.");
    }
    if (description && description.length > 150) {
      throw new Error("La descripción no puede superar los 150 caracteres.");
    }

    let filePath = app.filePath || null;
    let iconPath = app.iconPath || null;

    if (uploadType === "external") {
      const externalUrl =
        formData.get("externalUrl")?.toString().trim() || null;
      if (externalUrl) {
        filePath = externalUrl;
      }
    } else {
      const file = formData.get("file") as File | null;
      const safeFileName = await processAppFileUpload(file, app.filePath);
      if (safeFileName) {
        filePath = `${resolveUrl("api/download/")}${safeFileName}`;
      }
    }

    const newIconPath = await processIconUpload({
      iconFile: formData.get("icon") as File | null,
      currentIconPath: app.iconPath || null,
    });
    if (newIconPath) {
      iconPath = newIconPath;
    }

    // Procesar metadatos
    const metadataRaw = formData.get("metadata")?.toString().trim();
    let metadataEncrypted = null;
    if (metadataRaw) {
      try {
        const submittedMeta: Array<{ label: string; value: string; minRole?: string; helpdesk?: string | null; metaIndex?: number }> = JSON.parse(metadataRaw);
        if (Array.isArray(submittedMeta) && submittedMeta.length > 0) {
          // Merge: si value está vacío o es el placeholder de máscara ("••••••••"), conservar el valor original de decryptedMetadata
          const merged = submittedMeta.map((item, idx) => {
            const originalIndex = item.metaIndex !== undefined ? item.metaIndex : idx;
            const original = decryptedMetadata[originalIndex];
            const finalValue =
              item.value === "" || item.value === "••••••••"
                ? (original ? original.value : "")
                : item.value;
            return {
              label: item.label,
              value: finalValue,
              ...(item.minRole ? { minRole: item.minRole } : {}),
              ...(item.helpdesk ? { helpdesk: item.helpdesk } : {}),
            };
          });
          metadataEncrypted = encryptData(JSON.stringify(merged));
        }
      } catch (e) {
        console.error("Error al parsear o encriptar metadatos:", e);
      }
    }

    // Procesar PDF de instructivo
    const instructionPdfFile = formData.get("instructionPdf") as File | null;
    let instructionPdfPath = app.instructionPdfPath || null;

    if (
      instructionPdfFile &&
      instructionPdfFile.size > 0 &&
      instructionPdfFile.name
    ) {
      const fs = await import("node:fs");
      const path = await import("node:path");

      const pdfsDir = getPdfsDir();
      ensureDir(pdfsDir);

      const ext = path.extname(instructionPdfFile.name);
      if (ext.toLowerCase() !== ".pdf") {
        throw new Error("El instructivo adjunto debe ser un archivo PDF.");
      }

      const baseName = path
        .basename(instructionPdfFile.name, ext)
        .replace(/[^a-zA-Z0-9_\-\.]/g, "_")
        .replace(/_+/g, "_");
      const safeFileName = `${Date.now()}_${baseName}${ext}`;

      try {
        const buffer = Buffer.from(await instructionPdfFile.arrayBuffer());
        fs.writeFileSync(path.join(pdfsDir, safeFileName), buffer);

        // Si existía un archivo viejo, borrarlo
        if (app.instructionPdfPath) {
          const oldAbsPath = path.join(pdfsDir, app.instructionPdfPath);
          if (fs.existsSync(oldAbsPath)) {
            fs.unlinkSync(oldAbsPath);
          }
        }

        instructionPdfPath = safeFileName;
      } catch (writeError: any) {
        console.error(
          `[aplicativos] Error al escribir PDF privado: ${writeError.message}`,
        );
        throw new Error(`No se pudo guardar el archivo PDF en el servidor.`);
      }
    }

    const oldTitle = app.title;
    await db
      .update(applications)
      .set({
        title,
        categoryId,
        description,
        version,
        filePath,
        iconPath,
        metadata: metadataEncrypted,
        instructionPdfPath,
        inPackBase,
      })
      .where(eq(applications.id, app.id));
    if (oldTitle && oldTitle !== title) {
      await logAdminFromAstro(
        Astro.locals,
        `Actualizó el aplicativo de "${oldTitle}" a "${title}"`,
      );
    } else {
      await logAdminFromAstro(
        Astro.locals,
        `Actualizó el aplicativo "${title}"`,
      );
    }

    if (isAjax) {
      return toastResponse({
        success: true,
        message: "Aplicativo actualizado con éxito.",
        redirectUrl: resolveUrl("/admin/aplicativos"),
      });
    }

    return redirectWithToast(
      "/admin/aplicativos",
      "Aplicativo actualizado con éxito.",
    );
  } catch (error: any) {
    if (isAjax) {
      return toastResponse({
        success: false,
        error: error.message || "Error al guardar el aplicativo.",
      });
    }
    errorMsg = error.message || "Error al guardar el aplicativo.";
    if (formSnapshot) {
      app.title = formSnapshot.get("title")?.toString() || "";
      app.categoryId = formSnapshot.get("categoryId")?.toString() || "";
      app.description = formSnapshot.get("description")?.toString() || "";
      app.version = formSnapshot.get("version")?.toString() || "";
      formUploadType = formSnapshot.get("uploadType")?.toString() || "";
      formExternalUrl = formSnapshot.get("externalUrl")?.toString() || "";
      app.inPackBase =
        formSnapshot.get("inPackBase") === "true" ||
        formSnapshot.get("inPackBase") === "on";

      const formMeta = formSnapshot.get("metadata")?.toString() || "[]";
      try {
        app.metadata = JSON.parse(formMeta);
      } catch {
        app.metadata = [];
      }
    }
  }
}

const isExternal = formUploadType
  ? formUploadType === "external"
  : /^https?:\/\//i.test(app.filePath);
---

<FormShell
  async
  enctype="multipart/form-data"
  backHref={resolveUrl("/admin/aplicativos")}
  title="Editar aplicativo"
  subtitle="Modificá los datos del aplicativo seleccionado."
>
  <script is:inline define:vars={{ errorMsg }}>
    if (errorMsg) {
      window.addEventListener("load", () =>
        window.showToast?.(errorMsg, "alert-error"),
      );
    }
  </script>

  <SectionCard>
    <div class="space-y-6 p-6 sm:p-8">
      <div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-3">
        <FormField
          id="input-title"
          name="title"
          label="Título"
          required
          value={app.title}
          placeholder="Ej: ShareX"
          maxlength={50}
        />

        <SelectField
          id="select-categoryId"
          name="categoryId"
          label="Categoría"
          selectClass="font-medium"
        >
          <option value="" selected={!app.categoryId}> Sin categoría </option>
          {
            categories.map((cat) => (
              <option
                value={cat.id}
                selected={Number(cat.id) === Number(app.categoryId)}
              >
                {cat.title}
              </option>
            ))
          }
        </SelectField>

        <FormField
          id="input-version"
          name="version"
          label="Versión"
          value={app.version}
          placeholder="Ej: 1.2.0"
          inputClass="font-mono text-sm"
          helpText="(Opcional)"
        />
      </div>

      <FormField
        type="file"
        id="input-icon"
        name="icon"
        label="Ícono"
        accept="image/png, image/jpeg, image/svg+xml, .ico"
        helpText="(Opcional, .png, .jpg, .svg, .ico)"
      >
        {
          iconExists(app.iconPath) && (
            <div
              slot="preview"
              class="rounded-box border-base-300 bg-base-200 flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden border p-1"
            >
              <img
                src={resolveUrl(`api/icons/${app.iconPath}`)}
                alt="Preview del ícono"
                class="h-full w-full object-contain"
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }
      </FormField>

      <div class="space-y-4">
        <fieldset class="fieldset">
          <FormLegend class="mb-2"> Origen del archivo </FormLegend>
          <div
            class="bg-base-200/60 flex gap-1 rounded-lg p-1"
            role="radiogroup"
            aria-label="Tipo de subida"
          >
            <label
              class:list={[
                "flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-all duration-200",
                !isExternal
                  ? "bg-base-100 text-base-content shadow-sm"
                  : "text-base-content/50 hover:text-base-content/80",
              ]}
            >
              <input
                type="radio"
                name="uploadType"
                value="local"
                checked={!isExternal}
                class="hidden"
                id="radio-local"
              />
              <Icon
                name="boxicons:arrow-in-up-square-half-filled"
                size={16}
                class="shrink-0"
              />
              Archivo local
            </label>
            <label
              class:list={[
                "flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-all duration-200",
                isExternal
                  ? "bg-base-100 text-base-content shadow-sm"
                  : "text-base-content/50 hover:text-base-content/80",
              ]}
            >
              <input
                type="radio"
                name="uploadType"
                value="external"
                checked={isExternal}
                class="hidden"
                id="radio-external"
              />
              <Icon
                name="boxicons:arrow-out-up-right-square-filled"
                size={16}
                class="shrink-0"
              />
              Enlace externo
            </label>
          </div>
        </fieldset>

        <div id="localUploadGroup" class:list={[isExternal && "hidden"]}>
          <FormField
            type="file"
            id="input-file"
            name="file"
            label="Archivo"
            accept=".zip,.exe,.msi,.rar"
            helpText="Formatos: .zip, .exe, .msi, .rar"
          />

          <div class="fieldset border-base-300 rounded-box bg-base-200/30 mt-3 border p-4">
            <label class="flex cursor-pointer items-start gap-3 select-none">
              <input
                type="checkbox"
                name="inPackBase"
                value="true"
                checked={app.inPackBase}
                class="checkbox checkbox-primary mt-0.5"
                id="checkbox-inPackBase"
              />
              <div class="space-y-0.5">
                <span class="text-base-content text-sm font-medium">
                  Incluir en el Pack base de operatoria (.zip)
                </span>
                <p class="text-base-content/60 text-xs">
                  Se empaquetará automáticamente dentro del archivo descargable del catálogo.
                </p>
              </div>
            </label>
          </div>
        </div>

        <div id="externalUrlGroup" class:list={[!isExternal && "hidden"]}>
          <FormField
            id="input-externalUrl"
            name="externalUrl"
            label="URL externa"
            type="url"
            value={formExternalUrl ||
              (/^https?:\/\//i.test(app.filePath) ? app.filePath : "")}
            placeholder="https://ejemplo.com/descarga/archivo.zip"
            inputClass="font-mono"
          />
        </div>

        {
          app.filePath && (
            <div class="bg-success/10 border-success/20 flex items-center gap-3 rounded-lg border px-4 py-3">
              <Icon
                name={
                  isExternal
                    ? "boxicons:arrow-out-up-right-square-filled"
                    : "boxicons:file-filled"
                }
                size={20}
                class="text-success shrink-0" is:inline />
              <div class="min-w-0 flex-1">
                <p class="text-base-content text-sm font-medium">
                  {isExternal ? "Enlace actual" : "Archivo actual cargado"}
                </p>
                <p class="text-base-content/60 truncate font-mono text-xs">
                  {app.filePath}
                </p>
              </div>
              <ActionButton
                href={app.filePath}
                icon={
                  isExternal
                    ? "boxicons:arrow-to-right"
                    : "boxicons:arrow-in-down-square-half-filled"
                }
                label={isExternal ? "Abrir" : "Descargar"}
                variant="ghost"
                size="xs"
                newTab
              />
            </div>
          )
        }
      </div>

      <div class="space-y-4">
        <FormField
          type="file"
          id="input-instruction-pdf"
          name="instructionPdf"
          label="Instructivo PDF"
          accept=".pdf"
          helpText="(Opcional, archivo .pdf confidencial)"
        />

        {
          app.instructionPdfPath && (
            <div class="bg-info/10 border-info/20 flex items-center gap-3 rounded-lg border px-4 py-3">
              <Icon
                name="boxicons:file-detail-filled"
                size={20}
                class="text-info shrink-0"
              />
              <div class="min-w-0 flex-1">
                <p class="text-base-content text-sm font-medium">
                  Instructivo PDF actual cargado
                </p>
                <p class="text-base-content/60 truncate font-mono text-xs">
                  {app.instructionPdfPath}
                </p>
              </div>
              <ActionButton
                href={resolveUrl(`api/aplicativos/pdf/${app.id}`)}
                icon="boxicons:arrow-in-down-square-half-filled"
                label="Descargar"
                variant="ghost"
                size="xs"
                newTab
              />
            </div>
          )
        }
      </div>

      <fieldset
        class="fieldset border-base-300 rounded-box bg-base-200/30 border p-4"
      >
        <FormLegend class="px-2">
          Credenciales / Metadatos Sensibles
        </FormLegend>
        <p class="text-base-content/60 mb-3 px-2 text-xs">
          Agregá credenciales o información confidencial (ej. Entorno:
          Contraseña). Se almacenarán cifradas.
        </p>

        <div id="metadata-rows" class="space-y-3 px-2">
          <!-- Se poblará dinámicamente con JS -->
        </div>

        <div>
          <button
            type="button"
            id="btn-add-meta"
            class="btn btn-sm btn-outline mt-4 ml-2 gap-2"
          >
            <Icon name="boxicons:plus-filled" size={16} />
            Agregar credencial
          </button>
        </div>

        <input
          type="hidden"
          name="metadata"
          id="input-metadata-json"
          value={JSON.stringify(app.metadata || [])}
        />
      </fieldset>

      <FormTextarea
        id="input-description"
        name="description"
        label="Descripción (Opcional)"
        value={app.description}
        placeholder="Breve descripción del aplicativo y su uso operativo."
        rows={3}
        maxlength={150}
      />
    </div>
  </SectionCard>
</FormShell>
<AsyncFormScript />

<script>
  const radios = document.querySelectorAll<HTMLInputElement>(
    'input[name="uploadType"]',
  );
  const localGroup = document.getElementById("localUploadGroup");
  const externalGroup = document.getElementById("externalUrlGroup");

  function syncGroups() {
    const selected = document.querySelector<HTMLInputElement>(
      'input[name="uploadType"]:checked',
    );
    if (!selected || !localGroup || !externalGroup) return;

    const isExternal = selected.value === "external";

    localGroup.classList.toggle("hidden", isExternal);
    externalGroup.classList.toggle("hidden", !isExternal);

    radios.forEach((radio) => {
      const label = radio.closest("label");
      if (!label) return;
      if (radio.checked) {
        label.classList.add("bg-base-100", "shadow-sm", "text-base-content");
        label.classList.remove(
          "text-base-content/50",
          "hover:text-base-content/80",
        );
      } else {
        label.classList.remove("bg-base-100", "shadow-sm", "text-base-content");
        label.classList.add(
          "text-base-content/50",
          "hover:text-base-content/80",
        );
      }
    });
  }

  radios.forEach((radio) => radio.addEventListener("change", syncGroups));

  import { fetchRevealedCredential } from "@lib/credentialRevealClient";

  // Manejo de Metadatos Dinámicos
  const metadataRowsContainer = document.getElementById("metadata-rows");
  const btnAddMeta = document.getElementById("btn-add-meta");
  const form = document.querySelector("form");
  const metadataJsonInput = document.getElementById(
    "input-metadata-json",
  ) as HTMLInputElement | null;

  function createMetaRow(label = "", value = "", minRole = "", helpdesk = "", originalIndex?: number) {
    const row = document.createElement("div");
    row.className = "flex flex-wrap sm:flex-nowrap items-center gap-2 app-meta-row bg-base-100/50 p-2 rounded-lg border border-base-300";
    if (originalIndex !== undefined) {
      row.setAttribute("data-meta-index", String(originalIndex));
    }

    row.innerHTML = `
      <input
        type="text"
        placeholder="Entorno / Clave (ej: Debian, MySQL)"
        class="input input-sm flex-1 font-semibold min-w-32"
        value="${label.replace(/"/g, "&quot;")}"
        data-meta-key
        required
      />
      <div class="flex items-center gap-1.5 flex-1 min-w-36">
        <input
          type="password"
          placeholder="••••••••"
          class="input input-sm w-full font-mono"
          value="${value.replace(/"/g, "&quot;")}"
          data-meta-val
          required
        />
        ${
          originalIndex !== undefined
            ? `<button type="button" class="btn btn-sm btn-ghost btn-square text-base-content/60 btn-reveal-meta" title="Revelar valor actual guardado">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
              </button>`
            : ""
        }
      </div>
      <select class="select select-sm max-w-36 text-xs" data-meta-role title="Rol mínimo para revelar">
        <option value="" ${!minRole ? "selected" : ""}>Todos</option>
        <option value="agent" ${minRole === "agent" ? "selected" : ""}>Agente</option>
        <option value="referent" ${minRole === "referent" ? "selected" : ""}>Referente</option>
        <option value="team_leader" ${minRole === "team_leader" ? "selected" : ""}>Team Leader</option>
        <option value="supervisor" ${minRole === "supervisor" ? "selected" : ""}>Supervisor</option>
        <option value="admin" ${minRole === "admin" ? "selected" : ""}>Admin</option>
      </select>
      <input
        type="text"
        placeholder="Mesa (opc.)"
        class="input input-sm w-24 text-xs"
        value="${helpdesk ? helpdesk.replace(/"/g, "&quot;") : ""}"
        data-meta-helpdesk
        title="Restringir a mesa de ayuda específica"
      />
      <button type="button" class="btn btn-sm btn-circle btn-ghost text-error btn-remove-meta shrink-0" title="Eliminar">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M5 20a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8H5v12zM18 9v11a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9h12zM9 5h6V4H9v1zM8 3h8v3H8V3z"/></svg>
      </button>
    `;

    const valInput = row.querySelector<HTMLInputElement>("[data-meta-val]");
    const btnReveal = row.querySelector<HTMLButtonElement>(".btn-reveal-meta");

    if (btnReveal && valInput && originalIndex !== undefined) {
      btnReveal.addEventListener("click", async () => {
        if (valInput.type === "text") {
          valInput.type = "password";
          return;
        }

        if (valInput.value === "••••••••" || !valInput.value) {
          const urlParts = window.location.pathname.split("/");
          const appId = Number(urlParts[urlParts.length - 1]);
          if (!appId) return;

          btnReveal.setAttribute("disabled", "true");
          const secret = await fetchRevealedCredential({
            entityType: "application",
            entityId: appId,
            metaIndex: originalIndex,
          });
          btnReveal.removeAttribute("disabled");

          if (secret !== null) {
            valInput.value = secret;
            valInput.type = "text";
          }
        } else {
          valInput.type = "text";
        }
      });
    }

    row.querySelector(".btn-remove-meta")?.addEventListener("click", () => {
      row.remove();
    });

    metadataRowsContainer?.appendChild(row);
  }

  btnAddMeta?.addEventListener("click", () => {
    createMetaRow();
  });

  // Renderizar metadatos iniciales
  if (metadataJsonInput) {
    try {
      const initialMetadata = JSON.parse(metadataJsonInput.value || "[]");
      if (Array.isArray(initialMetadata)) {
        initialMetadata.forEach((meta: any, idx: number) => {
          if (meta && typeof meta === "object" && meta.label) {
            const origIdx = meta.originalIndex !== undefined ? meta.originalIndex : idx;
            createMetaRow(meta.label, meta.value || "••••••••", meta.minRole || "", meta.helpdesk || "", origIdx);
          }
        });
      }
    } catch (e) {
      console.error("Error al parsear metadatos iniciales:", e);
    }
  }

  // Serializar credenciales en el evento nativo `formdata`
  form?.addEventListener("formdata", (event) => {
    const formData = (event as FormDataEvent).formData;
    const rows = document.querySelectorAll(".app-meta-row");
    const metaArray: Array<{ label: string; value: string; minRole?: string; helpdesk?: string | null; metaIndex?: number }> = [];

    rows.forEach((row) => {
      const keyInput = row.querySelector<HTMLInputElement>("[data-meta-key]");
      const valInput = row.querySelector<HTMLInputElement>("[data-meta-val]");
      const roleSelect = row.querySelector<HTMLSelectElement>("[data-meta-role]");
      const helpdeskInput = row.querySelector<HTMLInputElement>("[data-meta-helpdesk]");
      const metaIndexAttr = row.getAttribute("data-meta-index");

      if (keyInput && valInput) {
        const label = keyInput.value.trim();
        const value = valInput.value.trim();
        const minRole = roleSelect?.value || undefined;
        const helpdesk = helpdeskInput?.value.trim() || null;
        const metaIndex = metaIndexAttr !== null ? Number(metaIndexAttr) : undefined;
        if (label || value) {
          metaArray.push({ label, value, minRole, helpdesk, metaIndex });
        }
      }
    });

    formData.set("metadata", JSON.stringify(metaArray));
    if (metadataJsonInput) {
      metadataJsonInput.value = JSON.stringify(metaArray);
    }
  });
</script>
