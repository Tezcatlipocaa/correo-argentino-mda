---
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import FormShell from "@components/ui/FormShell.astro";
import FormField from "@components/ui/forms/FormField.astro";
import SelectField from "@components/ui/forms/SelectField.astro";
import SectionCard from "@components/ui/SectionCard.astro";
import KbEditor from "@components/base-conocimiento/KbEditor.astro";
import { can } from "@lib/roleConfig";
import { getModulePermissions } from "@lib/rbac";
import { kbArticleSchema } from "@lib/validations";
import {
  getArticle,
  listCategorySuggestions,
  updateArticleAndTransition,
  type KbArticle,
  type KbScope,
} from "@lib/kb";
import { logAdminFromAstro } from "@lib/auditLogger";
import { redirectWithToast } from "@lib/api/redirectWithToast";
import { resolveUrl } from "@lib/url";
import type { ToastType } from "@lib/toastClient";

type ArticleStatus = "draft" | "published" | "archived";

const statusOptions: Array<{ value: ArticleStatus; label: string }> = [
  { value: "draft", label: "Borrador" },
  { value: "published", label: "Publicado" },
  { value: "archived", label: "Archivado" },
];

const statusLabels: Record<ArticleStatus, string> = {
  draft: "Borrador",
  published: "Publicado",
  archived: "Archivado",
};

const statusClasses: Record<ArticleStatus, string> = {
  draft: "badge-warning",
  published: "badge-success",
  archived: "badge-neutral",
};

const isArticleStatus = (value: string): value is ArticleStatus =>
  value === "draft" || value === "published" || value === "archived";

const rawId = Astro.params.id;
if (!rawId || !/^\d+$/.test(rawId)) {
  return Astro.rewrite(resolveUrl("/404"));
}

const articleId = Number(rawId);
if (!Number.isSafeInteger(articleId) || articleId <= 0) {
  return Astro.rewrite(resolveUrl("/404"));
}

const user = Astro.locals.user;
const canWrite = getModulePermissions("base-conocimiento", user.role).canWrite;

if (!canWrite) {
  return redirectWithToast(
    "/base-conocimiento",
    "No tenés permisos para editar artículos.",
    "error",
  );
}

const sessionHelpdeskId = user.helpdeskId;
if (
  typeof sessionHelpdeskId !== "number" ||
  !Number.isInteger(sessionHelpdeskId) ||
  sessionHelpdeskId <= 0
) {
  return redirectWithToast(
    "/base-conocimiento",
    "Tu usuario no tiene una mesa asignada.",
    "error",
  );
}

const isAdmin = can(user.role, "admin");
const scope: KbScope = {
  helpdeskId: sessionHelpdeskId,
  includeAll: isAdmin,
};

let article: KbArticle | null = null;
let loadError = false;
let loadErrorMsg = "";
let errorMsg = "";
let toastType: ToastType = "alert-error";

try {
  article = getArticle(articleId, scope);
} catch (error) {
  console.error("[KbEdit] Error cargando el artículo:", error);
  loadError = true;
  loadErrorMsg = "No se pudo cargar el artículo. Intentá de nuevo.";
}

if (!loadError && !article) {
  return Astro.rewrite(resolveUrl("/404"));
}

const formValues = {
  title: article?.title ?? "",
  category: article?.category ?? "",
  content: article?.content ?? "",
  status: article?.status ?? "draft",
};

if (Astro.request.method === "POST" && !loadError && article) {
  try {
    const formData = await Astro.request.formData();
    formValues.title = formData.get("title")?.toString() ?? "";
    formValues.category = formData.get("category")?.toString() ?? "";
    formValues.content = formData.get("content")?.toString() ?? "";
    formValues.status = formData.get("status")?.toString().trim() || "draft";

    const parsed = kbArticleSchema.safeParse({
      title: formValues.title,
      category: formValues.category,
      content: formValues.content,
      status: formValues.status,
    });

    if (!parsed.success) {
      errorMsg = parsed.error.issues.map((issue) => issue.message).join(", ");
    } else {
      const result = updateArticleAndTransition(
        articleId,
        {
          title: parsed.data.title,
          content: parsed.data.content,
          category: parsed.data.category ?? null,
        },
        parsed.data.status,
        user.id,
        scope,
      );

      if (!result.ok) {
        errorMsg =
          result.reason === "invalid_transition"
            ? "No se puede volver a borrador. Solo se puede publicar o archivar el artículo."
            : "No se encontró el artículo. Intentá de nuevo.";
      } else {
        await logAdminFromAstro(
          Astro.locals,
          `Actualizó el artículo "${parsed.data.title}"`,
        );

        if (result.statusChanged) {
          const statusAudit =
            result.status === "published"
              ? `Publicó el artículo "${parsed.data.title}"`
              : `Archivó el artículo "${parsed.data.title}"`;
          await logAdminFromAstro(Astro.locals, statusAudit);
          return redirectWithToast(
            `/base-conocimiento/${articleId}`,
            result.status === "published"
              ? "Artículo publicado con éxito."
              : "Artículo archivado con éxito.",
          );
        }

        return redirectWithToast(
          "/base-conocimiento",
          "Artículo actualizado con éxito.",
        );
      }
    }
  } catch (error) {
    console.error("[KbEdit] Error guardando el artículo:", error);
    errorMsg = "No se pudo actualizar el artículo. Intentá de nuevo.";
  }
}

const currentStatus = article?.status;
const currentStatusLabel =
  currentStatus && isArticleStatus(currentStatus)
    ? statusLabels[currentStatus]
    : "Estado desconocido";
const currentStatusClass =
  currentStatus && isArticleStatus(currentStatus)
    ? statusClasses[currentStatus]
    : "badge-ghost";
const articleMesaLabel = article?.mesaName || "Mesa desconocida";
const editorTargetHelpdeskId = article?.helpdeskId ?? null;
const categorySuggestions = listCategorySuggestions(editorTargetHelpdeskId);
const backHref = resolveUrl("/base-conocimiento");
---

{
  loadError ? (
    <BaseLayout title="No se pudo cargar el artículo">
      <PageContainer width="2xl">
        <PageHeader
          title="No se pudo cargar el artículo"
          description="Intentá de nuevo más tarde."
        />
        <div class="alert alert-error mt-4" role="alert">
          <Icon name="boxicons:x-circle-filled" size={24} />
          <span>{loadErrorMsg}</span>
        </div>
        <a href={backHref} class="btn btn-secondary mt-4 gap-2">
          <Icon name="boxicons:arrow-big-left-filled" size={24} />
          Volver a la base de conocimiento
        </a>
      </PageContainer>
    </BaseLayout>
  ) : (
    <FormShell
      backHref={backHref}
      title={`Editar: ${article?.title ?? "artículo"}`}
      subtitle="Modificá los datos del artículo seleccionado."
      formId="kb-article-form"
      saveLabel="Guardar cambios"
      containerWidth="2xl"
    >
      <input type="hidden" name="id" value={articleId} />

      <SectionCard title="Datos del artículo" icon="boxicons:article-filled">
        <div class="space-y-6 p-6 sm:p-8">
          <div class="border-base-300 bg-base-200/40 rounded-box border p-4">
            <p class="text-base-content/70 text-sm">
              Mesa: <span class="badge badge-accent">{articleMesaLabel}</span>
            </p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <FormField
              id="kb-title"
              name="title"
              label="Título"
              required
              value={formValues.title}
              placeholder="Ej: Configurar una cuenta de correo"
              maxlength={120}
            />
            <FormField
              id="kb-category"
              name="category"
              label="Categoría"
              value={formValues.category}
              placeholder="Ej: Accesos"
              maxlength={60}
              helpText="Opcional"
              list={
                categorySuggestions.length > 0
                  ? "kb-category-suggestions"
                  : undefined
              }
            />
          </div>

          {categorySuggestions.length > 0 && (
            <datalist id="kb-category-suggestions">
              {categorySuggestions.map((category) => (
                <option value={category} />
              ))}
            </datalist>
          )}

          <div class="border-base-300 bg-base-200/40 rounded-box border p-4">
            <p class="text-base-content/70 text-sm">
              Estado actual:{" "}
              <span class={`badge ${currentStatusClass}`}>
                {currentStatusLabel}
              </span>
            </p>
          </div>

          <SelectField
            id="kb-status"
            name="status"
            label="Estado"
            required
            options={statusOptions}
            value={formValues.status}
            helpText="Podés publicar o archivar el artículo; no se puede volver a borrador."
          />

          <div class="space-y-2">
            <label
              for="kb-content"
              class="fieldset-legend font-bold tracking-wider"
            >
              Contenido <span class="text-error">*</span>
            </label>
            <KbEditor
              id="kb-content"
              name="content"
              required
              value={formValues.content}
              targetHelpdeskId={editorTargetHelpdeskId}
              helpText="Escribí el contenido en Markdown. Las imágenes se guardan en la mesa del artículo."
            />
          </div>
        </div>
      </SectionCard>
    </FormShell>
  )
}

<script is:inline define:vars={{ errorMsg, toastType }}>
  if (errorMsg) {
    window.addEventListener("load", () =>
      window.showToast?.(errorMsg, toastType),
    );
  }
</script>

<script>
  const formElement = document.getElementById("kb-article-form");
  if (formElement instanceof HTMLFormElement) {
    formElement.addEventListener("submit", (event) => {
      if (formElement.dataset.submitting === "true") {
        event.preventDefault();
        return;
      }

      queueMicrotask(() => {
        if (event.defaultPrevented) return;
        formElement.dataset.submitting = "true";
        const submitButton = formElement.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.classList.add("btn-disabled");
        }
      });
    });
  }
</script>
