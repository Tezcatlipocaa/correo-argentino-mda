---
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import AutomatizacionDetalleContent from "./_components/AutomatizacionDetalleContent.astro";
import { resolveUrl } from "@lib/url";
import { resolveAutomationDetail } from "@lib/workflow/resolver";
import type { AutomationDetail } from "@lib/workflow/resolver";
import { normalizeRole } from "@lib/rbac";

const { id } = Astro.params;
const automationId = Number.parseInt(id ?? "", 10);
const isValidId = Number.isInteger(automationId);

const user = Astro.locals.user;
const canQuery = user.id !== 0;
const canClose = normalizeRole(user.role) === "admin";

let detail: AutomationDetail | null = null;
let loadError = "";

if (isValidId && canQuery) {
  try {
    const result = await resolveAutomationDetail(automationId);
    if (result.ok) {
      detail = result.detail;
    } else {
      loadError = result.message;
    }
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Error desconocido";
  }
}
---

<BaseLayout>
  {
    isValidId ? (
      <AutomatizacionDetalleContent
        detail={detail}
        loadError={loadError}
        canQuery={canQuery}
        canClose={canClose}
      />
    ) : (
      <PageContainer>
        <a
          href={resolveUrl("/automatizaciones")}
          class="text-base-content/60 hover:text-base-content mb-2 inline-flex items-center gap-1.5 text-sm transition-colors"
        >
          <Icon name="boxicons:arrow-left-filled" size={14} aria-hidden="true" />
          Volver a automatizaciones
        </a>
        <PageHeader description="Detalle del workflow de automatización de sucursal en InvGate Service Management." />
        <p class="border-base-300 text-base-content/60 rounded-lg border border-dashed px-4 py-10 text-center text-sm">
          No se encontró la automatización solicitada. Volvé al listado para
          ver las automatizaciones registradas.
        </p>
        <a
          href={resolveUrl("/automatizaciones")}
          class="btn btn-secondary btn-sm self-center"
        >
          Volver a automatizaciones
        </a>
      </PageContainer>
    )
  }
</BaseLayout>
