---
import type { AutomationNode } from "@lib/workflow/resolver";
import type { WorkflowNodeLifecycle } from "@lib/workflow/node-status";
import { NODE_LIFECYCLE_LABELS } from "@lib/workflow/node-status";
import { formatEpochDateTime } from "@lib/format/datetime";
import OpenExternalUrlButton from "@components/ui/OpenExternalUrlButton.astro";
import WorkflowNodeBadge from "./WorkflowNodeBadge.astro";

interface Props {
  node: AutomationNode;
  /** Número de paso dentro de su sección (1-based). */
  stepNumber: number;
  /** Nodo fantasma: ticket esperado por la plantilla que aún no existe. */
  ghost?: { label: string; variant: "missing" | "registration" };
  /** Etiqueta amigable (template de etapa o derivada del título). */
  displayLabel?: string;
  /** Último nodo de la lista (corta el conector vertical). */
  isLast?: boolean;
}

const {
  node,
  stepNumber,
  ghost = null,
  displayLabel,
  isLast = false,
} = Astro.props;

const isGhost = ghost !== null;

const dotClassByLifecycle: Record<WorkflowNodeLifecycle, string> = {
  completed: "bg-success",
  in_progress: "bg-info",
  pending: "bg-warning",
  blocked: "bg-error",
  skipped: "bg-neutral opacity-60",
  not_applicable: "bg-neutral opacity-60",
  unknown: "bg-neutral",
};

const ghostBadgeClass = {
  missing: "badge-warning badge-outline",
  registration: "badge-neutral badge-outline",
} as const;

const ghostBadgeLabel = {
  missing: "Faltante",
  registration: "Pendiente de registro",
} as const;

const stepLabel = isGhost
  ? ghost.label
  : (displayLabel?.trim() || node.stepLabel);
---

<li class="relative flex gap-4 pb-6 last:pb-0">
  <div class="flex w-3 shrink-0 flex-col items-center">
    {
      isGhost ? (
        <span
          aria-hidden="true"
          class="border-base-400 z-10 mt-2 size-3 rounded-full border-2 border-dashed"
        />
      ) : (
        <span
          aria-hidden="true"
          title={NODE_LIFECYCLE_LABELS[node.lifecycle]}
          class:list={[
            "ring-base-100 z-10 mt-2 size-3 rounded-full ring-4",
            dotClassByLifecycle[node.lifecycle],
          ]}
        />
      )
    }
    {!isLast && <span aria-hidden="true" class="bg-base-300 -mt-1 w-px flex-1" />}
  </div>

  <article
    class:list={[
      "min-w-0 flex-1 rounded-xl border p-4",
      isGhost
        ? "border-base-300 bg-base-200/40 border-dashed"
        : "bg-base-100 border-base-300 shadow-sm",
      node.lifecycle === "completed" ? "border-secondary/40 bg-secondary/10" : "",
    ]}
  >
    <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
      <div class="min-w-0">
        <div class="flex flex-wrap items-baseline gap-x-2">
          <span class="text-base-content/40 font-mono text-xs">
            {stepNumber}.
          </span>
          <h3 class="text-base-content text-sm font-semibold">{stepLabel}</h3>
          {
            !isGhost && node.prettyId && (
              <code class="bg-base-200 text-base-content/80 rounded px-1.5 py-0.5 font-mono text-xs">
                {node.prettyId}
              </code>
            )
          }
          {
            !isGhost && !node.prettyId && (
              <code class="border-base-300 text-base-content/60 rounded border border-dashed px-1.5 py-0.5 font-mono text-xs">
                T{node.refId}
              </code>
            )
          }
          {isGhost && (
            <span class:list={["badge py-0 rounded shrink-0", ghostBadgeClass[ghost.variant]]}>
              {ghostBadgeLabel[ghost.variant]}
            </span>
          )}
        </div>
        {
          !isGhost && node.title !== stepLabel && (
            <p class="text-base-content/60 mt-0.5 truncate text-xs">
              {node.title}
            </p>
          )
        }
      </div>

      <div class="flex shrink-0 flex-col items-end gap-1">
        {
          !isGhost && (
            <>
              <WorkflowNodeBadge lifecycle={node.lifecycle} />
              <time
                class="text-base-content/60 text-xs"
                datetime={
                  node.createdAt !== null
                    ? new Date(node.createdAt * 1000).toISOString()
                    : undefined
                }
              >
                {node.createdAt !== null
                  ? formatEpochDateTime(node.createdAt)
                  : "Sin fecha"}
              </time>
            </>
          )
        }
        {isGhost && (
          <span class="text-base-content/40 text-xs italic">Sin ticket aún</span>
        )}
      </div>
    </div>

    {
      !isGhost && node.lifecycle === "completed" && node.solution && (
        <div class="border-success/40 bg-success/10 mt-3 flex flex-col gap-1 rounded-lg border-l-2 px-3 py-2">
          <div class="flex flex-wrap items-center gap-x-2">
            <span class="text-success text-xs font-semibold tracking-wide uppercase">
              Solución
            </span>
            {node.solutionAuthorName && (
              <span class="text-base-content/50 text-xs">
                · {node.solutionAuthorName}
              </span>
            )}
          </div>
          <p class="text-base-content/80 break-words text-sm leading-relaxed whitespace-pre-line">
            {node.solution}
          </p>
        </div>
      )
    }

    {
      !isGhost && node.tasks.length > 0 && (
        <div class="mt-3 flex flex-col gap-2">
          <span class="text-base-content/60 text-xs font-semibold tracking-wide uppercase">
            Tareas ({node.tasks.length})
          </span>
          <ul class="flex flex-col gap-1.5">
            {node.tasks.map((task) => (
              <li class="bg-base-200/50 border-base-300 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-lg border px-3 py-2">
                <span class="text-base-content/80 text-sm">{task.name}</span>
                <span class="flex items-center gap-2">
                  {task.sectorName && (
                    <span class="text-base-content/50 text-xs">
                      {task.sectorName}
                    </span>
                  )}
                  <WorkflowNodeBadge lifecycle={task.lifecycle} />
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      !isGhost && node.activity.length > 0 && (
        <details class="mt-3">
          <summary class="text-base-content/60 hover:text-base-content cursor-pointer select-none text-xs font-medium transition-colors">
            Ver actividad ({node.activity.length})
          </summary>
          <ul class="mt-2 space-y-2">
            {node.activity.map((entry) => (
              <li class="bg-base-200/50 border-base-300 rounded-lg border px-3 py-2">
                <div class="flex flex-wrap items-center gap-x-2">
                  <time
                    class="text-base-content/40 text-xs"
                    datetime={new Date(entry.createdAt * 1000).toISOString()}
                  >
                    {formatEpochDateTime(entry.createdAt)}
                  </time>
                  {entry.authorName && (
                    <span class="text-base-content/50 text-xs">
                      · {entry.authorName}
                    </span>
                  )}
                </div>
                <p class="text-base-content/80 mt-1 break-words text-sm leading-relaxed whitespace-pre-line">
                  {entry.text}
                </p>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    {
      !isGhost && node.invgateUrl && (
        <div class="mt-3 flex justify-end">
          <OpenExternalUrlButton
            href={node.invgateUrl}
            ariaLabel={`Abrir ticket ${node.prettyId ?? `T${node.refId}`} en InvGate`}
            variant="text"
            label="Abrir en InvGate"
            size="xs"
          />
        </div>
      )
    }
  </article>
</li>
