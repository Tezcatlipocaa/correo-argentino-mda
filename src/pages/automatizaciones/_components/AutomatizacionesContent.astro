---
import { Icon } from "astro-icon/components";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import Pagination from "@components/ui/Pagination.astro";
import ActionButton from "@components/ui/ActionButton.astro";
import AutomationCardList from "./AutomationCardList.astro";
import AutomationRecentList from "./AutomationRecentList.astro";
import AutomationParentsTable from "./AutomationParentsTable.astro";
import AutomationFiltersDrawer from "./AutomationFiltersDrawer.astro";
import AutomationEmptyState from "./AutomationEmptyState.astro";
import {
  discoverAutomationsWithMeta,
  revalidateAutomations,
} from "@lib/workflow/discovery";
import type {
  AutomationDiscoveryResult,
  AutomationSummary,
} from "@lib/workflow/discovery";
import {
  AUTOMATION_PARENT_AGE_BUCKETS,
  getAutomationParentsDataAsOf,
  listAutomationParentsPage,
  listAutomationRegions,
  listRecentAutomationParents,
  parseAutomationParentsQuery,
} from "@lib/workflow/parent-history";
import type {
  AutomationParentAge,
  AutomationParentOrder,
  AutomationParentStatusFilter,
} from "@lib/workflow/parent-history";
import { getIncidentStatuses } from "@lib/invgate/automation/statuses";
import { buildStatusNameLookup } from "@lib/workflow/automation-status";
import { formatEpochDateTime } from "@lib/format/datetime";
import { getCleanBase } from "@lib/baseUrl";
import { resolveUrl } from "@lib/url";
import { isLoggedIn } from "@lib/rbac";

const user = Astro.locals.user;
const canQuery = isLoggedIn(user);

const searchParams = Astro.url.searchParams;
const parsedQuery = parseAutomationParentsQuery(searchParams);
const requestedPage = parsedQuery.page ?? 1;
const q = parsedQuery.q ?? "";
const status: AutomationParentStatusFilter = parsedQuery.status ?? "all";
const region = parsedQuery.region ?? "";
const age: AutomationParentAge | "" = parsedQuery.age ?? "";
const order: AutomationParentOrder = parsedQuery.order ?? "recent";
const fromDate = (searchParams.get("from") ?? "").trim();
const toDate = (searchParams.get("to") ?? "").trim();
const view: "cards" | "table" =
  searchParams.get("view") === "table" ? "table" : "cards";
const forceRefresh = searchParams.get("refresh") === "1";
const hasListFilters =
  q.length > 0 ||
  status !== "all" ||
  region !== "" ||
  age !== "" ||
  fromDate !== "" ||
  toDate !== "";

let discovery: AutomationDiscoveryResult | null = null;
let discoveryStale = false;
let statusNames: Record<number, string> = {};
let loadError = "";

if (canQuery) {
  try {
    const [result, statuses] = await Promise.all([
      forceRefresh ? revalidateAutomations() : discoveryRefresh(),
      getIncidentStatuses(),
    ]);
    discovery = result;
    statusNames = buildStatusNameLookup(statuses.ok ? statuses.data : null);
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Error desconocido";
  }
}

/** Wrapper para capturar el flag de staleness sin duplicar el await. */
async function discoveryRefresh(): Promise<AutomationDiscoveryResult> {
  const meta = await discoverAutomationsWithMeta();
  discoveryStale = meta.stale;
  return meta.result;
}

const pageResult = canQuery
  ? listAutomationParentsPage({
      page: requestedPage,
      q,
      status,
      region: region || undefined,
      age: age || undefined,
      from: parsedQuery.from,
      to: parsedQuery.to,
      order,
    })
  : { items: [], total: 0, page: 1, pageSize: 20, totalPages: 1 };

const regions = canQuery ? listAutomationRegions() : [];
const dataAsOf = canQuery ? getAutomationParentsDataAsOf() : null;

let recentParents = canQuery ? listRecentAutomationParents(4) : [];
let allParents = pageResult.items;
let totalParents = pageResult.total;
let page = pageResult.page;
const pageSize = pageResult.pageSize;
let totalPages = pageResult.totalPages;

/**
 * Fallback cuando la DB de historial todavía está vacía (primer render con
 * snapshot de discovery en cache): sembrar desde el snapshot para no mostrar
 * la vista vacía.
 */
if (
  canQuery &&
  discovery !== null &&
  discovery.ok &&
  (totalParents === 0 || recentParents.length === 0)
) {
  const fallback = new Map<number, AutomationSummary>();
  const seed = [
    ...(discovery.current ? [discovery.current] : []),
    ...discovery.otherActive,
    ...discovery.recentFinalized,
  ];
  for (const item of seed) {
    fallback.set(item.id, item);
  }
  const fallbackParents = [...fallback.values()];

  if (recentParents.length === 0) {
    recentParents = [...fallbackParents]
      .sort((a, b) => b.updatedAt - a.updatedAt || b.createdAt - a.createdAt)
      .slice(0, 4);
  }

  if (totalParents === 0 && !hasListFilters && fallbackParents.length > 0) {
    const sortedByCreated = [...fallbackParents].sort(
      (a, b) => b.createdAt - a.createdAt || b.id - a.id,
    );
    allParents = sortedByCreated;
    totalParents = sortedByCreated.length;
    totalPages = Math.max(1, Math.ceil(totalParents / pageSize));
  }
}

const featured = recentParents[0] ?? null;
const recent = recentParents.slice(1, 4);

const errorMessage =
  loadError || (discovery !== null && !discovery.ok ? discovery.message : "");

const parentsEmpty = totalParents === 0 && !hasListFilters;

const statusFilters = [
  { key: "all", label: "Todas" },
  { key: "active", label: "En curso" },
  { key: "finalized", label: "Terminadas" },
] as const;

/** Query params del listado preservando filtros. */
function buildFilterParams(overrides: {
  page?: number | null;
  q?: string | null;
  status?: AutomationParentStatusFilter | null;
  region?: string | null;
  age?: AutomationParentAge | null;
  from?: string | null;
  to?: string | null;
  order?: AutomationParentOrder | null;
  view?: "cards" | "table" | null;
  refresh?: boolean;
}): URLSearchParams {
  const nextQ = overrides.q === undefined ? q : (overrides.q ?? "");
  const nextStatus =
    overrides.status === undefined ? status : (overrides.status ?? "all");
  const nextRegion =
    overrides.region === undefined ? region : (overrides.region ?? "");
  const nextAge = overrides.age === undefined ? age : (overrides.age ?? "");
  const nextFrom =
    overrides.from === undefined ? fromDate : (overrides.from ?? "");
  const nextTo = overrides.to === undefined ? toDate : (overrides.to ?? "");
  const nextOrder =
    overrides.order === undefined ? order : (overrides.order ?? "recent");
  const nextView =
    overrides.view === undefined ? view : (overrides.view ?? "cards");
  const nextPage = overrides.page === undefined ? page : overrides.page;

  const params = new URLSearchParams();
  if (nextQ) params.set("q", nextQ);
  if (nextStatus !== "all") params.set("status", nextStatus);
  if (nextRegion) params.set("region", nextRegion);
  if (nextAge) params.set("age", nextAge);
  if (nextFrom) params.set("from", nextFrom);
  if (nextTo) params.set("to", nextTo);
  if (nextOrder && nextOrder !== "recent") params.set("order", nextOrder);
  if (nextView === "table") params.set("view", "table");
  if (nextPage && nextPage > 1) params.set("page", String(nextPage));
  if (overrides.refresh) params.set("refresh", "1");
  return params;
}

/** Href del listado preservando filtros; `page` null resetea la paginación. */
function buildListHref(overrides: Parameters<typeof buildFilterParams>[0]): string {
  const search = buildFilterParams(overrides).toString();
  return `${Astro.url.pathname}${search ? `?${search}` : ""}`;
}

/** Href de export CSV del listado con los filtros actuales. */
function buildExportHref(): string {
  const search = buildFilterParams({}).toString();
  return `${getCleanBase()}api/automatizaciones/export.csv${search ? `?${search}` : ""}`;
}

const regionOptions = [
  { value: "", label: "Todas" },
  ...regions.map((value) => ({ value, label: value })),
];

const ageOptions = [
  { value: "", label: "Todas" },
  ...AUTOMATION_PARENT_AGE_BUCKETS.map((value) => ({
    value,
    label: value === "30+" ? "Más de 30 días" : `${value} días`,
  })),
];

const orderOptions = [
  { value: "recent", label: "Más nuevas" },
  { value: "oldest", label: "Más antiguas" },
  { value: "updated", label: "Actualizadas" },
];

const statusOptions = statusFilters.map((filter) => ({
  value: filter.key,
  label: filter.label,
}));

const stateLabel =
  statusFilters.find((filter) => filter.key === status)?.label ?? "Todas";

/** Cantidad de filtros activos (estado/región/antigüedad/fechas/orden). */
const activeFilterCount =
  (status !== "all" ? 1 : 0) +
  (region ? 1 : 0) +
  (age ? 1 : 0) +
  (fromDate ? 1 : 0) +
  (toDate ? 1 : 0) +
  (order !== "recent" ? 1 : 0);
---

<PageContainer width="xl" gap="lg" class="acc">
  <PageHeader
    title="Automatizaciones"
    description="Monitoreo de automatizaciones de sucursales manuales ejecutadas en InvGate Service Management."
  />

  {
    !canQuery ? (
      <div role="alert" class="alert alert-warning">
        <span>
          Sesión no iniciada. Iniciá sesión para consultar las automatizaciones.
        </span>
      </div>
    ) : (
      <>
        {errorMessage && (
          <div role="alert" class="alert alert-error">
            <div>
              <h3 class="font-medium">No se pudo consultar InvGate</h3>
              <p class="text-sm opacity-80">
                {errorMessage} Mostramos el último estado conocido.
              </p>
            </div>
          </div>
        )}

        {discoveryStale && (
          <div
            role="status"
            aria-live="polite"
            data-automation-stale
            data-automation-revalidate-href={`${getCleanBase()}api/automatizaciones/revalidate`}
            class="text-base-content/60 flex items-center gap-2 text-xs"
          >
            <span class="loading loading-spinner loading-xs" />
            Actualizando estados en segundo plano…
          </div>
        )}

        {parentsEmpty ? (
          !errorMessage && (
            <AutomationEmptyState
              class="py-10"
              message="No hay automatizaciones en curso ni recientes registradas en la categoría de automatización de sucursales."
            />
          )
        ) : (
          <div class="flex flex-col gap-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex flex-1 flex-wrap items-center gap-2">
                <form
                  id="automation-filters-form"
                  method="get"
                  class="flex items-center"
                  role="search"
                  data-automation-search-form
                >
                  <SearchBar
                    id="automatizaciones-search"
                    name="q"
                    value={q}
                    placeholder="Buscar por NIS o sucursal..."
                    ariaLabel="Buscar automatización por NIS o nombre de sucursal"
                    class="automation-search w-full sm:w-64"
                    clearable
                  />
                  {view === "table" && (
                    <input type="hidden" name="view" value="table" />
                  )}
                </form>

                <ActionButton
                  href={buildListHref({ refresh: true })}
                  variant="ghost"
                  size="sm"
                  icon="boxicons:refresh-cw"
                  label="Actualizar"
                />

                {dataAsOf && (
                  <span class="text-base-content/60 text-xs">
                    Datos al {formatEpochDateTime(dataAsOf)}
                  </span>
                )}
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <ActionButton
                  href={resolveUrl("/automatizaciones/metricas")}
                  data-astro-prefetch="hover"
                  variant="ghost"
                  size="sm"
                  icon="boxicons:bar-chart-big-filled"
                  label="Métricas"
                />

                <ActionButton
                  href={buildExportHref()}
                  download
                  variant="ghost"
                  size="sm"
                  icon="boxicons:file-detail-filled"
                  label="Exportar CSV"
                />
              </div>
            </div>

            <p
              id="automatizaciones-live"
              class="sr-only"
              role="status"
              aria-live="polite"
            ></p>

            <div data-automation-results>
            {!hasListFilters && view === "cards" && (
              <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
                <section class="flex flex-col gap-3 lg:col-span-2">
                  <div class="flex flex-wrap items-baseline gap-x-2">
                    {featured?.isActive && (
                      <span class="relative mr-1 flex size-2 self-center">
                        <span class="acc-surface absolute inline-flex h-full w-full animate-ping rounded-full opacity-75" />
                        <span class="acc-surface relative inline-flex size-2 rounded-full" />
                      </span>
                    )}
                    <h2 class="text-base-content/60 text-sm font-semibold tracking-wide uppercase">
                      Última actualización
                    </h2>
                    {featured && (
                      <span class="text-base-content/50 text-xs">
                        {formatEpochDateTime(featured.updatedAt)}
                      </span>
                    )}
                  </div>
                  {featured && (
                    <AutomationCardList
                      items={[featured]}
                      statusNames={statusNames}
                      defaultOpenId={featured.id}
                      collapsible={false}
                    />
                  )}
                </section>

                <section class="flex flex-col gap-3">
                  <h2 class="text-base-content/60 text-sm font-semibold tracking-wide uppercase">
                    Actualizadas recientemente
                  </h2>
                  {/*
                  En lg la lista toma exactamente el alto de la card destacada:
                  el wrapper flexible no aporta altura intrínseca (min-h-0) y la
                  lista se posiciona absoluta dentro, con scroll propio si sobra.
                */}
                  <div class="lg:relative lg:min-h-0 lg:flex-1">
                    <div class="lg:absolute lg:inset-0">
                      <AutomationRecentList
                        items={recent}
                        emptyMessage="Sin automatizaciones recientes."
                      />
                    </div>
                  </div>
                </section>
              </div>
            )}

            <section class="flex flex-col gap-4 mt-4">
              <article class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <h2 class="text-base-content/60 text-sm font-semibold tracking-wide uppercase">
                    {hasListFilters
                      ? totalParents === 1
                        ? "automatización encontrada"
                        : "automatizaciones encontradas"
                      : "automatizaciones totales"}
                  </h2>
                  <span class="badge badge-ghost badge-lg text-base-content font-semibold">
                    {totalParents}
                  </span>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                  <div class="join" role="group" aria-label="Vista del listado">
                    <a
                      href={buildListHref({ view: "cards", page: null })}
                      aria-current={view === "cards" ? "true" : false}
                      aria-label="Tarjetas"
                      title="Vista de tarjetas"
                      class:list={[
                        "join-item btn btn-sm btn-square acc-flat",
                        view === "cards" && "acc-btn",
                      ]}
                    >
                      <Icon
                        name="boxicons:apps"
                        size={16}
                        is:inline
                        aria-hidden="true"
                      />
                    </a>
                    <a
                      href={buildListHref({ view: "table", page: null })}
                      aria-current={view === "table" ? "true" : false}
                      aria-label="Tabla"
                      title="Vista de tabla"
                      class:list={[
                        "join-item btn btn-sm btn-square acc-flat",
                        view === "table" && "acc-btn",
                      ]}
                    >
                      <Icon
                        name="boxicons:table-filled"
                        size={16}
                        is:inline
                        aria-hidden="true"
                      />
                    </a>
                  </div>

                  <ActionButton
                    type="button"
                    data-open-filters
                    variant="ghost"
                    size="sm"
                    icon="boxicons:filter-filled"
                    aria-haspopup="dialog"
                  >
                    <span>
                      Filtros{status !== "all" ? ` · ${stateLabel}` : ""}
                    </span>
                    {activeFilterCount > 0 && (
                      <span class="badge acc-badge badge-sm">
                        {activeFilterCount}
                      </span>
                    )}
                  </ActionButton>
                </div>
              </article>

              {view === "table" ? (
                <AutomationParentsTable
                  items={allParents}
                  emptyMessage={
                    hasListFilters
                      ? "Ninguna automatización coincide con la búsqueda o el filtro."
                      : "No hay automatizaciones registradas todavía."
                  }
                />
              ) : allParents.length === 0 ? (
                <AutomationEmptyState
                  message={
                    hasListFilters
                      ? "Ninguna automatización coincide con la búsqueda o el filtro."
                      : "No hay automatizaciones registradas todavía."
                  }
                />
              ) : (
                <AutomationCardList
                  items={allParents}
                  statusNames={statusNames}
                  defaultOpenId={q ? (allParents[0]?.id ?? null) : null}
                />
              )}
              {totalPages > 1 && (
                <div class="flex justify-center pt-2">
                  <Pagination
                    totalPages={totalPages}
                    currentPage={page}
                    hrefFor={(target) => buildListHref({ page: target })}
                    accent
                  />
                </div>
              )}
            </section>
            </div>

            <AutomationFiltersDrawer
              formId="automation-filters-form"
              status={status}
              statusOptions={statusOptions}
              region={region}
              age={age}
              order={order}
              fromDate={fromDate}
              toDate={toDate}
              regionOptions={regionOptions}
              ageOptions={ageOptions}
              orderOptions={orderOptions}
              clearHref={buildListHref({
                status: null,
                region: null,
                age: null,
                from: null,
                to: null,
                order: null,
                page: null,
              })}
            />
          </div>
        )}
      </>
    )
  }
</PageContainer>

<style is:global>
  /* El input de búsqueda usa type="search": Chromium agrega su propia "×" de
     limpiar además de la del componente. Se oculta la nativa. */
  .automation-search input[type="search"]::-webkit-search-cancel-button,
  .automation-search input[type="search"]::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
</style>
