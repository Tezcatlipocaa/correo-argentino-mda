---
import { NODE_LIFECYCLE_LABELS } from "@lib/workflow/node-status";
import type { WorkflowNodeLifecycle } from "@lib/workflow/node-status";
import { NODE_LIFECYCLE_BADGE_CLASSES } from "@lib/workflow/node-styles";

interface Props {
  lifecycle: WorkflowNodeLifecycle;
  class?: string;
  /** Texto alternativo (p. ej. el estado crudo de InvGate "En espera"). */
  label?: string;
}

const { lifecycle, class: className = "", label } = Astro.props;
---

<span
  class:list={[
    "badge badge-sm shrink-0",
    NODE_LIFECYCLE_BADGE_CLASSES[lifecycle],
    className,
  ]}
>
  {label?.trim() || NODE_LIFECYCLE_LABELS[lifecycle]}
</span>
