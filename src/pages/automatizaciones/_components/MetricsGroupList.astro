---
import SectionCard from "@components/ui/SectionCard.astro";
import MetricInfo from "@components/ui/MetricInfo.astro";
import type { GroupStat } from "@lib/workflow/metrics";
import { formatDays } from "@lib/workflow/metricsFormat";

interface Props {
  title: string;
  icon: string;
  description: string;
  groups: readonly GroupStat[];
  emptyMessage: string;
  hint?: { label: string; description: string };
  /** Si se define, cada fila enlaza al listado con el filtro del grupo. */
  hrefFor?: (group: GroupStat) => string;
}

const { title, icon, description, groups, emptyMessage, hint, hrefFor } =
  Astro.props;
---

<SectionCard title={title} description={description} icon={icon}>
  {
    hint && (
      <div slot="description" class="flex items-center gap-1">
        {description}
        <MetricInfo label={hint.label} description={hint.description} />
      </div>
    )
  }
  {
    groups.length === 0 ? (
      <p class="text-base-content/50 text-sm italic">{emptyMessage}</p>
    ) : (
      <ul class="flex flex-col divide-y divide-base-300">
        {groups.map((group) => (
          <li class="grid grid-cols-[1fr_auto] items-center gap-3 py-2 first:pt-0 last:pb-0">
            {hrefFor ? (
              <a
                href={hrefFor(group)}
                class="text-base-content/80 hover:acc-text min-w-0 truncate text-sm"
              >
                {group.label}
              </a>
            ) : (
              <span class="text-base-content/80 min-w-0 truncate text-sm">
                {group.label}
              </span>
            )}
            <span class="flex items-center gap-3 text-xs tabular-nums">
              <span class="text-base-content/60">{group.total} total</span>
              <span class="text-info font-semibold">{group.active} activos</span>
              <span class="text-base-content/60">
                {formatDays(group.medianLeadDays)}
              </span>
            </span>
          </li>
        ))}
      </ul>
    )
  }
</SectionCard>
