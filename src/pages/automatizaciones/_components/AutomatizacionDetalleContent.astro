---
import { Icon } from "astro-icon/components";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import OpenExternalUrlButton from "@components/ui/OpenExternalUrlButton.astro";
import Modal from "@components/ui/Modal.astro";
import FormTextarea from "@components/ui/forms/FormTextarea.astro";
import ActionCancelButton from "@components/ui/ActionCancelButton.astro";
import ActionConfirmButton from "@components/ui/ActionConfirmButton.astro";
import AutomationProgressBar from "./AutomationProgressBar.astro";
import AutomationTimeline from "./AutomationTimeline.astro";
import AutomationLifecycleLabel from "./AutomationLifecycleLabel.astro";
import InitialFormDetails from "./InitialFormDetails.astro";
import { isActiveStatus, isFinalizedStatus } from "@lib/workflow/automation-status";
import {
  DEFAULT_CLOSE_REASON,
  canManualClose,
} from "@lib/workflow/closures";
import type { AutomationClosure } from "@lib/workflow/closures";
import { formatEpochDateTime } from "@lib/format/datetime";
import { resolveUrl } from "@lib/url";
import { deriveInvGateUiUrl } from "@lib/invgate/automation/url";
import type { AutomationDetail } from "@lib/workflow/resolver";

interface Props {
  detail: AutomationDetail | null;
  loadError: string;
  canQuery: boolean;
  canClose: boolean;
}

const { detail, loadError, canQuery, canClose } = Astro.props;

const closure: AutomationClosure | null = detail?.closure ?? null;
const hasClosure = closure !== null;
const invgateUrl = detail ? deriveInvGateUiUrl(detail.id) : "";
const isFinalized =
  hasClosure || (detail !== null && isFinalizedStatus(detail.statusId));
const isLegacy = detail?.workflowKind === "legacy";
const showMissing = !isFinalized && !isLegacy;
const missingCount = detail?.stages?.missingBlockingCount ?? 0;
const initialFormAuthor = detail?.initialForm?.authorName ?? null;

const canShowCloseButton =
  canClose &&
  detail !== null &&
  !hasClosure &&
  isActiveStatus(detail.statusId) &&
  canManualClose(detail.progress.percent);
const canReopen = canClose && hasClosure && closure?.kind === "manual";
---

<PageContainer width="xl">
  <!-- Volver a automatizaciones -->
  <a
    href={resolveUrl("/automatizaciones")}
    data-astro-prefetch="hover"
    class="text-base-content/60 hover:text-base-content inline-flex items-center gap-1.5 text-sm transition-colors"
  >
    <Icon name="boxicons:arrow-left-filled" size={14} aria-hidden="true" />
    Volver a automatizaciones
  </a>

  <div
    class="bg-base-100 border-base-300 sticky -top-4 z-20 flex flex-col gap-3 border-b pb-4 md:-top-6"
  >
    {
      detail && (
        <div class="flex flex-wrap items-center gap-2">
          <div class="flex flex-wrap items-center gap-2">
            <code class="bg-secondary rounded-sm px-1.5 py-0.5 font-mono text-xs text-white">
              {detail.prettyId}
            </code>

            <div class="text-base-content/60 flex items-center gap-x-1 text-sm tracking-wide">
              <AutomationLifecycleLabel
                statusId={detail.statusId}
                hasClosure={hasClosure}
                class="text-sm"
              />
              <span>{" · "}</span>
              <p>
                Solicitud iniciada el
                {formatEpochDateTime(detail.createdAt)}
              </p>
            </div>
          </div>

          {(canShowCloseButton || canReopen) && (
            <div class="ml-auto flex items-center gap-2">
              {canShowCloseButton && (
                <button
                  type="button"
                  class="btn btn-secondary btn-sm gap-1"
                  data-open-close-automation
                >
                  <Icon
                    name="boxicons:check-circle"
                    size={16}
                    aria-hidden="true"
                  />
                  Cerrar caso
                </button>
              )}
              {canReopen && (
                <button
                  type="button"
                  class="btn btn-ghost btn-sm gap-1"
                  data-reopen-automation
                  data-automation-id={detail.id}
                >
                  <Icon name="boxicons:refresh-cw" size={16} aria-hidden="true" />
                  Reabrir
                </button>
              )}
            </div>
          )}
        </div>
      )
    }

    <PageHeader
      title={detail?.displayName}
      description="Monitoreo de la automatización de la sucursal manual"
    />

    {
      detail && (
        <header class="bg-base-100 flex flex-col gap-2">
          <div>
            <div class="flex items-baseline justify-between">
              <h3 class="text-base-content/60 text-xs font-semibold tracking-wide uppercase">
                Progreso
              </h3>
              <span class="text-base-content text-sm font-medium">
                {detail.progress.percent}% · {detail.progress.completed} de{" "}
                {detail.progress.applicableTotal} pasos
              </span>
            </div>
            <AutomationProgressBar
              percent={detail.progress.percent}
              class="mt-0"
            />
            {showMissing && missingCount > 0 && (
              <div
                role="status"
                class="border-warning/40 bg-warning/10 text-warning-content text-warning mt-2 flex items-center gap-2 rounded-lg border px-3 py-2 text-sm"
              >
                <Icon
                  name="boxicons:alert-circle"
                  size={18}
                  aria-hidden="true"
                />
                <span>
                  {missingCount}
                  {missingCount === 1
                    ? "gestión faltante"
                    : "gestiones faltantes"}
                  según las etapas configuradas del workflow.
                </span>
              </div>
            )}
          </div>
        </header>
      )
    }
  </div>

  {
    detail && closure && (
      <div
        role="status"
        data-automation-closure-banner
        class="border-success/40 bg-success/10 text-success-content text-success mb-2 flex items-start gap-2 rounded-lg border px-3 py-2"
      >
        <Icon
          name="boxicons:check-circle"
          size={18}
          class="mt-0.5 shrink-0"
          aria-hidden="true"
        />
        <div class="flex flex-col gap-0.5">
          <p class="text-sm font-medium">
            {closure.kind === "auto"
              ? "Finalizada automáticamente al completar el flujo"
              : "Finalizada en el portal"}
          </p>
          <p class="text-sm opacity-90">{closure.reason}</p>
          <p class="text-xs opacity-75">
            {closure.kind === "auto"
              ? "Cierre automático"
              : `Cerrada por ${closure.closedBy}`}
            {" · "}
            {formatEpochDateTime(closure.closedAt)}
            {` · ${closure.percent}%`}
          </p>
        </div>
      </div>
    )
  }

  {
    !canQuery ? (
      <div role="alert" class="alert alert-warning">
        <span>
          Sesión no iniciada. Iniciá sesión para consultar la automatización.
        </span>
      </div>
    ) : loadError || !detail ? (
      <div role="alert" class="alert alert-error">
        <div>
          <h3 class="font-medium">No se pudo cargar la automatización</h3>
          <p class="text-sm opacity-80">{loadError}</p>
        </div>
      </div>
    ) : (
      <>
        {detail.initialForm && (
          <section class="flex flex-col gap-3 px-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <h2 class="text-base-content/60 text-sm font-semibold tracking-wide uppercase">
                  Datos de la solicitud
                </h2>
                {initialFormAuthor && (
                  <span class="text-base-content/50 text-xs">
                    registrado por {initialFormAuthor}
                  </span>
                )}
              </div>
              {invgateUrl && (
                <OpenExternalUrlButton
                  href={invgateUrl}
                  ariaLabel={`Abrir ticket ${detail.prettyId} en InvGate`}
                  variant="text"
                  label="Abrir en InvGate"
                  size="sm"
                />
              )}
            </div>
            <InitialFormDetails
              form={detail.initialForm}
              location={detail.location}
            />
          </section>
        )}

        <section class="flex flex-col gap-4 px-4">
          <h2 class="text-base-content/60 text-sm font-semibold tracking-wide uppercase">
            Línea de tiempo del workflow
          </h2>
          <AutomationTimeline
            nodes={detail.nodes}
            stages={detail.stages}
            showMissing={showMissing}
            showStageless={!isLegacy}
          />
        </section>
      </>
    )
  }

  {
    detail && canShowCloseButton && (
      <Modal
        id="close-automation-modal"
        title="Cerrar caso"
        icon="boxicons:check-circle"
      >
        <Fragment slot="content">
          <input type="hidden" id="close-automation-id" value={detail.id} />
          <p class="text-base-content/70 mb-4 text-sm">
            Vas a marcar <span class="font-mono">{detail.prettyId}</span> como
            finalizado en el portal. El ticket en InvGate no se modifica.
          </p>
          <FormTextarea
            id="close-automation-reason"
            name="reason"
            label="Motivo del cierre"
            rows={3}
            value={DEFAULT_CLOSE_REASON}
            required
          />
        </Fragment>
        <Fragment slot="actions">
          <div class="modal-action mt-6 flex justify-end gap-2">
            <ActionCancelButton
              type="button"
              variant="error"
              icon="boxicons:x-filled"
              label="Cancelar"
              data-close-close-automation
            />
            <ActionConfirmButton
              type="button"
              id="btn-confirm-close-automation"
              color="btn-secondary"
              icon="boxicons:check-filled"
              label="Cerrar caso"
              data-confirm-close-automation
            />
          </div>
        </Fragment>
      </Modal>
    )
  }
</PageContainer>

<script>
  import { actions } from "astro:actions";
  import { showToast } from "@/lib/toastClient";

  const setBusy = (el: Element | null, busy: boolean): void => {
    if (el instanceof HTMLButtonElement) {
      el.disabled = busy;
      el.classList.toggle("loading", busy);
    }
  };

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const openBtn = target.closest("[data-open-close-automation]");
    if (openBtn) {
      const modal = document.getElementById("close-automation-modal");
      if (modal instanceof HTMLDialogElement) modal.showModal();
      return;
    }

    const closeBtn = target.closest("[data-close-close-automation]");
    if (closeBtn) {
      const modal = document.getElementById("close-automation-modal");
      if (modal instanceof HTMLDialogElement) modal.close();
      return;
    }

    const confirmBtn = target.closest("[data-confirm-close-automation]");
    if (confirmBtn) {
      const idInput = document.getElementById("close-automation-id");
      const reasonInput = document.getElementById("close-automation-reason");
      const automationId =
        idInput instanceof HTMLInputElement ? Number(idInput.value) : NaN;
      const reason =
        reasonInput instanceof HTMLTextAreaElement ? reasonInput.value : "";

      if (!Number.isInteger(automationId)) return;

      setBusy(confirmBtn, true);
      const { error } = await actions.closeAutomation({ automationId, reason });
      setBusy(confirmBtn, false);

      if (error) {
        showToast(
          error.message || "No se pudo cerrar el caso",
          "alert-error",
        );
        return;
      }

      showToast("Caso cerrado correctamente", "alert-success");
      window.location.reload();
      return;
    }

    const reopenBtn = target.closest("[data-reopen-automation]");
    if (reopenBtn) {
      const automationId = Number(
        reopenBtn.getAttribute("data-automation-id"),
      );
      if (!Number.isInteger(automationId)) return;

      setBusy(reopenBtn, true);
      const { error } = await actions.reopenAutomation({ automationId });
      setBusy(reopenBtn, false);

      if (error) {
        showToast(
          error.message || "No se pudo reabrir el caso",
          "alert-error",
        );
        return;
      }

      showToast("Caso reabierto", "alert-success");
      window.location.reload();
    }
  });
</script>
