---
import type { PlannedCard } from "@lib/workflow/timeline-plan";
import { NODE_LIFECYCLE_DOT_CLASSES } from "@lib/workflow/node-styles";
import { formatEpochDateTime } from "@lib/format/datetime";
import OpenExternalUrlButton from "@components/ui/OpenExternalUrlButton.astro";
import WorkflowNodeBadge from "./WorkflowNodeBadge.astro";

interface Props {
  card: PlannedCard;
}

const { card } = Astro.props;
const node = card.node;
const label = card.displayLabel?.trim() || node.stepLabel;
const blockedLabel =
  node.lifecycle === "blocked" && node.rawStatusName
    ? node.rawStatusName
    : undefined;
---

<li
  class="bg-base-200/30 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-lg px-3 py-2"
>
  <div class="flex min-w-0 flex-wrap items-center gap-x-2">
    <span
      aria-hidden="true"
      class:list={[
        "size-2 shrink-0 rounded-full",
        NODE_LIFECYCLE_DOT_CLASSES[node.lifecycle],
      ]}></span>
    <span class="text-base-content text-sm">{label}</span>
    {
      node.prettyId && (
        <code class="bg-base-200 text-base-content/80 rounded px-1.5 py-0.5 font-mono text-xs">
          {node.prettyId}
        </code>
      )
    }
  </div>
  <div class="flex flex-wrap items-center gap-2">
    {
      node.scheduledFor && (
        <span class="text-base-content/60 text-xs">
          Programada {node.scheduledFor}
        </span>
      )
    }
    <span class="text-base-content/50 text-xs">
      {
        node.createdAt !== null
          ? formatEpochDateTime(node.createdAt)
          : "Sin fecha"
      }
    </span>
    <WorkflowNodeBadge lifecycle={node.lifecycle} label={blockedLabel} />
    {
      node.invgateUrl && (
        <OpenExternalUrlButton
          href={node.invgateUrl}
          ariaLabel={`Abrir ticket ${node.prettyId ?? `T${node.refId}`} en InvGate`}
          variant="icon"
          size="xs"
        />
      )
    }
  </div>
</li>
