---
import { Icon } from "astro-icon/components";
import PageContainer from "@components/ui/PageContainer.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import SectionCard from "@components/ui/SectionCard.astro";
import AutomationBackLink from "./AutomationBackLink.astro";
import AutomationLink from "./AutomationLink.astro";
import AutomationEmptyState from "./AutomationEmptyState.astro";
import StatsCard from "@components/ui/StatsCard.astro";
import MetricInfo from "@components/ui/MetricInfo.astro";
import LineChart from "@components/ui/charts/LineChart.astro";
import DonutChart from "@components/ui/charts/DonutChart.astro";
import MetricsGlossary from "./MetricsGlossary.astro";
import {
  getAutomationMetrics,
  METRIC_DEFINITIONS,
} from "@lib/workflow/metrics";
import {
  formatDays as daysText,
  formatPct as pctText,
} from "@lib/workflow/metricsFormat";
import { parseWindowParam, windowLabel } from "@lib/workflow/metricsExport";
import {
  findPostAutomationErrors,
  listRecentlyFinalizedAutomations,
  postAutomationCandidateDays,
  postAutomationConfigured,
  postAutomationWindowDays,
  summarizeByKind,
} from "@lib/workflow/post-automation";
import { deriveInvGateUiUrl } from "@lib/invgate/automation/url";
import { formatEpochDateTime } from "@lib/format/datetime";
import { getCleanBase } from "@lib/baseUrl";
import { resolveUrl } from "@lib/url";
import { isLoggedIn } from "@lib/rbac";

const user = Astro.locals.user;
const canQuery = isLoggedIn(user);

const windowDays = parseWindowParam(Astro.url.searchParams.get("window"));
const metrics = canQuery ? getAutomationMetrics({ windowDays }) : null;

const def = Object.fromEntries(METRIC_DEFINITIONS.map((d) => [d.key, d]));

const MONTHS_SHORT = [
  "ene",
  "feb",
  "mar",
  "abr",
  "may",
  "jun",
  "jul",
  "ago",
  "sep",
  "oct",
  "nov",
  "dic",
];

function monthLabel(key: string): string {
  const [year, month] = key.split("-");
  const index = Number(month) - 1;
  return `${MONTHS_SHORT[index] ?? month} ${year.slice(2)}`;
}

const path = Astro.url.pathname;

/** Href de la propia página de métricas con otra ventana. */
function windowHref(value: string): string {
  const params = new URLSearchParams();
  if (value !== "all") params.set("window", value);
  const search = params.toString();
  return `${path}${search ? `?${search}` : ""}`;
}

/** Href al listado de automatizaciones con filtros (deep-link). */
function listHref(
  overrides: { status?: string; q?: string; region?: string; age?: string } = {},
): string {
  const params = new URLSearchParams();
  if (overrides.status && overrides.status !== "all") {
    params.set("status", overrides.status);
  }
  if (overrides.q) params.set("q", overrides.q);
  if (overrides.region) params.set("region", overrides.region);
  if (overrides.age) params.set("age", overrides.age);
  const search = params.toString();
  return resolveUrl(`/automatizaciones${search ? `?${search}` : ""}`);
}

const cleanBase = getCleanBase();
const exportQuery = windowDays ? `?window=${windowDays}` : "";
const csvHref = `${cleanBase}api/automatizaciones/metrics/export.csv${exportQuery}`;
const pngHref = `${cleanBase}api/automatizaciones/metrics/export.png${exportQuery}`;

const windowTabs = [
  { value: "30", label: "30 días" },
  { value: "90", label: "90 días" },
  { value: "365", label: "1 año" },
  { value: "all", label: "Todo" },
] as const;
const activeWindow = windowDays === null ? "all" : String(windowDays);

const DONUT_CLASSES = [
  "stroke-secondary",
  "stroke-info",
  "stroke-success",
  "stroke-accent",
  "stroke-warning",
  "stroke-error",
  "stroke-primary",
  "stroke-neutral",
] as const;

const regionSlices = metrics
  ? metrics.byRegion
      .slice(0, 6)
      .map((group, index) => ({
        label: group.label,
        value: group.total,
        colorClass: DONUT_CLASSES[index % DONUT_CLASSES.length],
      }))
  : [];

const slaSlices = metrics
  ? [
      {
        label: "En fecha",
        value: metrics.sla.onTime,
        colorClass: "stroke-success",
      },
      {
        label: "Fuera de fecha",
        value: Math.max(0, metrics.sla.sample - metrics.sla.onTime),
        colorClass: "stroke-error",
      },
    ]
  : [];

const idleMax = metrics
  ? Math.max(1, ...metrics.time.idleBuckets.map((bucket) => bucket.count))
  : 1;

const backlogMax = metrics
  ? Math.max(1, ...metrics.backlog.map((bucket) => bucket.count))
  : 1;

// Monitoreo post-automatización: errores Mosaic tras el cierre.
const postConfigured = postAutomationConfigured();
const postWindowDays = postAutomationWindowDays();
const postCandidateDays = postAutomationCandidateDays();
const postMatches =
  canQuery && postConfigured
    ? await findPostAutomationErrors(
        listRecentlyFinalizedAutomations(postCandidateDays),
        postWindowDays,
      )
    : [];
const postErrorTotal = postMatches.reduce(
  (sum, match) => sum + match.errors.length,
  0,
);
const postKindTotals = summarizeByKind(postMatches);

const KIND_META = {
  mosaic: { label: "Mosaic", badge: "badge-info" },
  hardware: { label: "Hardware", badge: "badge-warning" },
  otro: { label: "Otro", badge: "badge-ghost" },
} as const;
---

<PageContainer width="xl" class="acc">
  <AutomationBackLink />

  <PageHeader
    title="Métricas de automatizaciones"
    description="Indicadores del flujo de automatización de sucursales, calculados sobre el historial local del portal."
  />

  {
    !canQuery || !metrics ? (
      <div role="alert" class="alert alert-warning">
        <span>
          Sesión no iniciada. Iniciá sesión para consultar las métricas.
        </span>
      </div>
    ) : metrics.totals.total === 0 ? (
      <AutomationEmptyState
        class="py-10"
        message="Todavía no hay historial de automatizaciones para calcular métricas. A medida que el portal registre casos vas a ver los indicadores acá."
      />
    ) : (
      <>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div
            class="join"
            role="group"
            aria-label="Ventana temporal de las métricas"
          >
            {windowTabs.map((tab) => (
              <a
                href={windowHref(tab.value)}
                aria-current={tab.value === activeWindow ? "true" : false}
                class:list={[
                  "join-item border-base-300 bg-base-200 text-base-content/70 border px-3 py-1.5 text-sm font-medium transition-colors",
                  "hover:bg-base-300",
                  tab.value === activeWindow && "acc-surface hover:opacity-90",
                ]}
              >
                {tab.label}
              </a>
            ))}
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <a href={csvHref} class="btn btn-ghost btn-sm gap-1" download>
              <Icon name="boxicons:file-detail-filled" size={16} aria-hidden="true" />
              CSV
            </a>
            <a href={pngHref} class="btn btn-ghost btn-sm gap-1" download>
              <Icon name="boxicons:image-alt-filled" size={16} aria-hidden="true" />
              PNG
            </a>
          </div>
        </div>

        <p class="text-base-content/60 -mt-2 text-xs">
          {windowLabel(metrics.window.days)}
          {metrics.dataAsOf
            ? ` · datos al ${formatEpochDateTime(metrics.dataAsOf)}`
            : ""}
        </p>

        <SectionCard
          title="Resumen ejecutivo"
          description="Los números clave del flujo de automatización."
          icon="boxicons:bar-chart-big-filled"
        >
          <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <StatsCard
              icon="bar-chart-big-filled"
              label="Total histórico"
              value={metrics.executive.total}
              subtitle="casos en la ventana"
              color="auto"
              hint={def.total.description}
              delta={{ value: metrics.delta.createdPct }}
            />
            <StatsCard
              icon="check-filled"
              label="Finalizadas"
              value={metrics.executive.finalized}
              subtitle="casos resueltos"
              color="success"
              hint={def.finalized.description}
              delta={{ value: metrics.delta.finalizedPct }}
            />
            <StatsCard
              icon="calendar-filled"
              label="En curso (WIP)"
              value={metrics.executive.active}
              subtitle="activos sin cierre local"
              color="info"
              hint={def.active.description}
            />
            <StatsCard
              icon="clock-filled"
              label="Tiempo de ciclo (mediana)"
              value={daysText(metrics.executive.medianLeadDays)}
              subtitle={`sobre ${metrics.leadTime.sample} finalizadas`}
              color="primary"
              hint={def.leadTime.description}
              formula={def.leadTime.formula}
              delta={{
                value: metrics.delta.medianLeadDaysPct,
                goodWhenUp: false,
              }}
            />
          </section>
          <p class="text-base-content/70 mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
            <span>
              Ritmo de cierre:{" "}
              <strong>
                {metrics.pace.finalizedPerWeek === null
                  ? "—"
                  : `${metrics.pace.finalizedPerWeek}/semana`}
              </strong>
            </span>
            {metrics.pace.etaWeeks !== null && (
              <span class="text-base-content/60">
                · al ritmo actual el WIP se vacía en ~{metrics.pace.etaWeeks}{" "}
                semanas
              </span>
            )}
            <MetricInfo
              label={def.pace.label}
              description={def.pace.description}
            />
          </p>
        </SectionCard>

        <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <StatsCard
            icon="clock-filled"
            label="Tiempo de ciclo (p90)"
            value={daysText(metrics.leadTime.p90Days)}
            subtitle={`promedio ${daysText(metrics.leadTime.averageDays)}`}
            color="warning"
            hint={def.leadTime.description}
          />
          <StatsCard
            icon="check-filled"
            label="Cumplimiento fecha estimada"
            value={pctText(metrics.sla.onTimeRate)}
            subtitle={`${metrics.sla.sample} con fecha · desvío ${daysText(metrics.sla.avgDeviationDays)}`}
            color="accent"
            hint={def.sla.description}
            formula={def.sla.formula}
            delta={{
              value: metrics.delta.onTimeRatePoints,
              suffix: " pp",
            }}
          />
          <StatsCard
            icon="timer"
            label="Tiempo trabajado (mediana)"
            value={daysText(metrics.time.medianActiveDays)}
            subtitle={`${metrics.time.sampleActive} con días activos`}
            color="primary"
            hint={def.time.description}
            formula={def.time.formula}
          />
          <StatsCard
            icon="alert-circle"
            label="Activo más antiguo"
            value={daysText(metrics.oldestActive?.days ?? null)}
            subtitle={metrics.oldestActive?.displayName ?? "sin casos en curso"}
            color="error"
            hint={def.oldestActive.description}
          />
        </section>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <SectionCard
            title="Casos por mes"
            description="Casos creados y finalizados desde el inicio del historial."
            icon="boxicons:calendar-filled"
          >
            <div slot="description" class="flex items-center gap-1">
              Casos creados y finalizados por mes
              <MetricInfo
                label={def.throughput.label}
                description={def.throughput.description}
              />
            </div>
            <LineChart
              labels={metrics.throughput.map((m) => monthLabel(m.month))}
              series={[
                {
                  name: "Creadas",
                  colorClass: "stroke-secondary",
                  values: metrics.throughput.map((m) => m.created),
                },
                {
                  name: "Finalizadas",
                  colorClass: "stroke-success",
                  values: metrics.throughput.map((m) => m.finalized),
                },
              ]}
              ariaLabel="Casos creados y finalizados por mes"
            />
          </SectionCard>

          <SectionCard
            title="Tiempo de ciclo por mes"
            description="Mediana de días entre creación y resolución, por mes de cierre."
            icon="boxicons:timeline"
          >
            <div slot="description" class="flex items-center gap-1">
              Mediana de tiempo de ciclo por mes
              <MetricInfo
                label={def.leadTimeByMonth.label}
                description={def.leadTimeByMonth.description}
              />
            </div>
            <LineChart
              labels={metrics.leadTimeByMonth.map((m) => monthLabel(m.month))}
              series={[
                {
                  name: "Mediana (días)",
                  colorClass: "stroke-accent",
                  values: metrics.leadTimeByMonth.map((m) => m.medianDays ?? 0),
                },
              ]}
              ariaLabel="Tiempo de ciclo mediano por mes"
            />
          </SectionCard>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <SectionCard
            title="Por región"
            description="Reparto de casos por región de la sucursal."
            icon="boxicons:map-filled"
          >
            <div slot="description" class="flex items-center gap-1">
              Reparto de casos por región
              <MetricInfo
                label={def.region.label}
                description={def.region.description}
              />
            </div>
            {metrics.byRegion.length === 0 ? (
              <p class="text-base-content/50 text-sm italic">
                Sin regiones resueltas.
              </p>
            ) : (
              <DonutChart
                slices={regionSlices}
                centerLabel="casos"
                ariaLabel="Casos por región"
              />
            )}
          </SectionCard>

          <SectionCard
            title="Cumplimiento de fecha estimada"
            description="Casos resueltos dentro de la fecha estimada del título."
            icon="boxicons:check-shield"
          >
            <div slot="description" class="flex items-center gap-1">
              Cumplimiento de la fecha estimada
              <MetricInfo
                label={def.sla.label}
                description={def.sla.description}
              />
            </div>
            {metrics.sla.sample === 0 ? (
              <p class="text-base-content/50 text-sm italic">
                Todavía no hay casos con fecha estimada resueltos.
              </p>
            ) : (
              <DonutChart
                slices={slaSlices}
                centerLabel="con fecha"
                ariaLabel="Cumplimiento de fecha estimada"
              />
            )}
          </SectionCard>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <SectionCard
            title="Backlog por antigüedad"
            description="Casos en curso según hace cuánto se iniciaron."
            icon="boxicons:clock-filled"
          >
            <div slot="description" class="flex items-center gap-1">
              Casos en curso según antigüedad
              <MetricInfo
                label={def.backlog.label}
                description={def.backlog.description}
              />
            </div>
            <ul class="flex flex-col gap-3">
              {metrics.backlog.map((bucket) => (
                <li class="flex flex-col gap-1">
                  <div class="flex items-baseline justify-between gap-2 text-sm">
                    <a
                      href={listHref({ status: "active", age: bucket.age })}
                      class="text-base-content/80 hover:text-secondary"
                    >
                      {bucket.label}
                    </a>
                    <span class="text-base-content font-semibold tabular-nums">
                      {bucket.count}
                    </span>
                  </div>
                  <div class="bg-base-200 h-2.5 overflow-hidden rounded-sm">
                    <div
                      class:list={[
                        "h-full rounded-sm",
                        bucket.label === "Más de 30 días"
                          ? "bg-error"
                          : "acc-surface",
                      ]}
                      style={`width:${Math.round((bucket.count / backlogMax) * 100)}%`}
                    />
                  </div>
                </li>
              ))}
            </ul>
          </SectionCard>

          <SectionCard
            title="Tiempo trabajado y sin actividad"
            description="Días con actividad vs. días de calendario sin movimiento."
            icon="boxicons:timer"
          >
            <div slot="description" class="flex items-center gap-1">
              Días activos y sin actividad
              <MetricInfo
                label={def.time.label}
                description={def.time.description}
              />
            </div>
            {metrics.time.sampleActive === 0 ? (
              <p class="text-base-content/50 text-sm italic">
                Todavía no hay días activos registrados.
              </p>
            ) : (
              <div class="flex flex-col gap-4">
                <div class="grid grid-cols-2 gap-3">
                  <div class="flex flex-col rounded-lg bg-primary/10 p-3">
                    <span class="text-base-content/60 text-xs font-semibold tracking-wide uppercase">
                      Días activos (mediana)
                    </span>
                    <span class="text-base-content text-xl font-bold tabular-nums">
                      {daysText(metrics.time.medianActiveDays)}
                    </span>
                  </div>
                  <div class="flex flex-col rounded-lg bg-warning/10 p-3">
                    <span class="text-base-content/60 text-xs font-semibold tracking-wide uppercase">
                      Sin actividad (mediana)
                    </span>
                    <span class="text-base-content text-xl font-bold tabular-nums">
                      {daysText(metrics.time.medianIdleDays)}
                    </span>
                  </div>
                </div>
                <ul class="flex flex-col gap-2">
                  {metrics.time.idleBuckets.map((bucket) => (
                    <li class="flex items-center gap-3">
                      <span class="text-base-content/70 w-24 shrink-0 text-xs">
                        {bucket.label}
                      </span>
                      <div class="bg-base-200 h-2.5 flex-1 overflow-hidden rounded-sm">
                        <div
                          class="bg-warning h-full rounded-sm"
                          style={`width:${Math.round((bucket.count / idleMax) * 100)}%`}
                        />
                      </div>
                      <span class="text-base-content/60 w-6 text-right text-xs tabular-nums">
                        {bucket.count}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </SectionCard>
        </div>

        <SectionCard
          title="Sucursales con errores post-automatización"
          description={`Automatizaciones cerradas en los últimos ${postCandidateDays} días con tickets de error de la sucursal en los ${postWindowDays} días posteriores al cierre.`}
          icon="boxicons:bug"
        >
          {
            !postConfigured ? (
              <p class="text-base-content/50 text-sm italic">
                Configurá <code class="font-mono">INVGATE_MOSAIC_VIEW_ID</code>{" "}
                (vista de tickets de error) para activar este monitoreo.
              </p>
            ) : postMatches.length === 0 ? (
              <p class="text-base-content/50 text-sm italic">
                Sin tickets de error (Mosaic/hardware) detectados en las
                automatizaciones cerradas recientemente.
              </p>
            ) : (
              <div class="flex flex-col gap-4">
                <p class="text-base-content/70 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                  <span>
                    <strong>{postMatches.length}</strong>{" "}
                    {postMatches.length === 1 ? "sucursal" : "sucursales"} con{" "}
                    <strong>{postErrorTotal}</strong>{" "}
                    {postErrorTotal === 1 ? "ticket" : "tickets"} de error.
                  </span>
                  <span class="flex flex-wrap items-center gap-1.5">
                    {(["mosaic", "hardware", "otro"] as const).map((kind) =>
                      postKindTotals[kind] > 0 ? (
                        <span class:list={["badge badge-sm", KIND_META[kind].badge]}>
                          {KIND_META[kind].label}: {postKindTotals[kind]}
                        </span>
                      ) : null,
                    )}
                  </span>
                </p>
                <ul class="flex flex-col gap-4">
                  {postMatches.map((match) => (
                    <li class="border-base-300 rounded-lg border p-3">
                      <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                        <AutomationLink
                          automationId={match.automationId}
                          class="text-base-content/90 hover:acc-text min-w-0 truncate text-sm font-medium"
                        >
                          {match.displayName}
                        </AutomationLink>
                        <span class="text-base-content/50 shrink-0 text-xs">
                          cerrada el {formatEpochDateTime(match.closedAt)}
                        </span>
                      </div>
                      <ul class="flex flex-col divide-y divide-base-300">
                        {match.errors.map((error) => (
                          <li>
                            <a
                              href={deriveInvGateUiUrl(error.id)}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="group hover:bg-base-200 flex items-center gap-3 rounded-sm px-1 py-2.5 transition-colors"
                              title={`Abrir ${error.prettyId} en InvGate`}
                            >
                              <span class="bg-base-200 text-base-content/70 group-hover:bg-secondary group-hover:text-secondary-content shrink-0 rounded-sm px-1.5 py-0.5 font-mono text-xs transition-colors">
                                {error.prettyId}
                              </span>
                              <span
                                class="text-base-content/80 min-w-0 flex-1 truncate text-sm"
                                title={
                                  error.canonicalTitle
                                    ? `Original: ${error.title}`
                                    : error.title
                                }
                              >
                                {error.canonicalTitle ?? error.title}
                              </span>
                              {error.helpdeskName && (
                                <span class="badge badge-ghost shrink-0 text-xs">
                                  {error.helpdeskName}
                                </span>
                              )}
                              <Icon
                                name="boxicons:arrow-up-right-square-filled"
                                size={16}
                                class="text-base-content/40 group-hover:text-secondary shrink-0 transition-colors"
                                aria-hidden="true"
                              />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </SectionCard>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <SectionCard
            title="Progreso del WIP"
            description="Avance y casos estancados/críticos."
            icon="boxicons:git-branch-filled"
          >
            <div slot="description" class="flex items-center gap-1">
              Avance y casos estancados
              <MetricInfo
                label={def.progress.label}
                description={def.progress.description}
              />
            </div>
            {metrics.progress.withData === 0 ? (
              <p class="text-base-content/50 text-sm italic">
                Todavía no hay progreso persistido (se completa al abrir casos).
              </p>
            ) : (
              <div class="flex flex-col gap-3">
                <div class="flex items-baseline justify-between gap-2 text-sm">
                  <span class="text-base-content/80">Avance promedio</span>
                  <span class="text-base-content font-semibold tabular-nums">
                    {pctText(metrics.progress.average)}
                  </span>
                </div>
                <div class="bg-base-200 h-2.5 overflow-hidden rounded-sm">
                  <div
                    class="acc-surface h-full rounded-sm"
                    style={`width:${Math.min(100, metrics.progress.average ?? 0)}%`}
                  />
                </div>
                <p class="text-base-content/60 text-xs">
                  {metrics.progress.withData} casos con progreso conocido.
                </p>
              </div>
            )}
            <div class="mt-4 grid grid-cols-2 gap-3">
              <a
                href={listHref({ status: "active" })}
                class="flex flex-col rounded-lg bg-warning/10 p-3 transition-colors hover:bg-warning/20"
              >
                <span class="text-base-content/60 text-xs font-semibold tracking-wide uppercase">
                  Estancados
                </span>
                <span class="text-base-content text-xl font-bold tabular-nums">
                  {metrics.progress.stalled}
                </span>
                <span class="text-base-content/50 text-xs">
                  +{metrics.progress.stalledThresholdDays} días sin novedad
                </span>
              </a>
              <a
                href={listHref({ status: "active", age: "30+" })}
                class="flex flex-col rounded-lg bg-error/10 p-3 transition-colors hover:bg-error/20"
              >
                <span class="text-base-content/60 text-xs font-semibold tracking-wide uppercase">
                  Críticos
                </span>
                <span class="text-base-content text-xl font-bold tabular-nums">
                  {metrics.progress.critical}
                </span>
                <span class="text-base-content/50 text-xs">
                  +{metrics.progress.ageThresholdDays} días de antigüedad
                </span>
              </a>
            </div>
          </SectionCard>

          <SectionCard
            title="Sucursales con casos más antiguos"
            description="Casos en curso ordenados por antigüedad."
            icon="boxicons:buildings"
          >
            {metrics.topBranchesByActive.length === 0 ? (
              <p class="text-base-content/50 text-sm italic">
                No hay casos en curso.
              </p>
            ) : (
              <ul class="flex flex-col divide-y divide-base-300">
                {metrics.topBranchesByActive.map((branch) => (
                  <li class="flex items-center justify-between gap-3 py-2 first:pt-0 last:pb-0">
                    <a
                      href={listHref({ status: "active", q: branch.key })}
                      class="text-base-content/80 hover:acc-text min-w-0 truncate text-sm"
                    >
                      {branch.label}
                    </a>
                    <span class="text-base-content/50 shrink-0 text-xs tabular-nums">
                      {daysText(branch.oldestActiveDays)}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </SectionCard>
        </div>

        <SectionCard
          title="Calidad del dato"
          description="Cobertura de los metadatos."
          icon="boxicons:list-ul-filled"
        >
          <div slot="description" class="flex items-center gap-1">
            Cobertura de los metadatos
            <MetricInfo
              label={def.dataQuality.label}
              description={def.dataQuality.description}
            />
          </div>
          <dl class="flex flex-col divide-y divide-base-300 text-sm">
            <div class="flex items-center justify-between gap-3 py-2 first:pt-0">
              <dt class="text-base-content/70">Sin código de sucursal</dt>
              <dd class="font-mono tabular-nums">
                {metrics.dataQuality.missingBranchCode}
              </dd>
            </div>
            <div class="flex items-center justify-between gap-3 py-2">
              <dt class="text-base-content/70">Sin fecha estimada</dt>
              <dd class="font-mono tabular-nums">
                {metrics.dataQuality.missingEstimatedEnd}
              </dd>
            </div>
            <div class="flex items-center justify-between gap-3 py-2 last:pb-0">
              <dt class="text-base-content/70">Sin región</dt>
              <dd class="font-mono tabular-nums">
                {metrics.dataQuality.missingRegion}
              </dd>
            </div>
          </dl>
        </SectionCard>

        {metrics.oldestActive && (
          <p class="text-base-content/60 flex flex-wrap items-center gap-1 text-sm">
            El caso en curso más antiguo es
            <AutomationLink
              automationId={metrics.oldestActive.automationId}
              class="link acc-text font-medium"
            >
              {metrics.oldestActive.displayName}
            </AutomationLink>
            ({daysText(metrics.oldestActive.days)}).
          </p>
        )}

        <MetricsGlossary />
      </>
    )
  }
</PageContainer>
