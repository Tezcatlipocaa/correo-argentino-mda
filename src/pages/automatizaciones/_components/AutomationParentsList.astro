---
import type { AutomationSummary } from "@lib/workflow/discovery";
import AutomationCard from "./AutomationCard.astro";
import AutomationEmptyState from "./AutomationEmptyState.astro";

interface Props {
  items: readonly AutomationSummary[];
  statusNames: Readonly<Record<number, string>>;
  emptyMessage: string;
}

const { items, statusNames, emptyMessage } = Astro.props;
---

<div data-automation-list>
  {
    items.length === 0 ? (
      <AutomationEmptyState message={emptyMessage} />
    ) : (
      <ul class="flex flex-col gap-3">
        {items.map((item, index) => (
          <li
            data-automation-row
            data-order={index}
            data-active={item.isActive ? "1" : "0"}
            data-search-nis={item.branchCode}
            data-search-pretty={item.prettyId}
            data-search-name={item.branchName}
            data-search-title={item.displayName}
          >
            <AutomationCard item={item} statusNames={statusNames} />
          </li>
        ))}
      </ul>
    )
  }
  <AutomationEmptyState
    message="Ninguna automatización coincide con la búsqueda o el filtro."
    class="mt-3 hidden"
    data-automation-no-results
  />
</div>
