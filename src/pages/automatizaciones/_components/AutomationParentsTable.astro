---
import { Icon } from "astro-icon/components";
import type { AutomationSummary } from "@lib/workflow/discovery";
import { formatEpochDateTime } from "@lib/format/datetime";
import AutomationLifecycleLabel from "./AutomationLifecycleLabel.astro";
import AutomationLink from "./AutomationLink.astro";
import AutomationEmptyState from "./AutomationEmptyState.astro";
import DataTable from "@components/ui/DataTable.astro";
import DataTableHeaderCell from "@components/ui/DataTableHeaderCell.astro";

interface Props {
  items: readonly AutomationSummary[];
  emptyMessage: string;
}

const { items, emptyMessage } = Astro.props;

const headerGridClass =
  "grid-cols-[130px_minmax(180px,1.5fr)_120px_130px_100px_minmax(140px,1fr)_150px_90px] gap-3";
const rowGridClass = `grid ${headerGridClass} items-center`;
---

{
  items.length === 0 ? (
    <AutomationEmptyState message={emptyMessage} />
  ) : (
    <DataTable
      ariaLabel="Automatizaciones"
      headerGridClass={headerGridClass}
      rowGridClass={rowGridClass}
      minWidthClass="min-w-0 md:min-w-max"
      headerVariant="subtle"
      fullscreen
      stackOnMobile
    >
      <div slot="header">
        <DataTableHeaderCell sortKey="codigo">Código</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="sucursal">Sucursal</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="region">Región</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="estado">Estado</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell align="right" sortKey="progreso">
          Progreso
        </DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="mesa">Mesa</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell sortKey="iniciada">Iniciada</DataTableHeaderCell>
      </div>
      <div slot="header">
        <DataTableHeaderCell align="right">Acciones</DataTableHeaderCell>
      </div>

      {items.map((item) => (
        <div
          data-table-row
          class={`${rowGridClass} hover:bg-base-200/50 transition-colors duration-200`}
          data-sort-codigo={item.prettyId}
          data-sort-sucursal={item.displayName}
          data-sort-region={item.region ?? ""}
          data-sort-estado={item.statusId}
          data-sort-progreso={typeof item.progressPercent === "number" ? item.progressPercent : -1}
          data-sort-mesa={item.assignedGroupName ?? ""}
          data-sort-iniciada={item.createdAt}
        >
          <div class="min-w-0" data-label="Código">
            <code class="bg-base-200 text-base-content/80 rounded px-1.5 py-0.5 font-mono text-xs">
              {item.prettyId}
            </code>
          </div>
          <div class="min-w-0 truncate" title={item.displayName} data-label="Sucursal">
            {item.displayName}
          </div>
          <div class="min-w-0 text-base-content/70" data-label="Región">
            {item.region ?? "—"}
          </div>
          <div class="min-w-0" data-label="Estado">
            <AutomationLifecycleLabel
              statusId={item.statusId}
              active={item.isActive && !item.localClosure}
              hasClosure={item.localClosure != null}
            />
          </div>
          <div class="text-right font-mono tabular-nums" data-label="Progreso">
            {typeof item.progressPercent === "number"
              ? `${item.progressPercent}%`
              : "—"}
          </div>
          <div class="min-w-0 truncate text-base-content/70" data-label="Mesa">
            {item.assignedGroupName ?? "—"}
          </div>
          <div class="text-base-content/70 text-xs whitespace-nowrap" data-label="Iniciada">
            {formatEpochDateTime(item.createdAt)}
          </div>
          <div class="flex justify-end" data-label="Acciones">
            <AutomationLink
              automationId={item.id}
              class="btn btn-ghost btn-xs gap-1"
            >
              Ver
              <Icon name="boxicons:chevron-right" size={12} aria-hidden="true" />
            </AutomationLink>
          </div>
        </div>
      ))}
    </DataTable>
  )
}
