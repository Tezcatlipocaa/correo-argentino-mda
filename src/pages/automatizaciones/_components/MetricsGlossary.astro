---
import MetricsLegend from "@components/ui/MetricsLegend.astro";
import { METRIC_DEFINITIONS } from "@lib/workflow/metrics";

const definitions = METRIC_DEFINITIONS;
---

<MetricsLegend
  title="¿Cómo se calcula cada métrica?"
  items={definitions}
  collapsible
>
  <p slot="extra" class="text-base-content/50 text-xs">
    Los indicadores se calculan sobre el historial local del portal
    (`automation_parents`). El progreso persistido sólo existe para casos
    abiertos alguna vez y las fechas estimadas sólo para títulos con fecha
    (workflow AUTSUC).
  </p>
</MetricsLegend>
