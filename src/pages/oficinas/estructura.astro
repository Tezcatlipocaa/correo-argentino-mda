---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageContainer from "@components/ui/PageContainer.astro";
import MetricsHeader from "@components/ui/MetricsHeader.astro";
import OfficeTreeCanvas from "@components/oficinas/estructura/OfficeTreeCanvas";
import { getOfficeStructureTree } from "@lib/offices/structure-tree";
import { getCleanBase } from "@lib/baseUrl";
import { Icon } from "astro-icon/components";

const cleanBase = getCleanBase();
const tree = await getOfficeStructureTree();
---

<BaseLayout title="Estructura de Red Postal | Oficinas">
  <PageContainer width="xxl">
    <MetricsHeader
      backHref={`${cleanBase}oficinas`}
      backLabel="Volver al directorio"
      title="Estructura de Red Postal"
      description="Visualización jerárquica de regiones, provincias, complejos edilicios y unidades operativas de Correo Argentino."
    >
      <Fragment slot="actions">
        <a
          href={`${cleanBase}oficinas/estadisticas`}
          class="btn btn-outline btn-sm gap-2"
          title="Ver estadísticas consolidadas de la red"
        >
          <Icon name="boxicons:bar-chart-big" size={18} />
          <span>Estadísticas</span>
        </a>
      </Fragment>
    </MetricsHeader>

    <div class="mt-6">
      <OfficeTreeCanvas client:load rootNode={tree} />
    </div>
  </PageContainer>
</BaseLayout>
